#駐留軍施設 ar_a 茂木
ar_a_root:
  root:     true
  low:      "ar_a_root_low"

ar_b_root:
  root:     true
  low:      "ar_b_root_low"

ar_a:
  occluder: "ar_a_occ"
  low:      "ar_a_low"
  part:     true

ar_b:
  occluder: "ar_b_occ"
  low:      "ar_b_low"
  part:     true

ar_stage:               #ビスマレアに設置する舞台をArea化 工藤
  root:     true

