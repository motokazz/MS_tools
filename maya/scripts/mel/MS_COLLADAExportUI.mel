//ビジビリティーを強制OFF
global proc MS_forceVisibilityOff(int $mode){
	string $sel[]=`ls -sl`;
	if($mode==1){
		//選択オブジェクト以外のMESHビジビリティーを強制OFF
		select -all;
		select -d $sel;
	}
	//$mode==0なら選択オブジェクト内のMESHビジビリティーを強制OFF
	
	string $mesh[]=`listRelatives -f -ad -typ mesh`;
	string $obj[]=`listRelatives -f -p $mesh`;
	select -r $obj;
	setAttr -k on .visibility;
	for($each in $obj){
		setAttr ($each+".visibility") 0;
	}
	if($mode==1){
		select -r $sel;
	}
}


//ロケータ作成
global proc MS_COLLADAExportUI_transform2locator(){
	string $obj[]=`ls -tr -sl`;
	
	for ($each in $obj){
	
		float $tx=`getAttr($each+".tx")`;
		float $ty=`getAttr($each+".ty")`;
		float $tz=`getAttr($each+".tz")`;
		float $rx=`getAttr($each+".rx")`;
		float $ry=`getAttr($each+".ry")`;
		float $rz=`getAttr($each+".rz")`;
		float $sx=`getAttr($each+".sx")`;
		float $sy=`getAttr($each+".sy")`;
		float $sz=`getAttr($each+".sz")`;
		
		string $loc[]=`spaceLocator`;
		
		setAttr ($loc[0]+".tx") $tx;
		setAttr ($loc[0]+".ty") $ty;
		setAttr ($loc[0]+".tz") $tz;
		setAttr ($loc[0]+".rx") $rx;
		setAttr ($loc[0]+".ry") $ry;
		setAttr ($loc[0]+".rz") $rz;
		setAttr ($loc[0]+".sx") $sx;
		setAttr ($loc[0]+".sy") $sy;
		setAttr ($loc[0]+".sz") $sz;
		
		rename $loc[0] ("loc_"+$each);
		
	}


}

//重複オブジェクト名処理
global proc string[] MS_COLLADAExportUI_uniqueRename(string $mode){
	//シーン内のオブジェクトを、重複チェックや被らない名前にリネームする
	//オプション
	//check 重複チェックモード
	//rename リネームモード
	
	string $longName[]=`ls -l `;
	string $shortName[];
	
	int $i=0,$j=0;
	string $tmp[];
	string $renamed[];//リネーム前後の名前をセットにした配列<MS_NO_DABURI>という記号で区切られてる。
	string $kaburi[];//被り名前リスト
	int $found;//被りチェック
	
	//ショートネームのリスト作成
	for($each in $longName){
		tokenize($each,"|",$tmp);
		$shortName[$i]=$tmp[size($tmp)-1];
		
		$found =stringArrayCount($shortName[$i],$shortName);
		if($found>1){
			//チェック処理
			if($mode=="check"){
				string $kabutteru[]=`ls -l $shortName[$i]`;
				stringArrayToString($kabutteru,"&\n");
				$kaburi[$j]=("==================================================\n"+stringArrayToString($kabutteru,"\n")+"\n以上"+size($kabutteru)+"オブジェクトが重複\n==================================================\n");
				$j++;
				
			}
			//リネーム処理
			if($mode=="rename"){
				$renamed[$j]=`rename $each ($shortName[$i]+"_#")`+"<MS_NO_DABURI>"+$shortName[$i];
				$j++;
				print $each;
			}
		}
		$found=0;
		$i++;
		
	}
	
	print ("rename "+size($renamed));
	
	//リネーム後に元に戻す処理
	/*
	for($each in $renamed){
		tokenize($each,"<MS_NO_DABURI>",$tmp);
		rename $tmp[0] $tmp[1];
	}
	*/
	return $kaburi;
}


global proc string MS_exportAttr_createSet(string $attrList[]){
	string $obj[]=`ls -sl`;
	string $ex;
	
	$i=0;
	for($each in $obj){
		string $command;
		//objName
		$ex=$ex+$each+"(transform(";
		//setID
		//$ex=$ex+",ID="+$i;
		//eachAttr
		for($eachAttr in $attrList){
				//$ex=($ex+","+$eachAttr+"="+`getAttr ($each+"."+$eachAttr)`); 
				$ex=($ex+","+`getAttr ($each+"."+$eachAttr)`); 
		}
		
		$ex=$ex+"))\n";
		$i++;
	}
	return $ex;
}

//COLLADA出力

proc MS_colladaExport(string $outName, string $triangles ){
	//file -f -o $inName;
	file -f -op ("bakeTransforms=1;relativePaths=1;bakeLighting=0;exportCameraAsLookat=0;" 
		+ $triangles
		+ "isSampling=1;curveConstrainSampling=0;exportLights=0;exportCameras=0;exportJointsAndSkin=1;"
		+"exportInvisibleNodes=0;exportNormals=1;exportTexCoords=1;exportVertexColors=0;"
		+"exportTangents=0;exportTexTangents=1;exportMaterialsOnly=0;exportConstraints=0;"
		+"exportPhysics=0;exclusionSetMode=0;exclusionSets=;exportXRefs=1;dereferenceXRefs=0;"
		+"cameraXFov=0;cameraYFov=1;")
		-typ "COLLADA exporter"
		-pr 
		-ea ($outName + ".dae");
}

proc MS_colladaExport_All( string $outName ,int $mode ){
	string $OPTION=("bakeTransforms=1;exportPolygonMeshes=1;bakeLighting=0;isSampling=1;"
	+"curveConstrainSampling=0;removeStaticCurves=1;exportCameraAsLookat=0;"
	+"exportLights=0;exportCameras=0;exportJointsAndSkin=1;"
	+"exportAnimations=1;exportTriangles=1;exportInvisibleNodes=0;"
	+"exportNormals=1;exportTexCoords=1;"
	+"exportVertexColors=0;exportVertexColorsAnimation=0;exportTangents=0;"
	+"exportTexTangents=1;exportConstraints=0;exportPhysics=0;exportXRefs=1;instanceDuplicateCurves=0;"
	+"dereferenceXRefs=0;cameraXFov=0;cameraYFov=1");
	
	switch ($mode){
		case 0:
			file -op $OPTION -typ "COLLADA exporter" -pr -ea $outName;
		break;
		case 1:
			file -op $OPTION -typ "COLLADA exporter" -pr -es $outName;
		break;
	}
}

