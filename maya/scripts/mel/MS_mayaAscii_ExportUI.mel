/*
mayaAscii_Export.mel
v1.1
◆概要
選択したトップLOCATERの名前をつけて、その子供を全てXFFファイル出力

◆使用方法

１・準備
出力先の基本となるディレクトリ、
D:/DATA/xff/
を作成するとよい。

２・オプション設定
---チェックボックス---
ExportModel
ExportAnim
ExportMatanim
IgnoreBindpose
IgnoreRefferencenode
※上記チェックボックスは、onで各項目有効

AnimNameIsMotion
※このチェックボックスがONになっていると、出力されるアニメーション名が「motion」になる。（BG用）
　OFFのときは、親locaterの名前＋「additionalAnimationName」が有効になる。

---名前入力---
additionalModelName
additionalAnimationName
ここに入力した名前が、親locaterの名前にプラスされて出力される。

---出力パス設定---
mayaAscil_ExportUI_filePath
ここに入力したPATHに出力される。「Brouse」ボタンでブラウザによるディレクトリ選択が可能。

---各種ボタン---
Camera
カメラ出力が出来る。出力ファイル名は「additionalAnimationName」＋”.camera.pcxff”になる。

Export
オブジェクトのエキスポートが出来る。
出力ファイル名は、親locater名＋「additionalAnimationName」＋”.pcxff”になる。
出力アニメーション名は、親locater名＋「additionalAnimationName」になる。（AnimNameIsMotionにチェック無しの場合）

Exit
ウインドウを閉じる。

３・実行
出力したいオブジェクトを選択して、ボタンを押す。


◆詳細
選択したグループの名前でラベルを作成して、グループごとにファイルを出力します。
ファイル名もグループの名前で出力されます。

出力前に、テクスチャーファイルを全て.ddsファイルに張り替えます。（fileノードの拡張子記述を強制的に.ddsに書き換えています。）

基本出力先は、このスクリプトを直接いじっていただければ変更できます・・・


*/

global proc MS_disconnectSG(string $NODE[]){
	//cut parent
	for($eachNode in $NODE){
		string $CONNECTIONS[]= `listConnections -p 1 -d 1 -s 0 ($eachNode+".outColor")`;
		for ($each in $CONNECTIONS){
			disconnectAttr `listConnections -p 1 $each`  $each ;
		}
	}
}

global proc MS_disconnectParent(string $NODE[]){
	//cut parent
	for($eachNode in $NODE){
		string $CONNECTIONS[]= `listConnections -p 1 -d 1 -s 0 $eachNode`;
		for ($each in $CONNECTIONS){
			disconnectAttr `listConnections -p 1 $each`  $each ;
		}
	}
}

global proc MS_disconnectChild(string $NODE[]){
	//cut child
	for($eachNode in $NODE){
		string $CONNECTIONS[]= `listConnections -p 1 -d 0 -s 1 $eachNode`;
		for ($each in $CONNECTIONS){
			disconnectAttr $each `listConnections -p 1 $each`;
		}
	}
}

global proc MS_mayaAscilExport_storeRecallUI( string $mode ){
	string $prefix="MS_mayaAscilExport__";
	
	string $floatFieldList[] = {
		};

	string $intFieldList[] = {
		};

	string $floatSliderGrpList[] = {
		};

	string $intSliderGrpList[] = {
		};

	string $checkBoxList[] = {
		"History",
		"Channels",
		"Expressions",
		"Constraints",
		"TextureInfo"
		};

	string $radioButtonGrpList[] = {
		};

	string $frameLayoutList[] = {
		};

	string $textFieldList[] = {
		"ModelName",
		"AnimationName"
		};

	string $textFieldList_file[] = {
		"mayaAscil_ExportUI_filePath"
		};

	int $cnt;

	if ( $mode == "store" )
	{
		for ( $each in $floatFieldList)
			optionVar -floatValue ($prefix+$each) `floatField -q -value $each`;

		for ( $each in $intFieldList)
			optionVar -intValue ($prefix+$each) `intField -q -value $each`;

		for ( $each in $floatSliderGrpList)
			optionVar -floatValue ($prefix+$each) `floatSliderGrp -q -value $each`;

		for ( $each in $intSliderGrpList)
			optionVar -intValue ($prefix+$each) `intSliderGrp -q -value $each`;

		for ( $each in $checkBoxList)
			optionVar -intValue ($prefix+$each) `checkBox -q -value $each`;

		for ( $each in $radioButtonGrpList)
			optionVar -intValue ($prefix+$each) `radioButtonGrp -q -select $each`;

		for ( $each in $frameLayoutList)
			optionVar -intValue ($prefix+$each) `frameLayout -q -collapse $each`;

		for ( $each in $textFieldList)
			optionVar -stringValue ($prefix+$each) `textField -q -tx $each`;

		for ( $each in $textFieldList_file)
			optionVar -stringValue ($prefix+$each) `textField -q -fileName $each`;
	}

	if ( $mode == "recall" )
	{
		for ( $each in $floatFieldList)
			if ( `optionVar -exists ($prefix+$each)` )
				floatField -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $intFieldList)
			if ( `optionVar -exists ($prefix+$each)` )
				intField -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $floatSliderGrpList)
			if ( `optionVar -exists ($prefix+$each)` )
				floatSliderGrp -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $intSliderGrpList)
			if ( `optionVar -exists ($prefix+$each)` )
				intSliderGrp -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $checkBoxList)
			if ( `optionVar -exists ($prefix+$each)` )
				checkBox -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $radioButtonGrpList)
			if ( `optionVar -exists ($prefix+$each)` )
				radioButtonGrp -e -select `optionVar -q ($prefix+$each)` $each;

		for ( $each in $frameLayoutList)
			if ( `optionVar -exists ($prefix+$each)` )
				frameLayout -e -collapse `optionVar -q ($prefix+$each)` $each;

		for ( $each in $textFieldList)
			if ( `optionVar -exists ($prefix+$each)` )
				textField -e -tx `optionVar -q ($prefix+$each)` $each;

		for ( $each in $textFieldList_file)
			if ( `optionVar -exists ($prefix+$each)` )
				textField -e -fileName `optionVar -q ($prefix+$each)` $each;

	}

	if ( $mode == "reset" )
	{
		for ( $each in $floatFieldList)
			optionVar -remove ($prefix+$each);

		for ( $each in $intFieldList)
			optionVar -remove ($prefix+$each);

		for ( $each in $floatSliderGrpList)
			optionVar -remove ($prefix+$each);

		for ( $each in $intSliderGrpList)
			optionVar -remove ($prefix+$each);

		for ( $each in $checkBoxList)
			optionVar -remove ($prefix+$each);

		for ( $each in $radioButtonGrpList)
			optionVar -remove ($prefix+$each);

		for ( $each in $frameLayoutList)
			optionVar -remove ($prefix+$each);

		for ( $each in $textFieldList)
			optionVar -remove ($prefix+$each);

		for ( $each in $textFieldList_file)
			optionVar -remove ($prefix+$each);
	}
}

global proc mayaAscii_Export_core(){
	$path=`textField -q -fileName "mayaAscil_ExportUI_filePath"`;
	//$path="D:/DATA/xff/";//出力パス
	
	string $AnimationName=`textField -q -tx "AnimationName"` ;//Data//
	string $ModelName=`textField -q -tx "ModelName"`;//Data//
	string $newAnimName;
	
	//if(`radioButtonGrp -q -sl smp_radio`){
	
	int $ch=`checkBox -q -v "History"` ;//Data//
	int $chn=`checkBox -q -v "Channels"` ;//Data//
	int $con=`checkBox -q -v "Expressions"` ;//Data//
	int $exp=`checkBox -q -v "Constraints" `;//Data//
	int $sh=`checkBox -q -v "TextureInfo"` ;//Data//
	

	string $obj_name[];
	$obj_name=`ls -mat -sl`;
	if(!size($obj_name)){
		$obj_name=`ls -as -sl`;
	}else{
		print $obj_name;
		MS_disconnectSG $obj_name;
		string $UVCHOOSER[]=`ls -typ uvChooser`;
		MS_disconnectParent $UVCHOOSER;
		select -all;
		HideSelectedObjects;
		python("execfile(\"D:/MProject/GTools/scripts/MP_MS_matSwatchMaker.py\")\nMP_MS_matSwatchMaker(\'"+$path+"\')\n");
		undo;
	}
	
	$i=0;
	for($i=0;$i<size($obj_name);$i++){
		select -r $obj_name[$i];
		
		$full_p_name=($path+$obj_name[$i]+$ModelName);
		$operation=(
			"ch="+$ch+
			";chn="+$chn+
			";con="+$con+
			";exp="+$exp+
			";sh="+$sh+";"
		);
		
		print $operation;
		print $full_p_name;
		print "\n";
		$operation="v=0";
		file -op $operation -typ "mayaAscii" -pr -es $full_p_name;
	}
}

global proc MS_mayaAscii_Export(){

	mayaAscii_Export_core;
//	MS_mayaAscii_Export_TexExtRep_All 2;

}

global proc mayaAscii_Export_get_dir(string $exp_dir,string $dummy){

	textField -e -fileName ($exp_dir+"/") "mayaAscil_ExportUI_filePath";
	MS_mayaAscilExport_storeRecallUI store;
}


