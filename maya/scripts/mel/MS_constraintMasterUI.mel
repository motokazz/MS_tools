		for($each_b in $tangent_base){
			$tangent[$i]=`substring $each_b 1 (size($each_b)-2)`;
			$i++;
		}
		int $i=0;
		for($each_b in $poleVector_base){
			$poleVector[$i]=`substring $each_b 1 (size($each_b)-2)`;
