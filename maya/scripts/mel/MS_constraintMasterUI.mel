global proc MS_jointToComponents_core()
{
	float $center[3];

	// Assert that the user has selected one or more polymesh components	
	string $meshComponents[] = `filterExpand -sm 31 -sm 32 -sm 34`;

	// Get shape nodes for selected items
	string $selectedNodes[] = `selectedNodes`;
	
	//quary rotation 
	string $baseobj[]=`ls -o -hl`;
	float $rotX=0,$rotY=0,$rotZ=0;
	float $tmpX=0,$tmpY=0,$tmpZ=0;
	float $rot[];
	
	
	if ( size($meshComponents) && size($selectedNodes) )
	{
		float $bbox[5] = `polyEvaluate -bc`;
		
		$center[0] = ( ($bbox[0]/2) + ($bbox[1]/2) ) ;
		$center[1] = ( ($bbox[2]/2) + ($bbox[3]/2) ) ;
		$center[2] = ( ($bbox[4]/2) + ($bbox[5]/2) ) ;
		
		for($each in $baseobj){
		$rot=`xform -q -ws -ro $each`;
		$tmpX=$tmpX+$rot[0];
		$tmpY=$tmpY+$rot[1];
		$tmpZ=$tmpZ+$rot[2];
		}
		$rotX=$tmpX/size($baseobj);
		$rotY=$tmpY/size($baseobj);
		$rotZ=$tmpZ/size($baseobj);
		
		select -cl;
		$joint=`joint -p $center[0] $center[1] $center[2] -sc false`;
		xform -ws -ro $rotX $rotY $rotZ $joint;
		
	}
}

global proc MS_locatorToComponentsV2_core()
{
	float $center[3];

	// Assert that the user has selected one or more polymesh components	
	string $meshComponents[] = `filterExpand -sm 31 -sm 32 -sm 34`;

	// Get shape nodes for selected items
	string $selectedNodes[] = `selectedNodes`;
	
	//quary rotation 
	string $baseobj[]=`ls -o -hl`;
	float $rotX=0,$rotY=0,$rotZ=0;
	float $tmpX=0,$tmpY=0,$tmpZ=0;
	float $rot[];
	
	if ( size($meshComponents) && size($selectedNodes) )
	{
		float $bbox[5] = `polyEvaluate -bc`;
		
		$center[0] = ( ($bbox[0]/2) + ($bbox[1]/2) ) ;
		$center[1] = ( ($bbox[2]/2) + ($bbox[3]/2) ) ;
		$center[2] = ( ($bbox[4]/2) + ($bbox[5]/2) ) ;
		
		for($each in $baseobj){
		$rot=`xform -q -ws -ro $each`;
		$tmpX=$tmpX+$rot[0];
		$tmpY=$tmpY+$rot[1];
		$tmpZ=$tmpZ+$rot[2];
		}
		$rotX=$tmpX/size($baseobj);
		$rotY=$tmpY/size($baseobj);
		$rotZ=$tmpZ/size($baseobj);
		
		$locatername=`spaceLocator -p 0 0 0`;
		move -wd $center[0] $center[1] $center[2] $locatername;
		xform -ws -ro $rotX $rotY $rotZ $locatername;
		//spaceLocator -p $center[0] $center[1] $center[2];
	}
}

