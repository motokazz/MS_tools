		/*ターゲット名をウェイトリストから取得する試み
		string $point[];
		string $aim[];
		string $orient[];
		string $scale[];
		string $parent[];
		string $geometry[];
		string $normal[];
		string $tangent[];
		string $poleVector[];
		

		
		
		string $point_base[]=`pointConstraint -q -wal $each`;
		string $aim_base[]=`aimConstraint -q -wal $each`;
		string $orient_base[]=`orientConstraint -q -wal $each`;
		string $scale_base[]=`scaleConstraint -q -wal $each`;
