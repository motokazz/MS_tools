	-af "text15" "left" 16//Data//
	-af "text15" "top" 48//Data//
	-af "text14" "left" 16//Data//
	-af "text14" "top" 80//Data//
	-af "AlphaMax" "left" 80//Data//
	-af "AlphaMax" "top" 80//Data//
	-af "text11" "left" 16//Data//
	-af "text11" "top" 16//Data//
	-af "floatField6" "left" 80//Data//
