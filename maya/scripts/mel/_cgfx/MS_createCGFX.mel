/*
 -------------------
MS_replace_BG_1.mel
-------------------
◆概要
CGFXシェーダーが新規作成のみなので、BG-1シェーダーに関してのCGFXシェーダー差込みスクリプトを作ってみた。

◆使用方法
１・BG-1シェーダーを差し込みたいマテリアルを選ぶ。
２・スクリプトを実行する

◆詳細
テクスチャー関連の情報をBG1シェーダーを挟んだ状態で自動的にコネクションしなおして再現する。
今のところBG1シェーダにしか対応してない。

※注意
・コネクションしなおしてもテクスチャー自体の差し替えが無いので、DDS以外のフォーマットで作業をする場合は、そのままエキスポートできない。

 */
 
global proc MS_replace_BG_1()
{
	/*MS_情報取得*/
	string $sel_mat[]=`ls -sl`;
	string $defaultShader =$sel_mat[0];
	
	string $connectedColor[]=`listConnections -d off -s on .color`;
	string $connectedTexture0=$connectedColor[0];
	
	print $connectedTexture0;
	
	string $connectedP2D[]=`listConnections -d off -s on ($connectedTexture0+".uvCoord")`;
	string $connectedP2D0 = $connectedP2D[0];

	/* cgfxシェーダーノードと、SGノードを作成する */
	string $cgfxMaterialNode = `shadingNode -asShader cgfxShader`;
	string $cgfxMaterialSG   = $cgfxMaterialNode + string("SG");
	string $cgfxMaterialSGNode = `sets -renderable true -noSurfaceShader true -empty -name $cgfxMaterialSG`;
	//string $defaultShader    = `shadingNode -asShader lambert -n BG01defalut`;

	//setAttr ($defaultShader+".transparency") -type double3 0.1 0.1 0.1 ;

	/* cgfxのマテリアルデータを設定する */
	setMaterialUserdata( $cgfxMaterialNode );
	setAttr ($cgfxMaterialNode+".Priority") 0;
	setAttr -type "string" ($cgfxMaterialNode+".RenderStage") "background";
	
	/* シェーダー間をコネクトする */
	connectAttr -f ($cgfxMaterialNode+".outColor") ($defaultShader+".hardwareShader");
	connectAttr -f ($defaultShader+".outColor") ($cgfxMaterialSGNode+".surfaceShader");
	
	//addAttr -ln Priority -at long  -min -5 -max 5 $cgfxMaterialSGNode;
	//setAttr ($cgfxMaterialSGNode+".Priority") 0;
	
	/* エフェクト用のcgfxファイルを読み込む */
	eval(" cgfxShader -e -fx \"D:/cubic_maya/media/cgfx/01_constant.cgfx\"" + $cgfxMaterialNode );

	/* 接続されているPlace2DTextureノードを取得する */
	string $samplerName0    = "ColorSampler0";
	string $place2dtexture0 = eval( "findPlace2dTexture " + $cgfxMaterialNode + " " + $samplerName0 );
	string $filetexture0    = eval( "findTextureNode " + $cgfxMaterialNode + " " + $samplerName0 );

	/*MS_ノード削除*/
	if($connectedTexture0!=""){
		delete $place2dtexture0;
		delete $filetexture0;
		$place2dtexture0=$connectedP2D0;
	}
	
	/* テクスチャフィルタの設定 */
	if(`attributeExists Anisotropy $connectedTexture0`==0){
		eval( "setSamplerUserData " + $connectedTexture0 );
	}
	
	connectAttr -f ($connectedTexture0+".outColor") ( $cgfxMaterialNode+".ColorSampler0");

	/* Textureスクロール用のアトリビュートをシェーダーのアトリビュートに接続する */
	connectAttr -f ($place2dtexture0+".offsetU")  ($cgfxMaterialNode+".texOffset0X");
	connectAttr -f ($place2dtexture0+".offsetV")  ($cgfxMaterialNode+".texOffset0Y");
	connectAttr -f ($place2dtexture0+".repeatU")  ($cgfxMaterialNode+".texScale0X");
	connectAttr -f ($place2dtexture0+".repeatV")  ($cgfxMaterialNode+".texScale0Y");

	/* expressionでrotateUVの値をradianに変換する */
	expression -s ($cgfxMaterialNode+".texRotate0 = "+$connectedP2D0+".rotateUV * 3.1415926535 / 180.0") -o cgfxShader1 -ae 1 -uc all;
	
	/* テクスチャUV以外は頂点アトリビュートを設定しない */
	eval("setAttr " + $cgfxMaterialNode + ".cs -type stringArray 1 \"colorSet1\" ");
	eval("setAttr " + $cgfxMaterialNode + ".tcs -type stringArray 3 \"map1\" \"\" \"\" ");
	
	/*MS_ デフォルトシェーダにテクスチャノードを接続する */
	connectAttr -f ($connectedTexture0+".outColor") ($defaultShader+".color");

	select -r $defaultShader;

}

global proc MS_replace_BGS_1()
{
	/*MS_情報取得*/
	string $sel_mat[]=`ls -sl`;
	string $defaultShader =$sel_mat[0];
	
	string $connectedTexture[]=`listConnections -d off -s on .color`;
	//string $connectedTexture0=$connectedColor[0];
	
	string $connectedP2D[]=`listConnections -d off -s on ($connectedTexture[0]+".uvCoord")`;
	//string $connectedP2D0 = $connectedP2D[0];

	/* cgfxシェーダーノードと、SGノードを作成する */
	string $cgfxMaterialNode = `shadingNode -asShader cgfxShader`;
	string $cgfxMaterialSG   = $cgfxMaterialNode + string("SG");
	string $cgfxMaterialSGNode = `sets -renderable true -noSurfaceShader true -empty -name $cgfxMaterialSG`;
	//string $defaultShader    = `shadingNode -asShader lambert -n BG01defalut`;

	//setAttr ($defaultShader+".transparency") -type double3 0.1 0.1 0.1 ;

	/* cgfxのマテリアルデータを設定する */
	setMaterialUserdata( $cgfxMaterialNode );
	setAttr ($cgfxMaterialNode+".Priority") 0;
	setAttr -type "string" ($cgfxMaterialNode+".RenderStage") "background";
	
	/* シェーダー間をコネクトする */
	connectAttr -f ($cgfxMaterialNode+".outColor") ($defaultShader+".hardwareShader");
	connectAttr -f ($defaultShader+".outColor") ($cgfxMaterialSGNode+".surfaceShader");
	
	//addAttr -ln Priority -at long  -min -5 -max 5 $cgfxMaterialSGNode;
	//setAttr ($cgfxMaterialSGNode+".Priority") 0;
	
	/* エフェクト用のcgfxファイルを読み込む */
	eval(" cgfxShader -e -fx \"D:/cubic_maya/media/cgfx/32_constant_shadow.cgfx\"" + $cgfxMaterialNode );

	/* 接続されているPlace2DTextureノードを取得する */
	string $samplerName0    = "ColorSampler0";
	string $place2dtexture0 = eval( "findPlace2dTexture " + $cgfxMaterialNode + " " + $samplerName0 );
	string $filetexture0    = eval( "findTextureNode " + $cgfxMaterialNode + " " + $samplerName0 );
	
	string $samplerName1    = "ShadowSampler0";
	string $place2dtexture1 = eval( "findPlace2dTexture " + $cgfxMaterialNode + " " + $samplerName1 );
	string $filetexture1    = eval( "findTextureNode " + $cgfxMaterialNode + " " + $samplerName1 );
	

	/*MS_ノード削除*/
	if($connectedTexture[0]!=""){
		delete $place2dtexture0;
		delete $filetexture0;
		$place2dtexture0=$connectedP2D[0];
		$fileTexture0=$connectedTexture[0];
	}
	
	if($connectedTexture[1]!=""){
		delete $place2dtexture1;
		delete $filetexture1;
		$place2dtexture1=$connectedP2D[1];
		$fileTexture1=$connectedTexture[1];
	}
	
	/* テクスチャフィルタの設定 */
	if(`attributeExists Anisotropy $filetexture0`==0){
		eval( "setSamplerUserData " + $filetexture0 );
	}
	if(`attributeExists Anisotropy $filetexture1`==0){
		eval( "setSamplerUserData " + $filetexture1 );
	}
	
	/* デフォルトシェーダにテクスチャノードを接続する */
	connectAttr -f ($filetexture0+".outColor") ( $cgfxMaterialNode+".ColorSampler0");
	connectAttr -f ($filetexture1+".outColor") ( $cgfxMaterialNode+".ShadowSampler0");

	/* Textureスクロール用のアトリビュートをシェーダーのアトリビュートに接続する */
	connectAttr -f ($place2dtexture0+".offsetU")  ($cgfxMaterialNode+".texOffset0X");
	connectAttr -f ($place2dtexture0+".offsetV")  ($cgfxMaterialNode+".texOffset0Y");
	connectAttr -f ($place2dtexture0+".repeatU")  ($cgfxMaterialNode+".texScale0X");
	connectAttr -f ($place2dtexture0+".repeatV")  ($cgfxMaterialNode+".texScale0Y");
	
	connectAttr -f ($place2dtexture1+".offsetU")  ($cgfxMaterialNode+".texOffset1X");
	connectAttr -f ($place2dtexture1+".offsetV")  ($cgfxMaterialNode+".texOffset1Y");
	connectAttr -f ($place2dtexture1+".repeatU")  ($cgfxMaterialNode+".texScale1X");
	connectAttr -f ($place2dtexture1+".repeatV")  ($cgfxMaterialNode+".texScale1Y");

	/* expressionでrotateUVの値をradianに変換する */
	expression -s ($cgfxMaterialNode+".texRotate0 = "+$place2dtexture0+".rotateUV * 3.1415926535 / 180.0") -o cgfxShader1 -ae 1 -uc all;
	
	/* テクスチャUV以外は頂点アトリビュートを設定しない */
	eval("setAttr " + $cgfxMaterialNode + ".cs -type stringArray 1 \"colorSet1\" ");
	eval("setAttr " + $cgfxMaterialNode + ".tcs -type stringArray 3 \"map1\" \"\" \"\" ");
	
	/*MS_ デフォルトシェーダにテクスチャノードを接続する */
	connectAttr -f ($filetexture0+".outColor") ($defaultShader+".color");

	select -r $defaultShader;


}


global proc MS_add_BGS_1(){
	string $name[]=`ls -sl`;
	string $cgfxMaterialNode=$name[0];
	setAttr ($cgfxMaterialNode+".tcs") -type stringArray 2 "map1" "map2";
	
	AEcgfxShader_fileChoice 1 shader "D:/cubic_maya/media/cgfx/32_constant_shadow.cgfx" $cgfxMaterialNode;
	
	string $samplerName1    = "ShadowSampler0";
	string $samplerName1    = "ShadowSampler0";
	string $place2dtexture1 = eval( "findPlace2dTexture " + $cgfxMaterialNode + " " + $samplerName1 );
	string $filetexture1    = eval( "findTextureNode " + $cgfxMaterialNode + " " + $samplerName1 );


}


global proc MS_createCGFX_get_file(){
	
	//$full_path=(`workspace -q -rd`+"images/*.iff");
	//$full_path=(`workspace -q -rd`+"sourceimages/*.tga;*.dds;*.tif");
	$full_path=(`workspace -q -rd`+"renderData/mentalray/lightMap/*.tga;*.dds;*.tif");
	string $file_path=`fileDialog -dm $full_path`;
	
	if($file_path==""){
		$file_path=`textFieldGrp -q -text "filePath"`;
	}
	
	
	textFieldGrp -e -text $file_path "filePath";
}




global proc MS_createCGFX()
{
	
	//Window Check
	if(`window -exists MS_createCGFX`){
		deleteUI MS_createCGFX;
	}
	
	
	//Create Window
	
	window -title "MS_createCGFX" MS_createCGFX;
	
	columnLayout ;
	
	//Contents	
	
	
	//text
	text -label "ThisWindowIsMS_createCGFX";
	separator -w 600 -h 40 -st "single";
	
	button -bgc 1.0 0.5 0.5 -l "simpleTexture" -command "MS_replace_BG_1" ;
	button -bgc 0.5 0.5 1.0 -l "simpleShadowTexture" -command "MS_replace_BGS_1" ;
	button -bgc 0.5 0.5 1.0 -l "simpleShadowTexture" -command "MS_add_BGS_1" ;
	
	
	separator -w 600 -h 40 -st "single";
	
	//getFile
	textFieldButtonGrp 
		-l "New Root"
		-tx "C:/Documents and Settings/s002000/デスクトップ/My_mel"
		-buttonLabel "Browse..." 
		-bc "MS_createCGFX_get_file"
		"filePath"
		;
	
	separator -w 600 -h 40 -st "single";

	separator -w 600 -h 40 -st "double";
	
	button -l "undo" -command "Undo" ;
	
	button -l "exit" -command "deleteUI MS_createCGFX" ;
	
	
	//Footer
	showWindow MS_createCGFX;
	
}

MS_createCGFX;

