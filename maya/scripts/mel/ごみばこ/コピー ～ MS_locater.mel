/*
-------------------
MS_locater.mel
-------------------

◆概要
数値入力による絶対・相対・ランダムな移動・回転・スケーリングツール。


◆使用方法
実行するとダイアログが出るので適当にいじるといろいろなことがおきる。


◆詳細
とりあえずRandomとExpandは使えると思う。


※注意



*/

global proc MS_CenterResetter_core(){
	string $objz[]=`ls -sl`;
	for($obj_a in $objz){
		
		string $obj_a_tx=$obj_a+".tx";
		string $obj_a_ty=$obj_a+".ty";
		string $obj_a_tz=$obj_a+".tz";
		
		string $obj_a_rpx=$obj_a+".rotatePivotX";
		string $obj_a_rpy=$obj_a+".rotatePivotY";
		string $obj_a_rpz=$obj_a+".rotatePivotZ";
		
		float $orgx=`getAttr $obj_a_tx`;
		float $orgy=`getAttr $obj_a_ty`;
		float $orgz=`getAttr $obj_a_tz`;
		float $flpx=`getAttr $obj_a_rpx`;
		float $flpy=`getAttr $obj_a_rpy`;
		float $flpz=`getAttr $obj_a_rpz`;
		
		setAttr $obj_a_tx (-$flpx);
		setAttr $obj_a_ty (-$flpy);
		setAttr $obj_a_tz (-$flpz);
		
		makeIdentity -apply true -t 1 -r 1 -s 0 -n 0 $obj_a;
		
		setAttr $obj_a_tx ($orgx+$flpx);
		setAttr $obj_a_ty ($orgy+$flpy);
		setAttr $obj_a_tz ($orgz+$flpz);
		
	}
}

global proc MS_locater_valReset(){
	floatSliderGrp -e -v 1 expx;
	floatSliderGrp -e -v 1 expy;
	floatSliderGrp -e -v 1 expz;
	
	floatSliderGrp -e -v 0 trnx;
	floatSliderGrp -e -v 0 trny;
	floatSliderGrp -e -v 0 trnz;
	
	floatSliderGrp -e -v 0 rotx;
	floatSliderGrp -e -v 0 roty;
	floatSliderGrp -e -v 0 rotz;
	
	floatSliderGrp -e -v 1 sclx;
	floatSliderGrp -e -v 1 scly;
	floatSliderGrp -e -v 1 sclz;
}


global proc MS_expand(int $mode){
	string $objz[];
	
	if(`selectMode -q -co`){
		$objz=`filterExpand -sm 31 -sm 32 -sm 34 -sm 46`;
	}else{
		$objz=`ls -tr -sl`;
	}
	
	float $expx=`floatSliderGrp -q -v expx`;
	float $expy=`floatSliderGrp -q -v expy`;
	float $expz=`floatSliderGrp -q -v expz`;
	
	float $trnx=`floatSliderGrp -q -v trnx`;
	float $trny=`floatSliderGrp -q -v trny`;
	float $trnz=`floatSliderGrp -q -v trnz`;
	
	float $rotx=`floatSliderGrp -q -v rotx`;
	float $roty=`floatSliderGrp -q -v roty`;
	float $rotz=`floatSliderGrp -q -v rotz`;
	
	float $sclx=`floatSliderGrp -q -v sclx`;
	float $scly=`floatSliderGrp -q -v scly`;
	float $sclz=`floatSliderGrp -q -v sclz`;
	
	$rndtx=$trnx;
	$rndty=$trny;
	$rndtz=$trnz;
	
	$rnd_rotx=$rotx;
	$rnd_roty=$roty;
	$rnd_rotz=$rotz;
	
	$rnd_sclx=$sclx;
	$rnd_scly=$scly;
	$rnd_sclz=$sclz;
	
	PolySelectConvert 1;
	//----center check---
	//if(`polyEvaluate -bc`){
	//float $bbox[6] = `polyEvaluate -bc`;
	//}else{
	float $bbox[6] ={0,0,0,0,0,0};
	//}
	
	
	$center[0] = ( ($bbox[0]/2) + ($bbox[1]/2) ) ;
	$center[1] = ( ($bbox[2]/2) + ($bbox[3]/2) ) ;
	$center[2] = ( ($bbox[4]/2) + ($bbox[5]/2) ) ;
	
	
	for($name in $objz){
		if(!`selectMode -q -co`){
			xform -cp $name;
		}
		
		//----center check---
		select $name;
		PolySelectConvert 1;
		float $bbox[6] = `polyEvaluate -bc`;
		
		
		$nameCenter[0] = ( ($bbox[0]/2) + ($bbox[1]/2) ) ;
		$nameCenter[1] = ( ($bbox[2]/2) + ($bbox[3]/2) ) ;
		$nameCenter[2] = ( ($bbox[4]/2) + ($bbox[5]/2) ) ;
		
		
		//---Expand & Random Translate---
		
		if($mode==1){
			$rndtx=rand($trnx,(-$trnx));
			$rndty=rand($trny,(-$trny));
			$rndtz=rand($trnz,(-$trnz));
		}
		
		$valx=((($nameCenter[0]-$center[0])*($expx-1))+$rndtx);
		$valy=((($nameCenter[1]-$center[1])*($expy-1))+$rndty);
		$valz=((($nameCenter[2]-$center[2])*($expz-1))+$rndtz);
		
		move -ws -r $valx $valy $valz $name;


		//--- Random Rotate ---
		if($mode==1){
			$rnd_rotx=rand($rotx,-$rotx);
			$rnd_roty=rand($roty,-$roty);
			$rnd_rotz=rand($rotz,-$rotz);
		}
		rotate -p $nameCenter[0] $nameCenter[1] $nameCenter[2] -r $rnd_rotx $rnd_roty $rnd_rotz $name;
		
		//--- Random Scale ---
		if($mode==1){
			$rnd_sclx=rand(1,$sclx);
			$rnd_scly=rand(1,$scly);
			$rnd_sclz=rand(1,$sclz);
		}
		scale -r $rnd_sclx $rnd_scly $rnd_sclz $name;
	}
	
	select $objz;
	
}


global proc MS_locater()
{
	if(`window -exists MS_locater`){
		deleteUI MS_locater;
	}
	
	window -title "MS_locater" MS_locater;	
	
	$form = `formLayout`;

	setParent $form;
	$sep=`separator`;


	$com_expx=`floatSliderGrp -l "expx" -field true -min 0 -max 10000 -v 1 expx`;
	$com_expy=`floatSliderGrp -l "expy" -field true -min 0 -max 10000 -v 1 expy`;
	$com_expz=`floatSliderGrp -l "expz" -field true -min 0 -max 10000 -v 1 expz`;

	$com_trnx=`floatSliderGrp -l "trnx" -field true -min 0 -max 10000 -v 0 trnx`;
	$com_trny=`floatSliderGrp -l "trny" -field true -min 0 -max 10000 -v 0 trny`;
	$com_trnz=`floatSliderGrp -l "trnz" -field true -min 0 -max 10000 -v 0 trnz`;

	$com_rotx=`floatSliderGrp -l "rotx" -field true -min 0 -max 360 -v 0 rotx`;
	$com_roty=`floatSliderGrp -l "roty" -field true -min 0 -max 360 -v 0 roty`;
	$com_rotz=`floatSliderGrp -l "rotz" -field true -min 0 -max 360 -v 0 rotz`;

	$com_sclx=`floatSliderGrp -l "sclx" -field true -min .01 -max 10 -v 1 sclx`;
	$com_scly=`floatSliderGrp -l "scly" -field true -min .01 -max 10 -v 1 scly`;
	$com_sclz=`floatSliderGrp -l "sclz" -field true -min .01 -max 10 -v 1 sclz`;


	$com_exp=`button -bgc 1.0 0.5 0.5-l "locate" -command "MS_expand 0" `;
	$com_rnd=`button -bgc 0.5 0.5 1.0 -l "random" -command "MS_expand 1" `;
	$com_ctr=`button -bgc 0.5 1.0 0.5 -l "centerResetter" -command "MS_CenterResetter" `;
	
	$com_res=`button -bgc 0.5 0.75 0.5 -l "Reset" -command "MS_locater_valReset"`;
	$com_und=`button -l "undo" -command "Undo" `;
	$com_ext=`button -l "exit" -command "deleteUI MS_locater" `;


	formLayout -e
//----------------------------------
	-af $com_trnx "top" 10
        -af $com_trnx "left" 5
        -an $com_trnx "right"
        -an $com_trnx "bottom"

	-af $com_trny "top" 30
        -af $com_trny "left" 5
        -an $com_trny "right"
        -an $com_trny "bottom"

	-af $com_trnz "top" 50
        -af $com_trnz "left" 5
        -af $com_trnz "right" 5
        -an $com_trnz "bottom"

	-af $sep "top" 80
	-af $sep "left" 5
	-af $sep "right" 5
	-an $sep "bottom"
//------------------------------------
	-af $com_rotx "top" 110
        -af $com_rotx "left" 5
        -an $com_rotx "right"
        -an $com_rotx "bottom"

	-af $com_roty "top" 130
        -af $com_roty "left" 5
        -an $com_roty "right"
        -an $com_roty "bottom"

	-af $com_rotz "top" 150
        -af $com_rotz "left" 5
        -af $com_rotz "right" 5
        -an $com_rotz "bottom"

	-af $sep "top" 180
	-af $sep "left" 5
	-af $sep "right" 5
	-an $sep "bottom"
//------------------------------------

	-af $com_sclx "top" 210
        -af $com_sclx "left" 5
        -an $com_sclx "right"
        -an $com_sclx "bottom"

	-af $com_scly "top" 230
        -af $com_scly "left" 5
        -an $com_scly "right"
        -an $com_scly "bottom"

	-af $com_sclz "top" 250
        -af $com_sclz "left" 5
        -af $com_sclz "right" 5
        -an $com_sclz "bottom"

	-af $sep "top" 280
	-af $sep "left" 5
	-af $sep "right" 5
	-an $sep "bottom"
//------------------------------------

	-af $com_expx "top" 310
        -af $com_expx "left" 5
        -an $com_expx "right"
        -an $com_expx "bottom"

	-af $com_expy "top" 330
        -af $com_expy "left" 5
        -an $com_expy "right"
        -an $com_expy "bottom"

	-af $com_expz "top" 350
        -af $com_expz "left" 5
        -af $com_expz "right" 5
        -an $com_expz "bottom"

	-af $sep "top" 380
	-af $sep "left" 5
	-af $sep "right" 5
	-an $sep "bottom"
//------------------------------------

	-af $com_exp "top" 400
        -af $com_exp "left" 5
        -ap $com_exp "right" 0 25
        -an $com_exp "bottom"

        -af $com_rnd "top" 400
        -ap $com_rnd "left" 0 25
        -ap $com_rnd "right" 0 50
        -an $com_rnd "bottom"
        
       -af $com_ctr "top" 400
        -ap $com_ctr "left" 0 50
        -ap $com_ctr "right" 0 75
        -an $com_ctr "bottom"



	-af $sep "top" 440
	-af $sep "left" 5
	-af $sep "right" 5
	-an $sep "bottom"

//---------------------------------------

		-af $com_res "top" 450
        -af $com_res "left" 10
        -ap $com_res "right" 0 25
        -an $com_res "bottom"

        -af $com_und "top" 450
        -ap $com_und "left" 0 50
        -ap $com_und "right" 0 75
        -an $com_und "bottom"

        -af $com_ext "top" 450
        -ap $com_ext "left" 0 75
        -af $com_ext "right" 5
        -an $com_ext "bottom"
	$form;
	
	showWindow MS_locater;
	

}


MS_locater;

