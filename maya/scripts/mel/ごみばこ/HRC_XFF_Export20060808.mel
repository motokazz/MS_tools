/*
HRC_XFF_Export.mel
v1.1
◆概要
選択したトップLOCATERの名前をつけて、その子供を全てXFFファイル出力

◆使用方法

１・準備
出力先の基本となるディレクトリ、
D:/DATA/xff/
を作成するとよい。

２・オプション設定
---チェックボックス---
ExportModel
ExportAnim
ExportMatanim
IgnoreBindpose
IgnoreRefferencenode
※上記チェックボックスは、onで各項目有効

AnimNameIsMotion
※このチェックボックスがONになっていると、出力されるアニメーション名が「motion」になる。（BG用）
　OFFのときは、親locaterの名前＋「additionalAnimationName」が有効になる。

---名前入力---
additionalModelName
additionalAnimationName
ここに入力した名前が、親locaterの名前にプラスされて出力される。

---出力パス設定---
filePath
ここに入力したPATHに出力される。「Brouse」ボタンでブラウザによるディレクトリ選択が可能。

---各種ボタン---
Camera
カメラ出力が出来る。出力ファイル名は「additionalAnimationName」＋”.camera.pcxff”になる。

Export
オブジェクトのエキスポートが出来る。
出力ファイル名は、親locater名＋「additionalAnimationName」＋”.pcxff”になる。
出力アニメーション名は、親locater名＋「additionalAnimationName」になる。（AnimNameIsMotionにチェック無しの場合）

Exit
ウインドウを閉じる。

３・実行
出力したいオブジェクトを選択して、ボタンを押す。


◆詳細
選択したグループの名前でラベルを作成して、グループごとにファイルを出力します。
ファイル名もグループの名前で出力されます。

出力前に、テクスチャーファイルを全て.ddsファイルに張り替えます。（fileノードの拡張子記述を強制的に.ddsに書き換えています。）

基本出力先は、このスクリプトを直接いじっていただければ変更できます・・・

◆注意
同名のオブジェクトがシーンの中に、複数存在するとき、正常にエキスポートできないときがあります。

*/

global proc HRC_XFF_Camera_Export(){
	string $path=`textField -q -fileName "filePath"`;
	string $ModelName=`textField -q -tx "ModelName"`;//Data//
	$full_path=($path+$ModelName+".camera.pcxff");
	XFFexport -f $full_path -ce;
//cameraAnimExport $full_path "Best Guess";
}

global proc HRC_XFF_Export_core(){
	$path=`textField -q -fileName "filePath"`;
	//$path="D:/DATA/xff/";//出力パス
	
	string $AnimationName=`textField -q -tx "AnimationName"` ;//Data//
	string $ModelName=`textField -q -tx "ModelName"`;//Data//
	string $newAnimName;
	
	//if(`radioButtonGrp -q -sl smp_radio`){
	int $chkAnim=`checkBox -q -v "AnimNameIsMotion"` ;//Data//
	
	int $ir=`checkBox -q -v "IgnoreReferencenode"` ;//Data//
	int $ip=`checkBox -q -v "IgnoreBindpose"` ;//Data//
	int $ex=`checkBox -q -v "ExportMatAnim"` ;//Data//
	int $ea=`checkBox -q -v "ExportAnim" `;//Data//
	int $em=`checkBox -q -v "ExportModel"` ;//Data//
	int $le=`checkBox -q -v "ExportLight"` ;//Data//
	int $pi=`checkBox -q -v "PlacementInfo"` ;//Data//
	
	
	if($em){$em=0;}else{$em=1;}
	if($ea){$ea=0;}else{$ea=1;}
	if($ex){$ex=0;}else{$ex=1;}
	if($pi){$pi=0;}else{$pi=1;}
	
	string $obj_name[]=`ls -as -sl`;
	
	$i=0;
	for($i=0;$i<size($obj_name);$i++){
		select -r $obj_name[$i];
		
		
		if(!$chkAnim){
			$newAnimName=($obj_name[$i]+$AnimationName);
		}else{
			$newAnimName="motion";
		}
		
		
		$full_p_name=($path+$obj_name[$i]+$ModelName);
		$operation=(
			"em="+$em+
			";ea="+$ea+
			";ex="+$ex+
			";ip="+$ip+
			";le="+$le+
			";pi="+$pi+
			";name="+$newAnimName+
			";obj="+$obj_name[$i]+";"
		);
		
		
		print $operation;
		print $full_p_name;
		print "\n";
		
		
		file -op $operation -typ "XFFExport" -pr -es $full_p_name;
	}
}

global proc MS_HRC_XFF_Export_TexExtRep_All(int $val_radio)
{

	string $ext_name[]={"dummy",".dds",".tga",".tif",".jpg"};
	//int $val_radio=`radioButtonGrp -q -sl smp_radio`;

	string $rec_obj[]=`ls -sl`;

	select -all;

	string $obj_name[]=`ls -sl -typ file`;

	$i=0;
	
	for($i=0;$i<size($obj_name);$i++){
	
	string $name=`getAttr ($obj_name[$i]+".fileTextureName")`;


	//ピリオドで分割
	string $buffer[];
	tokenize $name "." $buffer;

	
		setAttr -type "string" ($obj_name[$i]+".fileTextureName") ($buffer[0]+$ext_name[$val_radio]);
	
	}
	
	select -r $rec_obj;
}





global proc MS_HRC_XFF_Export(){

	MS_HRC_XFF_Export_TexExtRep_All 1;
	HRC_XFF_Export_core;
//	MS_HRC_XFF_Export_TexExtRep_All 2;

}


global proc HRC_XFF_Export_get_dir(string $exp_dir,string $dummy){

	textField -e -fileName ($exp_dir+"/") "filePath";

}


