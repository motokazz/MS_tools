
string $num;
$i=1;
for($i=1;$i<38;$i++){

if($i<10){
$num="0"+$i;
}else{
$num=$i;
}

string $filez="D:/DATA/for_plan_shot/scenes/Pose_scenes/scene"+$num+".mb";
string $imagez="D:/DATA/for_plan_shot/images/cut_b/c"+$num+"_b";

file -f -options "v=0"  -typ "mayaBinary" -o "D:/DATA/for_plan_shot/scenes/stg_set_c.mb";addRecentFile("D:/DATA/for_plan_shot/scenes/stg_set_c.mb", "mayaBinary");
file -i $filez;
render persp1;
renderWindowSaveImageCallback "renderView" $imagez "image";

file -f -new;



}

