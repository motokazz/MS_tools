global proc MS_megabool_core(int $bl_flag){
	
	string $obj[]=`ls -sl`;
	string $bool_source;
	string $bool_destination;
	string $temp[];
	//polyBoolOp -n "MS_Bool_dist" -op $bl_flag -ch 0 $obj[0] $obj[1];
	

	for($each in $obj){
		if ($each == $obj[0]){
			if(`checkBox -q -v "keepSource"`){
				$temp=`duplicate $each`;
				$bool_source=$temp[0];
			}else{
				$bool_source=$each;
			}
			continue;
		}
		
		if(`checkBox -q -v "keepDestination"`){
			$temp=`duplicate $each`;
			$bool_destination=$temp[0];
		}else{
			$bool_destination=$each;
		}
		
		$resultname=`polyBoolOp -op $bl_flag -ch 0 $bool_source $bool_destination`;
		$bool_source=$resultname[0];
	}
	
	rename $bool_source "MS_megabooled";
}


global proc MS_bools_core(){
	
	string $objz[]=`ls -type transform -sl`;
	
	duplicate -n "bla" $objz[0];
	duplicate -n "blb" $objz[1];
	polyBoolOp -n "pc_a" -op 2 -ch 0 bla blb;
	
	duplicate -n "bla" $objz[0];
	duplicate -n "blb" $objz[1];
	polyBoolOp -n "pc_b" -op 3 -ch 0 bla blb;

	delete $objz[0];
	
}

