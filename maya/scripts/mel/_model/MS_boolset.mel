global proc MS_boolset()
{
if(`window -q -ex MyTools_MS_boolset`)deleteUI MyTools_MS_boolset;
window MyTools_MS_boolset;
formLayout myUIFormLayout;
//--DataPart--//
button -width 44 -label "exit" -recomputeSize 0 "exit" ;//Data//
button -recomputeSize 0 -label "undo" -width 44 -command "undo" "undo" ;//Data//
checkBox -label "keep destination" -width 120 "keepDestination" ;//Data//
checkBox -label "keep source" -width 120 "keepSource" ;//Data//
button -label "intercect" -width 60 -command "MS_megabool_core(3)" "intersect" ;//Data//
button -recomputeSize 0 -label "difference" -width 60 -command "MS_megabool_core(2)" "difference" ;//Data//
button -command "MS_megabool_core(1)" -label "union" -recomputeSize 0 -width 60 "union" ;//Data//
formLayout -e
	-af "exit" "left" 192//Data//
	-af "exit" "top" 128//Data//
	-af "undo" "left" 128//Data//
	-af "undo" "top" 128//Data//
	-af "keepDestination" "left" 16//Data//
	-af "keepDestination" "top" 32//Data//
	-af "keepSource" "left" 16//Data//
	-af "keepSource" "top" 16//Data//
	-af "intersect" "left" 176//Data//
	-af "intersect" "top" 80//Data//
	-af "difference" "left" 96//Data//
	-af "difference" "top" 80//Data//
	-af "union" "left" 16//Data//
	-af "union" "top" 80//Data//
//--DataPart--//
myUIFormLayout;
showWindow MyTools_MS_boolset;
}

