global proc MS_deleteLastUV()
{
	
	polyUVSet -luv;
	polyUVSet -d;

}


global proc MS_BakeShadowSetting_all()
{
	
	//Window Check
	if(`window -exists MS_BakeShadowSetting_all`){
		deleteUI MS_BakeShadowSetting_all;
	}
	
	
	//Create Window
	
	window -title "MS_BakeShadowSetting_all" MS_BakeShadowSetting_all;
	
	columnLayout ;
	
	//Contents
	
	
	//text
	text -label "ThisWindowIsMS_BakeShadowSetting_all";
	separator -w 600 -h 40 -st "single";
	
	
	//---------------
	//Execute Buttons
	//---------------
	separator -w 600 -h 40 -st "doubleDash";
		
	button -l "CreateShadowUVs" -command "MS_createshadowUV_core" ;
	
	button -l "BakeShadowSettings" -command "MS_BakeShadowSetting_all_Core" ;
	
	button -l "VetexColorSettings" -command "MS_VetexColorSetting_all_Core" ;
	
	separator -w 600 -h 40 -st "doubleDash";
	
	button -l "MS_deleteLastUV" -command "MS_deleteLastUV" ;
	
	separator -w 600 -h 40 -st "doubleDash";
	
	button -l "mrBakeToVertices" -command "mrBakeToVertices 1;" ;
	
	separator -w 600 -h 40 -st "double";
	
	button -l "undo" -command "Undo" ;
	
	button -l "exit" -command "deleteUI MS_BakeShadowSetting_all" ;
	
	
	//Footer
	showWindow MS_BakeShadowSetting_all;
	
}

MS_BakeShadowSetting_all;




