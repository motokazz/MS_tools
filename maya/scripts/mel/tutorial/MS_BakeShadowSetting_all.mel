global proc MS_createshadowUV_core()
{
	string $obj_name[] = `ls -sl`;
	
	int $i=0;

	for($i=0;$i<size($obj_name);$i++){
		select -r $obj_name[$i];
		int $j=0;
		int $check=0;
		
		int $indices[] = `polyUVSet -q -allUVSetsIndices $obj_name[$i]`;
		
		for( $j in $indices )
		{
			
			string $uvname = `getAttr ($obj_name[$i]+".uvSet["+$j+"].uvSetName")`;
			
			print( "Found uv set called " + $uvname + "\n" );
			
			if($uvname=="map2")
			{
				$check++;
			}
		
		}
		
		if($check == 0){
		
			polyUVSet -create -uvSet "map2" $obj_name[$i];
			
		}
		
		polyUVSet -currentUVSet -uvSet "map2";
		polyAutoProjection -pb 0 -ibd 1 -cm 0 -l 2 -sc 2 -o 1 -p 6 -ps 0.01 -ws 1 $obj_name[$i];
		
		selectMode -co;
		//setSelectMode components Components;
		selectType -smp 0 -sme 0 -smf 1 -smu 0 -pv 0 -pe 0 -pf 1 -puv 0;
		//select -cl;
	
		polySelectConstraint -va 100 ;
		polySelectConstraint -v true ;
		polySelectConstraint -m 3 ;
		polySelectConstraint -pp 0;

		invertSelection;
		DeleteUVs;

		resetPolySelectConstraint; 

		select -r $obj_name[$i];
		polyLayoutUV -l 2 -sc 2 -se 0 -rbf 1 -fr 1 -ps 0.001 -ch 0;
	}

select -cl  ;
changeSelectMode -object;
select -r $obj_name;

}



global proc MS_BakeShadowSetting_all_Core(){
	
	string $mat_name[];
	
	string $aniso_list[]=`lsType anisotropic`;
	string $blinn_list[]=`lsType blinn`;
	string $lambt_list[]=`lsType lambert`;
	string $phong_list[]=`lsType phong`;
	string $phonE_list[]=`lsType phongE`;
	
	appendStringArray($mat_name,$aniso_list,(size($aniso_list)-1));
	appendStringArray($mat_name,$blinn_list,(size($blinn_list)-1));
	appendStringArray($mat_name,$lambt_list,(size($lambt_list)-1));
	appendStringArray($mat_name,$phong_list,(size($phong_list)-1));
	appendStringArray($mat_name,$phonE_list,(size($phonE_list)-1));
	
	
//マテリアル設定
	
	string $mat_checker=($mat_name[0]+".incandescenceR");
	
	$i=0;
	
	for ($i=0;$i<size($mat_name);$i++){
			//transparancy normalize
		
		if (`connectionInfo -id ($mat_name[$i]+".transparency")`==0){
			setAttr ($mat_name[$i]+".transparency") -type double3 0 0 0;
		}
		
		string $mat_setting=($mat_name[$i]+".incandescence");
		
		
		if(`getAttr $mat_checker`!=0){
			setAttr $mat_setting -type double3 0 0 0 ;
		}else{
			setAttr $mat_setting -type double3 1 1 1 ;
		}
	
	}
	
//ライト設定
	
	select -r `listTransforms -lights`;
	string $lgt_name[]=`ls -sl`;
	
	$j=0;
	for($j=0;$j<size($lgt_name);$j++){
		
		string $lgt_setting=($lgt_name[$i]+".shadowColor");
		
		if(`getAttr $mat_checker`!=0){
		setAttr $lgt_setting -type double3 0 0 0 ;
		}else{
		setAttr $lgt_setting -type double3 -100 -100 -100 ;
		}
	}
	
	
	
	
	if(`getAttr $mat_checker`!=0){
	print"chenge to normal settings\n";

//テクスチャーを全部DDSファイルに
	//
	
	select -all;
	
	string $obj_name[]=`ls -sl -typ file`;
	
	$i=0;
	
	for($i=0;$i<size($obj_name);$i++){
		
		string $name=`getAttr ($obj_name[$i]+".fileTextureName")`;
		
		//ピリオドで分割
		string $buffer[];
		tokenize $name "." $buffer;
		
		setAttr -type "string" ($obj_name[$i]+".fileTextureName") ($buffer[0]+".dds");
	
	}
//レンダリング設定
	
	//一時保存
	nodePreset -load mentalrayGlobals temp;
	nodePreset -load miDefaultFramebuffer temp;
	nodePreset -load miDefaultOptions temp;
	

	}else{
	print"chenge to shadow texture settings\n";
	
	//
//テクスチャーを全部TGAファイルに
	//
	
	select -all;
	
	string $obj_name[]=`ls -sl -typ file`;
	
	$i=0;
	
	for($i=0;$i<size($obj_name);$i++){
		
		string $name=`getAttr ($obj_name[$i]+".fileTextureName")`;
		
		//ピリオドで分割
		string $buffer[];
		tokenize $name "." $buffer;
		
		setAttr -type "string" ($obj_name[$i]+".fileTextureName") ($buffer[0]+".tga");
	
	}
	
//レンダリング設定
	
	//一時保存
	nodePreset -save mentalrayGlobals temp;
	nodePreset -save miDefaultFramebuffer temp;
	nodePreset -save miDefaultOptions temp;
	
	//シャドウベイク用設定読み込み
	nodePreset -load mentalrayGlobals "shadowBake";
	nodePreset -load miDefaultFramebuffer "shadowBake";
	nodePreset -load miDefaultOptions "shadowBake";
	
	
	}



}


