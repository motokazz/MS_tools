
global proc MS_WindowSample_core()
{
	$smp_isg=`intSliderGrp -q -v smp_isg`;
	print ($smp_isg+"\n");
	
	$smp_fsg=`floatSliderGrp -q -v smp_fsg`;	
	print ($smp_fsg+"\n");
	
	int $smp_radio=`radioButtonGrp -q -sl smp_radio`;
	string $arr_radio[]={"dummy","radioX","radioY","radioZ"};
	print ($arr_radio[$smp_radio]+"\n");
	
	string $smp_tfbg=`textFieldButtonGrp -q -text smp_tfbg`;
	print ($smp_tfbg+"\n");
	
}

global proc MS_get_file(){
	string $get_file_path=`textFieldButtonGrp -q -text smp_tfbg`;
	string $file_path=`fileDialog -dm ($get_file_path+"\\*.*")`;
	//string $file_path=`workspace -q -rd`;
	textFieldButtonGrp -e -text $file_path smp_tfbg;
}

global proc MS_takeObj(){
	//オブジェクトをtextFieldGrpに取得
	string $obj[]=`ls -l -sl`;
	$list=stringArrayToString($obj,"<>");
	textFieldGrp -e -tx $list objName;
}

global proc MS_WindowSample()
{
	
	//Window Check
	if(`window -exists MS_WindowSample`){
		deleteUI MS_WindowSample;
	}
	
	
	//Create Window
	
	window -title "MS_WindowSample" MS_WindowSample;

	scrollLayout scrollLayout;
//		columnLayout -adjustableColumn true;
	columnLayout;
	frameLayout 
		-l test
		-borderVisible true 
		-labelVisible true 
		-labelAlign "center"
		-cll 1
		-w 200
		-h 100;


		columnLayout ;
	
	//Contents
			//text
			text -label "ThisWindowIsWindowFormatSample";
			//separator -w 600 -h 40 -st "single";
	
		setParent ..;
	setParent ..;
	
	
	
	//intSilder
	intSliderGrp -l "intSlider" -field true -min 1 -max 100 -v 1 smp_isg;
	separator -w 600 -h 40 -st "single";
	
	
	//floatSilder
	floatSliderGrp -l "floatSlider" -field true -min 1 -max 100 -v 1 smp_fsg;
	separator -w 600 -h 40 -st "single";
	
	
	//radio
	
	radioButtonGrp
            		-numberOfRadioButtons 3
            		-label "radio"
            		-labelArray3 "radioX" "radioY" "radioZ"
			-sl 1 smp_radio;
	
	separator -w 600 -h 40 -st "single";
	
	
	//getFile
	//ファイルパスをtextFieldButtonGrpに取得
	textFieldButtonGrp 
		-l "New Root"
		-tx "C:/Documents and Settings/s002000/デスクトップ/My_mel"
		-buttonLabel "Browse..." 
		-bc "MS_get_file"
		smp_tfbg
		;
	
	//getObj
	//選択オブジェクトをtextFieldGrpに取得
	//オブジェクトは"<>"で区切られた状態で表示される
	textFieldGrp -en 1 -w 200  "objName";
	button -bgc 0.8 0.8 1.0 -w 100 -l "take Source" -c "MS_takeObj";
	
	
	
	separator -w 600 -h 40 -st "single";
	
	//setParent ..;
	//setParent ..;

	separator -w 600 -h 40 -st "double";
	separator -w 600 -h 40 -st "doubleDash";
	
	frameLayout 
		-l Buttons
		-borderVisible true 
		-labelVisible true 
		-labelAlign "center"
		-cll 1
		-w 200
		-h 100;
		rowLayout -numberOfColumns 3 -cw3 32 32 32 ;
	//---------------
	//Execute Buttons
	//---------------
			button -w 32 -bgc 1.0 0.5 0.5 -l "do" -command "MS_WindowSample_core" ;
			button -w 32 -l "undo" -command "Undo" ;
			button -w 32 -l "exit" -command "deleteUI MS_WindowSample" ;
			setParent ..;
		setParent ..;
	
	//Footer
	showWindow MS_WindowSample;
	
}

MS_WindowSample;

