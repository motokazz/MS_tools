//マテリアルセットアップ
global proc MP_MS_matterSetup_Get(){
	//シェイプノードからの処理
	string $preobj[]=`ls -tr -typ mesh -sl`;
	string $lambertShapeFrom[];
	for ($each in $preobj){
		string $shape[]=`listRelatives -ad -typ shape $each`;
		string $shadingEngine[]=`listConnections -t shadingEngine $shape[0]`;
		$lambertShapeFrom=`listConnections -t lambert $shadingEngine[0]`;
	}
	//選択ランバート処理
	string $selectedLambert[]=`ls -typ lambert -sl`;
	if ($selectedLambert[0]!=""){
		$lambertShapeFrom[0]=$selectedLambert[0];
	}
	
	if (`attributeExists  "skin" $lambertShapeFrom[0]`){
		checkBox 
			-e
			-v `getAttr ($lambertShapeFrom[0]+".skin")`
			"skin";
	}
	if (`attributeExists  "anisoFilter" $lambertShapeFrom[0]`){
			optionMenu 
				-e
				-sl (`getAttr ($lambertShapeFrom[0]+".anisoFilter")`+1)
				"anisoFilter";
	}
	if (`attributeExists  "mipmapFilter" $lambertShapeFrom[0]`){
			optionMenu 
				-e
				-sl (`getAttr ($lambertShapeFrom[0]+".mipmapFilter")`+1)
				"mipmapFilter";
	}
	if (`attributeExists  "shaderFromName" $lambertShapeFrom[0]`){
			optionMenu 
				-e
				-sl (`getAttr ($lambertShapeFrom[0]+".shaderFromName")`+1)
				"shaderFromName";
	}
	if (`attributeExists  "blend" $lambertShapeFrom[0]`){
			optionMenu 
				-e
				-sl (`getAttr ($lambertShapeFrom[0]+".blend")`+1)
				"blend";
	}
	if (`attributeExists  "fogOff" $lambertShapeFrom[0]`){
			checkBox 
				-e
				-v `getAttr ($lambertShapeFrom[0]+".fogOff")`
				"fogOff";
	}
	if (`attributeExists  "backfaceCurring" $lambertShapeFrom[0]`){
			optionMenu 
				-e
				-sl (`getAttr ($lambertShapeFrom[0]+".backfaceCurring")`+1)
				"backfaceCurring";
	}
	if (`attributeExists  "zOffset" $lambertShapeFrom[0]`){
			intField
				-e
				-v `getAttr ($lambertShapeFrom[0]+".zOffset")`
				"zOffset";
	}
	if (`attributeExists  "zFunction" $lambertShapeFrom[0]`){
			optionMenu 
				-e
				-sl (`getAttr ($lambertShapeFrom[0]+".zFunction")`+1)
				"zFunction";
	}
	if (`attributeExists  "zWrite" $lambertShapeFrom[0]`){
			checkBox 
				-e
				-v `getAttr ($lambertShapeFrom[0]+".zWrite")`
				"zWrite";
	}
	if (`attributeExists  "aFunction" $lambertShapeFrom[0]`){
			optionMenu 
				-e
				-sl (`getAttr ($lambertShapeFrom[0]+".aFunction")`+1)
				"aFunction";
	}
	if (`attributeExists  "aReffernce" $lambertShapeFrom[0]`){
			intField
				-e
				-v `getAttr ($lambertShapeFrom[0]+".aReffernce")`
				"aReffernce";
	}
	if (`attributeExists  "renderStage" $lambertShapeFrom[0]`){
			optionMenu
				-e
				-sl (`getAttr ($lambertShapeFrom[0]+".renderStage")`+1)
				"renderStage";
	}
	if (`attributeExists  "priority" $lambertShapeFrom[0]`){
			floatField
				-e
				-v `getAttr ($lambertShapeFrom[0]+".priority")`
				"priority";
	}
	if (`attributeExists  "SetMultPass" $lambertShapeFrom[0]`){
			optionMenu
				-e
				-sl (`getAttr ($lambertShapeFrom[0]+".SetMultPass")`+1)
				"SetMultPass";
	}
	
	MP_MS_matterSetupUI_storeRecallUI store;
}

global proc MP_MS_matterSetup_preset(string $mode){
	if(($mode=="Filter" || $mode=="all")){
		int $anisoFilter=(`optionMenu -q -sl "anisoFilter"`-1);
		MP_MS_matterSetup_set anisoFilter $anisoFilter;
		int $mipmapFilter=(`optionMenu -q -sl "mipmapFilter"`-1);
		MP_MS_matterSetup_set mipmapFilter $mipmapFilter;
	}
	 if(($mode=="shaderFromName" || $mode=="all")){
		 int $shaderFromName=(`optionMenu -q -sl "shaderFromName"`-1);
		 MP_MS_matterSetup_set shaderFromName $shaderFromName;
	}
	
	 if(($mode=="blend" || $mode=="all")){
		 int $blend=(`optionMenu -q -sl "blend"`-1);
		 MP_MS_matterSetup_set blend $blend;
	}
	 if(($mode=="fogOff" || $mode=="all")){
		 int $fogOff=`checkBox -q -v "fogOff"`;
		 MP_MS_matterSetup_set fogOff $fogOff;
	}
	 if(($mode=="backfaceCurring" || $mode=="all")){
		 int $backfaceCurring=(`optionMenu -q -sl "backfaceCurring"`-1);
		 MP_MS_matterSetup_set backfaceCurring $backfaceCurring;
	}
	 if(($mode=="zOffset" || $mode=="all")){
		 int $zOffset=`intField -q -v "zOffset"`;
		 MP_MS_matterSetup_set zOffset $zOffset;
	}
	 if(($mode=="zFunction" || $mode=="all")){
		 int $zFunction=(`optionMenu -q -sl "zFunction"`-1);
		 MP_MS_matterSetup_set zFunction $zFunction;
	}
	 if(($mode=="zWrite" || $mode=="all")){
		 int $zWrite=`checkBox -q -v "zWrite"`;
		 MP_MS_matterSetup_set zWrite $zWrite;
	}
	 if(($mode=="aFunction" || $mode=="all")){
		 int $aFunction=(`optionMenu -q -sl "aFunction"`-1);
		 MP_MS_matterSetup_set aFunction $aFunction;
	}
	 if(($mode=="aReffernce" || $mode=="all")){
		 int $aReffernce=`intField -q -v "aReffernce"`;
		 MP_MS_matterSetup_set aReffernce $aReffernce;
	}
	 if(($mode=="renderStage" || $mode=="all")){
		 int $renderStage=(`optionMenu -q -sl "renderStage"`-1);
		 MP_MS_matterSetup_set renderStage $renderStage;
	}
	 if(($mode=="priority" || $mode=="all")){
		 float $priority=`floatField -q -v "priority"`;
		 MP_MS_matterSetup_set priority $priority;
	}
	 if(($mode=="SetMultPass" || $mode=="all")){
		 int $MultPass=(`optionMenu -q -sl "SetMultPass"`-1);
		 MP_MS_matterSetup_set SetMultPass $MultPass;
	}
}

global proc MP_MS_matterSetup_set(string $toroAttr,float $value){
	//マテリアルノードセットアップ
	//シェイプノードからの処理
	string $preobj[]=`ls -tr -typ mesh -sl`;
	string $lambertShapeFrom[];
	for ($each in $preobj){
		string $shape[]=`listRelatives -ad -typ shape $each`;
		string $shadingEngine[]=`listConnections -t shadingEngine $shape[0]`;
		$lambertShapeFrom=`listConnections -t lambert $shadingEngine[0]`;
	}
	//選択ランバート処理
	string $selectedLambert[]=`ls -typ lambert -sl`;
	print $selectedLambert;
	//対象オブジェクト特定
	string $newArray[]=`stringArrayCatenate $lambertShapeFrom $selectedLambert`;
	string $obj[]=`stringArrayRemoveDuplicates $newArray`;
	
	//フィルタ設定
	if (($toroAttr=="anisoFilter" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			if(`attributeExists "anisoFilter"  $each`){
				deleteAttr -at "anisoFilter" $each;
			}
			addAttr -k false -at "enum" -en "NEAREST:LINEAR:NEAREST_NEAREST:LINEAR_NEAREST:NEAREST_LINEAR:LINEAR_LINEAR:" -hidden false -ln "anisoFilter" $each;
			setAttr -channelBox true ($each+".anisoFilter") $value;
		}
	}
	if (($toroAttr=="mipmapFilter" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			if(`attributeExists "mipmapFilter"  $each`){
				deleteAttr -at "mipmapFilter" $each;
			}
			addAttr -k false -at "enum" -en "NEAREST:LINEAR:NEAREST_NEAREST:LINEAR_NEAREST:NEAREST_LINEAR:LINEAR_LINEAR:" -hidden false -ln "mipmapFilter" $each;
			setAttr -channelBox true ($each+".mipmapFilter") $value;
		}
	}
	//シェーダ設定
	if (($toroAttr=="shaderFromName" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			if(`attributeExists "shaderFromName"  $each`){
				deleteAttr -at "shaderFromName" $each;
			}
			addAttr -k false -at "enum" -en "bloom_f:blur:BuildLUTPass:castshadow_v:castshadowsk_v:ColorTweakPass:Decal:DecalSkin:DecodeNormalPass:DefaultVS:DefaultVSA:dof_f:dofy_f:gauss_f:gaussy_f:LightPass:LinearSkyBox:shadowgauss_f:shadowgaussy_f:shadowlight_v:shadowlights_v:shadowlightsk_v:Shiba:sRGBSkyBox:ssaogauss_f:ssaogaussy_f:SsaoPass:tonemap_f:ZtoDepthPass:" -hidden false -ln "shaderFromName" $each;
			setAttr -channelBox true ($each+".shaderFromName") $value;
		}
	}
	
	
	//ブレンド設定
	if (($toroAttr=="blend" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			if(`attributeExists "blend"  $each`){
				deleteAttr -at "blend" $each;
			}
			addAttr -k false -at "enum" -en "none:add:mul:sub:"-hidden false -ln "blend" $each;
			setAttr -channelBox true ($each+".blend") $value;
		}
	}
	//Fogオフ設定
	if (($toroAttr=="fogOff" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			if(`attributeExists "fogOff"  $each`){
				deleteAttr -at "fogOff" $each;
			}
			addAttr -k false-at bool -hidden false -ln "fogOff" $each;
			setAttr -channelBox true ($each+".fogOff") $value;
		}
	}
	
	//カリング設定
	if (($toroAttr=="backfaceCurring" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			if(`attributeExists "backfaceCurring"  $each`){
				deleteAttr -at "backfaceCurring" $each;
			}
			addAttr -k false -at "enum" -en "none:back:front" -hidden false -ln "backfaceCurring" $each;
			setAttr -channelBox true ($each+".backfaceCurring") $value;
		}
	}
	
	//Z-オフセット設定
	if (($toroAttr=="zOffset" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			if(`attributeExists "zOffset"  $each`){
				deleteAttr -at "zOffset" $each;
			}
			addAttr -k false-at short -hidden false -min 0 -max 255 -ln "zOffset" $each;
			setAttr -channelBox true ($each+".zOffset") $value;
		}
	}
	
	//zFunction設定
	if (($toroAttr=="zFunction" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			if(`attributeExists "zFunction"  $each`){
				deleteAttr -at "zFunction" $each;
			}
			addAttr -k false -at "enum" -en "none:ALWAYS:GREATER:GEQUAL:EQUAL:LEQUAL:LESS:NEVER:" -hidden false -ln "zFunction" $each;
			setAttr -channelBox true ($each+".zFunction") $value;
		}
	}
	
	//Z-書き込み設定
	if (($toroAttr=="zWrite" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			if(`attributeExists "zWrite"  $each`){
				deleteAttr -at "zWrite" $each;
			}
			addAttr -k false-at bool -hidden false -ln "zWrite" $each;
			setAttr -channelBox true ($each+".zWrite") $value;
		}
	}
	
	//aFunction設定
	if (($toroAttr=="aFunction" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			if(`attributeExists "aFunction"  $each`){
				deleteAttr -at "aFunction" $each;
			}
			addAttr -k false -at "enum" -en "none:ALWAYS:GREATER:GEQUAL:EQUAL:LEQUAL:LESS:NEVER:" -hidden false -ln "aFunction" $each;
			setAttr -channelBox true ($each+".aFunction") $value;
		}
	}
	//aReffernce設定
	if (($toroAttr=="aReffernce" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			if(`attributeExists "aReffernce"  $each`){
				deleteAttr -at "aReffernce" $each;
			}
			addAttr -k false-at short -hidden false  -min 0 -max 255 -ln "aReffernce" $each;
			setAttr -channelBox true ($each+".aReffernce") $value;
		}
	}
	
	//レンダリングステージ設定
	if (($toroAttr=="renderStage" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			if(`attributeExists "renderStage"  $each`){
				deleteAttr -at "renderStage" $each;
			}
			addAttr -k false -at "enum" -en "0:1:2:3:4:5:6:7:" -hidden false -ln "renderStage" $each;
			setAttr -channelBox true ($each+".renderStage") $value;
		}
	}
	
	//優先度設定
	if (($toroAttr=="priority" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			if(`attributeExists "priority"  $each`){
				deleteAttr -at "priority" $each;
			}
			addAttr -k false-at "float" -hidden false -min -255 -max 255  -ln "priority" $each;
			setAttr -channelBox true ($each+".priority") $value;
		}
	}
	
	//MultPass設定
	if (($toroAttr=="SetMultPass" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			if(`attributeExists "SetMultPass"  $each`){
				deleteAttr -at "SetMultPass" $each;
			}
			addAttr -k false -at "enum" -en "なし:castshadow_mate:" -hidden false -ln "SetMultPass" $each;
			setAttr -channelBox true ($each+".SetMultPass") $value;
		}
	}
	
	
}

global proc MP_MS_matterSetup_delete(string $toroAttr){
	//マテリアルノード削除
	//シェイプノードからの処理
	string $preobj[]=`ls -tr -typ mesh -sl`;
	string $lambertShapeFrom[];
	for ($each in $preobj){
		string $shape[]=`listRelatives -ad -typ shape $each`;
		string $shadingEngine[]=`listConnections -t shadingEngine $shape[0]`;
		$lambertShapeFrom=`listConnections -t lambert $shadingEngine[0]`;
	}
	//選択ランバート処理
	string $selectedLambert[]=`ls -typ lambert -sl`;
	//対象オブジェクト特定
	string $newArray[]=`stringArrayCatenate $lambertShapeFrom $selectedLambert`;
	string $obj[]=`stringArrayRemoveDuplicates $newArray`;
	
	//フィルタ設定
	if (($toroAttr=="filter" || $toroAttr=="all")&& size($obj)){
		for($each in $obj){
			
			if(`attributeExists "anisoFilter"  $each`){
				deleteAttr -at "anisoFilter" $each;
			}
			if(`attributeExists "mipmapFilter"  $each`){
				deleteAttr -at "mipmapFilter" $each;
			}
		}
	}
	if (($toroAttr=="shaderFromName" || $toroAttr=="all")&& size($obj)){
		for($each in $obj){
			
			if(`attributeExists "shaderFromName"  $each`){
				deleteAttr -at "shaderFromName" $each;
			}
		}
	}
	if (($toroAttr=="blend" || $toroAttr=="all")&& size($obj)){
		for($each in $obj){
			
			if(`attributeExists "blend"  $each`){
				deleteAttr -at "blend" $each;
			}
		}
	}
	if (($toroAttr=="fogOff" || $toroAttr=="all")&& size($obj)){
		for($each in $obj){
			
			if(`attributeExists "fogOff"  $each`){
				deleteAttr -at "fogOff" $each;
			}
		}
	}
	if (($toroAttr=="backfaceCurring" || $toroAttr=="all")&& size($obj)){
		for($each in $obj){
			
			if(`attributeExists "backfaceCurring"  $each`){
				deleteAttr -at "backfaceCurring" $each;
			}
		}
	}
	if (($toroAttr=="zOffset" || $toroAttr=="all")&& size($obj)){
		for($each in $obj){
			
			if(`attributeExists "zOffset"  $each`){
				deleteAttr -at "zOffset" $each;
			}
		}
	}
	if (($toroAttr=="zFunction" || $toroAttr=="all")&& size($obj)){
		for($each in $obj){
			
			if(`attributeExists "zFunction"  $each`){
				deleteAttr -at "zFunction" $each;
			}
		}
	}
	if (($toroAttr=="zWrite" || $toroAttr=="all")&& size($obj)){
		for($each in $obj){
			
			if(`attributeExists "zWrite"  $each`){
				deleteAttr -at "zWrite" $each;
			}
		}
	}
	if (($toroAttr=="aFunction" || $toroAttr=="all")&& size($obj)){
		for($each in $obj){
			
			if(`attributeExists "aFunction"  $each`){
				deleteAttr -at "aFunction" $each;
			}
		}
	}
	if (($toroAttr=="aReffernce" || $toroAttr=="all")&& size($obj)){
		for($each in $obj){
			
			if(`attributeExists "aReffernce"  $each`){
				deleteAttr -at "aReffernce" $each;
			}
		}
	}
	if (($toroAttr=="renderStage" || $toroAttr=="all")&& size($obj)){
		for($each in $obj){
			
			if(`attributeExists "renderStage"  $each`){
				deleteAttr -at "renderStage" $each;
			}
		}
	}
	if (($toroAttr=="priority" || $toroAttr=="all")&& size($obj)){
		for($each in $obj){
			
			if(`attributeExists "priority"  $each`){
				deleteAttr -at "priority" $each;
			}
		}
	}
	if (($toroAttr=="shaderFromName" || $toroAttr=="all")&& size($obj)){
		for($each in $obj){
			
			if(`attributeExists "shaderFromName"  $each`){
				deleteAttr -at "shaderFromName" $each;
			}
		}
	}
	if (($toroAttr=="SetMultPass" || $toroAttr=="all")&& size($obj)){
		for($each in $obj){
			
			if(`attributeExists "SetMultPass"  $each`){
				deleteAttr -at "SetMultPass" $each;
			}
		}
	}
	
	
	
	
	
	
	
}

//UI
global proc MP_MS_matterSetupUI_storeRecallUI( string $mode ){
	string $prefix="MS_MP_MS_matterSetupUI__";
	
	string $floatFieldList[] = {
		"nodePriority",
		"priority"
		};

	string $intFieldList[] = {
		"zOffset",
		"aReffernce",
		"startFrame",
		"endFrame"
		};

	string $floatSliderGrpList[] = {
		};

	string $intSliderGrpList[] = {
		};

	string $checkBoxList[] = {
		"fogOff",
		"zWrite",
		"skin",
		"collision",
		"osage",
		"hide",
		"billbord",
		"camera"
		};

	string $radioButtonGrpList[] = {
		};

	string $frameLayoutList[] = {
		};

	string $textFieldList[] = {
		};

	string $textFieldList_file[] = {
		};
	string $optionMenu[] = {
		"anisoFilter",
		"mipmapFilter",
		"shaderFromName",
		"blend",
		"backfaceCurring",
		"zFunction",
		"aFunction",
		"renderStage",
		"nodeRenderStage",
		"nodeSort",
		"SetMultPass"
		};
	string $oldENV[] = {
		"nodePriority",
		"priority"
	};
	
		
	int $cnt;

	if ( $mode == "store" )
	{
		for ( $each in $floatFieldList)
			optionVar -floatValue ($prefix+$each) `floatField -q -value $each`;

		for ( $each in $intFieldList)
			optionVar -intValue ($prefix+$each) `intField -q -value $each`;

		for ( $each in $floatSliderGrpList)
			optionVar -floatValue ($prefix+$each) `floatSliderGrp -q -value $each`;

		for ( $each in $intSliderGrpList)
			optionVar -intValue ($prefix+$each) `intSliderGrp -q -value $each`;

		for ( $each in $checkBoxList)
			optionVar -intValue ($prefix+$each) `checkBox -q -value $each`;

		for ( $each in $radioButtonGrpList)
			optionVar -intValue ($prefix+$each) `radioButtonGrp -q -select $each`;

		for ( $each in $frameLayoutList)
			optionVar -intValue ($prefix+$each) `frameLayout -q -collapse $each`;

		for ( $each in $textFieldList)
			optionVar -stringValue ($prefix+$each) `textField -q -tx $each`;

		for ( $each in $textFieldList_file)
			optionVar -stringValue ($prefix+$each) `textField -q -fileName $each`;

		for ( $each in $optionMenu)
			optionVar -intValue ($prefix+$each) `optionMenu -q -sl $each`;
	}

	if ( $mode == "recall" )
	{
		for ( $each in $floatFieldList)
			if ( `optionVar -exists ($prefix+$each)` )
				floatField -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $intFieldList)
			if ( `optionVar -exists ($prefix+$each)` )
				intField -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $floatSliderGrpList)
			if ( `optionVar -exists ($prefix+$each)` )
				floatSliderGrp -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $intSliderGrpList)
			if ( `optionVar -exists ($prefix+$each)` )
				intSliderGrp -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $checkBoxList)
			if ( `optionVar -exists ($prefix+$each)` )
				checkBox -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $radioButtonGrpList)
			if ( `optionVar -exists ($prefix+$each)` )
				radioButtonGrp -e -select `optionVar -q ($prefix+$each)` $each;

		for ( $each in $frameLayoutList)
			if ( `optionVar -exists ($prefix+$each)` )
				frameLayout -e -collapse `optionVar -q ($prefix+$each)` $each;

		for ( $each in $textFieldList)
			if ( `optionVar -exists ($prefix+$each)` )
				textField -e -tx `optionVar -q ($prefix+$each)` $each;

		for ( $each in $textFieldList_file)
			if ( `optionVar -exists ($prefix+$each)` )
				textField -e -fileName `optionVar -q ($prefix+$each)` $each;
		for ( $each in $optionMenu)
			if ( `optionVar -exists ($prefix+$each)` )
				optionMenu -e -sl `optionVar -q ($prefix+$each)` $each;
	}

	if ( $mode == "reset" )
	{
		for ( $each in $floatFieldList)
			optionVar -remove ($prefix+$each);

		for ( $each in $intFieldList)
			optionVar -remove ($prefix+$each);

		for ( $each in $floatSliderGrpList)
			optionVar -remove ($prefix+$each);

		for ( $each in $intSliderGrpList)
			optionVar -remove ($prefix+$each);

		for ( $each in $checkBoxList)
			optionVar -remove ($prefix+$each);

		for ( $each in $radioButtonGrpList)
			optionVar -remove ($prefix+$each);

		for ( $each in $frameLayoutList)
			optionVar -remove ($prefix+$each);

		for ( $each in $textFieldList)
			optionVar -remove ($prefix+$each);

		for ( $each in $textFieldList_file)
			optionVar -remove ($prefix+$each);

		for ( $each in $optionMenu)
			optionVar -remove ($prefix+$each);
		
		for ( $each in $oldENV)
			optionVar -remove ($prefix+$each);
	}
}

global proc MP_MS_matterSetupUI(){
	if (`window -q -ex MP_MS_matterSetupUI`){
		deleteUI MP_MS_matterSetupUI;
	}
	window MP_MS_matterSetupUI;
	
	columnLayout;
	//マテリアル設定
		separator -w 300 -h 20 ;
