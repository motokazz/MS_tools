/*
MP_MS_matterSetupUI
坂井元一

EOPPSPで使用するツールPEdit用のアトリビュートをMAYAでセットアップします。

MP_MS_matterSetup_set(string $toroAttr,int $value)
$toroAttrで指定したアトリビュートを$valueの値、任意の型式でshapeノードに追加します。

◆指定アトリビュート

anisoFilter
	0:NEAREST
	1:LINEAR
	2:NEAREST_NEAREST
	3:LINEAR_NEAREST
	4:NEAREST_LINEAR
	5:LINEAR_LINEAR

mipmapFilter
	0:NEAREST
	1:LINEAR
	2:NEAREST_NEAREST
	3:LINEAR_NEAREST
	4:NEAREST_LINEAR
	5:LINEAR_LINEAR
	6:mipmapFilter

shaderFromName
	0:DefaultVS
	1:FogSkinVS
	2:FogVS
	3:LightSkinVS
	4:LightVS
	5:ProjSkinVS
	6:ProjVS
	7:SphereSkinVS
	8:SphereVS
	9:ToonSkinVS
	10:ToonVS
	11:blend

blend
	0:none
	1:add
	2:mul
	3:sub:

fogOff
	0:fogOn
	1:fogOff

backfaceCurring
	0:none
	1:back
	2:front

zOffset
	0-255

zFunction
	0:none
	1:ALWAYS
	2:GREATER
	3:GEQUAL
	4:EQUAL
	5:LEQUAL
	6:LESS:NEVER

zWrite
	0:off
	1:on

aFunction
	0:none
	1:ALWAYS
	2:GREATER
	3:GEQUAL
	4:EQUAL
	5:LEQUAL
	6:LESS:NEVER


aReffernce
	0-255

renderStage
	0:3DNormal
	1:3DEffect
	2:2DGauge1
	3:Shadowmap
	4:2DEffect
	5:2DGauge2:

priority
	0-255

*/

global proc MP_MS_matterSetupUI_setDefault(){
	optionMenu -e -v "LINEAR" "anisoFilter";
	optionMenu -e -v "LINEAR" "mipmapFilter";
	optionMenu -e -v "shadowlight_v" "shaderFromName";
	optionMenu -e -v "通常" "blend";
	checkBox -e -v 0 "fogOff";
	optionMenu -e -v "Back" "backfaceCurring";
	intField -e -v 0 "zOffset";
	optionMenu -e -v "LEQUAL" "zFunction";
	checkBox -e -v 1 "zWrite";
	optionMenu -e -v "無し" "aFunction";
	intField -e -v 128 "aReffernce";
	optionMenu -e -v "0" "renderStage";
	floatField -e -v 0 "priority";
	optionMenu -e -v "castshadow_mate" "SetMultPass";
	MP_MS_matterSetupUI_storeRecallUI store;
}

//森田フレームセットアップ
global proc int[] MP_MS_matterSetupUI_Ret_min_max_anim(string $node_name) 
{
	int $ret_val[] = {};
	int $frame_array[] = {};
	int $index_no = 0;
/*TRS node animation frame check*/
	string $attr_type[] = {".tx", ".ty", ".tz", ".rx", ".ry", ".rz", ".sx", ".sy", ".sz"};
	for($i in $attr_type)
	{
		$anim_index = `keyframe -q -kc ($node_name + $i)`;
		for($j = 0; $j < $anim_index; $j++)
		{
			$time_v = `keyframe -in $j -q ($node_name + $i)`;
			$frame_array[$index_no] = $time_v[0];
			$index_no++;
		}
	}
/*texture UV animation frame check*/
	/*
	$shape_node = `listRelatives -s $node_name`;
	if(`objectType $shape_node[0]` == "mesh"){
		$sg_name = `listConnections -s 1 ($shape_node[0] + ".instObjGroups[0]")`;
		if(`connectionInfo -id ($sg_name[0] + ".surfaceShader")`){
			$mat_name = `listConnections -d 1 ($sg_name[0] + ".surfaceShader")`;
			if(`connectionInfo -id ($mat_name[0]+".color")`){
				$file_name = `listConnections -d 1 ($mat_name[0] + ".color")`;
				$place_name = `listConnections -d 1 ($file_name[0] + ".uvCoord")`;
			
				$anim_index = `keyframe -q -kc ($place_name[0] + ".ofu")`;
				if($anim_index > 0){
					$time_v = `keyframe -in 0 -q ($place_name[0] + ".ofu")`;
					$frame_array[$index_no] = $time_v[0];
					$index_no++;
					$time_v = `keyframe -in ($anim_index - 1) -q ($place_name[0] + ".ofu")`;
					$frame_array[$index_no] = $time_v[0];
					$index_no++;
				}
				
				$anim_index = `keyframe -q -kc ($place_name[0] + ".ofv")`;
				
				if($anim_index > 0){
					$time_v = `keyframe -in 0 -q ($place_name[0] + ".ofv")`;
					$frame_array[$index_no] = $time_v[0];
					$index_no++;
					$time_v = `keyframe -in ($anim_index - 1) -q ($place_name[0] + ".ofv")`;
					$frame_array[$index_no] = $time_v[0];
					$index_no++;
				}
			}
		}
	}
	*/
/*return value*/
	if(`size $frame_array` > 1)
	{
		$frame_array = `sort $frame_array`;
		$ret_val[0] = $frame_array[0];
		$ret_val[1] = $frame_array[(`size $frame_array` - 1)];	
	}
	else
	{
		$ret_val[0] = 0;
		$ret_val[1] = 0;
	}
	return $ret_val;
}

//スクリプト出力
//エクストラスクリプト
global proc MP_MS_scriptSetup_addExtraScript(string $mode,int $index){
	string $obj[]=`ls -as -sl`;
	if(!size($obj)){
		confirmDialog -bgc 1.0 0.8 0.6 -t "Warnning" -m "トップオブジェクトでなければExtraScriptつきません";
		return;
	}
	
	string $relatedShape[]=`listRelatives -typ shape $obj[0]`;
	
	string $value;
	
	if (`attributeExists "ExtraScript" $relatedShape[0]`){
		$value=`getAttr ($relatedShape[0]+".ExtraScript")`;
	}
	
	string $separatedCommand[];
	tokenize($value,";",$separatedCommand);
	
	//modify
	if( $mode=="modify" || $mode=="add" && !$index ||$mode=="delete"){
		$value = `scrollField -q -tx "addExtraScriptTag"`;
		setAttr -type "string" ($relatedShape[0]+".ExtraScript") $value;
	}
	
	//add
	if($mode=="add"){
		if (!`attributeExists "ExtraScript" $relatedShape[0]`){
			addAttr -k false -hidden false -ln "ExtraScript"  -dt "string" $relatedShape[0];
			setAttr -type "string" ($relatedShape[0]+".ExtraScript") $value;
		}else{
			setAttr -type "string" ($relatedShape[0]+".ExtraScript") $value;
		}
	}
	
	//delete
	if($mode=="delete"){
			if (`attributeExists "ExtraScript" $relatedShape[0]`){
				deleteAttr ($relatedShape[0]+".ExtraScript");
			}
	}
	
	//show
	MP_MS_scriptSetup_ExtraScriptWindow $value;
}

global proc MP_MS_scriptSetup_ExtraScriptWindow(string $ExtraScript){
	string $obj[]=`ls -as -l -sl`;
	string $relatedShape[]=`listRelatives -typ shape $obj[0]`;
	string $separatedCommand[];
	tokenize($ExtraScript,";",$separatedCommand);
	if (`window -q -ex MP_MS_scriptSetup_ExtraScriptLayout`){
		deleteUI MP_MS_scriptSetup_ExtraScriptLayout;
	}
	window MP_MS_scriptSetup_ExtraScriptLayout;
	columnLayout;
		text -w 80 -l "selected object";
		text -w 320 -h 40 -fn "boldLabelFont" -bgc 1.0 1.0 0.8 -l $obj[0] "MP_MS_scriptSetup_addExtraScript_selected";
		rowLayout -nc 2 -cw2 300 100;
			button -w 300 -bgc 0.8 0.9 1.0 -l "addExtraScript" -c ("MP_MS_scriptSetup_addExtraScript add "+size($separatedCommand));
			button -w 100 -bgc 1.0 0.9 0.8 -l "deleteExtraScript" -c ("MP_MS_scriptSetup_addExtraScript delete "+size($separatedCommand));
		setParent ..;
		text -w 50 -l "   ExtraScript";
		if(`attributeExists "ExtraScript" $relatedShape[0]`){
			scrollField -w 400 -h 300 -tx $ExtraScript "addExtraScriptTag";
			button -w 400 -h 30 -bgc 0.8 1.0 0.9 -l "setExtraScript" -c ("MP_MS_scriptSetup_addExtraScript modify "+size($separatedCommand));
		}
	setParent..;
	showWindow MP_MS_scriptSetup_ExtraScriptLayout;
}


//イベントテーブル
global proc MP_MS_scriptSetup_AddEventTable(string $mode,int $index){
	string $obj[]=`ls -as -sl`;
	if(!size($obj)){
		confirmDialog -bgc 1.0 0.8 0.6 -t "Warnning" -m "トップオブジェクトでなければモーションテーブルつきません";
		return;
	}
	
	string $relatedShape[]=`listRelatives -typ shape $obj[0]`;
	
	string $value;
	
	if (`attributeExists "EventTable" $relatedShape[0]`){
		$value=`getAttr ($relatedShape[0]+".EventTable")`;
	}
	
	string $separatedCommand[];
	tokenize($value,";",$separatedCommand);
	

	//modify
	if( $mode=="modify" || $mode=="add" && !$index ||$mode=="delete"){
		for ($i=0;$i<$index;$i++){
			$separatedCommand[$i]="";
			$separatedCommand[$i]=$separatedCommand[$i]+`text -q -l ("AddEventTable"+$i)`;
			$separatedCommand[$i]=$separatedCommand[$i]+"(";
			$separatedCommand[$i]=$separatedCommand[$i]+`intField -q -v ("AddEventTableTag"+$i)`;
			$separatedCommand[$i]=$separatedCommand[$i]+",\"";
			$separatedCommand[$i]=$separatedCommand[$i]+`optionMenu -q -v ("AddEventTableEvent"+$i)`;
			$separatedCommand[$i]=$separatedCommand[$i]+"\",\"";
			$separatedCommand[$i]=$separatedCommand[$i]+`textField -q -tx ("AddEventTableValueA"+$i)`;
			$separatedCommand[$i]=$separatedCommand[$i]+"\",\"";
			$separatedCommand[$i]=$separatedCommand[$i]+`textField -q -tx ("AddEventTableValueB"+$i)`;
			$separatedCommand[$i]=$separatedCommand[$i]+"\",\"";
			$separatedCommand[$i]=$separatedCommand[$i]+`textField -q -tx ("AddEventTableValueC"+$i)`;
			$separatedCommand[$i]=$separatedCommand[$i]+"\")";
			$value=`stringArrayToString $separatedCommand ";"`+";";
			setAttr -type "string" ($relatedShape[0]+".EventTable") $value;
		}
	}

	//add
	if($mode=="add"){
		$value=$value+"AddEventTable(0,\"Effect\",\"\",\"\",\"\");";
		if (!`attributeExists "EventTable" $relatedShape[0]`){
			addAttr -k false -hidden false -ln "EventTable"  -dt "string" $relatedShape[0];
			setAttr -type "string" ($relatedShape[0]+".EventTable") $value;
		}else{
			setAttr -type "string" ($relatedShape[0]+".EventTable") $value;
		}
	}
		
	//delete
	if($mode=="delete"){
		$value="";
		stringArrayRemoveAtIndex($index,$separatedCommand);
		for($each in $separatedCommand){
			$value=$value+$each+";";
		}
		setAttr -type "string" ($relatedShape[0]+".EventTable") $value;
	}
	
	//show
	MP_MS_scriptSetup_EventTableWindow $value;
}

global proc MP_MS_scriptSetup_EventTableWindow(string $EventTable){
	string $obj[]=`ls -as -l -sl`;
	string $separatedCommand[];
	tokenize($EventTable,";",$separatedCommand);
	if (`window -q -ex MP_MS_scriptSetup_EventTableLayout`){
		deleteUI MP_MS_scriptSetup_EventTableLayout;
	}
	window MP_MS_scriptSetup_EventTableLayout;
	columnLayout;
		text -w 80 -l "selected object";
		text -w 400 -h 40 -fn "boldLabelFont" -bgc 1.0 0.9 0.8 -l $obj[0] "MP_MS_scriptSetup_AddEventTable_selected";
		rowLayout -nc 2 -cw2 120 200;
			button -w 120 -bgc 0.9 1.0 1.0 -l "addTable" -c ("MP_MS_scriptSetup_AddEventTable add "+size($separatedCommand));
			button -w 200 -bgc 0.8 1.0 0.9 -l "setTable" -c ("MP_MS_scriptSetup_AddEventTable modify "+size($separatedCommand));
		setParent..;
		rowLayout -nc 2 -cw2 80 300;
			text -w 50 -l "script";
			rowLayout -nc 6 -cw6 30 60 60 60 70 30;
				text -w 50 -l "Frame";
				text -w 50 -l "Event";
				text -w 50 -l "Param1";
				text -w 50 -l "Param2";
				text -w 50 -l "Param3";
			setParent..;
		setParent..;
	setParent..;
	frameLayout -bv 0 -lv 0 -w 420 -h 400 ;
		scrollLayout;
			columnLayout;
			if($EventTable!=""){
				int $i;
				for($each in $separatedCommand){
					string $commandB=("MP_MS_scriptSetup_AddEventTable delete "+$i);
					string $tmp[];
					tokenize($each,"(,)",$tmp);
					rowLayout -nc 2 -cw2 80 300;
					text -l $tmp[0] ("AddEventTable"+$i);
						rowLayout -nc 6 -cw6 30 60 60 60 70 30 ;
							intField -w 30 -v (int($tmp[1])) ("AddEventTableTag"+$i);
							optionMenu  ("AddEventTableEvent"+$i);
								menuItem -label "Effect";
								menuItem -label "Signal";
								optionMenu -e -v `substituteAllString $tmp[2] "\"" ""` ("AddEventTableEvent"+$i);
							textField -w 60 -tx `substituteAllString $tmp[3] "\"" ""` ("AddEventTableValueA"+$i);
							textField -w 60 -tx `substituteAllString $tmp[4] "\"" ""` ("AddEventTableValueB"+$i);
							textField -w 60 -tx `substituteAllString $tmp[5] "\"" ""` ("AddEventTableValueC"+$i);
							button -bgc 1.0 0.9 0.8 -w 30 -l "del" -c $commandB;
						setParent..;
					setParent..;
					$i++;
				}
			}
			setParent..;
		setParent..;
	setParent..;
	
	showWindow MP_MS_scriptSetup_EventTableLayout;
}

//モーションテーブル
global proc MP_MS_scriptSetup_addMotionTable(string $mode,int $index){
	string $obj[]=`ls -as -sl`;
	if(!size($obj)){
		confirmDialog -bgc 1.0 0.8 0.6 -t "Warnning" -m "トップオブジェクトでなければモーションテーブルつきません";
		return;
	}
	
	string $relatedShape[]=`listRelatives -typ shape $obj[0]`;
	
	string $value;
	
	if (`attributeExists "MotionTable" $relatedShape[0]`){
		$value=`getAttr ($relatedShape[0]+".MotionTable")`;
	}
	
	string $separatedCommand[];
	tokenize($value,";",$separatedCommand);
	

	
	//modify
	if( $mode=="modify" || $mode=="add" && !$index ||$mode=="delete"){
		for ($i=0;$i<$index;$i++){
			$separatedCommand[$i]="";
			$separatedCommand[$i]=$separatedCommand[$i]+`text -q -l ("addMotionTable"+$i)`;
			$separatedCommand[$i]=$separatedCommand[$i]+"(\"";
			$separatedCommand[$i]=$separatedCommand[$i]+`textField -q -tx ("addMotionTableTag"+$i)`;
			$separatedCommand[$i]=$separatedCommand[$i]+"\",";
			$separatedCommand[$i]=$separatedCommand[$i]+`intField -q -v ("addMotionTableValueA"+$i)`;
			$separatedCommand[$i]=$separatedCommand[$i]+",";
			$separatedCommand[$i]=$separatedCommand[$i]+`intField -q -v ("addMotionTableValueB"+$i)`;
			$separatedCommand[$i]=$separatedCommand[$i]+",";
			$separatedCommand[$i]=$separatedCommand[$i]+`intField -q -v ("addMotionTableValueC"+$i)`;
			$separatedCommand[$i]=$separatedCommand[$i]+")";
			$value=`stringArrayToString $separatedCommand ";"`+";";
			setAttr -type "string" ($relatedShape[0]+".MotionTable") $value;
		}
	}
	
	//add
	if($mode=="add"){
		$value=$value+"AddMotionTable(\"New\",0,0,0);";
		if (!`attributeExists "MotionTable" $relatedShape[0]`){
			addAttr -k false -hidden false -ln "MotionTable"  -dt "string" $relatedShape[0];
			setAttr -type "string" ($relatedShape[0]+".MotionTable") $value;
		}else{
			setAttr -type "string" ($relatedShape[0]+".MotionTable") $value;
		}
	}
	//delete
	if($mode=="delete"){
		$value="";
		stringArrayRemoveAtIndex($index,$separatedCommand);
		for($each in $separatedCommand){
			$value=$value+$each+";";
		}
		setAttr -type "string" ($relatedShape[0]+".MotionTable") $value;
	}
	
	//show
	MP_MS_scriptSetup_MotionTableWindow $value;
}

global proc MP_MS_scriptSetup_MotionTableWindow(string $MotionTable){
	string $obj[]=`ls -as -l -sl`;
	string $separatedCommand[];
	tokenize($MotionTable,";",$separatedCommand);
	if (`window -q -ex MP_MS_scriptSetup_MotionTableLayout`){
		deleteUI MP_MS_scriptSetup_MotionTableLayout;
	}
	window MP_MS_scriptSetup_MotionTableLayout;
	columnLayout;
		text -w 80 -l "selected object";
		text -w 320 -h 40 -fn "boldLabelFont" -bgc 1.0 1.0 0.8 -l $obj[0] "MP_MS_scriptSetup_addMotionTable_selected";
		rowLayout -nc 2 -cw2 120 200;
			button -w 120 -bgc 0.9 1.0 1.0 -l "addTable" -c ("MP_MS_scriptSetup_addMotionTable add "+size($separatedCommand));
			button -w 200 -bgc 0.8 1.0 0.9 -l "setTable" -c ("MP_MS_scriptSetup_addMotionTable modify "+size($separatedCommand));
		setParent..;
		rowLayout -nc 6 -cw6 80 80 40 40 40 50;
			text -w 50 -l "script";
			text -w 50 -l "name";
			text -w 50 -l "start";
			text -w 50 -l "count";
			text -w 50 -l "offset";
		setParent..;
	setParent..;
	frameLayout -bv 0 -lv 0 -w 350 -h 400 ;
		scrollLayout;
			columnLayout ;
			if($MotionTable!=""){
				int $i;
				for($each in $separatedCommand){
					string $commandB=("MP_MS_scriptSetup_addMotionTable delete "+$i);
					string $tmp[];
					tokenize($each,"(,)",$tmp);
					rowLayout -nc 6 -cw6 80 80 40 40 40 30 ;
						text -l $tmp[0] ("addMotionTable"+$i);
						textField -w 80 -tx `substituteAllString $tmp[1] "\"" ""` ("addMotionTableTag"+$i);
						intField -w 40 -v (int($tmp[2])) ("addMotionTableValueA"+$i);
						intField -w 40 -v (int($tmp[3])) ("addMotionTableValueB"+$i);
						intField -w 40 -v (int($tmp[4])) ("addMotionTableValueC"+$i);
						button -bgc 1.0 0.9 0.8 -w 40 -l "del" -c $commandB;
					setParent..;
					$i++;
				}
			}
			setParent..;
		setParent..;
	setParent..;
	
	showWindow MP_MS_scriptSetup_MotionTableLayout;
}

//エクストラセットアップ
global proc MP_MS_extraStringSetup_set(string $toroAttr,string $value){
	string $obj[]=`ls -tr -typ mesh -sl`;
	//PEdit用スクリプトセットアップ
	if (($toroAttr=="PEScript" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			if(!`attributeExists "PEScript"  $relatedShape[0]`){
				addAttr -k false -hidden false -ln "PEScript"  -dt "string" $relatedShape[0];
			}
			setAttr -type "string" ($relatedShape[0]+".PEScript") $value;
		}
	}
	//その他テキストセットアップ
	if (($toroAttr=="EXText" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			if(!`attributeExists "EXText"  $relatedShape[0]`){
				addAttr -k false -hidden false -ln "EXText"  -dt "string" $relatedShape[0];
			}
			setAttr -type "string" ($relatedShape[0]+".EXText") $value;
		}
	}
}

//フレーム設定
global proc MP_MS_extraSetup_Get(){
	string $obj[]=`ls -tr -typ mesh -sl`;
	string $relatedShape[]=`listRelatives -typ shape $obj[0]`;
	if(`attributeExists "startFrame" $relatedShape[0]`){
		intField -e -v `getAttr ($relatedShape[0]+".startFrame")` "startFrame";
		intField -e -v `getAttr ($relatedShape[0]+".endFrame")` "endFrame";
	}
}

global proc MP_MS_frameSetup_setField(){
	string $obj[]=`ls -sl`;
	int $obj_frame[]=`MP_MS_matterSetupUI_Ret_min_max_anim $obj[0]`;
	intField -e -v $obj_frame[0] "startFrame";
	intField -e -v $obj_frame[1] "endFrame";
}

global proc MP_MS_extraSetup_preset(string $mode){
	 if(($mode=="frame" || $mode=="all")){
		 int $startFrame=`intField -q -v "startFrame"`;
		 MP_MS_extraSetup_set startFrame $startFrame;
		 int $endFrame=`intField -q -v "endFrame"`;
		 MP_MS_extraSetup_set endFrame $endFrame;
	}
	
	 if(($mode=="PEScript" || $mode=="all")){
		 string $PEScript=`textField -q -tx "PEScript"`;
		 MP_MS_extraStringSetup_set PEScript $PEScript;
	}
	
	if(($mode=="EXText" || $mode=="all")){
		 string $EXText=`textField -q -tx "EXText"`;
		 MP_MS_extraStringSetup_set EXText $EXText;
	}
}

global proc MP_MS_extraSetup_set(string $toroAttr,int $value){
	string $obj[]=`ls -tr -typ mesh -sl`;
	if (($toroAttr=="startFrame" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			if(`attributeExists "startFrame"  $relatedShape[0]`){
				deleteAttr -at "startFrame" $relatedShape[0];
			}
			addAttr -k false -at short -hidden false -ln "startFrame" $relatedShape[0];
			setAttr -channelBox true ($relatedShape[0]+".startFrame") $value;
		}
	}
	if (($toroAttr=="endFrame" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			if(`attributeExists "endFrame"  $relatedShape[0]`){
				deleteAttr -at "endFrame" $relatedShape[0];
			}
			addAttr -k false -at short -hidden false -ln "endFrame" $relatedShape[0];
			setAttr -channelBox true ($relatedShape[0]+".endFrame") $value;
		}
	}
	
	if (($toroAttr=="PEScript" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			if(`attributeExists "PEScript"  $relatedShape[0]`){
				deleteAttr -at "PEScript" $relatedShape[0];
			}
			addAttr -k false -dt "string" -hidden false -ln "PEScript"  $relatedShape[0];
			setAttr -type "string" ($relatedShape[0]+".PEScript") $value;		}
	}
	
	
	
}

global proc MP_MS_extraSetup_delete(string $toroAttr){
	string $obj[]=`ls -tr -typ transform -sl`;
	//フィルタ設定
	if (($toroAttr=="frame" || $toroAttr=="all")&& size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			if(`attributeExists "startFrame"  $relatedShape[0]`){
				deleteAttr -at "startFrame" $relatedShape[0];
			}
			if(`attributeExists "endFrame"  $relatedShape[0]`){
				deleteAttr -at "endFrame" $relatedShape[0];
			}
		}
	}
}

//ノードセットアップ
global proc MP_MS_nodeSetup_Get(){
	string $obj[]=`ls -tr -typ mesh -sl`;
	string $relatedShape[]=`listRelatives -typ shape $obj[0]`;
	print $relatedShape[0];
	if (`attributeExists  "skin" $relatedShape[0]`){
		checkBox 
			-e
			-v `getAttr ($relatedShape[0]+".skin")`
			"skin";
	}
	if (`attributeExists  "collision" $relatedShape[0]`){
		checkBox 
			-e
			-v `getAttr ($relatedShape[0]+".collision")`
			"collision";
	}
	if (`attributeExists  "osage" $relatedShape[0]`){
		checkBox 
			-e
			-v `getAttr ($relatedShape[0]+".osage")`
			"osage";
	}
	if (`attributeExists  "hide" $relatedShape[0]`){
		checkBox 
			-e
			-v `getAttr ($relatedShape[0]+".hide")`
			"hide";
	}
	if (`attributeExists  "billbord" $relatedShape[0]`){
		checkBox 
			-e
			-v `getAttr ($relatedShape[0]+".billbord")`
			"billbord";
	}
	if (`attributeExists  "camera" $relatedShape[0]`){
		checkBox 
			-e
			-v `getAttr ($relatedShape[0]+".camera")`
			"camera";
	}
	if (`attributeExists  "renderStage" $relatedShape[0]`){
		optionMenu 
			-e
			-sl (`getAttr ($relatedShape[0]+".renderStage")`+1)
			"nodeRenderStage";
	}
	if (`attributeExists  "priority" $relatedShape[0]`){
		floatField
			-e
			-v `getAttr ($relatedShape[0]+".priority")`
			"nodePriority";
	}
	if (`attributeExists  "nodeSort" $relatedShape[0]`){
		optionMenu 
			-e
			-sl (`getAttr ($relatedShape[0]+".nodeSort")`+1)
			"nodeSort";
	}
	MP_MS_matterSetupUI_storeRecallUI store;
}

global proc MP_MS_nodeSetup_preset(string $mode){
	 if(($mode=="skin" || $mode=="all")){
		 int $skin=`checkBox -q -v "skin"`;
		 MP_MS_nodeSetup_set skin $skin;
	}
	 if(($mode=="collision" || $mode=="all")){
		 int $collision=`checkBox -q -v "collision"`;
		 MP_MS_nodeSetup_set collision $collision;
	}
	 if(($mode=="osage" || $mode=="all")){
		 int $osage=`checkBox -q -v "osage"`;
		 MP_MS_nodeSetup_set osage $osage;
	}
	 if(($mode=="hide" || $mode=="all")){
		 int $hide=`checkBox -q -v "hide"`;
		 MP_MS_nodeSetup_set hide $hide;
	}
	 if(($mode=="billbord" || $mode=="all")){
		 int $billbord=`checkBox -q -v "billbord"`;
		 MP_MS_nodeSetup_set billbord $billbord;
	}
	 if(($mode=="camera" || $mode=="all")){
		 int $camera=`checkBox -q -v "camera"`;
		 MP_MS_nodeSetup_set camera $camera;
	}
	 if(($mode=="nodeRenderStage" || $mode=="all")){
		 int $nodeRenderStage=(`optionMenu -q -sl "nodeRenderStage"`-1);
		 MP_MS_nodeSetup_set nodeRenderStage $nodeRenderStage;
	}
	 if(($mode=="nodePriority" || $mode=="all")){
		 float $priority=`floatField -q -v "nodePriority"`;
		 MP_MS_nodeSetup_set nodePriority $priority;
	}
	if(($mode=="nodeSort" || $mode=="all")){
		 int $nodeSort=(`optionMenu -q -sl "nodeSort"`-1);;
		 MP_MS_nodeSetup_set nodeSort $nodeSort;
	}
}

global proc MP_MS_nodeSetup_set(string $toroAttr,float $value){
	string $obj[]=`ls -tr -typ mesh -sl`;

	//スキン設定
	if (($toroAttr=="skin" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			if(`attributeExists "skin"  $relatedShape[0]`){
				deleteAttr -at "skin" $relatedShape[0];
			}
			addAttr -k false-at bool -hidden false -ln "skin" $relatedShape[0];
			setAttr -channelBox true ($relatedShape[0]+".skin") $value;
		}
	}
	//コリジョン設定
	if (($toroAttr=="collision" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			if(`attributeExists "collision"  $relatedShape[0]`){
				deleteAttr -at "collision" $relatedShape[0];
			}
			addAttr -k false-at bool -hidden false -ln "collision" $relatedShape[0];
			setAttr -channelBox true ($relatedShape[0]+".collision") $value;
		}
	}
	//おさげ設定
	if (($toroAttr=="osage" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			if(`attributeExists "osage"  $relatedShape[0]`){
				deleteAttr -at "osage" $relatedShape[0];
			}
			addAttr -k false-at bool -hidden false -ln "osage" $relatedShape[0];
			setAttr -channelBox true ($relatedShape[0]+".osage") $value;
		}
	}
	//HIDE設定
	if (($toroAttr=="hide" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			if(`attributeExists "hide"  $relatedShape[0]`){
				deleteAttr -at "hide" $relatedShape[0];
			}
			addAttr -k false-at bool -hidden false -ln "hide" $relatedShape[0];
			setAttr -channelBox true ($relatedShape[0]+".hide") $value;
		}
	}
	//ビルボード設定
	if (($toroAttr=="billbord" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			if(`attributeExists "billbord"  $relatedShape[0]`){
				deleteAttr -at "billbord" $relatedShape[0];
			}
			addAttr -k false-at bool -hidden false -ln "billbord" $relatedShape[0];
			setAttr -channelBox true ($relatedShape[0]+".billbord") $value;
		}
	}
	//cameraノード設定
	if (($toroAttr=="camera" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			if(`attributeExists "camera"  $relatedShape[0]`){
				deleteAttr -at "camera" $relatedShape[0];
			}
			addAttr -k false-at bool -hidden false -ln "camera" $relatedShape[0];
			setAttr -channelBox true ($relatedShape[0]+".camera") $value;
		}
	}
	//カリング設定
	if (($toroAttr=="backfaceCurring" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			if(`attributeExists "backfaceCurring"  $relatedShape[0]`){
				deleteAttr -at "backfaceCurring" $relatedShape[0];
			}
			addAttr -k false -at "enum" -en "none:back:front" -hidden false -ln "backfaceCurring" $relatedShape[0];
			setAttr -channelBox true ($relatedShape[0]+".backfaceCurring") $value;
		}
	}
	//レンダリングステージ設定
	if (($toroAttr=="nodeRenderStage" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			if(`attributeExists "renderStage" $relatedShape[0]`){
				deleteAttr -at "renderStage" $relatedShape[0];
			}
			addAttr -k false -at "enum" -en "-1material:0 :1_:2_:3_:4_:5_:6_:7_:" -hidden false -ln "renderStage" $relatedShape[0];
			setAttr -channelBox true ($each+".renderStage") $value;
		}
	}
	//優先度設定
	if (($toroAttr=="nodePriority" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			if(`attributeExists "priority"  $relatedShape[0]`){
				deleteAttr -at "priority" $relatedShape[0];
			}
			addAttr -k false-at "float" -hidden false -min -255 -max 255  -ln "priority" $relatedShape[0];
			setAttr -channelBox true ($relatedShape[0]+".priority") $value;
		}
	}
	//ノードソート設定
	if (($toroAttr=="nodeSort" || $toroAttr=="all") && size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			if(`attributeExists "nodeSort"  $relatedShape[0]`){
				deleteAttr -at "nodeSort" $relatedShape[0];
			}
			addAttr -k false -at "enum" -en "none:X:Y:Z:Depth:-X:-Y:-Z:-Depth:" -hidden false -ln "nodeSort" $relatedShape[0];
			setAttr -channelBox true ($relatedShape[0]+".nodeSort") $value;
		}
	}
}

