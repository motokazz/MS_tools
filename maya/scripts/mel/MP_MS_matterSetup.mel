		setParent..;
		separator -w 300 -h 10;
		button -w 300 -h 30 -l "モーションテーブルセットアップ" -bgc 1.0 1.0 0.8
		-c "MP_MS_scriptSetup_addMotionTable show 0";
		
		separator -w 300 -h 10;
		button -w 300 -h 30 -l "イベントテーブルセットアップ" -bgc 1.0 0.9 0.8
		-c "MP_MS_scriptSetup_AddEventTable show 0";

		separator -w 300 -h 10;
		button -w 300 -h 30 -l "エクストラスクリプトセットアップ" -bgc 0.9 0.8 1.0 
		-c "MP_MS_scriptSetup_addExtraScript show 0";

		separator -w 300 -h 10 ;

		separator -w 300 -h 200;
		button -w 300 -l "環境変数クリアボタン" -bgc 1.0 0.5 0.5  -c "MP_MS_matterSetupUI_storeRecallUI reset";
	setParent..;
	
	MP_MS_matterSetupUI_storeRecallUI recall;
	
	window -e -wh 310 800 MP_MS_matterSetupUI;
	
	showWindow MP_MS_matterSetupUI;
}


//MP_MS_matterSetupUI;


