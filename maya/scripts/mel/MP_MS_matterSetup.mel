		separator -w 300;
		rowLayout -nc 4 -cw4 50 100 50 100;
			button -w 50 -l "ステージ" -c "MP_MS_matterSetup_preset renderStage";
			optionMenu -cc "MP_MS_matterSetupUI_storeRecallUI store" "renderStage";
