//頂点数で選択オブジェクトを振り分け。
//最小値と最大値を設定して、その範囲内にあるオブジェクトのリストのみを返す。

global proc string[] MS_vertexcountFiltering(int $min,int $max){
	string $obj[]=`ls -sl`;
	string $newobj[];
	for($each in $obj){
		int $num[]=`polyEvaluate -v $each`;
		if($num[0]>=$min && $num[0]<=$max){
			$newobj=stringArrayCatenate ($newobj,{$each});
		}
	}
	return $newobj;
}

global proc MS_vertexcountFiltering_command(){
	string $filtering[]=MS_vertexcountFiltering(`intField -q -v minField`,`intField -q -v maxField`);
	select -r $filtering;
}

