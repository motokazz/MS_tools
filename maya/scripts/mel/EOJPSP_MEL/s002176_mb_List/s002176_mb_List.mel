/////////////////////////////////////////////////////////////////////////////////////
//チェックアウト
global proc s002176_se_cout()
{
string $filename_path=`s002176_return_file`;
//print($filename_path);

//頭の「D/」を削る
 	string $delmoji = "D:";
	string $filename_path_delD=`substitute $delmoji $filename_path ""`;

 //string $mel_enmark="/";
 //string $floder_Path=`s002176_return_file`;
 //string $filename_path = substituteAllString($floder_Path,$mel_enmark,"\\");
print($filename_path_delD);
system("D:/EOJPSP/tools/sirenexplorer/SEConsole.exe -co "+ $filename_path_delD); 

}

