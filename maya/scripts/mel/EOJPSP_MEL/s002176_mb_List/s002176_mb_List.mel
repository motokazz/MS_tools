/////////////////////////////////////////////////////////////////////////////////////
//チェックイン
global proc s002176_se_cin()
{
string $filename_path=`s002176_return_file`;
//print($filename_path);

//頭の「D/」を削る
 	string $delmoji = "D:";
	string $filename_path_delD=`substitute $delmoji $filename_path ""`;

//print($filename_path_delD);

system("D:/EOJPSP/tools/sirenexplorer/SEConsole.exe -ci "+ $filename_path_delD); 
