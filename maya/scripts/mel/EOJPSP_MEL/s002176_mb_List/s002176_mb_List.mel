/////////////////////////////////////////////////////////////////////////////////////
//リターンfile名
global proc string s002176_return_file()
{
//file -f -new;
global string $s002176_RightArea;
global string $s002176_LeftArea;
string $tokenizedLists2[];

string $krbNM = `fyListSelectNMs($s002176_LeftArea)`;

string $fbxfileNM1 = `fyListSelectNMs($s002176_LeftArea)`;
//print($fbxfileNM1);

string $fbxfileNM2 = `fyListSelectNMs($s002176_RightArea)`;
//print($fbxfileNM2);

string $fbxFullPath = ($fbxfileNM2);

tokenizeList($fbxfileNM1,$tokenizedLists2);
//print($tokenizedLists2[1]);

string $fbxFullPath = ($tokenizedLists2[1] + $fbxfileNM2);
//print($fbxFullPath);

return($fbxFullPath);
}

