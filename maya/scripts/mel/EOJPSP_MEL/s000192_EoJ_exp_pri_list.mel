proc int s000192_EoJ_exp_list_render_stg(string $shape_stg, string $mtl_stg){	int $ret_val;	int $shape_stg_val = 1000;	if(isValidString($shape_stg, "[0-9]*") == 1){$shape_stg_val = $shape_stg;}	int $mtl_stg_val = 1000;	if(isValidString($mtl_stg, "[0-9]*") == 1){$mtl_stg_val = $mtl_stg;}	if($shape_stg_val > 0 && $shape_stg_val != 1000)	{		$ret_val = $shape_stg_val - 1;	}	else if($shape_stg_val == 1000 && $mtl_stg_val != 1000)	{		$ret_val = $mtl_stg_val;	}	else	{		$ret_val = 0;	}	return $ret_val;}proc int[] s000192_EoJ_exp_list_sort(int $bef_sort[]){	int $in_bef_sort[] = {};	$in_bef_sort = $bef_sort;	int $sort_array[] = {};	int $ret_array[] = {};	int $index_no = 0;	$sort_array = `sort $in_bef_sort`;	for($i = 0; $i < `size $sort_array`; $i++)	{		int $sort_array_i = $sort_array[$i];		for($j = 0; $j < `size $in_bef_sort`; $j++)		{			int $bef_sort_array_i = $in_bef_sort[$j];			if($sort_array_i == $bef_sort_array_i)			{				$ret_array[$index_no] = $j;				$in_bef_sort[$j] = 1000;				$index_no++;				break;			}		}	}	return $ret_array;}proc string s000192_EoJ_exp_list_geo_name(string $sg_name, int $chk_sort, string $mtl_val, string $mtl_rend_st){	int $mtl_val_num = 1000;	if(isValidString($mtl_val, "[0-9]*") == 1){$mtl_val_num = $mtl_val;}	string $chk_attr = "priority";	string $chk_attr2 = "renderStage";	string $no_val = "-";	string $div_word = ",";	int $index_no = 0;	int $index_no2 = 0;	string $attr_shape[] = {};	string $no_attr_shape[] = {};	int $shape_pri_val[] = {};	int $all_pri_val[] = {};	int $rend_stg[] = {};	int $no_attr_rend_stg[] = {};	string $ret_array = "";	int $aft_sort_shape_id[] = {};	$geo_name = `listConnections -d 1 ($sg_name + ".dagSetMembers")`;	for($i = 0; $i < `size $geo_name`; $i++)	{		$shape_name = `listRelatives -f -s $geo_name[$i]`;		if(`attributeQuery -node $shape_name[0] -ex $chk_attr` == 1)		{			$attr_shape[$index_no] = $shape_name[0];			$get_attr_val = `getAttr ($shape_name[0] + "." + $chk_attr)`;			$shape_pri_val[$index_no] = $get_attr_val;			if($mtl_val_num != 1000){ $all_pri_val[$index_no] = $get_attr_val + $mtl_val_num; }			else{ $all_pri_val[$index_no] = $get_attr_val; }			if(`attributeQuery -node $shape_name[0] -ex $chk_attr2` == 1)			{				string $shape_rend_st = `getAttr ($shape_name[0] + "." + $chk_attr2)`;				$rend_stg[$index_no] = s000192_EoJ_exp_list_render_stg($shape_rend_st, $mtl_rend_st);			}			else{ $rend_stg[$index_no] = s000192_EoJ_exp_list_render_stg("None", $mtl_rend_st); }			$index_no++;		}		else		{			$no_attr_shape[$index_no2] = $shape_name[0];			$no_attr_rend_stg[$index_no2] = s000192_EoJ_exp_list_render_stg("None", $mtl_rend_st);;			$index_no2++;		}	}	if($chk_sort == 1){ $aft_sort_shape_id = s000192_EoJ_exp_list_sort($shape_pri_val); }	for($i = 0; $i < `size $attr_shape`; $i++)	{		if($chk_sort == 0)		{			if($i == 0){ $ret_array = $ret_array + $attr_shape[$i] + $div_word + $shape_pri_val[$i] + $div_word + $all_pri_val[$i] + $div_word + $rend_stg[$i]; }			else{ $ret_array = $ret_array + $div_word + $attr_shape[$i] + $div_word + $shape_pri_val[$i] + $div_word + $all_pri_val[$i] + $div_word + $rend_stg[$i]; }		}		else		{			if($i == 0){ $ret_array = $ret_array + $attr_shape[$aft_sort_shape_id[$i]] + $div_word + $shape_pri_val[$aft_sort_shape_id[$i]] + $div_word + $all_pri_val[$aft_sort_shape_id[$i]] + $div_word + $rend_stg[$aft_sort_shape_id[$i]]; }			else{ $ret_array = $ret_array + $div_word + $attr_shape[$aft_sort_shape_id[$i]] + $div_word + $shape_pri_val[$aft_sort_shape_id[$i]] + $div_word + $all_pri_val[$aft_sort_shape_id[$i]] + $div_word + $rend_stg[$aft_sort_shape_id[$i]]; }		}	}	for($i = 0; $i < `size $no_attr_shape`; $i++)	{		if($i == 0 && $ret_array == ""){ $ret_array = $ret_array + $no_attr_shape[$i] + $div_word + $no_val + $div_word + $mtl_val + $div_word + $no_attr_rend_stg[$i]; }		else{ $ret_array = $ret_array + $div_word + $no_attr_shape[$i] + $div_word + $no_val + $div_word + $mtl_val + $div_word + $no_attr_rend_stg[$i]; }	}	return $ret_array;}proc string s000192_EoJ_exp_list_mtl(int $chk_sort){	string $chk_attr = "priority";	string $chk_attr2 = "renderStage";	int $bef_sort_mtl_id[] = {};	string $attr_mat[] = {};	string $no_attr_mat[] = {};	string $mtl_attr_link_geo[] = {};	string $no_mtl_attr_link_geo[] = {};	string $div_word = ",";	string $final_list = "";	int $aft_sort_mtl_id[] = {};	int $index_no = 0;	int $index_no2 = 0;	$mat_name = `ls -mat`;	for($i in $mat_name)	{		$sg_name = `listConnections -d 1 ($i + ".outColor")`;		for($j in $sg_name)		{			$geo_name = `listConnections -d 1 ($j + ".dagSetMembers")`;			if(`size $geo_name` != 0)			{				if(`attributeQuery -node $i -ex $chk_attr` == 1)				{					$bef_sort_mtl_id[$index_no] = `getAttr ($i + "." + $chk_attr)`;					$mtl_val = `getAttr ($i + "." + $chk_attr)`;					$attr_mat[$index_no] = $i;					string $mtl_rend_st = "";					if(`attributeQuery -node $i -ex $chk_attr2` == 1){ $mtl_rend_st = `getAttr ($i + "." + $chk_attr2)`; }					else{ $mtl_rend_st = "None"; }					$mtl_attr_link_geo[$index_no] = s000192_EoJ_exp_list_geo_name($j, $chk_sort, $mtl_val, $mtl_rend_st);					$index_no++;				}				else				{					$no_attr_mat[$index_no2] = $i;					$no_mtl_attr_link_geo[$index_no2] = s000192_EoJ_exp_list_geo_name($j, $chk_sort, "-", "None");					$index_no2++;				}			}		}	}	if($chk_sort == 1){ $aft_sort_mtl_id = s000192_EoJ_exp_list_sort($bef_sort_mtl_id); }	for($k = 0; $k < `size $attr_mat`; $k++)	{		if($chk_sort == 0)		{			$final_list = $final_list + $attr_mat[$k] + $div_word + $bef_sort_mtl_id[$k] + $div_word + $mtl_attr_link_geo[$k] + "\n";		}		else		{			$final_list = $final_list + $attr_mat[$aft_sort_mtl_id[$k]] + $div_word + $bef_sort_mtl_id[$aft_sort_mtl_id[$k]] + $div_word + $mtl_attr_link_geo[$aft_sort_mtl_id[$k]] + "\n";		}	}	for($k = 0; $k < `size $no_attr_mat`; $k++)	{		$final_list = $final_list + $no_attr_mat[$k] + $div_word + "-" + $div_word + $no_mtl_attr_link_geo[$k] + "\n";	}	return $final_list;}proc string s000192_EoJ_exp_list_format(string $filename, int $chk_sort){	string $div_enter[] = {};	string $out_text2 = "";	int $chk_word = 0;	string $div_word = ",";	$out_text = s000192_EoJ_exp_list_mtl($chk_sort);	tokenize $out_text "\n" $div_enter;	for($i = 0; $i < `size $div_enter`; $i++)	{		string $row_count[] = {};		$chk_word = `tokenize $div_enter[$i] $div_word $row_count`;		for($j = 2; $j < ($chk_word - 1); $j+=4)		{			$out_text2 = $out_text2 + $filename + "," + $row_count[0] + "," + $row_count[1] + "," + $row_count[$j] + "," + $row_count[$j+1] + "," + $row_count[$j+2] + "," + $row_count[$j+3] + "\n";		}	}	return $out_text2;}proc string s000192_EoJ_exp_list_format_xml(string $filename, int $chk_sort){	string $div_enter[] = {};	string $out_text2 = "<?xml version=" + "\"1.0" + "\" encoding=" + "\"utf-8" + "\"?>\r\n<main>\r\n<file ExportName=" + "\"" + $filename + "\"> \r\n";	string $div_word = ",";	$out_text = s000192_EoJ_exp_list_mtl($chk_sort);	tokenize $out_text "\n" $div_enter;	for($i = 0; $i < `size $div_enter`; $i++)	{		int $next_attr = 0;		string $row_count[] = {};		$chk_word = `tokenize $div_enter[$i] $div_word $row_count`;		for($j = 0; $j < `size $row_count`; $j+=2)		{			if($j < 2)			{				$out_text2 = $out_text2 + "<mtl MaterialName=" + "\"" + $row_count[$j] + "\" PriVal=" + "\"" + $row_count[$j+1] + "\">\r\n";			}			else if($j > 1 && $next_attr == 0)			{				$out_text2 = $out_text2 + "<geo ShapeName=" + "\"" + $row_count[$j] + "\" PriVal=" + "\"" + $row_count[$j+1] + "\" ";				$next_attr = 1;			}			else			{				$out_text2 = $out_text2 + "AllPriVal=" + "\"" + $row_count[$j] + "\" RenderStage=" + "\"" + $row_count[$j+1] + "\"/>\r\n";				$next_attr = 0;			}		}		$out_text2 = $out_text2 + "\t</mtl>\r\n";	}	$out_text2 = $out_text2 + "</file>\r\n";	$out_text2 = $out_text2 + "</main>\r\n";	return $out_text2;}global proc s000192_EoJ_exp_pri_list(string $filepath, string $filename, int $chk_sort, string $fileformat){	string $ext_name[] = {};	if($fileformat == "c"){ $ext_name[0] = ".csv"; }	else if($fileformat == "x"){ $ext_name[0] = ".xml"; }	else if($fileformat == "cx"){ $ext_name[0] = ".csv"; $ext_name[1] = ".xml"; }	else{ $ext_name[0] = ".csv"; }	for($i in $ext_name)	{		string $out_text = "";		$filename2 = $filepath + $filename + $i;		$fileId=`fopen $filename2 "w"`;		if($i == ".csv")		{			$out_text = s000192_EoJ_exp_list_format($filename, $chk_sort);		}		else		{			$out_text = s000192_EoJ_exp_list_format_xml($filename, $chk_sort);		}		fprint $fileId $out_text;		fclose $fileId;	}}