global proc s000192_EoJ_re_anim_create_tex_size_plane(){	string $mtl_name = `textFieldButtonGrp -q -ann sel_node2`;	string $node_name = `textFieldButtonGrp -q -tx sel_node2`;	int $div_u = `intField -q -v div_u2`;	int $div_v = `intField -q -v div_v2`;	$re_anim = s000192_EoJ_set_anim_create_tex_size_plane($mtl_name, $node_name, $div_u, $div_v);}global proc s000192_EoJ_check_node_create_tex_size_plane(){	$sel_node_n = `ls -sl -l`;	int $chk_sel = 0;	if(`size $sel_node_n` == 1)	{		$sel_node_t = `nodeType $sel_node_n[0]`;		if($sel_node_t == "transform")		{			$shape_node = `listRelatives -s $sel_node_n[0]`;			if(`objectType $shape_node[0]` == "mesh")			{				string $sel_node = `textFieldButtonGrp -e -tx $sel_node_n[0] sel_node2`;					$sel_shape = `listRelatives -s $sel_node_n[0]`;				string $mtl_name[] = {};				$sg_name = `connectionInfo -dfs ($sel_shape[0] + ".instObjGroups[0]")`;				string $sg_name2 = $sg_name[0];				tokenize $sg_name2 "." $mtl_name;				string $mat_name = `connectionInfo -sfd ($mtl_name[0] + ".surfaceShader")`;				tokenize $mat_name "." $mtl_name;				string $sel_node = `textFieldButtonGrp -e -ann $mtl_name[0] sel_node2`;				string $file_name = `connectionInfo -sfd ($mtl_name[0] + ".color")`;				tokenize $file_name "." $mtl_name;				$tex_name = `getAttr ($mtl_name[0] + ".fileTextureName")`;					$pic_list_array = `textScrollList -e -ra pic_list2`;				$pic_list = `textScrollList -e -a (basename($tex_name, "")) pic_list2`;				string $now_path2 = `text -e -l (dirname($tex_name)) now_path2_2`;			}			$chk_sel = 1;		}	}	if($chk_sel == 0)	{		string $sel_node = `textFieldButtonGrp -e -tx "" sel_node2`;		$err_list = `confirmDialog -t "Error" -m "Select One Node(polygon)" -b "Close" -cb "Close" -ds "Close"`; 	}}//view image (tm2 format). w-click left listglobal proc s000192_EoJ_viewimage_create_tex_size_plane(){	$pic_list = `textScrollList -q -si pic_list2`;	string $now_path2 = `text -q -l now_path2_2`;	$view_img = ($now_path2 + "/" + $pic_list[0]);	string $tm2_size[] = {};	$inf_tm2 = system("D:/EOJPSP/tools/toro_tools/toroconv -res " + $view_img);	tokenize $inf_tm2 " " $tm2_size;	int $img_w = $tm2_size[0];	int $img_h = $tm2_size[1];		$view_window = "s000192_EoJ_View_window";		if (`window -exists $view_window`) deleteUI $view_window;		window $view_window;		columnLayout;		image -w $img_w -h $img_h -image $view_img;		string $close_btn = `button -w 80 -l "Close" -c "deleteUI -window s000192_EoJ_View_window"`;	showWindow $view_window;		window -e -wh $img_w ($img_h + 50) $view_window;}global proc s000192_EoJ_set_dir_create_tex_size_plane(string $path, string $fileType){	string $now_path2 = `text -e -l $path now_path2_2`;	workspace -dir $path;	string $tex_name[] = {};	string $tex_name_sort[] = {};	$tex_name_tm2 = `getFileList -fld ($path + "/") -fs "*.tm2"`;	appendStringArray ($tex_name, $tex_name_tm2, (`size $tex_name_tm2`));	$tex_name_sort = `sort $tex_name`;	string $tex_list = `textScrollList -e -ra tex_list2`;	for($i in $tex_name_sort)	{		string $tex_list = `textScrollList -e -a $i tex_list2`;	}}proc int s000192_EoJ_set_anim_create_tex_size_plane(string $mtl_name, string $node_name, int $div_u, int $div_v){	int $key = 0;	int $chk_index = 0;	int $no_create = `intField -q -v no_create2`;	int $anim_step = `intField -q -v anim_step2`;	string $div_name[] = {};	string $file_tex = `connectionInfo -sfd ($mtl_name + ".color")`;	tokenize $file_tex "." $div_name;	string $place_name = `connectionInfo -sfd ($div_name[0] + ".offsetU")`;	tokenize $place_name "." $div_name;	if(`keyframe -q -kc ($div_name[0] + ".ofu")` != 0)	{cutKey -t ":" -f ":" -at "ofu" $div_name[0];}	if(`keyframe -q -kc ($div_name[0] + ".ofv")` != 0)	{cutKey -t ":" -f ":" -at "ofv" $div_name[0];}	for($i = 0; $i < $div_v; $i++)	{		for($j = 0; $j < $div_u; $j++)		{			if($chk_index < ($div_u * $div_v - $no_create))			{								setKeyframe -t $key -v ((1.0/$div_u)*$j) ($div_name[0] + ".ofu");				setKeyframe -t $key -v ((-1.0/$div_v)*$i) ($div_name[0] + ".ofv");			}			$key += $anim_step;			$chk_index++;		}	}	keyTangent -ott step ($div_name[0] + ".ofu");	keyTangent -ott step ($div_name[0] + ".ofv");	setInfinity -poi cycle ($div_name[0] + ".ofu");	setInfinity -poi cycle ($div_name[0] + ".ofv");	int $last_key_index = `keyframe -q -kc ($div_name[0] + ".ofu")`;	$last_key_frame = `keyframe -in ($last_key_index - 1) -q -tc ($div_name[0] + ".ofu")`;	$last_u_value = `keyframe -t $last_key_frame[0] -q -vc ($div_name[0] + ".ofu")`;	$last_v_value = `keyframe -t $last_key_frame[0] -q -vc ($div_name[0] + ".ofv")`;	setKeyframe -t ($last_key_frame[0] + $anim_step - 1) -v $last_u_value[0] ($div_name[0] + ".ofu");	setKeyframe -t ($last_key_frame[0] + $anim_step - 1) -v $last_v_value[0] ($div_name[0] + ".ofv");	playbackOptions -min 0 -max ($last_key_frame[0] + $anim_step - 1) -ast 0 -aet ($last_key_frame[0] + $anim_step - 1);	return 1;}proc string s000192_EoJ_make_mtl_create_tex_size_plane(string $tex_name, string $geo_name) {	$shd_n = `shadingNode -asShader lambert`;	$shd_SG_n = `sets -renderable true -noSurfaceShader true -empty -name ($shd_n + "SG")`;	connectAttr -f ($shd_n + ".outColor") ($shd_SG_n + ".surfaceShader");	$shd_Tex_n = `shadingNode -asTexture file`;	$shd_P2T_n = `shadingNode -asUtility place2dTexture`;	connectAttr -f ($shd_P2T_n + ".coverage") ($shd_Tex_n + ".coverage");	connectAttr -f ($shd_P2T_n + ".translateFrame") ($shd_Tex_n + ".translateFrame");	connectAttr -f ($shd_P2T_n + ".rotateFrame") ($shd_Tex_n + ".rotateFrame");	connectAttr -f ($shd_P2T_n + ".mirrorU") ($shd_Tex_n + ".mirrorU");	connectAttr -f ($shd_P2T_n + ".mirrorV") ($shd_Tex_n + ".mirrorV");	connectAttr -f ($shd_P2T_n + ".stagger") ($shd_Tex_n + ".stagger");	connectAttr -f ($shd_P2T_n + ".wrapU") ($shd_Tex_n + ".wrapU");	connectAttr -f ($shd_P2T_n + ".wrapV") ($shd_Tex_n + ".wrapV");	connectAttr -f ($shd_P2T_n + ".repeatUV") ($shd_Tex_n + ".repeatUV");	connectAttr -f ($shd_P2T_n + ".offset") ($shd_Tex_n + ".offset");	connectAttr -f ($shd_P2T_n + ".rotateUV") ($shd_Tex_n + ".rotateUV");	connectAttr -f ($shd_P2T_n + ".noiseUV") ($shd_Tex_n + ".noiseUV");	connectAttr -f ($shd_P2T_n + ".vertexUvOne") ($shd_Tex_n + ".vertexUvOne");	connectAttr -f ($shd_P2T_n + ".vertexUvTwo") ($shd_Tex_n + ".vertexUvTwo");	connectAttr -f ($shd_P2T_n + ".vertexUvThree") ($shd_Tex_n + ".vertexUvThree");	connectAttr -f ($shd_P2T_n + ".vertexCameraOne") ($shd_Tex_n + ".vertexCameraOne");	connectAttr ($shd_P2T_n + ".outUV") ($shd_Tex_n + ".uv");	connectAttr ($shd_P2T_n + ".outUvFilterSize") ($shd_Tex_n + ".uvFilterSize");	updateBinMembershipAfterConnection $shd_Tex_n;	connectAttr -force ($shd_Tex_n + ".outColor") ($shd_n + ".color");	setAttr ($shd_Tex_n + ".fileTextureName") -typ "string" $tex_name;	if(`getAttr ($shd_Tex_n + ".fileHasAlpha")` == 1)	{		connectAttr -force ($shd_Tex_n + ".outTransparency") ($shd_n + ".transparency");	}	updateBinMembershipAfterConnection $shd_Tex_n;	if(`window -ex hyperShadePanel1Window` == 1)	{		window -e -restoreCommand "refreshHyperShadePaneFrontTab firstPaneTabs false;" hyperShadePanel1Window;		//refresh hypershade	}	select -cl;	select $geo_name;	sets -e -fe $shd_SG_n;	return $shd_n;}global proc s000192_EoJ_plane_create_tex_size_plane(){	$tool_path = "D:/EOJPSP/tools/toro_tools/";	int $pic_list_v = `textScrollList -q -ni pic_list2`;	int $div_u = `intField -q -v div_u2`;	int $div_v = `intField -q -v div_v2`;	if( $pic_list_v != 0)	{		string $now_path2 = `text -q -l now_path2_2`;		string $pic_list_array[] = {};		string $err_pic_list = "";		$pic_list_array = `textScrollList -q -ai pic_list2`;		for($i in $pic_list_array)		{			string $pic_tex_size[] = {};			if(`filetest -f ($now_path2 + "/" + $i)` == 1)			{				$pic_tex_info = `system($tool_path + "toroconv -res " + $now_path2 + "/" + $i)`;				tokenize $pic_tex_info " " $pic_tex_size;				int $pic_tex_size0 = $pic_tex_size[0];				int $pic_tex_size1 = $pic_tex_size[1];				int $p_width = ($pic_tex_size0 / $div_u);				int $p_height = ($pic_tex_size1 / $div_v);				$geo_name = `polyCreateFacet -ch 0 -tx 2 -s 1 -p ($p_width/2*(-1)) ($p_height/2*(-1)) 0 -p ($p_width/2) ($p_height/2*(-1)) 0 -p ($p_width/2) ($p_height/2) 0 -p ($p_width/2*(-1)) ($p_height/2) 0`;				$mtl_name = s000192_EoJ_make_mtl_create_tex_size_plane(($now_path2 + "/" + $i), $geo_name[0]);				$new_name = basename($i, ".tm2");				$node_name = `rename $geo_name ($new_name)`;				select -r ($node_name + ".map[2]");				polyEditUV -r 0 -u (1.0/$div_u) -v 1;				select -r ($node_name + ".map[1]");				polyEditUV -r 0 -u (1.0/$div_u) -v (1.0 - 1.0/$div_u);				select -r ($node_name + ".map[0]");				polyEditUV -r 0 -u 0 -v (1.0 - 1.0/$div_u);				select -cl;				s000192_EoJ_set_anim_create_tex_size_plane($mtl_name, $node_name, $div_u, $div_v);			}			else { $err_pic_list = $err_pic_list + $i + "\n"; }		}		if( `size $err_pic_list` != 0)		{ $err_list = `confirmDialog -t "NotFound" -m $err_pic_list -b "Close" -cb "Close" -ds "Close"`; }	}}//left list clearglobal proc s000192_EoJ_clear_create_tex_size_plane(){	string $pic_list_array[] = {};	$pic_list_array = `textScrollList -q -si pic_list2`;	if(`size $pic_list_array` != 0)	{		for($i in $pic_list_array)		{			string $pic_list = `textScrollList -e -ri $i pic_list2`;		}	}}//list up right to leftglobal proc s000192_EoJ_move_create_tex_size_plane(){	string $tex_list_array[] = {};	string $pic_list_array[] = {};	string $diff_list_array[] = {};	$tex_list_array = `textScrollList -q -si tex_list2`;	$pic_list_array = `textScrollList -q -ai pic_list2`;	$diff_list_array = stringArrayRemove($pic_list_array, $tex_list_array);	for($i in $diff_list_array)	{		string $pic_list = `textScrollList -e -a $i pic_list2`;	}}global proc s000192_EoJ_create_tex_size_plane() {	$window = "s000192_EoJ_CreateTextureSizePlane_window";	if (`window -exists $window`) deleteUI $window;	window $window;	$form = `formLayout`;	string $now_path = `workspace -q -rd`;	workspace -dir $now_path;	string $tex_path = "fileBrowser \"s000192_EoJ_set_dir_create_tex_size_plane\" \"\" \"\" 4";	string $now_path2 = `text -en 0 -l $now_path now_path2_2`;	string $tex_list = `textScrollList -w 200 -h 100 -ams true tex_list2`;	string $tr_btn = `button -w 30 -l ">>>" -c s000192_EoJ_move_create_tex_size_plane`;	string $pic_list = `textScrollList -w 200 -h 100 -ams true -dcc "s000192_EoJ_viewimage_create_tex_size_plane " pic_list2`;	string $div_u_l = `text -l "U divide"`;	string $div_u = `intField -w 50 -min 1 -max 10 -s 1 -v 1 div_u2`;	string $div_v_l = `text -l "V divide"`;	string $div_v = `intField -w 50 -min 1 -max 10 -s 1 -v 1 div_v2`;	string $no_create_l = `text -l "No Create Num from tail"`;	string $no_create = `intField -w 50 -min 0 -max 10 -s 1 -v 0 no_create2`;	string $anim_step_l = `text -l "Step Anim Frame"`;	string $anim_step = `intField -w 50 -min 1 -max 10 -s 1 -v 1 anim_step2`;	string $sep02 = `separator`;	string $label01 = `text -l "Edit UV Animation step"`;	string $sel_node = `textFieldButtonGrp -bl "<- list one Node" -cw 1 130 -cw 2 110 -ct2 "both" "both" -co2 0 10 -bc "s000192_EoJ_check_node_create_tex_size_plane" sel_node2`;	string $new_step_b = `button -w 120 -l "Make New Step Anim" -c "s000192_EoJ_re_anim_create_tex_size_plane"`;	string $sep01 = `separator`;	string $rt_btn = `button -w 80 -l "Read Tex" -c $tex_path`;	string $cl_btn = `button -w 80 -l "Select Clear" -c s000192_EoJ_clear_create_tex_size_plane`;	string $mg_btn = `button -w 80 -l "Make Geo" -c s000192_EoJ_plane_create_tex_size_plane`;	string $close_btn = `button -w 80 -l "Close" -c "deleteUI -window s000192_EoJ_CreateTextureSizePlane_window"`;	$o = 5; $o2 = 20; $o3 = 100; $o4 = 10;	formLayout -e 		-af $now_path2 "top" $o		-ac $tex_list "top" $o $now_path2 -af $tex_list "left" $o		-ac $tr_btn "top" 50 $now_path2 -ac $tr_btn "left" $o $tex_list		-ac $pic_list "top" $o $now_path2 -ac $pic_list "left" $o $tr_btn		-ac $div_u_l "top" 10 $tex_list -af $div_u_l "left" 190		-ac $div_u "top" $o $tex_list -ac $div_u "left" $o $div_u_l		-ac $div_v_l "top" 10 $tex_list -ac $div_v_l "left" 64 $div_u		-ac $div_v "top" $o $tex_list -ac $div_v "left" $o $div_v_l		-ac $no_create_l "top" 10 $div_u_l -af $no_create_l "left" 113		-ac $no_create "top" $o $div_u_l -ac $no_create "left" $o $no_create_l		-ac $anim_step_l "top" 10 $div_u_l -ac $anim_step_l "left" $o2 $no_create		-ac $anim_step "top" $o $div_u_l -ac $anim_step "left" $o $anim_step_l		-ac $sep02 "top" $o $no_create_l -af $sep02 "left" $o -af $sep02 "right" $o		-ac $label01 "top" $o $sep02 -af $label01 "left" $o		-ac $sel_node "top" $o $label01 -af $sel_node "left" $o		-ac $new_step_b "top" $o $label01 -af $new_step_b "right" $o		-ac $sep01 "top" $o $sel_node -af $sep01 "left" $o -af $sep01 "right" $o		-ac $rt_btn "top" $o $sep01 -af $rt_btn "left" $o		-ac $cl_btn "top" $o $sep01 -ac $cl_btn "left" $o2 $rt_btn		-ac $mg_btn "top" $o $sep01 -ac $mg_btn "left" $o $tr_btn		-ac $close_btn "top" $o $sep01 -af $close_btn "right" $o		$form;	showWindow ;}