global proc float MS_distance(string $target_a,string $target_b){
	
	float $a[] = `xform -q -ws -t $target_a`;
	float $b[] = `xform -q -ws -t $target_b`;
	//2点間の移動距離を計算
	float $len = sqrt(($a[0]-$b[0])*($a[0]-$b[0])+($a[1]-$b[1])*($a[1]-$b[1])+($a[2]-$b[2])*($a[2]-$b[2]));
	
	return $len;
	
}


global proc MS_spaceLocatorBySceneName(){
	//シーン名の付いたロケーターを作成
	string $obj[]=`ls -typ transform -sl`;
	
	$loc=`spaceLocator`;
	$newname=`file -q -ns`;
	if(size($obj)){
		parent $obj $loc;
	}
	rename $loc $newname;
}



global proc MS_constraint(
	int $point,
	string $point_option,
	int $aim,
	int $orient,
	string $orient_option,
	int $scale,
	int $parent,
	int $geometry,
	int $normal,
	int $tangent,
	int $poleVector,
	string $target[],
	string $obj[])
{
	
	for($each in $obj){
		
		if($point){
			string $option=stringArrayToString($target," ");
			eval("pointConstraint -w 1.0 -o 0 0 0 "+$point_option+" "+$option+" "+$each+";");
		}
		
		if($aim)
		aimConstraint -offset 0 0 0 -weight 1 -aimVector 0 1 0 -upVector 0 1 0 -worldUpType "vector" $target $each;
		
		if($orient){
			string $option=stringArrayToString($target," ");
			eval("orientConstraint -offset 0 0 0 "+$orient_option+" -weight 1 "+$option+" "+$each+";");
		}
		
		if($scale)
		scaleConstraint -offset 1 1 1 -weight 1 $target $each;
		
		if($parent)
		parentConstraint -mo -weight 1 $target $each;
		
		
		if($geometry)
		geometryConstraint -weight 1 $target $each;
		
		if($normal)
		normalConstraint -weight 1 -aimVector 0 1 0 -upVector 0 1 0 -worldUpType "vector" -worldUpVector 0 1 0 $target $each;
		
		if($tangent)
		tangentConstraint -weight 1 -aimVector 0 1 0 -upVector 0 1 0 -worldUpType "vector" -worldUpVector 0 1 0 $target $each;
		
		if($poleVector)
		poleVectorConstraint -weight 1 $target $each;
		
	}
	select -r $obj;
}


global proc string[] MS_constraintMaster_nearestObject(string $sourceObj[],string $distObj){
	//要MS_distance
	string $sourceObj[]=`ls -typ transform`;
	string $entryObj[]=stringArrayRemove ({$distObj},$sourceObj);
	string $dists[];
	
	$i=0;
	for($each in $entryObj){
		float $ftemp=`MS_distance $distObj $each`;
		$dists[$i]=((1000000+$ftemp)+"<>"+$each);
		$i++;
	}
	string $result[]=`sort $dists`;
	
	string $final[];
	$j=0;
	for($each in $result){
		string $stemp[];
		tokenize($each,"<>",$stemp);
		$final[$j]=$stemp[1];
		$j++;
	}
	return $final;
}


global proc MS_createLocatorwithConstraint(){
	string $strtgt=`textFieldGrp -q -text TFGTgt`;

	string $target[];

	tokenize ($strtgt,$target);
	
	
	int $pointSeaparate=`checkBox -q -v "pointSeparate"   `;
	
	string $newArray[];
	
	int $i=0;
	
	
	
	if($pointSeaparate){
		for($each in $target){
			float $pos[]=`xform -q -ws -t $each`;
			string $tmp[]=`spaceLocator`;
			xform -ws -t $pos[0] $pos[1] $pos[2] $tmp[0];
			$newArray[$i]=$tmp[0];
			MS_constraint_exec ({$each},{$tmp[0]});
			$i++;
		}
	}else{
		string $tmp[]=`spaceLocator `;
		MS_constraint_exec ($target,{$tmp[0]});
	}
	select -r $newArray;

}



global proc MS_deleteConstraint(){
	string $obj[]=`ls -sl`;
	for($each in $obj){
		
		if (`checkBox -q -v "point"          `){
			string $connect[]=`listConnections -t pointConstraint $each`;
			if ($connect[0]!="")
			delete $connect[0];
		}
		
		if (`checkBox -q -v "aim"       `){
			string $connect[]=`listConnections -t aimConstraint $each`;
			if ($connect[0]!="")
			delete $connect[0];
		}
		
		if (`checkBox -q -v "orient"        `){
			string $connect[]=`listConnections -t orientConstraint $each`;
			if ($connect[0]!="")
			delete $connect[0];
		}
		
		if (`checkBox -q -v "scale"          `){
			string $connect[]=`listConnections -t scaleConstraint $each`;
			if ($connect[0]!="")
			delete $connect[0];
		}
		
		if (`checkBox -q -v "parent"       `){
			string $connect[]=`listConnections -t parentConstraint $each`;
			if ($connect[0]!="")
			delete $connect[0];
		}
		
		if (`checkBox -q -v "geometry"     `){
			string $connect[]=`listConnections -t geometryConstraint $each`;
			if ($connect[0]!="")
			delete $connect[0];
		}
		
		if (`checkBox -q -v "normal"       `){
			string $connect[]=`listConnections -t normalConstraint $each`;
			if ($connect[0]!="")
			delete $connect[0];
		}
		
		if (`checkBox -q -v "tangent"      `){
			string $connect[]=`listConnections -t tangentConstraint $each`;
			if ($connect[0]!="")
			delete $connect[0];
		}
		
		if (`checkBox -q -v "poleVector"   `){
			string $connect[]=`listConnections -t poleVectorConstraint $each`;
			if ($connect[0]!="")
			delete $connect[0];
		}
	}
	
}


global proc MS_deleteUnconnectExpression(string $type){

	//$typeにコネクションがないexpressionノードを削除

	string $exp[]=`ls -typ expression`;
	for($each in $exp){
		string $connect[]=`listConnections -t $type $each`;
		if ((size($connect))==0){delete $each;}
	print (size($connect));
	}

}



global proc MS_locatorToComponentsV2_core()
{
	float $center[3];

	// Assert that the user has selected one or more polymesh components	
	string $meshComponents[] = `filterExpand -sm 31 -sm 32 -sm 34`;

	// Get shape nodes for selected items
	string $selectedNodes[] = `selectedNodes`;
	
	if ( size($meshComponents) && size($selectedNodes) )
	{
		float $bbox[5] = `polyEvaluate -bc`;
		
		$center[0] = ( ($bbox[0]/2) + ($bbox[1]/2) ) ;
		$center[1] = ( ($bbox[2]/2) + ($bbox[3]/2) ) ;
		$center[2] = ( ($bbox[4]/2) + ($bbox[5]/2) ) ;
		
		$locatername=`spaceLocator -p 0 0 0`;
		move -wd $center[0] $center[1] $center[2] $locatername;
		//spaceLocator -p $center[0] $center[1] $center[2];
	}
}

global proc MS_pivotToComponents_core()
{
	string $name[]=`ls -o -hl`;
	float $center[3];

	// Assert that the user has selected one or more polymesh components	
	string $meshComponents[] = `filterExpand -sm 31 -sm 32 -sm 34`;

	// Get shape nodes for selected items
	string $selectedNodes[] = `selectedNodes`;
	
	if ( size($meshComponents) && size($selectedNodes) )
	{
		float $bbox[5] = `polyEvaluate -bc`;
		
		
		$center[0] = ( ($bbox[0]+$bbox[1]) /2 ) ;
		$center[1] = ( ($bbox[2]+$bbox[3]) /2 ) ;
		$center[2] = ( ($bbox[4]+$bbox[5]) /2 ) ;
		
		
		xform -ws -piv $center[0] $center[1] $center[2] $name[0];
	}
}


global proc MS_duplicateToLocater()
{
	
	string $obj_name[]=`ls -sl`;
	
	$i=0;
	
	for ($i=1;$i<size($obj_name);$i++)
	{
		string $obj_tx=$obj_name[$i]+".tx";
		string $obj_ty=$obj_name[$i]+".ty";
		string $obj_tz=$obj_name[$i]+".tz";
		
		float $val_tx=`getAttr $obj_tx`;
		float $val_ty=`getAttr $obj_ty`;
		float $val_tz=`getAttr $obj_tz`;
		
		duplicate -n "MS_duplicateToLocater_xxxx" $obj_name[0];
		align -atl -x Mid -y Mid -z Mid "MS_duplicateToLocater_xxxx" $obj_name[$i];
		delete $obj_name[$i];
		rename "MS_duplicateToLocater_xxxx" "MS_duplicateToLocater_0000";
		
	}
}


global proc MS_splitTwoPointConstraintLocator(int $split){
	
	int $xxx=$split+1;
	
	string $objz[]=`ls -sl` ;
	
	for ($i=1;$i<$xxx;$i++){
		string $newloc[]=`spaceLocator`;
		
		pointConstraint -w ($i) $objz[0] $newloc[0];
		pointConstraint -w ($xxx-$i) $objz[1] $newloc[0];
		
		rename $newloc[0] "MS_splitTwoPointConstraintLocator";
	}

}



global proc MS_vertexpointConstraint(string $src[],string $dist){
	
	string $a;
	$a=($a+"{\n");
	
	string $obj=stringArrayToString($src,"\",\"");
	
	$a=($a+"string $objz[]={\""+$obj+"\"};\n");
	$a=($a+"float $totalX=0;\n");
	$a=($a+"float $totalY=0;\n");
	$a=($a+"float $totalZ=0;\n");
	
	//ボリューム中心検出
	$a=($a+"for ($each in $objz){\n");
			
	$a=($a+"vector $location=`xform -q -ws -t $each`;\n");

	$a=($a+"$totalX=$totalX+($location.x);\n");
	$a=($a+"$totalY=$totalY+($location.y);\n");
	$a=($a+"$totalZ=$totalZ+($location.z);\n");
			
	$a=($a+"}\n");

	$a=($a+"//xform -ws -t ($totalX/size($objz)) ($totalY/size($objz)) ($totalZ/size($objz)) "+$dist+";\n");
	
	$a=($a+$dist+".translateX=($totalX/size($objz));\n");
	$a=($a+$dist+".translateY=($totalY/size($objz));\n");
	$a=($a+$dist+".translateZ=($totalZ/size($objz));\n");
	
	$a=($a+"}\n");
	
	print $a;
	expression -n "MS_vertexpointConstraint_Expression"-o $dist -s $a;
}



global proc MS_constraintNearest(){
	
	string $obj[]=`ls -typ transform -sl`;
	
	string $strtgt=`textFieldGrp -q -text TFGTgt`;
	string $target[];
	tokenize ($strtgt,$target);
	
	for($each in $obj){
		string $dist[]=`MS_constraintMaster_nearestObject $target $each`;
		print ($dist[0]+"\n");
		MS_constraint_exec {$dist[0]} {$each};
	
	}
	
}


global proc MS_splitTwoPointConstraintLocator_pipe(){
	int $split=`intSliderGrp -q -v "split"`;
	MS_splitTwoPointConstraintLocator $split;
	
}

global proc string MS_constraint_exec(string $target[],string $obj[]){
	int $point     =`checkBox -q -v "point"        `;
	string $point_option;
	if(!`checkBox -q -v "px"`){$point_option="-sk x ";}
	if(!`checkBox -q -v "py"`){$point_option=($point_option+"-sk y ");}
	if(!`checkBox -q -v "pz"`){$point_option=($point_option+"-sk z ");}
	
	int $aim       =`checkBox -q -v "aim"          `;
	
	int $orient    =`checkBox -q -v "orient"       `;
	string $orient_option;
	if(!`checkBox -q -v "ox"`){$orient_option="-sk x ";}
	if(!`checkBox -q -v "oy"`){$orient_option=($orient_option+"-sk y ");}
	if(!`checkBox -q -v "oz"`){$orient_option=($orient_option+"-sk z ");}
	
	int $scale     =`checkBox -q -v "scale"        `;
	int $parent    =`checkBox -q -v "parent"       `;
	int $geometry  =`checkBox -q -v "geometry"     `;
	int $normal    =`checkBox -q -v "normal"       `;
	int $tangent   =`checkBox -q -v "tangent"      `;
	int $poleVector=`checkBox -q -v "poleVector"   `;
	
	string $targets=stringArrayToString($target,"\",\"");
	string $objs=stringArrayToString($obj,"\",\"");
	

	string $command=("MS_constraint ("+$point+",\""+$point_option+"\","+$aim+","+$orient+",\""+$orient_option+"\","+$scale+","+$parent+","+$geometry+","+$normal+","+$tangent+","+$poleVector+","+"{\""+$targets+"\"},{\""+$objs+"\"})");
	
	eval $command;
	
	return $command;
}


global proc MS_constraintMasterUI_pipe(){
	
	string $strtgt=`textFieldGrp -q -text TFGTgt`;
	string $target[];
	tokenize ($strtgt,$target);
	
	string $obj[]=`ls -typ transform -sl`;
	
	
	MS_constraint_exec $target $obj;
	
}


global proc MS_vertexpointConstraint_pipe(){
	
	
	string $strtgt=`textFieldGrp -q -text TFGTgt`;
	string $target[];
	tokenize ($strtgt,$target);
	
	string $obj[]=`ls -typ transform -sl`;
	
	
	for ($each in $obj){
	MS_vertexpointConstraint $target $each;
	}
}

//ClickTragetList-------------------------------------------
global proc ClickTargetList(){
	string $objz[] = `ls -typ transform -sl`;
	
	string $fexz[] =`filterExpand -sm 31 -sm 32 -sm 34 -sm 46 -sm 28 `;
	
	string $objzstr=stringArrayToString($objz," ");
	string $fexzstr=stringArrayToString($fexz," ");
	
	textFieldGrp -e -tx ($objzstr+" "+$fexzstr) TFGTgt;
	
}


