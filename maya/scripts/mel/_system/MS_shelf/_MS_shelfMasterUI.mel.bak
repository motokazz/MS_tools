
global proc MS_shelfMasterUI(){
	
	string $command;
	int $nShelves = `optionVar -q numShelves`;
	
	if ((`window -ex MS_shelfMasterUI`) == true	) {deleteUI MS_shelfMasterUI;};
	window -mb true -t "MS_shelfMasterUI" -iconName "MS_shelfMasterUI" MS_shelfMasterUI;
	
	columnLayout;
	
	
	//shelf選択フォーム作成。
	$command="int $val[];int $j=0;\n";
	for ($i=1;$i<=$nShelves;$i++){
		string $shelfName = `optionVar -q ("shelfName" + $i)`;
		string $shelfFile = `optionVar -q ("shelfFile" + $i)`;
		checkBox -l $shelfName ("chk"+$i);
		$command=$command+"if (`checkBox -q -v "+("chk"+$i)+"`){$val[$j]="+$i+";$j++;}\n";
		
	}
	
	//shelfWindow作成
	separator -w 200;
	button -l "MS_shelfWindow" -c ($command+"MS_shelf $val;clear $val;\n") ;
	
	//shelfButton作成
	separator -w 200;
	textFieldGrp -l "shelfButtonName" shelfName;//shelfButtopnのラベル名入力
	button -l "createShelfButton" -c ($command+"MS_createShelfButton $val `textFieldGrp -q -tx shelfName`;clear $val;\n");
	
	setParent ..;
	
	showWindow MS_shelfMasterUI;
	
}

MS_shelfMasterUI;