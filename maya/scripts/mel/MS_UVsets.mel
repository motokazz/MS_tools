global proc MS_createUVset()
{

	string $MS_createUVset=`textFieldButtonGrp -q -text MS_createUVset`;
	
	string $obj_name[] = `ls -sl`;
	
	int $i=0;
	
	for($i=0;$i<size($obj_name);$i++){
		select -r $obj_name[$i];
		int $j=0;
		int $check=0;
		
		int $indices[] = `polyUVSet -q -allUVSetsIndices $obj_name[$i]`;
		
		for( $j in $indices )
		{
			
			string $uvname = `getAttr ($obj_name[$i]+".uvSet["+$j+"].uvSetName")`;
			
			print( "Found uv set called " + $uvname + "\n" );
			
			if($uvname==$MS_createUVset)
			{
				$check++;
			}
		
		}
		
		if($check != 0){
		
			polyUVSet -create -uvSet $MS_createUVset $obj_name[$i];
			
		}
		polyUVSet -currentUVSet -uvSet $MS_createUVset;
	}
	select -cl  ;
	changeSelectMode -object;
	select -r $obj_name;

}


global proc MS_deleteUVset()
{

	string $MS_deleteUVset=`textFieldButtonGrp -q -text MS_deleteUVset`;
	
	string $obj_name[] = `ls -sl`;
	
	int $i=0;
	
	for($i=0;$i<size($obj_name);$i++){
		select -r $obj_name[$i];
		int $j=0;
		int $check=0;
		
		int $indices[] = `polyUVSet -q -allUVSetsIndices $obj_name[$i]`;
		
		for( $j in $indices )
		{
			
			string $uvname = `getAttr ($obj_name[$i]+".uvSet["+$j+"].uvSetName")`;
			
			print( "Found uv set called " + $uvname + "\n" );
			
			if($uvname==$MS_deleteUVset)
			{
				$check++;
			}
		}
		
		if($check != 0){
		
			polyUVSet -delete -uvSet $MS_deleteUVset $obj_name[$i];
			
		}
		else
		{
			 MS_error;
		}
	}
	select -cl  ;
	changeSelectMode -object;
	select -r $obj_name;

}



global proc MS_createUVset()
{

	string $MS_createUVset=`textFieldButtonGrp -q -text MS_createUVset`;
	
	string $obj_name[] = `ls -sl`;
	
	int $i=0;
	
	for($i=0;$i<size($obj_name);$i++){
		select -r $obj_name[$i];
		int $j=0;
		int $check=0;
		
		int $indices[] = `polyUVSet -q -allUVSetsIndices $obj_name[$i]`;
		
		for( $j in $indices )
		{
			
			string $uvname = `getAttr ($obj_name[$i]+".uvSet["+$j+"].uvSetName")`;
			
			print( "Found uv set called " + $uvname + "\n" );
			
			if($uvname==$MS_createUVset)
			{
				$check++;
			}
		
		}
		
		if($check == 0){
		
			polyUVSet -create -uvSet $MS_createUVset $obj_name[$i];
			
		}
		
		polyUVSet -currentUVSet -uvSet $MS_createUVset;
	}

select -cl  ;
changeSelectMode -object;
select -r $obj_name;

}




global proc MS_createShadowUVset()
{

	string $MS_createShadowUVset=`textFieldButtonGrp -q -text MS_createShadowUVset`;
	
	string $obj_name[] = `ls -sl`;
	
	int $i=0;

	for($i=0;$i<size($obj_name);$i++){
		select -r $obj_name[$i];
		int $j=0;
		int $check=0;
		
		int $indices[] = `polyUVSet -q -allUVSetsIndices $obj_name[$i]`;
		
		for( $j in $indices )
		{
			
			string $uvname = `getAttr ($obj_name[$i]+".uvSet["+$j+"].uvSetName")`;
			
			print( "Found uv set called " + $uvname + "\n" );
			
			if($uvname==$MS_createShadowUVset)
			{
				$check++;
			}
		
		}
		
		if($check == 0){
		
			polyUVSet -create -uvSet $MS_createShadowUVset $obj_name[$i];
			
		}
		
		polyUVSet -currentUVSet -uvSet $MS_createShadowUVset;
		polyAutoProjection -pb 0 -ibd 1 -cm 0 -l 2 -sc 2 -o 1 -p 6 -ps 0.01 -ws 1 $obj_name[$i];
		
		selectMode -co;
		//setSelectMode components Components;
		selectType -smp 0 -sme 0 -smf 1 -smu 0 -pv 0 -pe 0 -pf 1 -puv 0;
		//select -cl;
		polySelectConstraint -pp 0;
		polySelectConstraint -va 100 ;
		polySelectConstraint -v true ;
		polySelectConstraint -m 3 ;

		invertSelection;
		DeleteUVs;

		resetPolySelectConstraint; 

		select -r $obj_name[$i];
		polyLayoutUV -l 2 -sc 2 -se 0 -rbf 1 -fr 1 -ps 0.001 -ch 0;
	}

select -cl  ;
changeSelectMode -object;
select -r $obj_name;

}



global proc MS_deleteLastUVset()
{
	polyUVSet -luv;
	polyUVSet -d;
}


