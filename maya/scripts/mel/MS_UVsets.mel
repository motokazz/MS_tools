global proc MS_UVsets_copyuvs()
{
	string $MS_UVsets_copyuvs_source=`textFieldGrp -q -text MS_UVsets_copyuvs_source`;
	string $MS_UVsets_copyuvs_dist=`textFieldButtonGrp -q -text MS_UVsets_copyuvs_dist`;
	
	string $obj_name[] = `ls -sl`;
	
	int $i=0;
	
	for($i=0;$i<size($obj_name);$i++){
		select -r $obj_name[$i];
		int $j=0;
		int $check=0;
		
		int $indices[] = `polyUVSet -q -allUVSetsIndices $obj_name[$i]`;
		
		for( $j in $indices )
		{
			
			string $uvname = `getAttr ($obj_name[$i]+".uvSet["+$j+"].uvSetName")`;
			
			print( "Found uv set called " + $uvname + "\n" );
			
			if($uvname==$MS_UVsets_copyuvs_dist)
			{
				$check++;
			}
			if($uvname==$MS_UVsets_copyuvs_source)
			{
				$check++;
			}
		
		}
		
		if($check == 2){
		
			polyCopyUV -uvSetNameInput $MS_UVsets_copyuvs_source -uvs $MS_UVsets_copyuvs_dist;
			
		}
		else
		{
			MS_error;
		}
	}

select -cl  ;
changeSelectMode -object;
select -r $obj_name;


}




global proc MS_UVsets()
{
	
	//Window Check
	if(`window -exists MS_UVsets`){
		deleteUI MS_UVsets;
	}
	
	
	//Create Window
	
	window -title "MS_UVsets" MS_UVsets;
	
	columnLayout ;
	
	//Contents	
	
	
	//text
	text -label "ThisWindowIsWindowFormatSample";
	
	
	
separator -w 600 -h 40 -st "single";
	
	
	
	
	
	textFieldButtonGrp 
		-l "createUV"
		-tx "map1"
		-buttonLabel "create" 
		-bc "MS_createUVset"
		MS_createUVset
	;
	
	textFieldButtonGrp 
		-l "deleteUV"
		-tx "map2"
		-buttonLabel "delete" 
		-bc "MS_deleteUVset"
		MS_deleteUVset
	;
	
separator -w 600 -h 40 -st "single";
	
	textFieldButtonGrp 
		-l "mapchange"
		-tx "map1"
		-buttonLabel "cange" 
		-bc "MS_UVsets_mapchange"
		MS_UVsets_mapchange
	;
	
	textFieldGrp 
		-l "source"
		-tx "map1"
		MS_UVsets_copyuvs_source
	;
	
	textFieldButtonGrp 
		-l "dist"
		-tx "map2"
		-buttonLabel "copy" 
		-bc "MS_UVsets_copyuvs"
		MS_UVsets_copyuvs_dist
	;


separator -w 600 -h 40 -st "single";
	
	textFieldButtonGrp 
		-l "createShadowUVset"
		-tx "map2"
		-buttonLabel "createShadowUVset" 
		-bc "MS_createShadowUVset"
		MS_createShadowUVset
		;
	
	button -l "MS_deleteLastUVset" -command "MS_deleteLastUVset";
	
	//---------------
	//Execute Buttons
	//---------------
separator -w 600 -h 40 -st "doubleDash";
	
	
	separator -w 600 -h 40 -st "double";
	
	button -l "undo" -command "Undo" ;
	
	button -l "exit" -command "deleteUI MS_UVsets" ;
	
	
	//Footer
	showWindow MS_UVsets;
	
}





