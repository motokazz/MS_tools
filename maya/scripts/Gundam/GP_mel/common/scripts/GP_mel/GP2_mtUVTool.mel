//GP2用・UVセットメンテナンス用ツール
//機能1
//不要なUVセットを持つメッシュや、UVセットが不足しているメッシュの警告を表示し、
//簡易的にデカール用UVセットの自動生成を行います。
//
//機能2
//マテリアル・レイヤーテクスチャの新規作成・２種のテクスチャファイル読み込みと、
//各ノード及びメッシュの接続作業を自動で行います。
//各テクスチャは、それぞれ決められた名前のUVセット(map1,map2)にリンクが行われます。
//
//20140408	UVはみ出し検出を追加
//20131121	新規作成、アイコン画像を使うので要注意

//マテリアル制作
global proc GP2_makeDefaultMaterial(string $colorTexture,string $decalTexture){
	//キャラID取得
	string $charaID;
	string $sceneName[] = `file -q -l -shn`;
	string $temp[];
	tokenize $sceneName[0] "." $temp;
	$charaID = $temp[0];

	string $matName = "mat_" + $charaID;
	shadingNode -asShader -n $matName phong;
	sets -renderable true -noSurfaceShader true -empty -name ($matName + "SG");
	connectAttr -f ($matName + ".outColor") ($matName + "SG.surfaceShader");

	string $texName = "layTex_" + $charaID;
	shadingNode -n $texName -asTexture layeredTexture;
	setAttr ($texName + ".inputs[0].color") -type "double3" 0.2 0.7 0.3;
	setAttr ($texName + ".inputs[0].alpha") 1;
	setAttr ($texName + ".inputs[0].blendMode") 1;
	setAttr ($texName + ".inputs[1].color") -type "double3" 0.2 0.7 0.3;
	setAttr ($texName + ".inputs[1].alpha") 1;
	setAttr ($texName + ".inputs[1].blendMode") 1;

	connectAttr -f ($texName + ".outColor") ( $matName + ".color");

	shadingNode -n "decalTexture" -asTexture file;
	shadingNode -n "decalTexture_p2dT" -asUtility place2dTexture;
	connectAttr -f decalTexture.outColor ($texName + ".inputs[0].color");
	setAttr -type "string" decalTexture.fileTextureName $decalTexture;

	shadingNode -n "colorTexture" -asTexture file;
	shadingNode -n "colorTexture_p2dT" -asUtility place2dTexture;
	connectAttr -f colorTexture.outColor ($texName + ".inputs[1].color");
	setAttr -type "string" colorTexture.fileTextureName $colorTexture;

	select -r -hi  parts;
	select -d parts partsShape;
	string $objList[] = `ls -sl -typ transform`;
	sets -e -forceElement ($matName + "SG");

	for($item in $objList){
		select -r $item;
		string $SN = mUVT_getShape($item);
		int $uvID = getuvSetNumber("map1");
		uvLink -make -uvSet ($SN + ".uvSet[" + $uvID + "].uvSetName") -texture colorTexture;
		int $uvID = getuvSetNumber("map2");
		uvLink -make -uvSet ($SN + ".uvSet[" + $uvID + "].uvSetName") -texture decalTexture;
	}
	GP2_MessageDialog ( "GP2_makeUVmap2forAllParts", {"作業が完了しました。","マテリアル・レイヤーテクスチャの作成及び、各UVセットへのリンクを行いました。","各UVセットの調整を行って下さい。"} );
}

global proc string mUVT_getShape(string $item){
	select -r -hi $item;
	string $temp[] = `ls -sl -typ shape`;
	string $res = $temp[0];
	select -r $item;
	return $res;
}


global proc int getuvSetNumber(string $tgt){
	string $tmpUVList[] = `polyUVSet -q -allUVSets`;
	for($i=0 ; $i<size($tmpUVList) ; $i++){
		if($tmpUVList[$i] == $tgt) break;
	}
	return $i;
}

//setup_UVmap2
global proc GP2_makeUV2forAllParts(){
	select -r -hi parts;
	select -d parts;
	string $objList[] = `ls -sl -typ transform`;
	string $tmpUVList[];

	for($item in $objList){
		select -r $item;
		string $tmpUVList[] = `polyUVSet -q -allUVSets` ;
		if( stringArrayContains("map2" , $tmpUVList) != 1 ){
			polyCopyUV -uvSetNameInput "map1" -uvSetName "map2" -createNewMap 1 -ch 1 ;
		}else{
			print ($item + " には既にmap2が存在するため、無視します。\r\n");
		}
		clear $tmpUVList;
	}
	GP2_MessageDialog ( "GP2_makeUVmap2forAllParts", {"作業が完了しました。","既にmap2が存在していたメッシュは変更されません。スクリプトエディタのログを確認してください。"} );
    GP2_mUVT_listRestore();
}

proc string[] checkUVSetSize_Lack(string $tgt , string $tmpUVList[] , string $lackList[]){
	if( size($tmpUVList) < 2 ){
		$lackList[size($lackList)] = $tgt;
	}
	return $lackList;
}

proc string[] checkUVSetSize_Surplus(string $tgt , string $tmpUVList[] , string $surplusList[]){
	if( size($tmpUVList) > 2 ){
		$surplusList[size($surplusList)] = $tgt;
	}
	return $surplusList;
}

proc string[] checkUVSetSize_badName(string $tgt , string $tmpUVList[] , string $badNameList[]){
	if( stringArrayContains("map2" , $tmpUVList) != 1 ){
		$badNameList[size($badNameList)] = $tgt;
	}
	return $badNameList;
}


global proc string[] GP2_scanUVsetStatus(){
	string $lackList[];		//GP2.UV調整用。UVセット不足ノードリスト
	string $surplusList[];	//GP2.UV調整用。UVセット余剰ノードリスト
	string $badNameList[];	//GP2.UV調整用。UVセット名不正ノードリスト
	select -r -hi parts;
	select -d parts;
	string $objList[] = `ls -sl -typ transform`;
	string $tmpUVList[];

	for($item in $objList){
		select -r $item;
		string $tmpUVList[] = `polyUVSet -q -allUVSets` ;
		$lackList = checkUVSetSize_Lack( $item , $tmpUVList , $lackList );
		$surplusList = checkUVSetSize_Surplus( $item , $tmpUVList , $surplusList );
		$badNameList = checkUVSetSize_badName( $item , $tmpUVList , $badNameList );
		clear $tmpUVList;
	}
	string $res[];
	if(size($lackList)){
		$res[size($res)] = "以下のメッシュにて、UVセットが1つしかありません。";
		$res = stringArrayCatenate($res , $lackList);
	}
	if(size($surplusList)){
		$res[size($res)] = "以下のメッシュにて、UVセットが3つ以上検出されました。";
		$res = stringArrayCatenate($res , $surplusList);
	}
	if(size($badNameList)){
		$res[size($res)] = "以下のメッシュにて、UVセット「map2」が検出できません。";
		$res = stringArrayCatenate($res , $badNameList);
	}
	return $res;
}





//GPMSPartUVChecker

//GPプロジェクトのモビルスーツのUVがエリアからはみ出ていないかチェックします。

//使用方法：
//パーツ分解まで終了したモビルスーツのシーンにこのスクリプトをドラッグ&ドロップすると、結果が表示されます。
//はみ出しがある場合は、はみ出しているパーツが選択されます。

//注意点：間違ったエリアにUVを配置している場合は検出出来ません。
//（例えば右腕のエリアに左腕のUVが収まっている場合など）


//-------------------------------------------------------------------------
global proc GPResultWindow(string$line1,string$line2,string$line3,string$line4,string$line5){
//リザルトウィンドウ
	string $windowTitle = "GPResultWindow";
	string $windowObjName = $windowTitle + "WindowObj";

	if(`window -ex  $windowObjName` == 1){
		deleteUI  $windowObjName;
	}

	window -t $windowTitle $windowObjName;
	columnLayout;
//--------------------------
	text -l $line1;
	text -l $line2;
	text -l $line3;
	text -l $line4;
	text -l $line5;
//--------------------------
//ウィンドウサイズを指定
	window -e -w 200 -h 150 $windowObjName;
	showWindow $windowObjName;
}
//--------------------------------------------------------------------------

//--------------------------------------------------------
proc int GPCheckUVAreaByObj(string$obj){
//GPプロジェクト用フォーマットにおいて、$objのUVがどのエリアに入っているかをチェックし、
//値を返します。

//下左が1、下中が2、下右が3、上左が4、上中が5、上右が6になります。
//はみ出しがあった場合は0が返ります。

//$objListからUVを取得し選択する

	select -cl;

	int $uvNumList[] = `polyEvaluate -uv $obj`;
	int $uvNum = $uvNumList[0] - 1;
	$uvNumString = (string)$uvNum;
	string $uvList = $obj + ".map[0:" + $uvNumString + "]";
	select -add $uvList;

//選択からバウンディングボックスを取得する
	float $uvArea[] = `polyEvaluate -bc2`;

//範囲を確認し結果を返す
	int $result = 0;

	if(($uvArea[2] >= 0.0) && ($uvArea[3] <= 0.5)){
		if(($uvArea[0] >= 0.0) && ($uvArea[1] <= 0.5)){
			$result = 1;
		}else if(($uvArea[0] >= 0.5) && ($uvArea[1] <= 0.75)){
			$result = 2;
		}/*else if(($uvArea[0] >= 0.625) && ($uvArea[1] <= 0.75)){
			$result = 3;
		}*/
	}else if(($uvArea[2] >= 0.5) && ($uvArea[3] <= 1.0)){
		if(($uvArea[0] >= 0.0) && ($uvArea[1] <= 0.25)){
			$result = 4;
		}else if(($uvArea[0] >= 0.25) && ($uvArea[1] <= 0.5)){
			$result = 5;
		}else if(($uvArea[0] >= 0.5) && ($uvArea[1] <= 0.75)){
			$result = 6;
		}
	}

	select -cl;
	return $result;
}


//--------------------------------------------------------
global proc GPMSPartsUVChecker(){
	string $list[] = `listRelatives -c -ad -pa -type "transform" "parts"`;
	string $item;
	string $resultList[];
	clear $resultList;
	int $i = 0;
	for($item in $list){
		int $check = `GPCheckUVAreaByObj $item`;
		if($check == 0){
			$resultList[$i] = $item;
			$i++;
		}
	}

	if(`size $resultList` == 0){
		select -cl;
		GPResultWindow "UVs are OK." "" "" "" "";
	}else{
		GPResultWindow "UVs are NG." "NG parts are selected." "" "" "";
		select $resultList;
	}
}







//UIwork

global proc GP2_mUVT_listRestore(){
	textScrollList -e -ra mUVT_stTS;
	string $obj[] = `ls`;
	if(stringArrayContains("parts",$obj)){
		string $temp[] = GP2_scanUVsetStatus();
		for($item in $temp){
			textScrollList -e -a $item mUVT_stTS;
		}
	}
}

global proc mUVT_stTSselcmd(){
	string $temp[] = `textScrollList -q -si mUVT_stTS`;
	string $obj[] = `ls`;
	if(stringArrayContains($temp[0],$obj)){
		select -r $temp[0];
	}
}

global proc mUVT_editTfData(string $accessedData){
	string $result[] = `fileDialog2 -cap "使用するテクスチャを指定してください。" -fileMode 1 -okc "set" -dialogStyle 0`;
    if($result[0] != "")	textFieldButtonGrp -e -text ($result[0]) $accessedData;
}

//UI基礎
global proc GP2_mtUVTool(){
	string $ut = ("source \"" + `getenv "GP_MAYA_ROOT"` + "\\\\common\\\\scripts\\\\GP_mel\\\\subscripts\\\\GP2_Ut.mel\"");
	eval $ut;
    string $windowName = "GP2_mainteUVToolWindow";
    if(`window -q -exists $windowName`){
        deleteUI -window $windowName;
    }
    window -h 200 -w 150 $windowName;
	string $form = `formLayout`;
	string $rsBtIcon = (`getenv "GP_MAYA_ROOT"` + "/common/scripts/GP_mel/bmp/GP2_mtUV_reload.bmp");

	string $tTTx = `text -l "モデルUV調整用ツール" -al "left" -font "boldLabelFont" mUVT_titleTXT`;
	string $tlET1 = `text -l "UVセットの状態をチェックし、UVセット「map2」が存在しないパーツに自動生成を行います。" -al "left" mUVT_explTXT1`;
	string $stTx = `text -label "■Error_Status"`;
	string $rsBt = `iconTextButton -c "GP2_mUVT_listRestore()" -ann "エラーメッセージを更新" -image $rsBtIcon`;
	string $stTS = `textScrollList -sc "mUVT_stTSselcmd()" -ann "UVセットの状態が適切でない場合、ここに表示されます。\r\nこのツールでの「不要UVセットの削除」は出来ませんので、\r\nUVセットエディタでの確認・削除を行って下さい。" mUVT_stTS`;
//	string $colLay = `columnLayout -w 600`;
		string $mkUV = `button -label "make_UVset [map2]" -c "GP2_makeUV2forAllParts()" -ann "parts以下の、UVセット「map2」を持たないメッシュに自動生成を行います。"`;
		string $sept = `separator  -hr 1 -h 3`;
		string $tlET2 = `text -l "指定したテクスチャを元にレイヤーテクスチャ・マテリアルを生成し、各UVセットにアサインします。" -al "left" mUVT_explTXT2`;
		string $ctTF = `textFieldButtonGrp -bc "mUVT_editTfData(\"mUVT_coTexTF\");" -adjustableColumn2 1 -tx "Color_texture_Path" -bl "set Color-Texture Path" mUVT_coTexTF`;
		string $dtTF = `textFieldButtonGrp -bc "mUVT_editTfData(\"mUVT_deTexTF\");" -adjustableColumn2 1 -tx "Decal_texture_Path" -bl "set Decal-Texture Path" mUVT_deTexTF`;
	string $mkMT = `button -label "make_Material + LayerTexture" -c "GP2_makeDefaultMaterial(`textFieldButtonGrp -q -tx mUVT_coTexTF`,`textFieldButtonGrp -q -tx mUVT_deTexTF`)" -ann "新たなマテリアル・レイヤーテクスチャを生成し、parts以下のメッシュに自動設定します。"`;

	string $sept2 = `separator  -hr 1 -h 3`;
	string $tlET3 = `text -l "UVのはみ出しを検出します。" -al "left" mUVT_explTXT3`;
	string $ckUV = `button -label "CheckUVArea" -c "GPMSPartsUVChecker()" -ann "UVのはみ出しを検出し、はみ出しているメッシュを選択します。"`;


//	setParent ..;
	formLayout -edit
		-attachForm $tTTx "top"    15
		-attachForm $tTTx "left"   15
		-attachNone $tTTx "bottom"
		-attachNone $tTTx "right"

		-attachControl $tlET1 "top"    15 $tTTx
		-attachForm $tlET1 "left"   15
		-attachNone $tlET1 "bottom"
		-attachNone $tlET1 "right"

		-attachControl $stTx "top"    1 $tlET1
		-attachForm $stTx "left"   15
		-attachNone $stTx "bottom"
		-attachNone $stTx "right"

		-attachControl $stTS "top"	5 $stTx
		-attachForm $stTS "left"   15
		-attachControl $stTS "bottom" 5 $mkUV
		-attachForm $stTS "right"  15

		-attachNone $rsBt "top"    
		-attachNone $rsBt "left"
		-attachControl $rsBt "bottom" 5 $stTS
		-attachForm $rsBt "right" 15

		-attachNone $mkUV "top"
		-attachForm $mkUV "left"   15
		-attachControl $mkUV "bottom" 15 $sept
		-attachForm $mkUV "right"  15

		-attachNone $sept "top"
		-attachForm $sept "left"   5
		-attachControl $sept "bottom" 15 $tlET2
		-attachForm $sept "right"  5

		-attachNone $tlET2 "top"
		-attachForm $tlET2 "left"   15
		-attachControl $tlET2 "bottom" 1 $ctTF
		-attachForm $tlET2 "right"  15

		-attachNone $ctTF "top"
		-attachForm $ctTF "left"   15
		-attachControl $ctTF "bottom" 1 $dtTF
		-attachForm $ctTF "right"  15

		-attachNone $dtTF "top"
		-attachForm $dtTF "left"   15
		-attachControl $dtTF "bottom" 1 $mkMT
		-attachForm $dtTF "right"  15

		-attachNone $mkMT "top"
		-attachForm $mkMT "left"   15
		-attachControl $mkMT "bottom" 15 $sept2
		-attachForm $mkMT "right"  15

		-attachNone $sept2 "top"
		-attachForm $sept2 "left"   15
		-attachControl $sept2 "bottom" 15 $tlET3
		-attachForm $sept2 "right"  15

		-attachNone $tlET3 "top"
		-attachForm $tlET3 "left"   15
		-attachControl $tlET3 "bottom" 1 $ckUV
		-attachForm $tlET3 "right"  15

		-attachNone $ckUV "top"
		-attachForm $ckUV "left"   15
		-attachForm $ckUV "bottom" 15
		-attachForm $ckUV "right"  15
	$form;
    GP2_mUVT_listRestore();
	showWindow $windowName;
}