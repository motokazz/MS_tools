//
//
//######################################################
//#               Pose_Selecter ver5.7                 #
//######################################################
//#                                                    #
//#                更新日：2014/05/23                  #
//#                作成者：杉山篤司                    #
//#                                                    #
//######################################################
//┌─────────────────────────┐
//│概要：                                            │
//│    ポーズの保存をするツールです。                │
//├─────────────────────────┤
//│使い方：                                          │
//│    Name Space欄にネームスペースを入れて、        │
//│      ・Store Poseボタンでポーズの保存            │
//│      ・リスト選択の変更でポーズ読み込み          │
//│      ・PoseNameフィールドでポーズ名の変更        │
//│      ・MatchSelObjにチェックをつけると、         │
//│        選択しているオブジェクト位置でマッチ      │
//│                                                  │
//│    ～.fmtファイルで、どのノードの値を保存するかを│
//│    設定できます。                                │
//│                                                  │
//│    Prefメニューから、                            │
//│      ～.fmtファイル                              │
//│      ポーズの保存先フォルダ                      │
//│    を設定できます。                              │
//│                                                  │
//│    Copy Animボタンでモーションコピー             │
//│    Paste Animボタンでカレントフレームでペースト  │
//├─────────────────────────┤
//│～.fmtファイルの書き方：                          │
//│    値を記録したいオブジェクト名のネームスペースを│
//│    除いた名前を１行１オブジェクト名で羅列。      │
//│    その際、頭に                                  │
//│      "!"をつけると、                             │
//│        MatchSelObjモード時に動かすオブジェクト   │
//│      "#"をつけると、                             │
//│        IgnoreRootモード時に動かさないオブジェクト│
//│    として指定できます。                          │
//└─────────────────────────┘
//
//更新履歴
//2014/05/23：v5.7
//  .poseファイルにrotateOrderアトリビュートがあると、
//  アニメーションレイヤー使用時にうまくポーズのセットができないので、
//  rotateOrderアトリビュートはStorePose時に、.poseファイルに
//  書き出さないようにした。
//2014/05/19：v5.6
//  アニメーションのコピー時に、シーンに存在しないオブジェクトが
//  .fmtファイルには書かれていると、うまく動かなかった。
//2014/05/09：v5.5
//  ポーズのセット時、ロックされたアトリビュートを検出して
//  セットしないようにした。
//2014/05/02：v5.4
//  ポーズのストア、セット時に、シーンに存在しないオブジェクトが、
//  .fmtファイルには書かれていると、うまく動かなかった。
//  オブジェクトがあるか、チェックするようにした。
//  
//  ・既知のバグ
//      ポーズのセット時、対象のアトリビュートが
//      ロックされていた場合、うまく動かない。
//2014/04/25：v5.3
//  ポーズのストア時に、二重以上のリファレンスでうまくいっていなかった。
//  ↓の更新がストア時に".*:"の文字列置換でオブジェクト名と
//  ネームスペースを分離していたのが原因で、うまくいってなかった。
//2014/04/25：v5.2
//  .fmtファイルのノード名リストにネームスペースを含められるようにした。
//    aaa:
//  がネームスペースの欄に入っているとき、
//    aaa:bbb:hogehoge
//  というオブジェクト名のモーションのコピーペーストに失敗していたので。
//  この場合は、.fmtファイルに
//    bbb:hogehoge
//  と書く。
//2014/04/11：v5.1
//  存在しないアトリビュートのチェックを入れた。
//  過去にコンストレインとかしてたオブジェクトに、
//  まれに.blendPointとかがのこってしまうため。
//2014/02/14：v5.0
//  IgnoreRootモードを実装。
//2014/02/14：v4.0
//  モーションのコピペの実装。
//  一時的にキャラクターセットを作成して無理やりコピペ。
//  なお、SGY_toolsのCopy(Paste)_Anim_Exと互換です。
//2014/02/03：v3.1
//  名前フィールドで決定時、
//  すでにある名前なら、それを選択するようにした。
//2014/02/03：v3.0
//  MatchSelObjモードを実装。
//2014/02/03：v2.0
//  ポーズの更新を実装。
//  ポーズ名のリネームまわりを改良。
//  （名前の衝突時、Confrictってでて止めてたのを、
//    連番つきの名前になるようにした）
//2014/01/31：v1.0
//  リリース。
//
//



/************************************************************


　実行proc群。


************************************************************/

//モーションのコピペ用キャラクターセットの作成
////////////////////////////////////////////////////////////
proc string PS_Add_Character(string $name_space, string $node_list[])
{

	string $node_name;
	string $keyable_attr_list[];
	string $keyable_attr;

	string $chr_set = `character -em -name "TEMP_CHR_SET"`;

	for ($node_name in $node_list)
	{
		$node_name = ($name_space + $node_name);
		if(`objExists $node_name`)
		{
			$keyable_attr_list = `listAnimatable $node_name`;
			for ($keyable_attr in $keyable_attr_list)
			{
				if (!`gmatch $keyable_attr "*\.visibility"`)
				{
					character -fe $chr_set $keyable_attr;
				}
			}
			clear $keyable_attr_list;
		}
	}
	return $chr_set;
}

//アニメーションをコピー。実行部
////////////////////////////////////////////////////////////
proc PS_Copy_Anim_EXE(string $name_space, string $chr_set)
{

	string $maya_APP_DIR = `getenv "MAYA_APP_DIR"`;

	string $now_sel[] = `ls -sl`;
	int $i;

	string $animatable_attr[] = `listAnimatable $chr_set`;
		int $animatable_attr_size = `size $animatable_attr`;
	string $tokenize_buff[];
	string $animatable_attr_only;
	string $export_list[];
	string $export_list_TMP[];


	string $connect_list[];
	string $connect_list_tmp[];
	string $connect_list_tmptmp;

	string $node_type;
	string $inter_keyable_check[];



	//エクスポートする、アニメカーブのついた、グループを作成
	//エクスポートするリストも作る
	for ($i = 0; $i < $animatable_attr_size; $i++)
	{
		//コネクトリストの初期値。アニメータブルなアトリビュートのリストを、だらっと調べる
		$connect_list[0] = $animatable_attr[$i];
		//手繰る先がなくなるまで手繰る。
		while (1)
		{

			if (`size $connect_list[0]` != 0)
			{

				$connect_list_tmp = `listConnections -s 1 -d 0 -scn 1 -p 1 $connect_list[0]`;

				if(`size $connect_list_tmp[0]` == 0)
				{
					//pairBlendノードでアトリビュートが".out*"の時は".out*"を".in*1"に置き換えてループ続行
					if (`nodeType $connect_list[0]` == "pairBlend")
					{
						if (`gmatch $connect_list[0] "*\.out*"`)
						{
							$connect_list_tmp[0] = `substitute "\.out" $connect_list[0] ".in"`;
							$connect_list_tmp[0] = ($connect_list_tmp[0]+"1");
						}
					}else{
						break;
					}
				}
				$connect_list[0] = $connect_list_tmp[0];
				clear $connect_list_tmp;

			}else{
				break;
			}

		}

		//↑で調べた終点と、今しらべてるアトリビュートが同じだったら
		//（要は↑のループを1回で抜けていたら）
		//アニメやらが何もついていないってことなので、処理しない
		if ($connect_list[0] != $animatable_attr[$i])
		{
			$node_type = `nodeType $connect_list[0]`;

			//さらに、終点のノードタイプがアニメカーブじゃなかったら、処理しない
			//（エクスプレッションなどもありえるので）
			if (`gmatch $node_type "animCurve*"`)
			{
				//アニメカーブのオブジェクト名をとりだす
				tokenize $connect_list[0] "." $tokenize_buff;
				$connect_list[0] = $tokenize_buff[0];
				clear $tokenize_buff;

				//アニメカーブをデュプっとく。
				$connect_list_tmptmp = `substitute ".*:" $connect_list[0] ""`;
				$connect_list = `duplicate -n ($connect_list_tmptmp + "_TEMPORARY") $connect_list[0]`;

				//今調べてるアトリビュートから、アトリビュート名のみをとりだす
				//（オブジェクト名.アトリビュート名　のかたちになっているので）
				tokenize $animatable_attr[$i] "." $tokenize_buff;
				$animatable_attr_only = `substitute ($name_space) $tokenize_buff[1] ""`;

				//からのトランスフォームを作り、さっきデュプったアニメカーブをtranslateXにコネクト
				group -w -em -n ($connect_list[0] + "_Export_INFO");
				connectAttr ($connect_list[0] + ".output")
							($connect_list[0] + "_Export_INFO" + ".translateX");

				//↑に、もともとどこにコネクトしていたのかを記したアトリビュートを追加。
				addAttr -dt "string" -ln "Connect_Attribute" ($connect_list[0] + "_Export_INFO");
				setAttr -type "string" ($connect_list[0] + "_Export_INFO" + ".Connect_Attribute")
						$animatable_attr_only;
				
				//アニメカーブと、からグループをエクスポートするリストに追加
				$export_list_TMP[0] = $connect_list[0];
				$export_list_TMP[1] = ($connect_list[0] + "_Export_INFO");
				$export_list = `stringArrayCatenate $export_list $export_list_TMP`;
			}
		}

		//一応、クリアしとく
		clear $tokenize_buff;

	}


	//完成したエクスポートリストをもとに、オブジェクト（からグループ）をエクスポート
	select -r $export_list;
	string $size_chk[] = `ls -sl`;
	
	if (`size $size_chk`)
	{
		//MAYAの吐き出す先にすでにこのmelでエクスポートされたmbファイルがあると
		//いちいち上書き確認のダイアログがでてウザイので、デリる。
		if (`filetest -w ($maya_APP_DIR+"/Copy_Anim_Ex_TMPBuff.mb")`)
		{
			$maya_APP_DIR = `fromNativePath( $maya_APP_DIR )`;
			system ("del \""+ $maya_APP_DIR + "\\Copy_Anim_Ex_TMPBuff.mb\"");
			$maya_APP_DIR = `toNativePath( $maya_APP_DIR )`;
			file -es -type "mayaBinary" ($maya_APP_DIR+"/Copy_Anim_Ex_TMPBuff.mb");
		}else{
			file -es -type "mayaBinary" ($maya_APP_DIR+"/Copy_Anim_Ex_TMPBuff.mb");
		}
	}

	//後始末。
	//作った（デュプった）ノードを消す。選択状況の復元。
	delete $export_list;
	select -r $now_sel;

}

//アニメーションをペースト。実行部
////////////////////////////////////////////////////////////
proc PS_Paste_Anim_EXE(string $name_space, string $chr_set)
{

	string $maya_APP_DIR = `getenv "MAYA_APP_DIR"`;

	string $now_sel[] = `ls -sl`;
	string $export_info_temporary_object[];
		int $export_info_temporary_object_size;
	
	string $paste_attr_name;

	string $animatable_attr[] = `listAnimatable $chr_set`;
		int $animatable_attr_size = `size $animatable_attr`;
	string $tokenize_buff[];
	string $animatable_attr_only[];

	int $i,$j,$attr_check_flag = 0;
	float $current_time = `currentTime -q`;


	//アニメ可能なアトリビュートの名前のみ取得
	for ($i=0; $i < $animatable_attr_size; $i++)
	{
			tokenize $animatable_attr[$i] "." $tokenize_buff;
			$animatable_attr_only[$i] = $tokenize_buff[1];
			clear $tokenize_buff;
	}

	//所定のファイル（Copy_Anim_Exで作成したmbファイル）をインポート
	file -i ($maya_APP_DIR+"/Copy_Anim_Ex_TMPBuff.mb");

	//インポートしてきたオブジェクトには命名規則があるので、それにしたがって選択
	//で、どのオブジェクトをインポートしてきたのかしらべる
	select -r "*_TEMPORARY*_Export_INFO";
	$export_info_temporary_object = `ls -sl`;
		$export_info_temporary_object_size = `size $export_info_temporary_object`;

	//インポートしたオブジェクトから、アニメをコピペ
	for ($i=0; $i < $export_info_temporary_object_size; $i++)
	{
		//インポートしたオブジェクトのアニメが、もともとどこにコネクトしていたのか調べる
		//（どのアトリビュートにくっついてたアニメなのかを記述したアトリビュートがあるはずなので）
		$paste_attr_name = `getAttr ($export_info_temporary_object[$i] + ".Connect_Attribute")`;
		$paste_attr_name = ($name_space+$paste_attr_name);

		//ペースト先に同一のアトリビュートがあるかチェック
		//なぜか、キャラクタセットにたいして"attrExist"がきかなかったので自前で^^;
		for ($j=0; $j < $animatable_attr_size; $j++)
		{
			if ($animatable_attr_only[$j] == $paste_attr_name)
			{
				$attr_check_flag = 1;
				break;
			}else{
				$attr_check_flag = 0;
			}
		}

		//ペースト先に同じアトリビュートが無ければ、ペーストしない
		if ($attr_check_flag == 1)
		{
			//アニメをコピー
			copyKey -time ":" -float ":" -hierarchy none -controlPoints 0 -shape 1 $export_info_temporary_object[$i];
			//アニメをペースト
			pasteKey -option merge -copies 1 -connect 0 -timeOffset $current_time
			($chr_set + "." + $paste_attr_name);

			delete $export_info_temporary_object[$i];
		}else{
			warning "ペースト失敗！";
			warning ($chr_set + "には、" + $paste_attr_name + "が、ありません");

			duplicate -inputConnections $export_info_temporary_object[$i];
			delete $export_info_temporary_object[$i];
		}

	}
	//後始末。
	//インポートしたノードを消す。選択状況の復元。
	select -r $now_sel;

}

//.poseファイルの書き出し
////////////////////////////////////////////////////////////
proc PS_Write_Pose_File(string $pose_file_name)
{
	global string $POSE_SELECTER_NS_FIELD;
	global string $PS_NODE_LIST[];
	global string $PS_POSE_FOLDER_OPTVAR;

	string $node_name;
	string $animatable_list[];
	string $animatable_name;
	float $val;
	string $out_string_list[];
	string $out_string;
	int $i;
	int $file_ID;

	string $name_space = `textFieldButtonGrp -q -tx $POSE_SELECTER_NS_FIELD`;

	for($node_name in $PS_NODE_LIST)
	{
		if(`objExists ($name_space+$node_name)`)
		{
			$animatable_list = `listAnimatable ($name_space+$node_name)`;
		}
		for($animatable_name in $animatable_list)
		{
			print $animatable_name;print "----\n";
			if (!(`gmatch $animatable_name "*.rotateOrder"`))
			{
				$animatable_name = `substitute ".*|" $animatable_name ""`;
				$animatable_name = `substitute $name_space $animatable_name ""`;
				$val = `getAttr ($name_space+$animatable_name)`;
				$out_string_list[$i] = ($animatable_name +" "+ $val);
				$i++;
			}else{
				$animatable_name = `substitute ".*|" $animatable_name ""`;
				$animatable_name = `substitute $name_space $animatable_name ""`;
				$val = `getAttr ($name_space+$animatable_name)`;
				print ($animatable_name +" "+ $val+"\n");
			}
		}
		clear $animatable_list;
	}
	$file_ID = `fopen ($PS_POSE_FOLDER_OPTVAR+$pose_file_name+".pose") "w"`;
	for($out_string in $out_string_list)
	{
		fprint $file_ID ($out_string+"\n");
	}
	fclose $file_ID;
}

//.poseファイルの読み込み
////////////////////////////////////////////////////////////
proc string[] PS_Read_Pose_File(string $pose_file_name)
{
	global string $PS_POSE_FOLDER_OPTVAR;
	string $res[];
	int $i;
	int $file_ID = `fopen ($PS_POSE_FOLDER_OPTVAR+$pose_file_name+".pose") "r"`;
		$res[0] = `fgetline $file_ID`;
		$res[0] = `substitute "\n" $res[0] ""`;
		while(`size $res[$i]` > 0)
		{
			$i++;
			$res[$i] = `fgetline $file_ID`;
			$res[$i] = `substitute "\n" $res[$i] ""`;
		}
	fclose $file_ID;
	
	return $res;
}

//重複チェック
//（$chk_list[]内に$in_strと重複するものがあったら連番つきの名前を返す）
////////////////////////////////////////////////////////////
proc string PS_Chk_List(string $in_str, string $chk_list[])
{
	string $res;
	string $chk;
	string $chk_node1;
	string $chk_parent;
		$chk_parent = `createNode "transform" -n "PS_CHECK_NODE_GRP"`;
	for($chk in $chk_list)
	{
		createNode "transform" -n $chk -p $chk_parent;
	}
	$res = `createNode "transform" -n $in_str -p $chk_parent`;
	delete $chk_parent;
	return $res;
}

//ポーズの新規作成
////////////////////////////////////////////////////////////
proc PS_Store_New_Pose_EXE()
{
	global string $PS_POSE_NAME_FIELD;
	global string $PS_POSE_SELECTER_SCLIST;
	global string $PS_OLD_ALL_ITEM[];clear $PS_OLD_ALL_ITEM;
	global string $PS_OLD_SELECT_ITEM;

	string $all_item[];
		$all_item = `textScrollList -q -allItems $PS_POSE_SELECTER_SCLIST`;
	string $pose_name;
		$pose_name = "New_Pose";
	string $pose_name_tmp;
		$pose_name_tmp = `textField -q -tx $PS_POSE_NAME_FIELD`;
	if(`size $pose_name_tmp` != 0)
	{
		$pose_name = $pose_name_tmp;
	}
	$pose_name = PS_Chk_List($pose_name, $all_item);
	textField -e -tx $pose_name $PS_POSE_NAME_FIELD;
	textScrollList -e -append $pose_name $PS_POSE_SELECTER_SCLIST;
	textScrollList -e -selectItem $pose_name $PS_POSE_SELECTER_SCLIST;
	$PS_OLD_ALL_ITEM = `textScrollList -q -allItems $PS_POSE_SELECTER_SCLIST`;
	$PS_OLD_SELECT_ITEM = $pose_name;

	PS_Write_Pose_File($pose_name);
}

//ポーズの更新
////////////////////////////////////////////////////////////
proc PS_Store_Update_Pose_EXE(string $pose_name)
{
	PS_Write_Pose_File($pose_name);
}

//ポーズのMach
////////////////////////////////////////////////////////////
proc PS_Mach_Pose(string $sel_obj,float $sel_trans_val_old[],string $name_list[])
{

	global string $PS_MATCH_NODE_LIST[];
		string $match_node;
	float $sel_trans_val_new[];
		$sel_trans_val_new = `xform -q -ws -t $sel_obj`;
	float $sel_trans_val_def[];
		$sel_trans_val_def[0] = $sel_trans_val_old[0] - $sel_trans_val_new[0];
		$sel_trans_val_def[1] = $sel_trans_val_old[1] - $sel_trans_val_new[1];
		$sel_trans_val_def[2] = $sel_trans_val_old[2] - $sel_trans_val_new[2];
	float $trans_val[];
	string $obj_name_list_tmp[];
	string $obj_name_list[];
	string $obj_name;
	string $buff[];
	int $i;
	int $flag;

	for($obj_name in $name_list)
	{
		if(`gmatch $obj_name "*\.translate*"`)
		{
			tokenize $obj_name "\." $buff;
			$obj_name_list_tmp[$i] = $buff[0];
			$i++;
		}
	}
	$obj_name_list = stringArrayRemoveDuplicates($obj_name_list_tmp);
	for($obj_name in $obj_name_list)
	{
		for($match_node in $PS_MATCH_NODE_LIST)
		{
			if(`gmatch $obj_name ("*:"+$match_node)`)
			{
				$flag = 1;
				break;
			}
		}
		if($flag == 1)
		{
//print $obj_name;print "\n";
			$trans_val = `xform -q -ws -t $obj_name`;
			$trans_val[0] = $trans_val[0] + $sel_trans_val_def[0];
			$trans_val[1] = $trans_val[1] + $sel_trans_val_def[1];
			$trans_val[2] = $trans_val[2] + $sel_trans_val_def[2];
			xform -ws -t $trans_val[0] $trans_val[1] $trans_val[2] $obj_name;
			$flag = 0;
		}
	}

}

//ポーズの読み込み
////////////////////////////////////////////////////////////
proc PS_Set_Pose_EXE()
{
	global string $PS_IGNORE_ROOT_CHECKBOX;
	global string $PS_MACH_CHECKBOX;
	global string $PS_ROOT_NODE_LIST[];
	global string $POSE_SELECTER_NS_FIELD;
	global string $PS_POSE_SELECTER_SCLIST;
	global string $PS_POSE_FOLDER_OPTVAR;
	global string $PS_SELECT_OBJ;
	global float $PS_SELECT_OBJ_GBL_TRNS_VAL[];

	int $match_flag = `checkBox -q -value $PS_MACH_CHECKBOX`;
	int $ignore_root_flag = `checkBox -q -value $PS_IGNORE_ROOT_CHECKBOX`;
	string $root_node_name;
	string $pose_name[];
		$pose_name = `textScrollList -q -selectItem $PS_POSE_SELECTER_SCLIST`;
	string $name_val_list[];
	string $name_val;
	string $name_list[];
	string $buff[];
	string $buff2[];
	int $i,$ignore_flag;

	string $name_space = `textFieldButtonGrp -q -tx $POSE_SELECTER_NS_FIELD`;

	$name_val_list = PS_Read_Pose_File($pose_name[0]);
	for($name_val in $name_val_list)
	{
		if ($name_val != "")
		{
			//↓↓setAtter実行前のチェックルーチン↓↓
			if($ignore_root_flag == 1)
			{
				tokenize $name_val "." $buff;
				for($root_node_name in $PS_ROOT_NODE_LIST)
				{
					if(`gmatch $buff[0] $root_node_name`)
					{
						$ignore_flag = 1;
						break;
					}
				}
			}
			clear $buff;
			clear $buff2;
			tokenize $name_val "." $buff;
			tokenize $buff[1] " " $buff2;
			if(`objExists ($name_space+$buff[0])`)//オブジェクトがあるか？
			{
				if(!(`attributeExists $buff2[0] ($name_space+$buff[0])`))//アトリビュートがあるか？
				{
					$ignore_flag = 1;
				}else if((`getAttr -l ($name_space+$buff[0]+"."+$buff2[0])`))//そのアトリビュートがロックされているか？
					{
						$ignore_flag = 1;
					}
			}else{
				$ignore_flag = 1;
			}
			clear $buff;
			clear $buff2;
			//↑↑ここまで↑↑
			if ($ignore_flag == 0)
			{
//print ("setAttr "+$name_space+$name_val);print "\n";
				eval("setAttr "+$name_space+$name_val);
			}
			tokenize $name_val " " $buff;
			$name_list[$i] = ($name_space+$buff[0]);
			$i++;
			$ignore_flag = 0;
		}
	}
	if($match_flag && !(`gmatch $PS_SELECT_OBJ ""`))
	{
		PS_Mach_Pose($PS_SELECT_OBJ,$PS_SELECT_OBJ_GBL_TRNS_VAL,$name_list);
	}
}

//ポーズのリネーム実行。
////////////////////////////////////////////////////////////
proc PS_Pose_Rename_EXE(string $new_name)
{
	global string $PS_POSE_NAME_FIELD;
	global string $PS_POSE_SELECTER_SCLIST;
	global string $PS_OLD_SELECT_ITEM;
	global string $PS_OLD_ALL_ITEM[];
	global string $PS_POSE_FOLDER_OPTVAR;

	string $all_item[];
		$all_item = `textScrollList -q -allItems $PS_POSE_SELECTER_SCLIST`;
	string $old_name[];
		$old_name = `textScrollList -q -selectItem $PS_POSE_SELECTER_SCLIST`;
	int $sel_num[];
		$sel_num = `textScrollList -q -selectIndexedItem $PS_POSE_SELECTER_SCLIST`;
	if(`size $old_name` != 0)
	{
		if (!(`gmatch $old_name[0] $new_name`))
		{
			$new_name = PS_Chk_List($new_name, $all_item);
			textScrollList -e -appendPosition $sel_num[0] $new_name $PS_POSE_SELECTER_SCLIST;
			textScrollList -e -removeIndexedItem ($sel_num[0]+1) $PS_POSE_SELECTER_SCLIST;
			textScrollList -e -sii $sel_num[0] $PS_POSE_SELECTER_SCLIST;
			textField -e -tx $new_name $PS_POSE_NAME_FIELD;

			sysFile
				-rename ($PS_POSE_FOLDER_OPTVAR+$new_name+".pose")
				($PS_POSE_FOLDER_OPTVAR+$old_name[0]+".pose");

			$PS_OLD_ALL_ITEM = `textScrollList -q -allItems $PS_POSE_SELECTER_SCLIST`;
			$PS_OLD_SELECT_ITEM = $new_name;
		}
	}
}



/************************************************************


　実行前の前処理proc群。


************************************************************/

global proc PS_Copy_Anim()
{
	global string $POSE_SELECTER_NS_FIELD;
	global string $PS_NODE_LIST[];
	string $name_space = `textFieldButtonGrp -q -tx $POSE_SELECTER_NS_FIELD`;
	string $chr_set;

	//キャラクターセットの作成
	$chr_set = PS_Add_Character($name_space,$PS_NODE_LIST);
	//コピー実行
	PS_Copy_Anim_EXE($name_space,$chr_set);

	//キャラクターセットの削除
	delete $chr_set;
}

global proc PS_Paste_Anim()
{
	global string $POSE_SELECTER_NS_FIELD;
	global string $PS_NODE_LIST[];
	string $name_space = `textFieldButtonGrp -q -tx $POSE_SELECTER_NS_FIELD`;
	string $chr_set;

	//キャラクターセットの作成
	$chr_set = PS_Add_Character($name_space,$PS_NODE_LIST);

	//ペースト実行
	PS_Paste_Anim_EXE ($name_space,$chr_set);

	//キャラクターセットの削除
	delete $chr_set;
}

//ポーズリネーム前のチェック
//（ポーズ名が空ならスクロールリストの選択解除、そうでないなら
//　同名ポーズの選択、同名ポーズがないなら、選択チェック。
//　選択されてるならリネーム、されてないなら新規ポーズ作成。）
////////////////////////////////////////////////////////////
global proc PS_Pose_Rename_CHK()
{
	global string $PS_POSE_NAME_FIELD;
	global string $PS_POSE_SELECTER_SCLIST;
	global string $PS_OLD_SELECT_ITEM;
	string $pose_list[];
	string $pose_name;
	string $sel_lis[];
	string $new_name;
	int $flag;
	$new_name = `textField -q -tx $PS_POSE_NAME_FIELD`;
	if (`gmatch $new_name ""`)
	{
		textScrollList -e -deselectAll $PS_POSE_SELECTER_SCLIST;
		$PS_OLD_SELECT_ITEM = "";
	}else{
		$pose_list = `textScrollList -q -allItems $PS_POSE_SELECTER_SCLIST`;
		for($pose_name in $pose_list)
		{
			if(`gmatch $pose_name $new_name`)
			{
				$flag = 1;
				break;
			}
		}
		if ($flag == 1)
		{
			textScrollList -e -selectItem $pose_name $PS_POSE_SELECTER_SCLIST;
		}else{
			$sel_list = `textScrollList -q -selectItem $PS_POSE_SELECTER_SCLIST`;
			if(`size $sel_list`)
			{
				PS_Pose_Rename_EXE($new_name);
			}else{
				PS_Store_New_Pose_EXE;
			}
		}
	}
}

//ポーズのストア前のチェック
//（スクロールリストの選択と、nameフィールドの文字列が同じ→更新
//　スクロールリストの選択と、nameフィールドの文字列が違う→新規
//　スクロールリストの選択が空→新規）
////////////////////////////////////////////////////////////
global proc PS_Store_Pose_CHK()
{
	global string $PS_POSE_NAME_FIELD;
	global string $PS_POSE_SELECTER_SCLIST;
	string $select_item[];
		$select_item = `textScrollList -q -selectItem $PS_POSE_SELECTER_SCLIST`;
	string $name;
		 $name = `textField -q -tx $PS_POSE_NAME_FIELD`;

	if(`size $select_item`)
	{
		if(`gmatch $select_item[0] $name`)
		{
			PS_Store_Update_Pose_EXE($name);
		}else{
			PS_Store_New_Pose_EXE;
		}
	}else{
		PS_Store_New_Pose_EXE;
	}
}

//ポーズ変更前のチェック。
//（現在選択中のものなら選択解除、そうでないならポーズ変更）
////////////////////////////////////////////////////////////
global proc PS_Set_Pose_CHK()
{
	global string $PS_OLD_SELECT_ITEM;
	global string $PS_POSE_NAME_FIELD;
	global string $PS_POSE_SELECTER_SCLIST;
	global string $PS_SELECT_OBJ;$PS_SELECT_OBJ = "";
		string $now_sel[] = `ls -sl`;
			int $now_sel_size = `size $now_sel`;
		if ($now_sel_size != 0)
		{
			$PS_SELECT_OBJ = $now_sel[$now_sel_size-1];
		}
	global float $PS_SELECT_OBJ_GBL_TRNS_VAL[];clear $PS_SELECT_OBJ_GBL_TRNS_VAL;
		if(`size $PS_SELECT_OBJ`)
		{
			$PS_SELECT_OBJ_GBL_TRNS_VAL = `xform -q -ws -t $PS_SELECT_OBJ`;
		}
	string $select_item[];
		$select_item = `textScrollList -q -selectItem $PS_POSE_SELECTER_SCLIST`;

	if (`gmatch $select_item[0] $PS_OLD_SELECT_ITEM`)
	{
		textScrollList -e -deselectAll $PS_POSE_SELECTER_SCLIST;
		$PS_OLD_SELECT_ITEM = "";
		textField -e -tx "" $PS_POSE_NAME_FIELD;

	}else{
		textField -e -tx $select_item[0] $PS_POSE_NAME_FIELD;
		$PS_OLD_SELECT_ITEM = $select_item[0];
		PS_Set_Pose_EXE;
	}
}

global proc PS_Nosekae()
{
	global string $POSE_SELECTER_NS_FIELD;

	int $start;
	int $end;

	//開いているmbファイルのパス取得
	string $scene_path_tmp = `file -q -sn`;
	$scene_path_tmp = `fromNativePath ($scene_path_tmp)`;
	string $dir = `dirname ($scene_path_tmp)`;

	//.mbファイルのリスト取得
	string $file_list_all[] = `getFileList -folder ($dir+"/") -filespec "*.mb"`;
	string $file_name;

	int $FBXWorkTool_exists_flag = 0;
	string $maya_APP_DIR = `getenv "MAYA_APP_DIR"`;
	string $name_space;

	//$file_list_allをすべて載せ替え
	for ($file_name in $file_list_all)
	{
		//ロード
		file -force -open ($dir+"/"+$file_name);
		$start = `playbackOptions -q -min`;
		$end = `playbackOptions -q -max`;

		//ネームスペースの取得＆UIにセット
		textFieldButtonGrp -e -tx "master_rig:" $POSE_SELECTER_NS_FIELD;

		//コピー
		PS_Copy_Anim;

		//exportFBXWorkTool_saveDataがあればエクスポート（存在した場合はフラグたてもする）
		if (`objExists "exportFBXWorkTool_saveData"`)
		{
			$FBXWorkTool_exists_flag = 1;
			select -r exportFBXWorkTool_saveData;
			if (`filetest -w ($maya_APP_DIR+"/Copy_Anim_Ex_TMPBuff.mb")`)
			{
				$maya_APP_DIR = `fromNativePath( $maya_APP_DIR )`;
				system ("del \""+ $maya_APP_DIR + "\\exportFBXWorkTool_saveData.mb\"");
				$maya_APP_DIR = `toNativePath( $maya_APP_DIR )`;
				file -es -type "mayaBinary" ($maya_APP_DIR+"/exportFBXWorkTool_saveData.mb");
			}else{
				file -es -type "mayaBinary" ($maya_APP_DIR+"/exportFBXWorkTool_saveData.mb");
			}
		}

		//もともとひらいてたファイル（ペースト先）をロード
		file -f -options "v=0;" -typ "mayaBinary" -o $scene_path_tmp;

		//タイムレンジを合わせる（ついでにカレントフレームも0に）
		playbackOptions -min $start;
		playbackOptions -max $end;
		currentTime 0;

		//ネームスペースの取得＆UIにセット
		textFieldButtonGrp -e -tx "chr000000_rigbase:master_rig:" $POSE_SELECTER_NS_FIELD;

		//ペースト
		PS_Paste_Anim;

		//フラグがたってたら、exportFBXWorkTool_saveDataのインポート。
		if($FBXWorkTool_exists_flag == 1)
		{
			file -i ($maya_APP_DIR+"/exportFBXWorkTool_saveData.mb");
		}
		//保存
		 print "---------------\n";print ($dir+"/"+$file_name); print "\n---------------\n";
		file -rename ($dir+"/"+$file_name);
		file -force -save -type "mayaBinary";

		//後処理
			$FBXWorkTool_exists_flag = 0;
	}
}

/************************************************************


　初期化やfmtファイルの読み込みなどの内部処理的なproc群。


************************************************************/

//ポーズライブラリフォルダからポーズ名の取得。UIの更新。
////////////////////////////////////////////////////////////
global proc PS_Pose_Folder_Reload()
{
	global string $PS_POSE_FOLDER_OPTVAR;
	global string $PS_POSE_SELECTER_SCLIST;
	global string $PS_OLD_ALL_ITEM[];clear $PS_OLD_ALL_ITEM;
	global string $PS_OLD_SELECT_ITEM;
		$PS_OLD_SELECT_ITEM = "";

	string $pose_list[];
	string $pose_name;
	int $i;

	$pose_list = `getFileList -folder $PS_POSE_FOLDER_OPTVAR -filespec "*.pose"`;
	textScrollList -e -removeAll $PS_POSE_SELECTER_SCLIST;
	for($pose_name in $pose_list)
	{
		$pose_name = basename( $pose_name, ".pose" );
		$PS_OLD_ALL_ITEM[$i] = $pose_name;
		textScrollList -e -a $pose_name $PS_POSE_SELECTER_SCLIST;
		$i++;
	}
}

//フォーマットファイルの読み込み。
////////////////////////////////////////////////////////////
global proc PS_Load_Format_File()
{
	global string $PS_NODE_LIST[];clear $PS_NODE_LIST;
	global string $PS_MATCH_NODE_LIST[];clear $PS_MATCH_NODE_LIST;
	global string $PS_ROOT_NODE_LIST[];clear $PS_ROOT_NODE_LIST;
	global string $PS_FORMAT_FILE_OPTVAR;

	string $all_line[];
	string $match_node_name;
	string $root_node_name;
	int $i,$j,$k;
	int $file_id = `fopen $PS_FORMAT_FILE_OPTVAR "r"`;
		$all_line[0] = `fgetline $file_id`;
		while ( `size $all_line[$i]`  > 0 )
		{
			$i++;
			$all_line[$i] = `fgetline $file_id`;
		}
	fclose $file_id;

	for($i=0; $i<`size $all_line`; $i++)
	{
		$all_line[$i] = `substitute "\n" $all_line[$i] ""`;
		$all_line[$i] = `substitute "\/\/.*" $all_line[$i] ""`;
		if(`gmatch $all_line[$i] "!*"`)
		{
			$PS_MATCH_NODE_LIST[$j] = $all_line[$i];
			$j++;
		}
		if(`gmatch $all_line[$i] "#*"`)
		{
			$PS_ROOT_NODE_LIST[$k] = $all_line[$i];
			$k++;
		}
		$all_line[$i] = `substitute "!" $all_line[$i] ""`;
		$all_line[$i] = `substitute "#" $all_line[$i] ""`;
	}
	$j=0;
	$k=0;
	for($match_node_name in $PS_MATCH_NODE_LIST)
	{
		$PS_MATCH_NODE_LIST[$j] = `substitute "!" $PS_MATCH_NODE_LIST[$j] ""`;
		$PS_MATCH_NODE_LIST[$j] = `substitute "#" $PS_MATCH_NODE_LIST[$j] ""`;
		$j++;
	}
	for($root_node_name in $PS_ROOT_NODE_LIST)
	{
		$PS_ROOT_NODE_LIST[$k] = `substitute "!" $PS_ROOT_NODE_LIST[$k] ""`;
		$PS_ROOT_NODE_LIST[$k] = `substitute "#" $PS_ROOT_NODE_LIST[$k] ""`;
		$k++;
	}

	$PS_NODE_LIST = stringArrayRemove({""}, $all_line);
}

//Option_Var読み込み。
////////////////////////////////////////////////////////////
global proc PS_Load_Option_Var()
{
	global string $PS_POSE_FOLDER_OPTVAR;
	global string $POSE_SELECTER_PATH;
	global string $PS_FORMAT_FILE_OPTVAR;

	$PS_POSE_FOLDER_OPTVAR = ($POSE_SELECTER_PATH+"\/");
	if (`optionVar -ex "PS_Pose_Folder"` == 1)
	{
		$PS_POSE_FOLDER_OPTVAR = `optionVar -q "PS_Pose_Folder"`;
	}

	$PS_FORMAT_FILE_OPTVAR = ($POSE_SELECTER_PATH+"\/pose_selecter.fmt");
	if (`optionVar -ex "PS_Format_File"` == 1)
	{
		$PS_FORMAT_FILE_OPTVAR = `optionVar -q "PS_Format_File"`;
	}
}

//ポーズライブラリフォルダの指定変更。メニューの更新。
////////////////////////////////////////////////////////////
global proc PS_Pose_Folder_Change()
{
	global string $PS_POSE_FOLDER_OPTVAR;
	global string $PS_POSE_FOLDER_CHANGE_MENU;
	string $res[];
	$res = `fileDialog2
		-dir $PS_POSE_FOLDER_OPTVAR
		-fileMode 3`;
	if (`size $res` > 0)
	{
		$PS_POSE_FOLDER_OPTVAR = ($res[0]+"\/");
		optionVar -stringValue "PS_Pose_Folder" $PS_POSE_FOLDER_OPTVAR;
		menuItem -e -label ("Pose Folder  \("+$PS_POSE_FOLDER_OPTVAR+"\)") $PS_POSE_FOLDER_CHANGE_MENU;
		PS_Pose_Folder_Reload;
	}
}

//フォーマットファイルの指定変更。メニューの更新。
////////////////////////////////////////////////////////////
global proc PS_Format_File_Change()
{
	global string $PS_FORMAT_FILE_OPTVAR;
	global string $PS_FORMAT_FILE_CHANGE_MENU;
	string $res[];
	string $dir;
		$dir = dirname($PS_FORMAT_FILE_OPTVAR);
	string $ext = "*.fmt";
	$res = `fileDialog2
		-dir $dir
		-fileFilter $ext
		-fileMode 1`;
	if (`size $res` > 0)
	{
		$PS_FORMAT_FILE_OPTVAR = $res[0];
		optionVar -stringValue "PS_Format_File" $PS_FORMAT_FILE_OPTVAR;
		menuItem -e -label ("Format File  \("+$PS_FORMAT_FILE_OPTVAR+"\)") $PS_FORMAT_FILE_CHANGE_MENU;
		PS_Load_Format_File;
	}
}

//ネームスペース欄に選択オブジェクトのネームスペースを入れる
////////////////////////////////////////////////////////////
global proc PS_Get_Select_Name_Space(string $textFieldButtonGrp_name)
{
	string $now_sel[] = `ls -sl -o -tail 1`;
		int $now_sel_size = `size $now_sel`;
	string $text;
	string $buffer[];
	string $buf;
	string $name_space;
	int $num;
	if ($now_sel_size != 0)
	{
		$num = `tokenize $now_sel[0] ":" $buffer`;
		$buffer[$num-1] = "";
		for($buf in $buffer)
		{
			if($name_space == "")
			{
				$name_space = ($buf);
			}else{
				$name_space = ($name_space+":"+$buf);
			}
		}
		textFieldButtonGrp -e -tx $name_space $textFieldButtonGrp_name;
	}else{
		textFieldButtonGrp -e -tx "" $textFieldButtonGrp_name;
	}
}



/************************************************************


　UIの構築。


************************************************************/

//UI作成
////////////////////////////////////////////////////////////
global proc Pose_Selecter()
{
	if (`window -exists Pose_Selecter`)
	{
		deleteUI -window Pose_Selecter;
	}

	string $ps = `whatIs "Pose_Selecter"`;
	string $path_tmp[];
		tokenize $ps " " $path_tmp;
	global string $POSE_SELECTER_PATH;
		$POSE_SELECTER_PATH = dirname($path_tmp[4]);
	global string $POSE_SELECTER_NS_FIELD;
	global string $PS_POSE_FOLDER_CHANGE_MENU;
	global string $PS_FORMAT_FILE_CHANGE_MENU;
	global string $PS_POSE_FOLDER_OPTVAR;
	global string $PS_FORMAT_FILE_OPTVAR;
	global string $PS_POSE_NAME_FIELD;
	global string $PS_MACH_CHECKBOX;
	global string $PS_IGNORE_ROOT_CHECKBOX;
	global string $PS_POSE_SELECTER_SCLIST;
	global string $PS_NOSEKAE_MENU;

	PS_Load_Option_Var;

	window -resizeToFitChildren true -menuBar true -wh 410 455 -t "Pose Selecter" Pose_Selecter;
	menu -label "Pref";
		$PS_POSE_FOLDER_CHANGE_MENU = `menuItem -label ("Pose Folder  \("+$PS_POSE_FOLDER_OPTVAR+"\)")
					-command "PS_Pose_Folder_Change"`;
		$PS_FORMAT_FILE_CHANGE_MENU = `menuItem -label ("Format File  \("+$PS_FORMAT_FILE_OPTVAR+"\)")
					-command "PS_Format_File_Change"`;
		$PS_NOSEKAE_MENU = `menuItem -label ("NOSEKAE")
					-command "PS_Nosekae"`;

	columnLayout -adj 1 -columnOffset "both" 5 -rowSpacing 5;
		separator -h 2 -style "in";
		$POSE_SELECTER_NS_FIELD =
		`textFieldButtonGrp -columnAlign 1 "left" -columnAlign 2 "left"
		-adj 2 -label "Name Space" -buttonLabel "!<-"
		-columnWidth3 80 1 30
		-columnAttach3 "left" "left" "left"
		-columnOffset3 0 0 5
		-bc "PS_Get_Select_Name_Space $POSE_SELECTER_NS_FIELD"`;
		separator -h 5 -style "in";
	setParent ..;
	string $form1 = `formLayout -numberOfDivisions 100`;
		string $column0 = `rowLayout -numberOfColumns 2
							-columnWidth 1 80
							-ct2 "both" "both"
							-co2 0 0 -adjustableColumn 2`;
			text -align "left" -l "Pose Name" -w 80;
			$PS_POSE_NAME_FIELD = `textField -ec "PS_Pose_Rename_CHK"`;
		setParent ..;

		$PS_POSE_SELECTER_SCLIST = `textScrollList -allowMultiSelection false
							-selectCommand "PS_Set_Pose_CHK"
							-width 10`;

		string $column1 = `columnLayout -adjustableColumn 1 -rowSpacing 5`;
			$PS_IGNORE_ROOT_CHECKBOX = `checkBox -label "Ignore Root Obj"`;
			$PS_MACH_CHECKBOX = `checkBox -label "Match Sel Obj"`;
			separator -h 5 -style "in";
		setParent ..;

		string $column2 = `columnLayout -adjustableColumn 1 -rowSpacing 5`;
			separator -h 5 -style "in";
			button -w 110 -h 30 -label "Copy Anim" -c "PS_Copy_Anim";
			button -w 80 -h 30 -label "Paste Anim" -c "PS_Paste_Anim";
		setParent ..;

		string $column3 = `columnLayout -adjustableColumn 1 -rowSpacing 5`;
			separator -h 5 -style "in";
			button -w 80 -h 30 -label "Store Pose" -c "PS_Store_Pose_CHK";
		setParent ..;
	setParent ..;

	formLayout -edit
		-attachForm $column0 "top" 0
		-attachForm $column0 "left" 5
		-attachForm $column0 "right" 10

		-attachControl $PS_POSE_SELECTER_SCLIST "top" 5 $column0
		-attachForm $PS_POSE_SELECTER_SCLIST "left" 20
		-attachControl $PS_POSE_SELECTER_SCLIST "bottom" 5 $column3
		-attachControl $PS_POSE_SELECTER_SCLIST "right" 5 $column1

		-attachControl $column1 "top" 5 $column0
		-attachControl $column1 "bottom" 5 $column2
		-attachForm $column1 "right" 20

		-attachControl $column2 "bottom" 5 $column3
		-attachForm $column2 "right" 20

		-attachForm $column3 "left"   5
		-attachForm $column3 "bottom" 5
		-attachForm $column3 "right"  5
	$form1;

	PS_Pose_Folder_Reload;
	PS_Load_Format_File;

	//ウィンドウ表示
	showWindow Pose_Selecter;
}
