				string $tx_MDC_0 = `text -label $mes -ann ""`;
				string $tf_MDC_1 = (`textFieldButtonGrp -cl3 left both right -cw3 120 440 100 -label "モーションフォルダ" -text $basePath -ann "" -buttonLabel "Edit" MDC_MotTf`);
				string $tf_MDC_2 = (`textFieldButtonGrp -cl3 left both right -cw3 120 440 100 -label "ヘッダマスターデータ" -text $masterPath -ann "" -buttonLabel "Edit" MDC_MasTf`);
				string $text_of_shortCutLabel_MDC_2 = `text -label "プリセット"`;
				string $radioCollection1 = `radioCollection MDC_rC1`;
				string $radioLayout = `rowLayout -numberOfColumns 2 -cw2 50 50 MDC_rLo`;
					radioButton -label "HG" -select MDC_rb1;
					radioButton -label "PG" MDC_rb2;
					setParent ..;
				string $tx_MDC_1 = `text -label "■対象キャラID(chr～)" -ann ""`;

				string $charaCode = stringArrayToString($checkList,",");
				string $gmpCode = stringArrayToString($checkGmpList,",");

				string $tx_MDC_2 = `scrollField -text $charaCode MDC_charaList`;
				string $tx_MDC_4 = `text -label "■対象モーションID(gmp～)" -ann ""`;
				string $tx_MDC_3 = `scrollField -text $gmpCode -h 200 MDC_gmpList`;

				string $MDC_b1 = `button -w 420 -h 30 -l "モーションデータチェック" motCheckBtn`;

				formLayout -edit

					-attachForm $tx_MDC_0 "top"    5
					-attachForm $tx_MDC_0 "left"   10
					-attachNone $tx_MDC_0 "bottom"
					-attachForm $tx_MDC_0 "right"  10

					-attachControl $tf_MDC_1 "top"    5 $tx_MDC_0
					-attachForm $tf_MDC_1 "left"   10
					-attachNone $tf_MDC_1 "bottom"
					-attachForm $tf_MDC_1 "right"  10

					-attachControl $tf_MDC_2 "top"  5 $tf_MDC_1
					-attachForm $tf_MDC_2 "left"   10
					-attachNone $tf_MDC_2 "bottom"
					-attachForm $tf_MDC_2 "right"  10

					-attachControl $text_of_shortCutLabel_MDC_2 "top"  20 $tf_MDC_2
					-attachForm $text_of_shortCutLabel_MDC_2 "left"   10
					-attachNone $text_of_shortCutLabel_MDC_2 "bottom"
					-attachNone $text_of_shortCutLabel_MDC_2 "right"

					-attachControl $radioLayout "top" 20 $tf_MDC_2
					-attachControl $radioLayout "left" 80 $text_of_shortCutLabel_MDC_2
					-attachNone $radioLayout "bottom"
					-attachForm $radioLayout "right"  10

					-attachControl $tx_MDC_1 "top"  5 $text_of_shortCutLabel_MDC_2
					-attachForm $tx_MDC_1 "left"   10
					-attachNone $tx_MDC_1 "bottom"
					-attachForm $tx_MDC_1 "right"  10

					-attachControl $tx_MDC_2 "top"    0 $tx_MDC_1
					-attachForm $tx_MDC_2 "left"      10
					-attachControl $tx_MDC_2 "bottom" 10 $tx_MDC_4
					-attachForm $tx_MDC_2 "right"     10

					-attachNone $tx_MDC_4 "top"
					-attachForm $tx_MDC_4 "left"   10
					-attachControl $tx_MDC_4 "bottom" 5 $tx_MDC_3
					-attachForm $tx_MDC_4 "right"  10

					-attachNone $tx_MDC_3 "top"
					-attachForm $tx_MDC_3 "left"   10
					-attachControl $tx_MDC_3 "bottom" 10 $MDC_b1
					-attachForm $tx_MDC_3 "right"  10

					-attachNone $MDC_b1 "top"
					-attachForm $MDC_b1 "left"   10
					-attachForm $MDC_b1 "bottom" 10
					-attachForm $MDC_b1 "right"  10
				$MDC_forms;
				setParent ..;
			setParent ..;

	//---------------------------------------------------------------------------------------------


	button -edit -command "GPCheckFileExistsInTrunkExec();" -ann "指定フォルダ内のモーションヘッダファイルチェックを行います。" motCheckBtn;
	string $tfc0 = `textFieldButtonGrp -edit -bc ("fileBrowserDialog -mode 4 -fileType \"directory\" -actionName \"select Folder\" -fileCommand \"rtd_setTextfData(\\\"MDC_MotTf\\\")\" ") MDC_MotTf`;
	string $tfc1 = `textFieldButtonGrp -edit -bc ("fileBrowserDialog -mode 4 -fileType \"directory\" -actionName \"select Folder\" -fileCommand \"rtd_setTextfData(\\\"MDC_MasTf\\\")\" ") MDC_MasTf`;

	radioButton -edit -onCommand "MDC_setText(\"HG\")" MDC_rb1;
	radioButton -edit -onCommand "MDC_setText(\"PG\")" MDC_rb2;

	window -e -w 640 -h 620 $MDCwindow;
	showWindow $MDCwindow;
}










motionDataChecker();