	string $tc2 = `textFieldButtonGrp -edit -bc ("fileBrowserDialog -mode 4 -fileType \"directory\" -actionName \".animファイルを出力するフォルダを指定して下さい。\" -fileCommand \"MMT_setTextfData(\\\"MMT_animNameTf\\\")\" ") MMT_animNameTf`;
