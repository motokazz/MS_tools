		setParent ..;

//実行
	string $b1 = `button -w 100 -l "Motion Transfer" Btn`;

	radioButton -edit -onCommand "textFieldButtonGrp -e -en true  MMT_iMbNameTf ;textFieldButtonGrp -e -en true  MMT_eMbNameTf ;textFieldButtonGrp -e -en true  MMT_rigNameTf ;textFieldGrp -e -en true  MMT_chrNameTf ;checkBox -e -en true  bakeFlag ;radioButton -e -en true  rb_mb ;radioButton -e -en true  rb_ma ;radioButton -e -en true  rb_keep ;" rb1;
