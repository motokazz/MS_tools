//処理対象選定
	string $epTf = `textFieldGrp -cl2 left both -cw2 120 440 -label "処理対象を名前で絞る" -ann"エクスポートおよびインポート処理の対象を、名前で絞ります。半角スペースで複数入力した場合、どれかに該当したものが処理されます。" extgtTF`;

//読んで字の如く
	string $c1 = `checkBox -v 0 -label "Anim出力時、キーのベイクを行わない" bakeFlag`;

	string $radioCollection2 = `radioCollection rCexpt`;
		string $radioLayout2 = `rowLayout -numberOfColumns 4 -cw4 120 100 100 150`;
