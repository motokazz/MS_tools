	string $com_B = "fileBrowserDialog -mode 0 -fileType \".mb\" -actionName \"open\" -fileCommand \"MMT_setTextfData( \\\"MMT_rigNameTf\\\" )\" ";
	string $tc4 = `textFieldButtonGrp -edit -bc ($com_A + ";" + $com_B) MMT_rigNameTf`;

