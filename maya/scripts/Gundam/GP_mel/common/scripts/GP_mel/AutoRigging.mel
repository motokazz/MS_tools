//--------------------------------------------------------------------------------
//動作を止めていたIKを再起動
global proc ikSwitch(){
	//reboot IK
	select -cl  ;
	select -r ik_l_hand ik_r_hand ik_l_foot ik_r_foot ;
	setAttr "ik_l_hand.ikBlend" 1;
	setAttr "ik_r_hand.ikBlend" 1;
	setAttr "ik_l_foot.ikBlend" 1;
	setAttr "ik_r_foot.ikBlend" 1;
}

//--------------------------------------------------------------------------------
//位置合わせしたコントローラを、移動値フリーズ
global proc rigFreeze(){
	//freeze rig transform
	select -r rig_body ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_pelvis ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_neck ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });

	select -r rig_r_collor ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_r_shoulder ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_r_arm ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_r_elbow ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_r_sArmor ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_r_weapon ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });

	select -r rig_l_collor ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_l_shoulder ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_l_arm ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_l_elbow ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_l_sArmor ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_l_weapon ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });

	select -r rig_l_knee ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_l_ankle ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_l_foot ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_l_foot_armor ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });

	select -r rig_r_knee ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_r_ankle ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_r_foot ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
	select -r rig_r_foot_armor ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });

	select -r rig_booster ;makeIdentity -apply true -t 1 -r 0 -s 0 -n 0;doBakeNonDefHistory( 1, {"prePost" });
}

//--------------------------------------------------------------------------------
//コンストレイン付け直し
//リグ→ダミー骨階層
global proc reConst(){
	//re_constrain
	select -r rig_location dummy_root_1 ;
	pointConstraint -mo -weight 1;
	orientConstraint -mo -weight 1;

	select -r rig_hip dummy_jointroot_000 ;
	pointConstraint -mo -weight 1;

	select -r rig_hip dummy_J_hip_400 ;
	orientConstraint -mo -weight 1;

	select -r rig_pelvis dummy_J_chest_001 ;
	pointConstraint -mo -weight 1;
	orientConstraint -mo -weight 1;

	select -r rig_l_collor dummy_J_L_shoulder_300 ;
	orientConstraint -mo -weight 1;


	select -r rig_l_sArmor dummy_J_L_sldArmor_310 ;
	pointConstraint -mo -weight 1;


	select -r dummy_J_L_foreArm_303 rig_l_wrist_dummy ;
	parentConstraint -mo -weight 1;


	select -r Lbuki_switch_ctrl dummy_J_L_weapon_305 ;
	pointConstraint -mo -weight 1;


	select -r rig_r_collor dummy_J_R_shoulder_200 ;
	orientConstraint -mo -weight 1;


	select -r rig_r_sArmor dummy_J_R_sldArmor_210 ;
	pointConstraint -mo -weight 1;


	select -r dummy_J_R_foreArm_203 rig_r_wrist_dummy ;
	parentConstraint -mo -weight 1;

	select -r Rbuki_switch_ctrl dummy_J_R_weapon_205 ;
	pointConstraint -mo -weight 1;

	select -r rig_r_skirtF dummy_J_R_skirtF_440 ;
	parentConstraint -mo -weight 1;

	select -r rig_r_skirtB dummy_J_R_skirtB_441 ;
	parentConstraint -mo -weight 1;

	select -r rig_r_skirtS dummy_J_R_skirtS_442 ;
	parentConstraint -mo -weight 1;

	select -r rig_l_skirtF dummy_J_L_skirtF_443 ;
	parentConstraint -mo -weight 1;

	select -r rig_l_skirtB dummy_J_L_skirtB_444 ;
	parentConstraint -mo -weight 1;

	select -r rig_l_skirtS dummy_J_L_skirtS_445 ;
	parentConstraint -mo -weight 1;

	select -r rig_r_skirtF_dummy_constlocator rig_r_skirtF_dummy ;
	pointConstraint -mo -weight 1;

	select -r rig_l_skirtF_dummy_constlocator rig_l_skirtF_dummy ;
	pointConstraint -mo -weight 1;

	select -r rig_r_skirtS_dummy_constlocator rig_r_skirtS_dummy ;
	pointConstraint -mo -weight 1;

	select -r rig_l_skirtS_dummy_constlocator rig_l_skirtS_dummy ;
	pointConstraint -mo -weight 1;

	//以下、ダミー骨追加分
	//3本IKに対応する形で肘を調整
	select -r rig_r_kataP dummy_J_R_armCnct_220 ;
	pointConstraint -mo -weight 1;
	orientConstraint -mo -weight 1;

	select -r rig_l_kataP dummy_J_L_armCnct_320 ;
	pointConstraint -mo -weight 1;
	orientConstraint -mo -weight 1;

	select -r rig_r_foot_armor dummy_J_R_ftArmor_425 ;
	pointConstraint -mo -weight 1;
	orientConstraint -mo -weight 1;

	select -r rig_l_foot_armor dummy_J_L_ftArmor_435 ;
	pointConstraint -mo -weight 1;
	orientConstraint -mo -weight 1;

	select -r rig_booster dummy_J_booster_501 ;
	pointConstraint -mo -weight 1;
	orientConstraint -mo -weight 1;


}

