//リグ設定ツール(補助骨関節版)
//機能1、あらかじめ用意したリグコントローラ・ダミー骨のシーンをインポート
//機能2、キャラクターのモデルデータをリファレンス
//機能3、コントローラー、ダミー骨、キャラクターの骨をコンストレイン・再設定
//
//「骨の入ったキャラデータ」と「ダミー骨→コントローラ構造のrigシーン」を接続し、Rigbaseシーンを作るスクリプトです。
//キャラ固有骨があるので、一発で全部設定するのは難しい、かも。
//
//20140902	エクストラジョイントの統合により存在しない骨へのリグが大量発生、存在しないエクストラジョイントへの対応を追加
//20140312	Addrig系調整
//20121012	盾リグ設定再構築
//20121009	手形状変化・追加対応(basepose.mb時にスケール変化キャンセル)
//20121002	CSS対応
//20120927	手形状変化に対応
//20120808	盾リグの動作を精査
//20120709	膝PVをデフォルトローカルへ
//20120706	上半身スケール取得のミスを修正
//20120705^ 下半身に骨追加(hip)、リグ「hip」からの回転値のみ、jointrootの変わりに受け取る。
//20120612	バックパックの接続方式変更に対応(骨名称backpack_250→backpack_290)
//20120518	ストフリのバックパック骨名変更へ対応
//			その他細々と
//20120502	jointOrientを切る事になったので、dummy→model骨のorientConstをオフセット自動計算へ。
//			多分、baserig調整したほうが綺麗な流れ。
//20120425	エラーチェック用の進捗表示を追加
//20120413	rigバージョン9へ対応(腿付け根・肩アーマー・下腕調整)	ver16
//20120315	ネットワーク更新式に変更

//--------------------------------------------------------------------------------
global proc string getVersion(){
	string $ARTversion = "ver1.33_20140902";
	return ($ARTversion);
}
//--------------------------------------------------------------------------------
global proc doMyImport(string $file,string $type)
{
	file -import $file; 
}

global proc rigImport(){
	confirmDialog -title "Auto rigging tool" -message ("最新版rigのMayaシーンデータをインポートします。")
		-button "OK" -defaultButton "OK";
	string $fileName = (`getenv "GP_MAYA_ROOT"` + "\\common\\scripts\\GP_mel\\CSS\\");
	file -i -type "mayaBinary" -ignoreVersion -gl -loadReferenceDepth "all" -options "v=0" ( $fileName + "baserig.mb");
	
/*
	confirmDialog -title "Auto rigging tool" -message ("リグの新規設定を行います。\n使用するrigのMayaシーンデータを選択して下さい。\r\n当ツールのバージョンは1.31、対応するbaserigのバージョンは15となります。")
		-button "OK" -defaultButton "OK";
	string $myDir = "S:\\motion\\Rigging_source";
	string $oldDir = `workspace -q -fn`;
	catch(`setProject  $myDir `);
	fileBrowserDialog -m 0 -fc "doMyImport" -ft "mayaBinary" -an "Import_Rig" -om "Import";
	setProject $oldDir;
*/

}

//--------------------------------------------------------------------------------
global proc chrImport(){
	confirmDialog -title "Auto rigging tool" -message ("使用するキャラクターのMayaシーンデータを選択して下さい。")
		-button "OK" -defaultButton "OK";
	projectViewer Reference;
}

//--------------------------------------------------------------------------------
//骨ロックチェック
global proc int GPAutoRigging_lockCheck(){
	select -r -hi "*:root";
	string $chjoints[] = `ls -sl -type joint`;
	int $checklist[];
	string $checkmes = "";
	int $checksum = 0;
	for($i = 0 ; $i < size($chjoints) ; $i++ ){
		$checklist[$i] = $checklist[$i] + `getAttr -lock ($chjoints[$i] + ".tx")`;
		$checklist[$i] = $checklist[$i] + `getAttr -lock ($chjoints[$i] + ".ty")`;
		$checklist[$i] = $checklist[$i] + `getAttr -lock ($chjoints[$i] + ".tz")`;
		$checklist[$i] = $checklist[$i] + `getAttr -lock ($chjoints[$i] + ".rx")`;
		$checklist[$i] = $checklist[$i] + `getAttr -lock ($chjoints[$i] + ".ry")`;
		$checklist[$i] = $checklist[$i] + `getAttr -lock ($chjoints[$i] + ".rz")`;
		$checklist[$i] = $checklist[$i] + `getAttr -lock ($chjoints[$i] + ".sx")`;
		$checklist[$i] = $checklist[$i] + `getAttr -lock ($chjoints[$i] + ".sy")`;
		$checklist[$i] = $checklist[$i] + `getAttr -lock ($chjoints[$i] + ".sz")`;
		$checksum = $checksum + $checklist[$i];
		if($checklist[$i]){$checkmes = ($checkmes + $chjoints[$i] + "\n" );}
	}
	select -cl;
	if($checksum){
		string $SSwindow = "CSSsystem";
		if ( `window -exists $SSwindow` != 1 ){
			confirmDialog -title "Auto rigging tool" -message ("以下のジョイントがロックされています。\n" + $checkmes )
			-button "OK" -defaultButton "OK";
		}
		return(1);
	}
	return(0);
}

//--------------------------------------------------------------------------------
//レイヤー確認
//モデル側のレイヤー状態を確認する
global proc int GPAutoRigging_layerCheck(){
	int $checkList[];
	string $checkmes;

	string $layName = `objectLayer "*:root"`;
	if($layName == "defaultLayer"){
		$checkList[0] = 1;
		$checkmes = ("root\n");
	}

	$layName = `objectLayer "*:parts"`;
	if($layName == "defaultLayer"){
		$checkList[1] = 1;
		$checkmes = ($checkmes + "parts\n");
	}

	if($checkList[0] || $checkList[1]){
		string $SSwindow = "CSSsystem";
		if ( `window -exists $SSwindow` != 1 ){
			confirmDialog -title "Auto rigging tool" -message ("以下のオブジェクトが、defaultLayerに入っています。\n" + $checkmes + "\nモーション作業用に表示状態を設定しますので、\n何らかのディスプレイレイヤーに格納して下さい。")
			-button "OK" -defaultButton "OK";
		}
		return(1);
	}
	return(0);
}

//--------------------------------------------------------------------------------
//キャラ体格に合わせた、リグのサイズ調整
global proc rigScale(){
//scale loaded_rig

	float $chsizey = `getAttr "*:jointroot_000.ty"`;	//腰の高さ取得
	$chsizey = $chsizey/122.105;		//122.105はrigのデフォ腰高さ
	//計算結果、1より大きい→足長
	//計算結果、1より小さい→足短
/*
	setAttr rig.sx (9.4*$chsizey);
	setAttr rig.sy (9.4*$chsizey);
	setAttr rig.sz (9.4*$chsizey);
*/

	spaceLocator -p 0 0 0 -n ArmLength_root;
	spaceLocator -p 0 0 0 -n ArmLength_tip;
	parent ArmLength_tip ArmLength_root ;

	select -r "*:J_L_wrist_30?" ArmLength_root ;
	pointConstraint -offset 0 0 0 -weight 1;
	select -r "*:J_L_upArm_30?" ArmLength_tip ;
	pointConstraint -offset 0 0 0 -weight 1;

	float $amsizey = `getAttr ArmLength_tip.ty`;
	$amsizey = $amsizey/51.292;
	$amsizey = $amsizey/$chsizey;		//ルートのスケール分をキャンセル

	setAttr rig.sx (9.4*$chsizey);
	setAttr rig.sy (9.4*$chsizey);
	setAttr rig.sz (9.4*$chsizey);
	setAttr rig_pelvis.sx (1*$amsizey);
	setAttr rig_pelvis.sy (1*$amsizey);
	setAttr rig_pelvis.sz (1*$amsizey);

	select -r ArmLength_root ;
	doDelete;
}

//--------------------------------------------------------------------------------
//ダミー階層をキャラ階層へ位置あわせ
//その後逆順へコンスト
global proc jointConnect(){
	//connect dummy-charajoint
	select -r -hi "*:jointroot_000";
	string $chjoints[] = `ls -sl -type joint`;
	int $i=0;
	for ( $i=0 ; $i<size($chjoints) ; $i++){
		string $divjlist[];
		int $lasjlist = `tokenize $chjoints[$i] ":" $divjlist`;
		$lasjlist--;
		string $chtgt = $divjlist[$lasjlist];	//キャラ側骨のショートネーム
		string $dmtgt = ("dummy_" + $chtgt);	//ダミー回想骨
		if( size(`ls $dmtgt`) <=2 ){
			select -r -hi dummy_root;
			string $tmp[] = `ls -sl $dmtgt`;
			$dmtgt = $tmp[0];
		}
		if (size(`ls $dmtgt`) > 0){
			select -r  ("*:" + $chtgt) $dmtgt;
		}
		if (size(` ls -sl `) == 2){
			pointConstraint -offset 0 0 0 -weight 1;
			pointConstraint -remove;
			select -r  $dmtgt ("*:" + $chtgt);
			pointConstraint -offset 0 0 0 -weight 1;
//			orientConstraint -offset 0 0 0 -weight 1;
			orientConstraint -mo -weight 1;
			scaleConstraint -mo -weight 1;
			select -cl;
		}
	}
	select -r dummy_root_1 "*:root" ;
	pointConstraint -mo -weight 1;
	
	select -r jointroot_000_orientConstraint1 jointroot_000_scaleConstraint1 ;
	delete;

}

