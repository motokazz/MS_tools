//--------------------------------------------------------------------------------
//レイヤー設定
//処理後のレイヤー表示、非表示を設定する
global proc laySetup(){
	string $layName = `objectLayer "*:root"`;
	setAttr ($layName + ".visibility") 0;

	$layName = `objectLayer "*:parts"`;
	setAttr ($layName + ".visibility") 1;
	setAttr ($layName + ".displayType") 2;

	$layName = `objectLayer "dummy_root"`;
	setAttr ($layName + ".visibility") 0;

	$layName = `objectLayer "rig_origin"`;
	setAttr ($layName + ".visibility") 1;
	setAttr ($layName + ".displayType") 0;
}

//--------------------------------------------------------------------------------
//完了報告
//エラーメッセージを返したいけれど、発生状況を想定できない
global proc endMes(){
	string $SSwindow = "CSSsystem";
	if ( `window -exists $SSwindow` != 1 ){
		confirmDialog -title "Auto rigging tool" -message ("作業が完了しました。")
		-button "OK" -defaultButton "OK"
		-cancelButton "OK" -dismissString "OK";
	}
}

//--------------------------------------------------------------------------------
//モデルデータ調整
//骨ロックとレイヤーを調整する
//他にも直す物があれば追加する予定
global proc GPAutoRigging_repairModelState(){
	//今の状態を一時保存
	string $rigFile[] = `file -q -r`;
	string $chrPass[];
	tokenize $rigFile[0] "/" $chrPass;
	int $max = `size($chrPass)`;
	$max--;
	for($i=1 ; $i<$max ; $i++){
		$chrPass[0] = ($chrPass[0] + "/" + $chrPass[$i]);
	}
	

	string $SSwindow = "CSSsystem";
	if ( `window -exists $SSwindow` != 1 ){
		confirmDialog -title "Auto rigging tool" -message ("モデルデータの調整を行います。\n" + ($chrPass[0] + "/Rigging_tmp.mb") + "に現在の状態を保存しました。")
		-button "OK" -defaultButton "OK"
		-cancelButton "OK" -dismissString "OK";
	}



	file -rename ($chrPass[0] + "/Rigging_tmp");
	file -f -s -options "v=0" -type "mayaBinary";

	//キャラモデルロード
	file -f -o -iv -options "v=0" -type "mayaBinary" $rigFile[0];
	
//骨ロック全解除
	select -r -hi "root";
	string $chjoints[] = `ls -sl -type joint`;
	string $attrList[] = {".tx",".ty",".tz",".rx",".ry",".rz",".sx",".sy",".sz"};
	for($i = 0 ; $i < size($chjoints) ; $i++ ){
		for($j = 0 ; $j < 9 ; $j++ ){
			setAttr -lock 0 ($chjoints[$i] + $attrList[$j]);
		}
	}

//レイヤー調整
	select -r -hi root parts;
	string $layName;
	string $chjoints[] = `ls -sl`;
	for($i = 0 ; $i < size($chjoints) ; $i++ ){
		$layName = `objectLayer $chjoints[$i]`;
		if($layName != "defaultLayer"){
			delete $layName;
		}
	}
	select -r parts ;
	createDisplayLayer -name "model" -number 1 ;
	select -r root ;
	createDisplayLayer -name "joint" -number 1 ;
	select -cl;

	file -f -s -options "v=0" -type "mayaBinary";

//作業完了として、元の状態を開きなおす
	file -f -o -options "v=0" -type "mayaBinary" ($chrPass[0] + "/Rigging_tmp.mb");
}
//--------------------------------------------------------------------------------
//全体処理
//rig機能の追加時は、ここに条件付で処理を組み込むこと
global proc rigAttach(){

//中断用オプション
	int $i, $percent;
	float $calCount = 0;
	progressWindow -title "Rigging_Status"
		-progress $percent
		-status "キャラジョイントのロックをチェック...: 0%"
		-isInterruptable false;

	int $lockCheck = GPAutoRigging_lockCheck();
		$i++;	$calCount = ( ($i * 100) / 14);	$percent = int( $calCount );
		progressWindow -e -progress $percent -status ("キャラデータのレイヤをチェック... : "+$percent+"%");

	int $layerCheck = GPAutoRigging_layerCheck();
		$i++;	$calCount = ( ($i * 100) / 14);	$percent = int( $calCount );
		progressWindow -e -progress $percent -status ("キャラデータのジョイント・レイヤ調整... : "+$percent+"%");

	if($lockCheck || $layerCheck){
		int $repFlag = `checkBox -q -v errorRepCb`;
		if($repFlag){
			GPAutoRigging_repairModelState();
		}else{
			return;
		}
	}
		$i++;	$calCount = ( ($i * 100) / 14);	$percent = int( $calCount );
		progressWindow -e -progress $percent -status ("リグのスケール調整... : "+$percent+"%");
	
	rigScale();
		print "rigScale() completed.\n";
		$i++;	$calCount = ( ($i * 100) / 14);	$percent = int( $calCount );
		progressWindow -e -progress $percent -status ("dummy⇒chara間のコンストレイン... : "+$percent+"%");

	jointConnect();
		print "jointConnect() completed.\n";
		$i++;	$calCount = ( ($i * 100) / 14);	$percent = int( $calCount );
		progressWindow -e -progress $percent -status ("dummy⇒rig間のコンストレインを削除... : "+$percent+"%");

	tmpBreak();
		print "tmpBreak() completed.\n";
		$i++;	$calCount = ( ($i * 100) / 14);	$percent = int( $calCount );
		progressWindow -e -progress $percent -status ("IKの有効化... : "+$percent+"%");

	ikSwitch();
		print "ikSwitch() completed.\n";
		$i++;	$calCount = ( ($i * 100) / 14);	$percent = int( $calCount );
		progressWindow -e -progress $percent -status ("リグ調整のフリーズ... : "+$percent+"%");

	rigFreeze();
		print "rigFreeze() completed.\n";
		$i++;	$calCount = ( ($i * 100) / 14);	$percent = int( $calCount );
		progressWindow -e -progress $percent -status ("rig⇒dummy間のコンストレイン... : "+$percent+"%");

	reConst();
		print "reConst() completed.\n";
		$i++;	$calCount = ( ($i * 100) / 14);	$percent = int( $calCount );
		progressWindow -e -progress $percent -status ("肩アーマー制御調整... : "+$percent+"%");

	GPAutoRiggingTool_sArmorSetup();
		print "sArmorSetup() completed.\n";
		$i++;	$calCount = ( ($i * 100) / 14);	$percent = int( $calCount );
		progressWindow -e -progress $percent -status ("バックパック処理... : "+$percent+"%");

	string $wcheck[] = `ls rig_Rwing_all_constlocator`;
	if(size($wcheck)){
		sfWingSetup();	//羽ありなら独自処理へ(ストフリ)
			print "sfWingSetup() completed.\n";
	}
		$i++;	$calCount = ( ($i * 100) / 14);	$percent = int( $calCount );
		progressWindow -e -progress $percent -status ("腿付け根調整... : "+$percent+"%");

	string $wcheck[] = `ls momocloser_waistpos`;
	if(size($wcheck)){
		GPAutoRigging_setupMC();
			print "GPAutoRigging_setupMC() completed.\n";
	}
		$i++;	$calCount = ( ($i * 100) / 14);	$percent = int( $calCount );


		progressWindow -e -progress $percent -status ("基本コントローラのロック調整... : "+$percent+"%");

	GPAutoRigging_setupHygoggArm();
		print "GPAutoRigging_setupHygoggArm() completed.\n";
		$i++;	$calCount = ( ($i * 100) / 14);	$percent = int( $calCount );

	
		progressWindow -e -progress $percent -status ("基本コントローラのロック調整... : "+$percent+"%");

	setAt();
		print "setAt() completed.\n";
		$i++;	$calCount = ( ($i * 100) / 14);	$percent = int( $calCount );
		progressWindow -e -progress $percent -status ("レイヤーの表示設定... : "+$percent+"%");

	laySetup();
		print "laySetup() completed.\n";
		$percent = 100;	progressWindow -e -progress $percent -status ("作業完了 : "+$percent+"%");

	endMes();
	progressWindow -endProgress;
}



//--------------------------------------------------------------------------------
//手の形状切り替え用

global proc int HandTypeSysSetupExec(){
/*
	if(size(`ls HandTypeSys`) > 0){
		return(1);
	}
*/
	string $a[] = `ls "*:root"`;
	if(size($a) > 1){
		return(2);//骨が大杉
	}else if(size($a) == 0){
		return(3);//骨なし
	}
	string $joints[] = {"J_R_handA_206" , "J_R_handB_207" , "J_R_handC_208" , "J_L_handA_306" , "J_L_handB_307" , "J_L_handC_308" };
	string $control[] = {"rig_r_wrist.HandType_R" , "rig_l_wrist.HandType_L"};
	string $command , $modelID;//	string $modelID;
	string $temp[];
	int $i;

	tokenize $a[0] ":" $temp;
	for($i = 0; $i < size($temp)-1; $i++){ $modelID = ($modelID + $temp[$i] + ":"); }

	$command = "if(`file -q -sn -shn` != \"_basepose.mb\"){\r\n";
		for($i = 0; $i < size($joints); $i++){
			$command = $command + ("\tif(" +  $control[$i/3] + " != " + ($i%3) + " ){\r\n");
				$command = $command + ("\t\t" + $modelID + $joints[$i] + ".scaleX = 0.001;\r\n");
				$command = $command + ("\t\t" + $modelID + $joints[$i] + ".scaleY = 0.001;\r\n");
				$command = $command + ("\t\t" + $modelID + $joints[$i] + ".scaleZ = 0.001;\r\n");
				$command = $command + ("\t}else{\r\n");
				$command = $command + ("\t\t" + $modelID + $joints[$i] + ".scaleX = 1.000;\r\n");
				$command = $command + ("\t\t" + $modelID + $joints[$i] + ".scaleY = 1.000;\r\n");
				$command = $command + ("\t\t" + $modelID + $joints[$i] + ".scaleZ = 1.000;\r\n");
				$command = $command + ("\t}\r\n");
		}
		$command = $command + ("}else{\r\n");
		for($i = 0; $i < size($joints); $i++){
			$command = $command + ("\t" + $modelID + $joints[$i] + ".scaleX = 1.000;\r\n");
			$command = $command + ("\t" + $modelID + $joints[$i] + ".scaleY = 1.000;\r\n");
			$command = $command + ("\t" + $modelID + $joints[$i] + ".scaleZ = 1.000;\r\n");
		}
		$command = $command + ("}\r\n");

	if(size(`ls HandTypeSys`) == 0){
		//初回限定処理
		addAttr -ln "HandType_R"  -at "enum" -en "グー:手刀:シャイニングフィンガー:"  rig_r_wrist;
		setAttr -e -keyable true rig_r_wrist.HandType_R;
		addAttr -ln "HandType_L"  -at "enum" -en "グー:手刀:シャイニングフィンガー:"  rig_l_wrist;
		setAttr -e -keyable true rig_l_wrist.HandType_L;
		spaceLocator -p 0 0 0 -n HandTypeSys;
		parent HandTypeSys etc ;
		expression -s $command -ae 1 -o HandTypeSys -uc all ;
		return(0);
	}else{
		//2回目以降処理
		string $getInfo = $modelID + $joints[0] + ".scaleX";
		if (`connectionInfo -isDestination $getInfo`) {
			$getInfo = `connectionInfo -sourceFromDestination $getInfo`;
			tokenize $getInfo "." $temp;
			expression -e -s $command $temp[0];
		}else{
			expression -s $command -ae 1 -o HandTypeSys -uc all ;
		}
		return(1);
	}
}

//--------------------------------------------------------------------------------
//手の形状切り替え用
global proc HandTypeSysSetup(){
	string $SSwindow = "CSSsystem";
	if ( `window -exists $SSwindow` != 1 ){
		confirmDialog -title "Auto rigging tool" -message ("現在開いているリグに、手形状の切り替え機構を追加します。")
		-button "OK" -defaultButton "OK"
		-cancelButton "OK" -dismissString "OK";
	}
	int $res = HandTypeSysSetupExec();
	string $mes;
	switch($res){
	case 0:
		$mes = "正常に処理が行われました。";
		break;
	case 1:
		$mes = "ノード「HandTypeSys」が見つかりました。\r\n既に処理が行われている可能性があります。\r\nエクスプレッションのみ、最新版に更新しました。";
		break;
	case 2:
		$mes = "ノード「root」が2つ以上見つかりました。\r\n処理対象のキャラクターが2体以上いる可能性があります。";
		break;
	case 3:
		$mes = "ノード「root」が見つかりませんでした。処理対象のキャラクターが検出できません。";
		break;
	}

	if ( `window -exists $SSwindow` != 1 || $res !=0 ){
		confirmDialog -title "Auto rigging tool" -message $mes
			-button "OK" -defaultButton "OK"
			-cancelButton "OK" -dismissString "OK";
	}
}


//--------------------------------------------------------------------------------
//(GP2)addrig階層のセットアップ
global proc aRT_GP2_connectAddrig(){
	string $sceneList[] = `file -q -shn -r`;
	string $charaID = basenameEx($sceneList[0]);

	file -r -type "mayaBinary" -gl -mergeNamespacesOnClash false -namespace "addrig" -options "v=0;" "M:/Design/Motions/MS/rig/full_rig/addrig.mb";

	if(size(`ls ("addrig:" + $charaID + "_ctrls")`)){
		setAttr "addrig:global_default_ctrl.translateY" 0;
		setAttr ("addrig:" + $charaID + "_ctrls.v") 1;

	//parent rigTop
		string $rigRoots[] = `listRelatives -type transform ("addrig:" + $charaID + "_ctrls")`;

		for($i=0 ; $i<size($rigRoots) ; $i++){
			string $jName = UT_cutUnuseByTokenize($rigRoots[$i] , ":" , 1 , 0);
			$jName = UT_cutUnuseByTokenize($jName , "_" , 0 , 1);
			if(size(`ls ($charaID + ":" + $jName)`)!= 0){
				select -r ($charaID + ":" + $jName);
				string $pList[] = `listRelatives -p ($charaID + ":" + $jName)`;
				select -r $pList[0] $rigRoots[$i];
				parentConstraint -mo -weight 1;
			}
		}

	//connect dummy-to-charaJoint
		string $dummyRoots[] = `listRelatives -type transform ("addrig:" + $charaID + "_dummyJoints")`;
		
		// GB4用の新機体IDの命名規則かどうかをチェック ※「_」の位置がズレるため
		int $gb4flag = 0;
		string $gb4CharaIDList[] = {"HG_*", "PG_*", "SD_*", "IF_*"};
		for($j=0 ; $j<size($gb4CharaIDList) ; $j++){
			if(`gmatch $charaID $gb4CharaIDList[$j]` != 0){
				$gb4flag = 1;
			}
		}

		for($i=0 ; $i<size($dummyRoots) ; $i++){
			string $charaJoint;
			if($gb4flag){
				// GB4新機体ID用
				$charaJoint = UT_cutUnuseByTokenize($dummyRoots[$i] , "_" , 3 , 0);
			}else{
				// 旧機体ID用
				$charaJoint = UT_cutUnuseByTokenize($dummyRoots[$i] , "_" , 2 , 0);
			}
			select -r ($charaID + ":" + $charaJoint) $dummyRoots[$i];
			parentConstraint  -weight 1;
		}

		select -r -hi ("addrig:" + $charaID + "_dummyJoints");
		select -d ("addrig:" + $charaID + "_dummyJoints") $dummyRoots;
		string $dummys[] = `ls -sl -type joint`;

		for($i=0 ; $i<size($dummys) ; $i++){
			string $charaJoint = UT_cutUnuseByTokenize($dummys[$i] , "_" , 1 , 0);
			if(size(`ls ($charaID + ":" + $charaJoint)`)!= 0){
				select -r $dummys[$i] ($charaID + ":" + $charaJoint);
				parentConstraint -mo -weight 1;
			}
		}
		setAttr "addrig:global_default_ctrl.translateY" 100;
	}else{
		print("addrigをロードしました。専用のコントローラはありません。\n");
	}
}




//shield_rigging
global proc GP2_setupShieldRig(){
	file -import -type "mayaBinary" -mergeNamespacesOnClash false -rpr "shield_rig" -options "v=0;"  -pr "M:/Design/Motions/MS/rig/full_rig/shields.mb";
	parent rig_shields rig ;
	select -r rig_l_shield rig_shields ;
	parentConstraint -weight 1;

	string $shie[] = {"elbow","S","M","L","XL","XXL"};
	string $axis[] = {"X","Y","Z"};
	for($size in $shie){
		for($jiku in $axis){
			setDrivenKeyframe -currentDriver addrig:global_default_getnum_child.translateY ("shield_" + $size + "_cal.rotate" + $jiku);
		}
	}
	setAttr "addrig:global_default_ctrl.translateY" 0;
	for($size in $shie){
		for($jiku in $axis){
			setAttr ("shield_" + $size + "_cal.rotate" + $jiku) 0;
			setDrivenKeyframe -currentDriver addrig:global_default_getnum_child.translateY ("shield_" + $size + "_cal.rotate" + $jiku);
		}
	}
	setAttr "addrig:global_default_ctrl.translateY" 100;

	setAttr "rig_shields.visibility" 0;
}



global proc string UT_cutUnuseByTokenize(string $tgt , string $letter , int $unuseSt , int $unuseEd){
	string $res;
	string $temp[];
	tokenize $tgt $letter $temp;
	string $res = $temp[$unuseSt];
	$unuseSt++;
	int $max = size($temp) - $unuseEd;
	for($p=$unuseSt ; $p < $max ; $p++){
		$res = ($res + $letter + $temp[$p]);
	}
	return $res;
}

global proc string UT_getNumberdByTokenize(string $tgt , string $letter , int $num){
	string $temp[];
	tokenize $tgt $letter $temp;
	string $res = $temp[$num];
	return $res;
}



//--------------------------------------------------------------------------------
//UI周り
global proc AutoRigging(){
	string $title = "AutoRigging";
	string $RGwindow = "rigtool";

	if ( `window -exists $RGwindow` )
	{
		deleteUI	$RGwindow;
	}
	string $ARTversion = getVersion();
	window  -t ($title + "   " + $ARTversion) -w 208 -h 130 $RGwindow;

	string $Numset = `formLayout`;
		string $b0 = `button -w 200 -h 30 -l "Import Rig-file" iptRigBtn`;
		string $b1 = `button -w 200 -h 30 -l "reference Character-file" refChrBtn`;
		string $b2 = `button -w 200 -h 30 -l "Rig Setup!" atcRigBtn`;
		string $b3 = `button -w 200 -h 30 -l "HandRigSystem Setup" atcHandBtn`;
		string $b4 = `button -w 200 -h 30 -l "AddRig Setup" atcAddBtn`;
		string $b5 = `button -w 200 -h 30 -l "sized-ShieldRig Setup" sldSetupBtn`;
		string $c0 = `checkBox -w 200 -h 12 -v 1 -l "エラー発生時、自動調整" errorRepCb`;

		button -edit -command "rigImport();" -ann "リグデータをインポートします。" iptRigBtn;
		button -edit -command "chrImport();" -ann "キャラデータをリファレンスします。" refChrBtn;
		button -edit -command "rigAttach();" -ann "リグとキャラクターを接続します。" atcRigBtn;
		button -edit -command "HandTypeSysSetup();" -ann "手の切り替え機能の設定を行います。" atcHandBtn;
		button -edit -command "aRT_GP2_connectAddrig();" -ann "全機体用追加リグの設定を行います。" atcAddBtn;
		button -edit -command "GP2_setupShieldRig();" -ann "サイズ別盾コントローラの設定を行います。" sldSetupBtn;
		checkBox -edit -ann "骨のロック・レイヤー状態を確認し、調整を行います" errorRepCb;
//	setParent ..;
	formLayout -edit
		-attachForm	$b0	"top"	0
		-attachForm	$b0	"left"   0
		-attachNone	$b0	"bottom"
		-attachForm	$b0	"right" 0

		-attachControl	$b1	"top" 0 $b0
		-attachForm	$b1	"left" 0
		-attachNone	$b1	"bottom"
		-attachForm	$b1	"right" 0

		-attachControl	$b2	"top" 0 $b1
		-attachForm	$b2	"left" 0
		-attachNone	$b2	"bottom"
		-attachForm	$b2	"right" 0

		-attachControl	$c0	"top" 0 $b2
		-attachForm	$c0	"left" 0
		-attachNone	$c0	"bottom" 
		-attachForm	$c0	"right" 0

		-attachControl	$b3	"top" 0 $c0
		-attachForm	$b3	"left" 0
		-attachNone	$b3	"bottom"
		-attachForm	$b3	"right" 0

		-attachControl	$b4	"top" 0 $b3
		-attachForm	$b4	"left" 0
		-attachNone	$b4	"bottom"
		-attachForm	$b4	"right" 0

		-attachControl	$b5	"top" 0 $b4
		-attachForm	$b5	"left" 0
		-attachForm	$b5	"bottom" 0
		-attachForm	$b5	"right" 0
	$Numset;

	showWindow $RGwindow;
}
