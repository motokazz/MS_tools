lder.rpz","rig_r_arm.rpz","rig_r_elbow.rpz","rig_r_wrist.rpz","rig_l_collor.rpz","rig_l_shoulder.rpz","rig_l_arm.rpz","rig_l_elbow.rpz","rig_l_wrist.rpz","rig_r_foot.rpz","rig_r_ankle.rpz","rig_l_foot.rpz","rig_l_ankle.rpz","rig_l_sArmor.rpz","rig_r_sArmor.rpz","rig_l_knee_polevector.rpz","rig_r_knee_polevector.rpz","rig_l_knee.rpz","rig_r_knee.rpz","rig_l_shield.rpz","rig_l_weapon.rpz","rig_r_weapon.rpz","rig_l_kataP.rpz","rig_r_kataP.rpz","rig_l_foot_armor.rpz","rig_r_foot_armor.rpz","rig_booster.rpz","rig_r_momo_closeControl.rpz","rig_l_momo_closeControl.rpz","rig_c_skirtF.rpz"};

	for($lockAttr in $lockAt){
		setAttr -lock true $lockAttr;
	}

	//膝PVをデフォルトローカル化
	setAttr "rig_r_knee_polevector.Parent" 1;
	setAttr "rig_l_knee_polevector.Parent" 1;


	select -r dummy_J_R_upArm_201_constlocator dummy_J_L_upArm_301_constlocator ;
	doDelete;
}


//--------------------------------------------------------------------------------
//足付け根スライド機能
//1204　追加
global proc GPAutoRigging_setupMC(){
//計算=足を開いた際に付け根が中央方向へスライド
//サブ階層の追従を解除
	select -r momo_l_offset_pointConstraint1 momo_r_offset_pointConstraint1 ;
	doDelete;
	select -r rig_r_momo_closeControl_dummy_pointConstraint1 rig_l_momo_closeControl_dummy_pointConstraint1 ;
	doDelete;
	select -r "subIK_*_pointConstraint1";
	doDelete;
	select -r footIKPos_l_offset_pointConstraint1 footIKPos_r_offset_pointConstraint1 ;
	doDelete;

//自動計算ノードをコントローラ上に接続
	select -r momo_l_driven rig_l_momo_closeControl_dummy ;
	pointConstraint -offset 0 0 0 -weight 1;

	select -r momo_r_driven rig_r_momo_closeControl_dummy ;
	pointConstraint -offset 0 0 0 -weight 1;

//本IKのコントローラでサブIKも制御
	select -r rig_l_ankle subIK_l_foot ;
	pointConstraint -offset 0 0 0 -weight 1;
	select -r rig_l_knee_polevector subIK_l_foot ;
	poleVectorConstraint -weight 1;

	select -r rig_r_ankle subIK_r_foot ;
	pointConstraint -offset 0 0 0 -weight 1;
	select -r rig_r_knee_polevector subIK_r_foot ;
	poleVectorConstraint -weight 1;

//サブIK起動
	select -r subIK_l_foot ;
	ikHandle -e -eh;
	select -r subIK_r_foot ;
	ikHandle -e -eh;

//サブIKから計算されたノードに追従するコントローラを、本IKに接続
	select -r rig_r_momo_closeControl dummy_J_R_upLeg_420 ;
	pointConstraint -offset 0 0 0 -weight 1;

	select -r rig_l_momo_closeControl dummy_J_L_upLeg_430 ;
	pointConstraint -offset 0 0 0 -weight 1;

	string $lockAt[] = {
		"rig_r_momo_closeControl.rx", "rig_r_momo_closeControl.ry", "rig_r_momo_closeControl.rz",
		"rig_l_momo_closeControl.rx", "rig_l_momo_closeControl.ry", "rig_l_momo_closeControl.rz"};

	for($lockAttr in $lockAt){
		setAttr -lock true $lockAttr;
	}
}


//--------------------------------------------------------------------------------
//ハイゴッグ腕用・双方向接続
global proc GPAutoRigging_setupHygoggArm(){

	select -r getAttr_R_offset_pointConstraint1 getAttr_L_offset_pointConstraint1 getAttr_L_pv_offset_pointConstraint1 getAttr_R_pv_offset_pointConstraint1 J_R_upArm_201_offset_pointConstraint1 J_L_upArm_301_offset_pointConstraint1 ;
	doDelete;


	select -r dummy_J_R_shoulder_200 getAttr_R_offset;
	parentConstraint -mo -weight 1;
	select -r dummy_J_R_shoulder_200 getAttr_R_pv_offset;
	parentConstraint -mo -weight 1;
	select -r dummy_J_R_shoulder_200 J_R_upArm_201_offset;
	parentConstraint -mo -weight 1;
	select -r dummy_J_L_shoulder_300 getAttr_L_offset;
	parentConstraint -mo -weight 1;
	select -r dummy_J_L_shoulder_300 getAttr_L_pv_offset;
	parentConstraint -mo -weight 1;
	select -r dummy_J_L_shoulder_300 J_L_upArm_301_offset;
	parentConstraint -mo -weight 1;



	select -r primeIK_dummy_J_R_upArm_201 dummy_J_R_upArm_201 ;
	orientConstraint -mo -weight 1;
	select -r primeIK_dummy_J_R_elbow_202 dummy_J_R_elbow_202 ;
	orientConstraint -mo -weight 1;
	select -r primeIK_dummy_J_R_foreArm_203 dummy_J_R_foreArm_203 ;
	orientConstraint -mo -weight 1;

	select -r primeIK_dummy_J_L_upArm_301 dummy_J_L_upArm_301;
	orientConstraint -mo -weight 1;
	select -r primeIK_dummy_J_L_elbow_302 dummy_J_L_elbow_302;
	orientConstraint -mo -weight 1;
	select -r primeIK_dummy_J_L_foreArm_303 dummy_J_L_foreArm_303;
	orientConstraint -mo -weight 1;


	select -r dummy_J_R_upArm_201 subarm_r_dummyConnector;
	orientConstraint -offset 0 0 0 -weight 1;
	orientConstraint -remove;
	select -r subarm_r_dummyConnector dummy_J_R_upArm_201;
	orientConstraint -offset 0 0 0 -weight 1;

	select -r dummy_J_L_upArm_301 subarm_l_dummyConnector;
	orientConstraint -offset 0 0 0 -weight 1;
	orientConstraint -remove;
	select -r subarm_l_dummyConnector dummy_J_L_upArm_301;
	orientConstraint -offset 0 0 0 -weight 1;

	expression -s "dummy_J_L_upArm_301_orientConstraint1.primeIK_dummy_J_L_upArm_301W0 = (1 - subArm_L_ctrl.ctrl_switch);\ndummy_J_L_upArm_301_orientConstraint1.subarm_l_dummyConnectorW1 = subArm_L_ctrl.ctrl_switch;\ndummy_J_R_upArm_201_orientConstraint1.primeIK_dummy_J_R_upArm_201W0 = (1 - subArm_R_ctrl.ctrl_switch);\ndummy_J_R_upArm_201_orientConstraint1.subarm_r_dummyConnectorW1 = subArm_R_ctrl.ctrl_switch;"  -o rig_R_elbow_pos -ae 1 -uc all ;
}

//--------------------------------------------------------------------------------
//肩アーマー、x:yzブレンド値調整
//腕の長さから発生しうる最大値を取り、0.9をmax、0.1をminとする。
global proc GPAutoRiggingTool_sArmorSetup(){
	float $x = `getAttr rig_r_sArmor_weightDriver.tx `;
	$x = `pow $x 2`;

	float $y = `getAttr rig_r_sArmor_weightDriver.ty `;
	$y = `pow $y 2`;

	float $z = sqrt ($x + $y);

	keyframe -option over -index 0 -absolute -floatChange ($z * -0.9) -valueChange 0 rig_r_sArmor_rotSwitch_xRotW0 ;
	keyframe -option over -index 1 -absolute -floatChange ($z * -0.1) -valueChange 1 rig_r_sArmor_rotSwitch_xRotW0 ;
	keyframe -option over -index 0 -absolute -floatChange ($z * -0.9) -valueChange 1 rig_r_sArmor_rotSwitch_yRotW1 ;
	keyframe -option over -index 1 -absolute -floatChange ($z * -0.1) -valueChange 0 rig_r_sArmor_rotSwitch_yRotW1 ;

	keyframe -option over -index 0 -absolute -floatChange ($z * 0.1) -valueChange 1 rig_l_sArmor_rotSwitch_xRotW1 ;
	keyframe -option over -index 1 -absolute -floatChange ($z * 0.9) -valueChange 0 rig_l_sArmor_rotSwitch_xRotW1 ;
	keyframe -option over -index 0 -absolute -floatChange ($z * 0.1) -valueChange 0 rig_l_sArmor_rotSwitch_yRotW0 ;
	keyframe -option over -index 1 -absolute -floatChange ($z * 0.9) -valueChange 1 rig_l_sArmor_rotSwitch_yRotW0 ;
}

//--------------------------------------------------------------------------------
//ストライクフリーダムガンダム、翼処理
//wingではなくBPRなどが良いかと思われる
global proc sfWingSetup(){
	sfWingConnect();
	select -r rig_Rwing_all_constlocator rig_Lwing_all_constlocator ;
	group -n "rot_cansel"; xform -os -piv 0 0 0 ;

	select -r "*:J_mune_001" ;
	string $tgname[] = `ls -sl`;
	spaceLocator -p 0 0 0 -n "allWing_connect";
	select -r $tgname[0] "allWing_connect";
	pointConstraint -offset 0 0 0 -weight 1;
	orientConstraint -offset 0 0 0 -weight 1;

	select -r rot_cansel rig_Rwing_group ;
	parentConstraint -mo -weight 1;
	select -r rot_cansel rig_Lwing_group ;
	parentConstraint -mo -weight 1;

	parent rot_cansel allWing_connect ;
	parent allWing_connect etc ;
	//レイヤーに追加
	select -r rig_Rwing_all rig_Rwing00 rig_RwingF01 rig_RwingF02A rig_RwingF02B rig_RwingB01 rig_RwingB02A rig_RwingB02B rig_Lwing_all rig_Lwing00 rig_LwingF01 rig_LwingF02A rig_LwingF02B rig_LwingB01 rig_LwingB02A rig_LwingB02B ;
	editDisplayLayerMembers -noRecurse CH_rig_layer `ls -selection`;
	$createSetResult = `sets -name "selection_set_wing"`;
}

