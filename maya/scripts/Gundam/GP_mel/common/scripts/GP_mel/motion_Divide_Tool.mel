				string $tf_MHME_2 = (`textFieldButtonGrp -cl3 left both right -cw3 120 440 100 -label "コピー先機体フォルダ" -text $mayaPass -ann "直下のフォルダからキャラ一覧を取得し、ホール機体_rigbase.mbを使って出力を行います。" -buttonLabel "Edit" MHME_tgtCharaTF`);
				string $tx_MHME_1 = `text -label "■対象キャラ" -ann "(以下のキャラクターに、[コピー元リグ選択]にて選ばれたモーションがインポート・出力されます。)"`;

//				string $tx_MHME_2 = `text -label "" -align "left" MHME_charaList`;
