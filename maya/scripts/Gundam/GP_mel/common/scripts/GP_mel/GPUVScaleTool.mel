//--------------------------------------------------------------------------------
global proc GP2_UST_setupBC(){
	string $mode = `radioCollection -q -select GP2_UST_modeRC`;
	string $imgIcon,$command;
	if($mode == "GP2_UST_smallRB"){
		$imgIcon = (`getenv "GP_MAYA_ROOT"` + "\\common\\scripts\\GP_mel\\bmp\\scaleDown.png");
		$command = ("GPAdjustMSPartUVexe(\"small\" , " + 10 + ");");
		iconTextButton -e -image1 $imgIcon -c $command GP2UST_btn1;
		$command = ("GPAdjustMSPartUVexe(\"small\" , " + 11 + ");");
		iconTextButton -e -image1 $imgIcon -c $command GP2UST_btn2;
		$command = ("GPAdjustMSPartUVexe(\"small\" , " + 12 + ");");
		iconTextButton -e -image1 $imgIcon -c $command GP2UST_btn3;
		$command = ("GPAdjustMSPartUVexe(\"small\" , " + 7 + ");");
		iconTextButton -e -image1 $imgIcon -c $command GP2UST_btn4;
		$command = ("GPAdjustMSPartUVexe(\"small\" , " + 8 + ");");
		iconTextButton -e -image1 $imgIcon -c $command GP2UST_btn5;
		$command = ("GPAdjustMSPartUVexe(\"small\" , " + 9 + ");");
		iconTextButton -e -en 0 -image1 $imgIcon -c $command GP2UST_btn6;
	}else{
		$imgIcon = (`getenv "GP_MAYA_ROOT"` + "\\common\\scripts\\GP_mel\\bmp\\scaleUp.png");
		$command = ("GPAdjustMSPartUVexe(\"big\" , " + 4 + ");");
		iconTextButton -e -image1 $imgIcon -c $command GP2UST_btn1;
		$command = ("GPAdjustMSPartUVexe(\"big\" , " + 5 + ");");
		iconTextButton -e -image1 $imgIcon -c $command GP2UST_btn2;
		$command = ("GPAdjustMSPartUVexe(\"big\" , " + 6 + ");");
		iconTextButton -e -image1 $imgIcon -c $command GP2UST_btn3;
		$command = ("GPAdjustMSPartUVexe(\"big\" , " + 1 + ");");
		iconTextButton -e -image1 $imgIcon -c $command GP2UST_btn4;
		$command = ("GPAdjustMSPartUVexe(\"big\" , " + 2 + ");");
		iconTextButton -e -image1 $imgIcon -c $command GP2UST_btn5;
		$command = ("GPAdjustMSPartUVexe(\"big\" , " + 3 + ");");
		iconTextButton -e -en 1 -image1 $imgIcon -c $command GP2UST_btn6;
	}

}
//UI周り
global proc GPUVScaleTool(){
	string $title = "GP2_uv_scaleTool";
	string $USwindow = "uvScaleTool";

	if ( `window -exists $USwindow` )
	{
		deleteUI	$USwindow;
	}
	string $USTversion = getVersion();
	window  -t ($title + "   " + $USTversion) -w 208 -h 130 $USwindow;
	string $imgIcon = (`getenv "GP_MAYA_ROOT"` + "\\common\\scripts\\GP_mel\\bmp\\scaleUp.png");
	string $baseLayout = `columnLayout`;
		string $modeSwitch = `rowLayout -numberOfColumns 2 -columnWidth2 96 96
	    -adjustableColumn 1
	    -columnAlign  1 "left"
	    -columnAlign  2 "left"
	    -columnAttach 1 "both" 0
	    -columnAttach 2 "both" 0`;
			string $collection1 = `radioCollection GP2_UST_modeRC`;
			string $rb1, $rb2;
			$rb1 = `radioButton -label "縮小" -cc "GP2_UST_setupBC()" GP2_UST_smallRB`;
			$rb2 = `radioButton -select -label "拡大" -cc "GP2_UST_setupBC()" GP2_UST_bigRB`;
		setParent ..;

		string $btnGroupUp = `rowLayout -numberOfColumns 3 -columnWidth3 64 64 64
		-adjustableColumn 1
		-columnAlign  1 "left"
		-columnAlign  2 "left"
		-columnAlign  3 "left"
		-columnAttach 1 "both" 0
		-columnAttach 2 "both" 0
		-columnAttach 3 "both" 0`;
			string $btn1, $btn2,$btn3;
			$btn1 = `iconTextButton -w 64 -h 64 -bgc 0 0 1 -style "iconAndTextVertical" -image1 $imgIcon -label "Head" GP2UST_btn1`;
			$btn2 = `iconTextButton -w 64 -h 64 -bgc 0 1 1 -style "iconAndTextVertical" -image1 $imgIcon -label "Body" GP2UST_btn2`;
			$btn3 = `iconTextButton -w 64 -h 64 -bgc 0 0.48 0.2578 -style "iconAndTextVertical" -image1 $imgIcon -label "Backpack" GP2UST_btn3`;
		setParent ..;

		string $btnGroupDown = `rowLayout -numberOfColumns 2 -columnWidth2 128 64
		-adjustableColumn 1
		-columnAlign  1 "left"
		-columnAlign  2 "left"
		-columnAttach 1 "both" 0
		-columnAttach 2 "both" 0`;
			string $btn4, $btn5;
			$btn4 = `iconTextButton -w 130 -h 64 -bgc 1 0 0 -style "iconAndTextVertical" -image1 $imgIcon -label "Foot" GP2UST_btn4`;
			$btn5 = `iconTextButton -w 64 -h 64 -bgc 1 1 0 -style "iconAndTextVertical" -image1 $imgIcon -label "Arm" GP2UST_btn5`;
		setParent ..;
	string $btn6;
	$btn6 = `iconTextButton -vis 0 -w 196 -h 64 -style "iconAndTextVertical" -image1 $imgIcon -label "Auto" GP2UST_btn6`;
	GP2_UST_setupBC();
	showWindow $USwindow;
}


