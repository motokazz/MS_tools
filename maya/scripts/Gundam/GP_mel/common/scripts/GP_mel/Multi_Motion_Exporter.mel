global proc Multi_Motion_ExporterWindow(string $MME_csvSaveFileName){
	string $ut = ("source \"" + `getenv "GP_MAYA_ROOT"` + "\\\\common\\\\scripts\\\\GP_mel\\\\subscripts\\\\GP2_Ut.mel\"");
	eval $ut;

	string $title = "Multi_Motion_Exporter";
	string $MEwindow = "MCMEtool";

	if ( `window -exists $MEwindow` )
	{
		deleteUI	$MEwindow;
	}

	string $MMEversion = getMMEVersion();
	window  -t ($title + "   " + $MMEversion) -menuBar true -w 200 -h 90 $MEwindow;
	string $srcDefPass;
	string $daeDefPass;
	string $cvtDefPass;
//--------------------------
	//$srcDefPass = "S:\\motion\\maya\\";
	//$daeDefPass = "S:\\motion\\collada\\";
	//$cvtDefPass = "C:\\GP\\trunk\\resource\\original\\GP\\motion\\";
	$srcDefPass = "C:\\work\\GB4作業＆データ\\GB4\\GB4motion_0412\\cmnMotion0412\\";
	$daeDefPass = "";
	$cvtDefPass = "";
//--------------------------

	string $formL = `formLayout -numberOfDivisions 100`;
	string $ioset = `frameLayout -label "input/output Pass" -labelAlign "top" -borderStyle "etchedIn" passLo`;
		string $pathset = `columnLayout`;
			string $tf1 = (`textFieldButtonGrp -cl3 left both right -cw3 125 450 100 -label "Source Project Path" -text $srcDefPass -ann "全身キャラクターのプロジェクトが存在するパスを指定して下さい。" -buttonLabel "Edit" sourcePassTf`);
			string $tf2 = (`textFieldButtonGrp -cl3 left both right -cw3 125 450 100 -label "dae Folder Path" -text $daeDefPass -ann "キャラ別colladaフォルダの保存先を指定して下さい。" -buttonLabel "Edit" daePassTf`);
			string $tf3 = (`textFieldButtonGrp -cl3 left both right -cw3 125 450 100 -label "Convert Path" -text $cvtDefPass -ann ".gmpファイルの保存先を指定して下さい。" -buttonLabel "Edit" cvtPassTf`);
			string $tc1 = `textFieldButtonGrp -edit -bc ("$srcDefPass = `textFieldButtonGrp -q -text sourcePassTf` ; $srcDefPass = `fromNativePath $srcDefPass` ; workspace -dir $srcDefPass ; fileBrowserDialog -mode 4 -fileType \"directory\" -actionName \"キャラクターのプロジェクトを格納したフォルダを指定して下さい。\" -fileCommand \"setTextfData(\\\"sourcePassTf\\\")\" ") sourcePassTf`;
			string $tc2 = `textFieldButtonGrp -edit -bc ("$daeDefPass = `textFieldButtonGrp -q -text daePassTf` ; $daeDefPass = `fromNativePath $daeDefPass` ; workspace -dir $daeDefPass ; fileBrowserDialog -mode 4 -fileType \"directory\" -actionName \"キャラ別のcolladaフォルダを格納したフォルダを指定して下さい。\" -fileCommand \"setTextfData(\\\"daePassTf\\\")\" ") daePassTf`;
			string $tc3 = `textFieldButtonGrp -edit -bc ("$cvtDefPass = `textFieldButtonGrp -q -text cvtPassTf` ; $cvtDefPass = `fromNativePath $cvtDefPass` ; workspace -dir $cvtDefPass ; fileBrowserDialog -mode 4 -fileType \"directory\" -actionName \"キャラ別出力を行う際の、対象フォルダを指定して下さい。\" -fileCommand \"setTextfData(\\\"cvtPassTf\\\")\" ") cvtPassTf`;
			string $cb_teamExpt01 = `checkBox -v 0 -vis 0 -label "enable_TeamExportSystem" cbBE01`;
			string $cb_setting01 = `checkBox -v 1 -vis 0 -label "setting_checkDrowedMbFile" cbSTcheckBtn`;
			string $cb_setting02 = `checkBox -v 1 -vis 0 -label "setting_checkAnnounceEdits" cbcdIgnoreDialogBtn`;
		setParent ..;
	setParent ..;
//--------------------------
	string $ExPset = `frameLayout -label "input/output Pass" -labelAlign "center" -borderStyle "etchedIn" ipopLo`;
		string $ExProject = `formLayout`;
			string $tit1 = `text -label "キャラクターリスト"`;
			string $tslA = `textScrollList -w 300 -h 400 -shi 1 -ams 1 -ann "選択されたキャラが右欄に入ります" cPJList`;
			$IDAppendList= cPJListGet($srcDefPass);
			$work= ("textScrollList -e " + $IDAppendList + " cPJList" );
			eval( $work );
			string $srcLay = `columnLayout -w 90 -h 120 `;
				string $exportModeRc = `radioCollection exportModeRc`;
				string $allRb = `radioButton -label "ホール機体・全パーツ一括" -select expAllRb`;
				string $prtRb = `radioButton -label "個別選択" expPrtRb`;
				string $allc = `rowLayout -numberOfColumns 2 -columnWidth2 15 150 -adjustableColumn 2`;
					text -label "├";	string $cb1 = `checkBox -label "ホール機体(chr---0)" -v 1 -en 0 c0`;	setParent ..;
				string $headc = `rowLayout -numberOfColumns 2 -columnWidth2 15 150 -adjustableColumn 2`;
					text -label "├";	string $cb2 = `checkBox -label "頭(chr---2)" -v 1 -en 0 c2`;	setParent ..;
				string $larmc = `rowLayout -numberOfColumns 2 -columnWidth2 15 150 -adjustableColumn 2`;
					text -label "├";	string $cb3 = `checkBox -label "右腕(chr---3)" -v 1 -en 0 c3`;	setParent ..;
				string $rarmc = `rowLayout -numberOfColumns 2 -columnWidth2 15 150 -adjustableColumn 2`;
					text -label "├";	string $cb4 = `checkBox -label "左腕(chr---4)" -v 1 -en 0 c4`;	setParent ..;
				string $undrc = `rowLayout -numberOfColumns 2 -columnWidth2 15 150 -adjustableColumn 2`;
					text -label "├";	string $cb5 = `checkBox -label "下半身(chr---5)" -v 1 -en 0 c5`;	setParent ..;
				string $backc = `rowLayout -numberOfColumns 2 -columnWidth2 15 150 -adjustableColumn 2`;
					text -label "├";	string $cb6 = `checkBox -label "バックパック(chr---6)" -v 1 -en 0 c6`;	setParent ..;
				string $bodyc = `rowLayout -numberOfColumns 2 -columnWidth2 15 150 -adjustableColumn 2`;
					text -label "└";	string $cb7 = `checkBox -label "胴体(chr---7)" -v 1 -en 0 c7`;	setParent ..;
				string $prtRb = `radioButton -label "ホール機体・全パーツ一括(Div-Exp)" expFullRb`;
				radioButton -e -onc ("checkBox -e -en 0 c0;checkBox -e -en 0 c2;checkBox -e -en 0 c3;checkBox -e -en 0 c4;checkBox -e -en 0 c5;checkBox -e -en 0 c6;checkBox -e -en 0 c7;")expAllRb;
				radioButton -e -onc ("checkBox -e -en 1 c0;checkBox -e -en 1 c2;checkBox -e -en 1 c3;checkBox -e -en 1 c4;checkBox -e -en 1 c5;checkBox -e -en 1 c6;checkBox -e -en 1 c7;")expPrtRb;
				radioButton -e -onc ("checkBox -e -en 0 c0;checkBox -e -en 0 c2;checkBox -e -en 0 c3;checkBox -e -en 0 c4;checkBox -e -en 0 c5;checkBox -e -en 0 c6;checkBox -e -en 0 c7;")expFullRb;
			setParent ..;
			string $formLR = `formLayout -numberOfDivisions 100 formLeftRight`;
				string $btnLay = `columnLayout `;
					string $rightABtn = `button -label "All→" setB`;
					string $rightSBtn = `button -label "→" setSoloB`;
					string $leftBtn = `button -label "←" canselB`;
					button -edit -command "multiCharacterExporter_OnRightButton()" -ann "選択キャラ・パーツを出力リストへ追加します。" setB;
					button -edit -command "multiCharacterExporter_OnRightButton_Solo()" -ann "選択キャラ・パーツを出力リストへ追加します。" setSoloB;
					button -edit -command "multiCharacterExporter_OnLeftButton()" -ann "選択したキャラ・パーツを出力リストから削除します。" canselB;
				setParent ..;
				formLayout -edit
					-attachForm	$btnLay	"top" 150
					-attachForm	$btnLay	"left"15
					-attachNone	$btnLay	"bottom"
					-attachForm	$btnLay	"right" 15
				$formLR;
			setParent ..;

			string $tit2 = `text -label "出力モーション" expPartsTxt`;
			string $tslB = `textScrollList -w 300 -h 400 -shi 1 -ams 1 -ann "選択されたキャラ・パーツが処理されます" -dcc (" ; MCE_addSelection_ChildMotions($DCItem)") expPJList`;
			$IDAppendList= expPJListGet($MME_csvSaveFileName);
			$work= ("textScrollList -e " + $IDAppendList + " -dcc (\"string ; MCE_addSelection_ChildMotions($DCItem)\") expPJList" );
			eval( $work );
			string $selLay = `columnLayout -w 90 -h 120 `;
				string $allc = `rowLayout -numberOfColumns 3 -columnWidth3 60 60 100 -adjustableColumn 3`;
					string $expb1 = `button -label "all select" expListAsBtn`;
					string $expb2 = `button -label "all clear" expListClBtn`;
					string $expb3 = `button -label "clear UnSelected" expListClUsBtn`;
					button -edit -command "multiCharacterExport_expSceneItemAllSelect()" -ann "出力リストを全選択します。" expListAsBtn;
					button -edit -command "textScrollList -e -ra expPJList" -ann "出力リストを全削除します。" expListClBtn;
					button -edit -command "multiCharacterExport_expSceneItemClearUnSelect()" -ann "非選択アイテムを、リストから削除します。" expListClUsBtn;
				setParent ..;
			setParent ..;

			formLayout -edit 

				-attachForm	$tit1	"top" 5
				-attachForm	$tit1	"left"5
				-attachNone	$tit1	"bottom"
				-attachNone	$tit1	"right" 

				-attachControl	$tslA	"top" 0 $tit1
				-attachForm	$tslA	"left"5
				-attachControl	$tslA	"bottom" 5 $srcLay
				-attachControl	$tslA	"right" 5 $formLR

				-attachNone	$srcLay	"top"
				-attachForm	$srcLay	"left"5
				-attachForm	$srcLay	"bottom" 10
				-attachNone	$srcLay	"right" 

				-attachForm	$formLR	"top" 10
				-attachForm	$formLR	"bottom" 5
				-attachForm	$formLR	"left" 150 
				-attachNone	$formLR	"right" 

				-attachForm	$tit2	"top" 5
				-attachControl	$tit2	"left" 5 $formLR
				-attachNone	$tit2	"bottom"
				-attachForm	$tit2	"right" 5

				-attachControl	$tslB	"top" 0 $tit2
				-attachControl	$tslB	"left" 5 $formLR
				-attachControl	$tslB	"bottom" 10 $selLay
				-attachForm	$tslB	"right"5

				-attachNone	$selLay	"top"
				-attachControl	$selLay	"left" 5 $formLR
				-attachForm	$selLay	"bottom" 5
				-attachForm	$selLay	"right" 5
			$ExProject;
			setParent ..;
		setParent ..;

	menu -label "Save-Load Settings";
	menuItem -label "save settings" saveBtn ;
	menuItem -label "load settings" loadBtn ;
	menuItem -edit -command "multiMotionExporter_saveCharaIDList($MME_csvSaveFileName)" -ann "出力リストをセーブします。" saveBtn;
	menuItem -edit -command "multiMotionExporter_loadCharaIDList($MME_csvSaveFileName)" -ann "出力リストをロードします。" loadBtn;
	
	menu -label "Buggers-Export System[OFF]" BEmenu;
	menuItem -label "複数PCでの出力を有効にする" BEBootBtn ;
	menuItem -label "指定パスのログファイルを削除" -en 0 BECleanBtn ;
	menuItem -label "エクスポート設定を出力" -en 0 BESaveBtn ;
	menuItem -label "エクスポート設定を取得" -en 0 BELoadBtn ;
	menuItem -edit -command "multiCharacterExport_switchBuggerSystem()" -ann "複数マシンでのエクスポート補助を有効化します。" BEBootBtn;
	menuItem -edit -command "multiMotionExporter_cleanLogFile(`textFieldButtonGrp -q -text daePassTf`)" -ann "出力確認用のログファイルを全削除します。" BECleanBtn;
	menuItem -edit -command "multiMotionExporter_saveCharaIDList(`textFieldButtonGrp -q -text daePassTf` + \"BuggersExportLog\\\\GpMultiCharaMotionExport.csv\")" -ann "出力リストをアップロードします。" BESaveBtn;
	menuItem -edit -command "multiMotionExporter_loadCharaIDList(`textFieldButtonGrp -q -text daePassTf` + \"BuggersExportLog\\\\GpMultiCharaMotionExport.csv\")" -ann "出力リストをダウンロードします。" BELoadBtn;
	
	menu -label "Settings" STmenu;
	menuItem -label "「→」ボタンを押した際、ファイル名・日付をチェック(現在有効)" STcheckBtn ;
	menuItem -label "gmpフォルダの生成時、エラーダイアログを表示しない(現在の設定:表示する)" cdIgnoreDialogBtn;
	menuItem -edit -command "multiCharacterExport_switchSettingSystem(\"STcheckBtn\")" -ann "出力対象のファイルをリストに追加する際、ファイル名とパーツ･ホール間の更新日付をチェックします。" STcheckBtn;
	menuItem -edit -command "multiCharacterExport_switchSettingSystem(\"cdIgnoreDialogBtn\")" -ann "「～gmpフォルダを作る」ボタンの動作を、告知で中断させずに進行させます。" cdIgnoreDialogBtn;
	
//--------------------------

	string $epTf = `textFieldGrp -cat 1 "left" 0 -cw 1 130 -label "■処理対象を名前で絞る" -ann"エクスポートおよびコンバート処理の対象を、名前で絞ります。半角スペースで複数入力した場合、どれかに該当したものが処理されます。" extgtTF`;
	string $b0 = `button -w 655 -h 30 -l "選択したキャラクター・パーツをエクスポート" exptBtn`;
	string $b3 = `button -w 655 -h 30 -l "選択したキャラ・パーツのdaeFolderからgmpフォルダを作る" sortBtn`;

	string $convertModeRc = `radioCollection convertModeRc`;
	string $chrRb = `radioButton -vis 0 -label "chr000（※旧仕様）" cvtChrRb`;
	string $gmpRb = `radioButton -vis 0 -label "chr0000\\chr0000_gmp000" -select cvtGmpRb`;

	string $b2 = `button -w 655 -h 30 -l "エクスポートしたデータをコンバート" cvtBtn`;
	button -edit -command "multiCharaMotionExport_motSelectable($sForm,`textFieldGrp -q -text extgtTF`);" -ann "指定キャラのモーションをcolladaへ出力します。" exptBtn;
	button -edit -command "mCME_colladaDirectorySetup_Confirm(\"\");" -ann "colladaデータを振り分けします。" sortBtn;
	button -edit -command "mCME_convertSwitch(`textFieldButtonGrp -q -text daePassTf` , `textFieldButtonGrp -q -text cvtPassTf`);" -ann "colladaデータをキャラ単位でコンバートします。" cvtBtn;



	formLayout -edit
	    -attachForm	$ioset	"top"    0
	    -attachForm	$ioset	"left"   15
	    -attachNone	$ioset	"bottom"
	    -attachForm	$ioset	"right" 15

	    -attachControl	$ExPset	"top" 2 $ioset
	    -attachForm	$ExPset	"left"   15
	    -attachControl	$ExPset	"bottom" 5 $epTf
	    -attachForm	$ExPset	"right" 15
	
	    -attachNone	$epTf	"top"
	    -attachForm	$epTf	"left"   15
	    -attachControl	$epTf	"bottom"  3 $b0
	    -attachForm	$epTf	"right" 15

	    -attachNone	$b0	"top"
	    -attachForm	$b0	"left"   15
	    -attachControl	$b0	"bottom"  2 $b3
	    -attachForm	$b0	"right" 15

	    -attachNone	$b3	"top"
	    -attachForm	$b3	"left"   15
	    -attachControl	$b3	"bottom"  2 $b2
	    -attachForm	$b3	"right" 15

	    -attachNone	$b2	"top"
	    -attachForm	$b2	"left"   15
	    -attachForm	$b2	"bottom" 15
	    -attachForm	$b2	"right" 15

	$formL;

	showWindow $MEwindow;
}
