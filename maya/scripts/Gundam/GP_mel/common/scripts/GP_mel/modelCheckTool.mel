global proc string[] mdlCheckTool_getUseMotionList(int $partsCtgr){
	string $useModelList[];
	switch ($partsCtgr){
		case 2:
			$useModelList={
				"0102","0112","0112","0112","0172","0182",
				"0212","0222","0232","0102","0102","0102","0282",
				"0302","0312","0322","0342","0362","0382","0392",
				"0402","0422","0442","0672","0472","0492",
				"0492","0512","0532","0532","0552","0552","0572","0582","0592",
				"0612","0672","0672","0672",
				"0722","0722","0762",
				"0102"
			};
			break;

		case 3:
			$useModelList={
				"0103","0113","0113","0173","0183",
				"0213","0223","0233","0103","0103","0103","0103","0283",
				"0303","0313","0323","0343","0363","0383","0393",
				"0403","0423","0443","0673","0473","0493",
				"0513","0533","0533","0553","0553",
				"0613","0623","0633","0673","0673","0673",
				"0723","0763",
				"0103","0113","0613"
			};
			break;

		case 4:
			$useModelList={
				"0104","0114","0114","0174","0184",
				"0214","0224","0234","0104","0104","0104","0104","0284",
				"0304","0314","0324","0344","0364","0384","0394",
				"0404","0424","0444","0674","0474","0494",
				"0514","0534","0534","0554","0554",
				"0614","0624","0634","0674","0674","0674",
				"0724","0764",
				"0104","0114","0614"
			};
			break;

		case 5:
			$useModelList={
				"0105","0115","0115","0115","0115","0175","0185","0115",
				"0115","0215","0225","0235","0105","0105","0105","0105","0285",
				"0305","0315","0325","0345","0365","0385","0395",
				"0405","0425","0675","0445","0675","0475","0495",
				"0515","0535","0535","0555","0555",
				"0615","0675","0675","0675",
				"0725","0765",
				"0225","0445"
			};
			break;

		case 6:
			$useModelList={
				"0106","0116","0116","0116","0176","0186","0116",
				"0216","0226","0236","0106","0106","0106","0286","0296",
				"0306","0316","0326","0346","0366","0376","0386","0396",
				"0406","0426","0436","0446","0466","0476","0496",
				"0516","0536","0536","0556","0556",
				"0616","0626","0636","0646","0676","0676","0676",
				"0726","0766",
				"0856"
			};
			break;

		case 7:
			$useModelList={
				"0107","0117","0117","0117","0177","0187",
				"0217","0227","0237","0107","0107","0107","0287",
				"0307","0317","0327","0347","0367","0387","0397",
				"0407","0427","0447","0477","0497",
				"0517","0537","0537","0557","0557",
				"0617","0677","0677","0677",
				"0727","0767"
			};
			break;

	}
	return($useModelList);
}



global proc modelCheckTool_execConnectionCheck(string $savePath , string $modelPath , string $motionPath){
	sysFile -md $savePath;
	modelConnectionChecker_compCheckScene($savePath,$modelPath);
	modelConnectionChecker_compConnectionScene($savePath,$motionPath);
	modelConnectionChecker_compPrintScene($savePath);
	confirmDialog -title "MotionDataChecker" -message ("作業が完了しました。" + $savePath + "\\images\\の画像を確認してください。") -button "OK";
}


//テキストフィールドのボタンから、データを指定された時の動作--------------------------------------------------------------------
global proc MoDeCh_setTextfData(string $textf , string $fileName, string $fileType){
	$fileName = `toNativePath( $fileName )`;
	$fileName = ($fileName + "\\");
	textFieldButtonGrp -e -text $fileName $textf;
}


global proc modelCheckTool(){
	string $savePathPrime = ("L:\\partsCheckProject\\scenes\\");
//	string $savePathPrime = ("L:\\partsCheckProject\\scenes\\" + `date -format "YYYY_MM_DD_hhmm"`);
	string $modelPath = "C:\\GP\\trunk\\resource\\original\\GP\\model\\";
	string $motionPath = "S:\\motion\\collada\\";
	
	string $title = "ModelDataCheckTool";
	string $MoDeChwindow = "ModelDataCheckTool";

	if ( `window -exists $MoDeChwindow` ){ deleteUI $MoDeChwindow;}

	window  -t ($title) -menuBar true -w 640 -h 300 $MoDeChwindow;

	//---------------------------------------------------------------------------------------------
		string $MoDeCh_frame = `frameLayout -labelAlign "top" -label "指定したフォルダ内のパーツモデル(.mdl.dae)にwaitモーションを流し込み、チェック用SSを撮影します。" -borderStyle "etchedIn" MoDeCh_frame`;
			string $MoDeCh_forms = `formLayout -numberOfDivisions 100`;
				string $tf_MoDeCh_1 = (`textFieldButtonGrp -cl3 left both right -cw3 120 440 100 -label "出力先フォルダ" -text $savePathPrime -ann "" -buttonLabel "Edit" MoDeCh_exptTf`);
				string $tf_MoDeCh_2 = (`textFieldButtonGrp -cl3 left both right -cw3 120 440 100 -label "モデルデータフォルダ" -text $modelPath -ann "" -buttonLabel "Edit" MoDeCh_ModTf`);
				string $tf_MoDeCh_3 = (`textFieldButtonGrp -cl3 left both right -cw3 120 440 100 -label "モーションcolladaフォルダ" -text $motionPath -ann "" -buttonLabel "Edit" MoDeCh_ColTf`);

				string $MoDeCh_b1 = `button -w 420 -h 30 -l "モデルデータチェック" modCheckBtn`;

				formLayout -edit

					-attachForm $tf_MoDeCh_1 "top"    10
					-attachForm $tf_MoDeCh_1 "left"   10
					-attachNone $tf_MoDeCh_1 "bottom"
					-attachForm $tf_MoDeCh_1 "right"  10

					-attachControl $tf_MoDeCh_2 "top"  5 $tf_MoDeCh_1
					-attachForm $tf_MoDeCh_2 "left"   10
					-attachNone $tf_MoDeCh_2 "bottom"
					-attachForm $tf_MoDeCh_2 "right"  10

					-attachControl $tf_MoDeCh_3 "top"  5 $tf_MoDeCh_2
					-attachForm $tf_MoDeCh_3 "left"   10
					-attachNone $tf_MoDeCh_3 "bottom"
					-attachForm $tf_MoDeCh_3 "right"  10

					-attachNone $MoDeCh_b1 "top"
					-attachForm $MoDeCh_b1 "left"   10
					-attachForm $MoDeCh_b1 "bottom" 10
					-attachForm $MoDeCh_b1 "right"  10
				$MoDeCh_forms;
				setParent ..;
			setParent ..;

	//---------------------------------------------------------------------------------------------


	button -edit -command "modelCheckTool_execConnectionCheck((`textFieldButtonGrp -q -text MoDeCh_exptTf` + `date -format \"YYYY_MM_DD_hhmm\"`) , `textFieldButtonGrp -q -text MoDeCh_ModTf` , `textFieldButtonGrp -q -text MoDeCh_ColTf`);" -ann "指定フォルダ内のモーションヘッダファイルチェックを行います。" modCheckBtn;
	string $tfc0 = `textFieldButtonGrp -edit -bc ("fileBrowserDialog -mode 4 -fileType \"directory\" -actionName \"select Folder\" -fileCommand \"MoDeCh_setTextfData(\\\"MoDeCh_exptTf\\\")\" ") MoDeCh_exptTf`;
	string $tfc1 = `textFieldButtonGrp -edit -bc ("fileBrowserDialog -mode 4 -fileType \"directory\" -actionName \"select Folder\" -fileCommand \"MoDeCh_setTextfData(\\\"MoDeCh_ModTf\\\")\" ") MoDeCh_ModTf`;
	string $tfc2 = `textFieldButtonGrp -edit -bc ("fileBrowserDialog -mode 4 -fileType \"directory\" -actionName \"select Folder\" -fileCommand \"MoDeCh_setTextfData(\\\"MoDeCh_ColTf\\\")\" ") MoDeCh_ColTf`;

	window -e -w 640 -h 300 $MoDeChwindow;
	showWindow $MoDeChwindow;
}


