//modelJointCheckTool
//
//
//
//モデルの組み合わせチェックSS撮影用ツール
//まあ動くんじゃないかなレベル


//Aパート、各ジャンルのモデル集合シーンを作る
global proc modelConnectionChecker_compCheckScene(string $savePath , string $modelPath){
	string $fullModelPath;
	string $fullTexPath;
	int $i,$workPartsCat;
//繰り返し処理
	for($workPartsCat=2 ; $workPartsCat<8 ; $workPartsCat++){
		file -f -new;
	//作業パーツカテゴリの取得
	//対象パーツIDを確定
		string $useModelList[];
		clear $useModelList;
		$useModelList = `mdlCheckTool_getUseList($workPartsCat)`;

		spaceLocator -n "cycleControlSystem";
		addAttr -ln "cycleFrame"  -at long  -min 1 -dv 1 |cycleControlSystem;
		setAttr -e-keyable true |cycleControlSystem.cycleFrame;
		addAttr -ln "partsNum"  -at long  -min 1 -dv 1 |cycleControlSystem;
		setAttr -e-keyable true |cycleControlSystem.partsNum;
		//繰り返し処理
		for($i=0 ; $i<size($useModelList) ; $i++){

		//対応するマテリアルを作成
			shadingNode -asShader blinn -n ("mat_" + $useModelList[$i]);
			sets -renderable true -noSurfaceShader true -empty -name ("mat_" + $useModelList[$i] + "SG");

		//テクスチャインポート
			$fullTexPath = ($modelPath + "chr" + $useModelList[$i] + "\\chr" + $useModelList[$i] + "_col.dds");
			$fullTexPath = `substitute "\\\\" $fullTexPath "\\"`;
			importImageFile($fullTexPath, false, false, true);
		
		//マテリアル構築
			connectAttr -f ("mat_" + $useModelList[$i] + ".outColor") ("mat_" + $useModelList[$i] + "SG.surfaceShader");

		//モデルインポート
			$fullModelPath = ($modelPath + "chr" + $useModelList[$i] + "\\chr" + $useModelList[$i] + ".mdl.dae");
			catch( `file -i -f $fullModelPath` );
			rename parts ("parts" + $i);
			rename root ("root" + $i);
			select -r ("root" + $i) ("parts" + $i);
			group -n ("group_" + $useModelList[$i]);
		//マテリアル設定
			//if($i==0){	select -r "parts";	}else{	select -r ("parts" + $i);	}
			select -r ("parts" + $i);
			sets -e -forceElement ("mat_" + $useModelList[$i] + "SG");

			string $texNodeName = "";
			string $tokeTemp[];
			tokenize $fullModelPath "\\" $tokeTemp;
			int $tokeCount;
			for($tokeCount = 1; $tokeCount < (size($tokeTemp) -1) ; $tokeCount++){
				$texNodeName = $texNodeName + "_" + $tokeTemp[$tokeCount];
			}
			print $texNodeName;
			catch( `connectAttr -force ($texNodeName + "_chr" + $useModelList[$i] + "_col_1.outColor") ("mat_" + $useModelList[$i] + ".color")` );

		//エクスプレッション(手のリグを参考に、シーン名によってサイクルを変えたい)
			expression -s ("if((trunc(frame/cycleControlSystem.cycleFrame))% " + `size($useModelList)` + " == " + $i + "){\r\n\tgroup_" + $useModelList[$i] + ".visibility = 1;\r\n}else{\r\n\tgroup_" + $useModelList[$i] + ".visibility = 0;\r\n}")  -o ("group_" + $useModelList[$i]) -ae 1 -uc all ;
		}
		setAttr "|cycleControlSystem.partsNum" $i;
	//保存
		file -rename ( $savePath + "\\checkScene0" + $workPartsCat + ".mb" );
		file -f -s -options "v=0" -type "mayaBinary";
		file -f -new;
	}
}



//Bパート、複数パーツの組み合わせシーンを構築、任意のモーションを流し込む
global proc modelConnectionChecker_compConnectionScene(string $savePath , string $motionPath){
	string $fullMotPath;
	int $i;
//								0			1				2				3				4			
	string $checkTypeList[]	= {"Head_Body",	"Right_Body",	"Left_Body",	"Under_Body",	"Back_Body"	};
	string $parentIDList[]	= {"7",			"7",			"7",			"5",			"7"		};
	string $childIDList[]	= {"2",			"3",			"4",			"7",			"6"		};
	string $connectList[]	= {"|checkScene07:jointroot_000|checkScene07:J_mune_001|checkScene07:J_kao_002","|checkScene07:jointroot_000|checkScene07:J_mune_001|checkScene07:J_Rkata_100","|checkScene07:jointroot_000|checkScene07:J_mune_001|checkScene07:J_Lkata_200","|checkScene05:jointroot_000","|checkScene07:jointroot_000|checkScene07:J_mune_001|checkScene07:J_backpackConnect_250"};

//繰り返し処理
	for($i=0 ; $i<size($checkTypeList) ; $i++){
		//対象カテゴリ×カテゴリの取得
		string $useChildModelList[] = mdlCheckTool_getUseList($childIDList[$i]);
		string $useParentModelList[] = mdlCheckTool_getUseList($parentIDList[$i]);
		
		//リファレンス
		file -r -type "mayaBinary" -gl -loadReferenceDepth "all" -namespace ("checkScene0" + $parentIDList[$i]) -options "v=0" ($savePath + "\\checkScene0" + $parentIDList[$i] + ".mb");
		file -r -type "mayaBinary" -gl -loadReferenceDepth "all" -namespace ("checkScene0" + $childIDList[$i] ) -options "v=0" ($savePath + "\\checkScene0" + $childIDList[$i]  + ".mb");

		int $childNumMax = `getAttr ("checkScene0" + $childIDList[$i] + ":cycleControlSystem.partsNum")`;
		int $parentNumMax = `getAttr ("checkScene0" + $parentIDList[$i] + ":cycleControlSystem.partsNum")`;

		//全子をロケータヘコンストレイン
			for($j=0 ; $j<$childNumMax ; $j++){
				select -r ("checkScene0" + $childIDList[$i] + ":cycleControlSystem");
				select -add ("*:group_" + $useChildModelList[$j] + "|*:root*");
				parentConstraint -weight 1;
			}

		//ロケータを全親へコンストレイン
			for($j=0 ; $j<$parentNumMax ; $j++){
				select -r ("checkScene0" + $parentIDList[$i] + ":group_" + $useParentModelList[$j] + "|checkScene0" + $parentIDList[$i] + ":root" + $j + $connectList[$i]);
				select -add ("checkScene0" + $childIDList[$i] + ":cycleControlSystem");
				parentConstraint -weight 1;
			}
		
		//全親をロケータヘコンストレイン
			for($j=0 ; $j<$parentNumMax ; $j++){
				select -r ("checkScene0" + $parentIDList[$i] + ":cycleControlSystem");
				select -add ("*:group_" + $useParentModelList[$j] + "|*:root*");
				parentConstraint -weight 1;
			}

		//エクスプレッション
		string $temp[];
		tokenize $connectList[$i] ":" $temp;
		string $connectJointShortName = $temp[size($temp)-1];
			for($j=0;$j<$parentNumMax;$j++){
				expression -s ("if((trunc(frame/checkScene0" + $parentIDList[$i] + ":cycleControlSystem.cycleFrame))% " + $parentNumMax + " == " + $j + "){\r\n\tcheckScene0" + $childIDList[$i] + ":cycleControlSystem_parentConstraint1." + $connectJointShortName + "W" + $j + " = 1;\r\n}else{\r\n\tcheckScene0" + $childIDList[$i] + ":cycleControlSystem_parentConstraint1." + $connectJointShortName + "W" + $j + " = 0;\r\n}")  -o ("group_" + $useChildModelList[$j]) -ae 1 -uc all ;
			}


		string $useParentMotionList[] = mdlCheckTool_getUseMotionList($parentIDList[$i]);
		string $useChildMotionList[] = mdlCheckTool_getUseMotionList($childIDList[$i]);
		string $lackMotionList[];
		//モーション流し込み
		string	$grZipPath = "\"" + `getenv "GP_MAYA_ROOT"` + "/common/tool/GrZip.exe\"";
			$grZipPath = `toNativePath $grZipPath`;
		for($j=0 ; $j<$parentNumMax ; $j++){
			$fullMotPath = ($motionPath + "\\chr" + $useParentMotionList[$j] + "\\motion_chr" + $useParentMotionList[$j] + "_gmp000_wait.mot.dae");

			if(size(`getFileList -filespec $fullMotPath`) != 1){
				$fullMotPath = ($motionPath + "\\chr010" + $parentIDList[$i] + "\\motion_chr010" + $parentIDList[$i] + "_gmp000_wait.mot.dae");
			}

			string	$command = ($grZipPath + " -x \"" + `toNativePath $fullMotPath` + ".gz\"");
			$command = ("\"" + $command + "\"");
			system	$command;
			file -i -f -typ "COLLADA importer" $fullMotPath;
			sysFile -delete $fullMotPath;
			pause -sec 1;
		}
		rename root root0;
		for($j=0 ; $j<$parentNumMax ; $j++){
			select -hi ("root" + $j);
			SetKeyRotate;
			setKeyframe -at rotate;
			copyKey -time ":" -float ":" -hierarchy below -controlPoints 0 -shape 1 {("root" + $j)};
			pasteKey -option merge -copies 1 -connect 0 -timeOffset 0 -floatOffset 0 -valueOffset 0 {("checkScene0" + $parentIDList[$i] + ":group_" + $useParentModelList[$j] + "|checkScene0" + $parentIDList[$i] + ":root" + $j)};
			delete ("root" + $j);
		}

		for($j=0 ; $j<$childNumMax ; $j++){
			$fullMotPath = ($motionPath + "\\chr" + $useChildMotionList[$j] + "\\motion_chr" + $useChildMotionList[$j] + "_gmp000_wait.mot.dae");

			if(size(`getFileList -filespec $fullMotPath`) != 1){
				$fullMotPath = ($motionPath + "\\chr010" + $childIDList[$i] + "\\motion_chr010" + $childIDList[$i] + "_gmp000_wait.mot.dae");
			}

			string	$command = ($grZipPath + " -x \"" + `toNativePath $fullMotPath` + ".gz\"");
			$command = ("\"" + $command + "\"");
			system	$command;
			file -i -f -typ "COLLADA importer" $fullMotPath;
			sysFile -delete $fullMotPath;
			pause -sec 1;
		}
		rename root root0;
		for($j=0 ; $j<$childNumMax ; $j++){
			select -hi ("root" + $j);
			SetKeyRotate;
			setKeyframe -at rotate;
			copyKey -time ":" -float ":" -hierarchy below -controlPoints 0 -shape 1 {("root" + $j)};
			pasteKey -option merge -copies 1 -connect 0 -timeOffset 0 -floatOffset 0 -valueOffset 0 {("checkScene0" + $childIDList[$i] + ":group_" + $useChildModelList[$j] + "|checkScene0" + $childIDList[$i] + ":root" + $j)};
			delete ("root" + $j);
		}

		//保存
		setAttr ("checkScene0" + $childIDList[$i] + ":cycleControlSystem.cycleFrame") $parentNumMax;
		playbackOptions -min 0 -max ($parentNumMax -1) ;

		file -rename ( $savePath + "\\connectionScene0" + $childIDList[$i] + $parentIDList[$i] + ".mb" );
		file -f -s -options "v=0" -type "mayaBinary";

		setAttr ("checkScene0" + $childIDList[$i] + ":cycleControlSystem.cycleFrame") 1;
		setAttr ("checkScene0" + $parentIDList[$i] + ":cycleControlSystem.cycleFrame") $childNumMax;
		playbackOptions -min 0 -max ($childNumMax -1) ;

		file -rename ( $savePath + "\\connectionScene0" + $parentIDList[$i] + $childIDList[$i] + ".mb" );
		file -f -s -options "v=0" -type "mayaBinary";
		file -f -new;

	}
}

//Cパート、あらかじめ設定したシーンで撮影
global proc modelConnectionChecker_compPrintScene(string $savePath){
	int $i,$j;
	string $conIDList[] = {"27","37","47","57","67","72","73","74","75","76"};
	sysFile -md ($savePath + "\\images");

	//各種設定用グローバル変数
	global int $gUseScenePanelConfig;
	global string $gDynPaintEditorName;
	int $gUseScenePanelConfigBackup = $gUseScenePanelConfig;
	$gUseScenePanelConfig = 1;

	for($i=0 ; $i<size($conIDList) ; $i++ ){
		//準備しておいた配置設定シーンデータを使用
		sysFile -copy ( $savePath + "\\printScene0" + $conIDList[$i] + ".mb") (`getenv "GP_MAYA_ROOT"` + "/common/scripts/GP_mel/MCT/printScene0" + $conIDList[$i] +".mb");
		file -f -options "v=0"  -ignoreVersion  -typ "mayaBinary" -o ( $savePath + "\\printScene0" + $conIDList[$i] + ".mb");

		//撮影用セットアップ
		lookThroughModelPanel front modelPanel4;
		updateModelPanelBar modelPanel4;
		DisplayShadedAndTextured;
		{
			string $currentPanel = `getPanel -withFocus`;
			string $panelType = `getPanel -to $currentPanel`;
			if ($panelType ==  "modelPanel") {
				modelEditor -edit -da "smoothShaded" -displayTextures on -dl "default" $currentPanel;
			} else if (`isTrue "MayaCreatorExists"` && `scriptedPanel -ex $currentPanel` && `scriptedPanel -q -type $currentPanel` == "dynPaintScriptedPanelType") {
				dynPaintEditor -e -dtx 1 -dsa "smoothShaded" -dsl "default" $gDynPaintEditorName;
			} else if ($panelType ==  "scriptedPanel") {
				string $cmd = "modelEditor -edit -displayAppearance \"smoothShaded\" -displayTextures on -displayLights \"default\" ";
				scriptedPanelRunTimeCmd( $cmd, $currentPanel );
			}
		};
		updateLightingMenu MayaWindow|mayaMainWindowForm|formLayout3|viewPanes|modelPanel4|menu28 modelPanel4;
		modelEditor -e -dl none modelPanel4;
		modelPanelBarDecorationsCallback("GridBtn", "modelPanel4", "MayaWindow|mayaMainWindowForm|formLayout3|viewPanes|modelPanel4|modelPanel4|modelEditorIconBar");
		restoreLastPanelWithFocus();
		updateModelPanelBar modelPanel4;

		string $scaleObjs[];
		string $fnamePiece;
		for($j=0 ; $j<3 ; $j++ ){
			switch($j){
				case 0:
					$fnamePiece = "HG_HG";
					break;
				case 1:
					$scaled = startString($conIDList[$i],1);
					select -r ("connectionScene0*:checkScene0" + $scaled + ":root*");
					$scaleObjs = `ls -sl -type joint`;
					for($scaleItem in $scaleObjs){
						setAttr ($scaleItem + ".sx") 1.2;
						setAttr ($scaleItem + ".sy") 1.2;
						setAttr ($scaleItem + ".sz") 1.2;
					}
					$fnamePiece = "HG_MG";
					break;
				case 2:
					$scaled = endString($conIDList[$i],1);
					select -r ("connectionScene0*:checkScene0" + $scaled + ":root*");
					$scaleObjs = `ls -sl -type joint`;
					for($scaleItem in $scaleObjs){
						setAttr ($scaleItem + ".sx") 1.2;
						setAttr ($scaleItem + ".sy") 1.2;
						setAttr ($scaleItem + ".sz") 1.2;
					}
					$fnamePiece = "MG_HG";
					break;
			}
			playblast -format image -v 0 -w 1280 -h 1024 -p 100 -filename ($savePath + "\\images\\checker_" + $fnamePiece + "_" + $conIDList[$i] + "") ;

			for($scaleItem in $scaleObjs){
				setAttr ($scaleItem + ".sx") 1;
				setAttr ($scaleItem + ".sy") 1;
				setAttr ($scaleItem + ".sz") 1;
			}
			clear $scaleObjs;
		}
	}
	$gUseScenePanelConfig = $gUseScenePanelConfigBackup;
}

