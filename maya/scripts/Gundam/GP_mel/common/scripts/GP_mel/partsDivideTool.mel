//パーツ自動分割スクリプト
//開いているシーンデータ(キャラクタ一体分を想定)から、パーツ分割を行い、ファイルとして保存します。
//モデラーさん用にorochi出力機能を追加
//
//2014/08/14
//エクストラジョイントの仕様変更に対応
//
//2014/07/02
//PGの骨格新ルール整備
//
//2014/02/21
//UV2の扱いを変更(0-1正方形内のUV=コーションマーク領域のみ、横方向5倍スケールの対象とする)
//
//2014/01/22
//UV2の扱いを変更(0-1への圧縮を行わない)
//
//2013/11/11
//骨名一新
//
//2013/10/30
//新環境変数に対応、両腕のUVを共有するので判定・移動スケール値を調整
//
//2013/10/10
//GP2用に更新、マルチUVに対応
//
//2012/10/09
//外部ツールによる起動に対応
//
//2012/09/26
//duplicate周りが不安定なので対応
//
//2012/08/23
//ゲルズゲー対応
//
//2012/08/20
//モビルアーマー対応
//
//2012/08/02
//一方的に必須骨を削除される痛さと怖さを教えられる機能
//
//2012/07/18
//上半身mune直下にextraがあると止まるバグに対応
//
//2012/07/06
//尻骨対応
//
//2012/06/19
//divide前にoptimizeを行う機能を追加。
//
//2012/06/13(2)
//maya出力時に、上書きを強制的に行う仕様へ
//
//2012/06/13
//バックパック接続用骨の追加に対応
//
//2012/06/04
//各種調整、ヘルプ追加
//
//
//2012/05/30
//UIを微調整
//手動でウェイト調整を行うオブジェクト(ザクのパイプなど)に対しての処理を追加
//CSVへ「やわらかパーツ」としてIDを追加
//対応したグループへ振られるが、ウェイト調整は行われない。
//
//
//2012/05/07
//↓機能をデフォルトonに
//
//
//プログラム対応を待っていた↓の機能を、オプションとして本流に統合。
//2012/04/25
//
//回転値のアタッチ機能に対応するよう、アタッチ親側のJointOrient・Rotateをグローバルでの0,0,0にリセットする機能
//実際の出力に使用される骨を、単体ファイル「○○_expj.mb」として出力する機能を追加
//前者はモデル作業側にも影響する可能性有り。
//後者の作業は、モデルエクスポートには影響しない。
//2012年4月6日
//
//エクスポート先の保存機能を追加
//設定は"L:\\MEL\\csv\\GPtool_savedata.csv"に保存
//2012年3月15日


//ウェイト設定ツール読み込み
source "WeightFiller.mel";
source "IDBindTool.mel";
string $PDT_csvPartsListFileName = (`getenv "GP_MAYA_ROOT"` + "\\common\\scripts\\GP_mel\\csv\\GxChrSkinCluster.csv");

//--------------------------------------------------------------------------------
global proc string getPDTVersion(){
	string $PDTversion = "ver2.30_20140814";
	return ($PDTversion);
}

global proc partsDivideTool(){
	//.csv指定
	string $PDT_csvPartsListFileName = (`getenv "GP_MAYA_ROOT"` + "\\common\\scripts\\GP_mel\\csv\\GxChrSkinCluster.csv");
	partsDivideToolWindow($PDT_csvPartsListFileName);
}

//IDリスト取得--------------------------------------------------------------------
//csvからデータを読み込み、配列として返す。
//$fileName		csvファイル名
//$tgtData		取得するデータを行数で指定

global proc string[] getCsvData(string $fileName , int $tgtData){

	print ("「" + $fileName + "」から" + $tgtData + "番目のデータを取得します");

	int $fileId = `fopen $fileName "r"`;
	string $line = `fgetline $fileId`;		//最上段は不要（目次）
	$line = `fgetline $fileId`;
	int $i=0;
	string $IDlist[];

	while ( size( $line ) > 0 ){
		string $buffer[];
		tokenize $line "," $buffer;
		$IDlist[$i] = $buffer[$tgtData];
		$line = `fgetline $fileId`;
		$i++;
	}
	fclose $fileId;
	print ("->完了しました。\r\n");
	return( $IDlist );
}


//ID式ウェイト調整--------------------------------------------------------------------
global proc int partsIDBindExec(string $fileName){
	print ("IDを元にウェイトを調整します・・・\r\n");
	string $IDlist[] = getBindIDList($fileName);
	select -hierarchy parts;
	string $transnd[] = `ls -sl -tr`;
	int $i = size($transnd);
	int $trcheck[];		//ID拾えたかのチェック用
	for($i = 0; $i < size($transnd); $i++){
		string $transname = $transnd[$i];
		$transname = getTransName($transname);
		$transnd[$i] = $transname;
		$trcheck[$i] = 0;
	}

//---load csv file---
	int $fileId = `fopen $fileName "r"`;
	string $line = `fgetline $fileId`;		//最上段は不要（目次）
	$line = `fgetline $fileId`;

//---ID check---
	while ( size( $line ) > 0 ){
		string $buffer[];
		tokenize $line "," $buffer;
			//$buffer[]…0がオブジェクト名(使用見送り)、1が骨名、2が判定用ID、3がパーツ名(未使用)

		//print ("bindID :" + $buffer[2] + "\n");
		//print ("joint  :" + $buffer[1] + "\n");

		$i = 0;
		while ( $i < size($transnd) && $buffer[1] != "(--SmoothWeightParts--)" ){
			if(startsWith($transnd[$i] , $buffer[2])){
				print ("object\t:" + $transnd[$i] + "\r\njoint\t:" + $buffer[1] + "\r\n");
				if( (catch( `select $buffer[1]`) ) == 0  ){
					weightFiller ("parts|" + $transnd[$i]) $buffer[1];
				}
				print ("----ウェイト調整完了!----\r\n\r\n");
				$trcheck[$i] = 1;
			}
			$i++;
		}
		$line = `fgetline $fileId`;
	}
	fclose $fileId;
	print ("このパーツのID式ウェイト調整は完了しました。\r\n");
	return(1);
}


//---------------------------------------------
//新規骨名称[root]を、元ネタ側の骨名[rootOrig]へ変換。
global proc string[] PDT_comvertJointsNameToOrig(string $jntList[]){
	int $i = 0;
	for( $i=0 ; $i < size($jntList) ; $i++ ){
		$jntList[$i] = `substitute "parts" $jntList[$i] "partsOrig"`;
	}
	return($jntList);
}


//rootOrigの骨名を元に、root階層側の骨名を返す。
global proc string[] PDT_comvertJointNameFromOrig(string $joints[]){
	string $result[];
	string $temp[];
	int $i,$j;

	for($jointItem in $joints){
		$j = `tokenize $jointItem "|" $temp`;
		$j--;
		select -r ("*|" + $temp[$j]);
		select -hi -d rootOrig;
		clear $temp;
		$temp = `ls -sl -tr -l`;
		$result[$i] = $temp[0];
		$i++;
	}
	return($result);
}


//バインドしなおし--------------------------------------------------------------------
global proc int PDT_GPmeshBind(){
	select -r parts;
	select -tgl -hi parts;
	$partsList = `ls -sl -tr`;
	string $sourceParts;
	string $joints[];

	for($partsItem in $partsList){
			print ("パーツ用にコピーした、「" + $partsItem + "」のバインドを行います。\r\n");
		string $command = ("substitute \"parts\" " + $partsItem + " \"partsOrig\"");
		$sourceParts =  eval($command);

		clear $joints;
			print("\t→コピー元からジョイントのリストを取得\r\n");
		$joints = `skinCluster -q -inf $sourceParts`;
			print("\t→ジョイント名をコピー先のものへ変換" + $joints[0] + "\r\n");
		$joints = `PDT_comvertJointNameFromOrig($joints)`;
			print("\t→ジョイント名を変換" + $joints[0] + "\r\n");
		select -r $partsItem;
			print ("\t" + $partsItem + "\r\n");
		for($jointsItem in $joints){
			print("\t→" + $jointsItem + "\r\n");
			select -add $jointsItem;
		}
		print("上記構成でバインドを行います\r\n");
		SmoothBindSkin;
	}
		print("当パーツの全メッシュ再バインドは完了しました。\r\n");
	return(1);
}

//バインドしなおし--------------------------------------------------------------------
global proc int GPPartsRebind(int $wcmode){
	PDT_GPmeshBind();	//パーツ用スムースバインド
	if ($wcmode) {
		PDT_GPpartsWeightCopy();	//オリジナルからウェイトを取得、削除する処理
	}
	return(1);
}

//本体ウェイト継承--------------------------------------------------------------------
global proc int PDT_GPpartsWeightCopy(){
	print("パーツ用のメッシュへ、本体のウェイト値をコピーします。\r\n");
	select -hierarchy parts;
	string $transnd[] = `ls -sl -tr`;
	int $i ;
	for($i = 1; $i < size($transnd); $i++){
		string $transname = $transnd[$i];
		$transname = getTransName($transname);
		PDT_transferSkinWeight(("partsOrig|" + $transname) , ("parts|" + $transname) );
	}
	return(1);
}

//骨位置チェッカー--------------------------------------------------------------------
//ウェイトコピー時に確認。
global proc int PDT_jointPosCheck(){
	print ("\r\n\r\n\r\n\r\n\r\n\r\n\☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆　checkpoint B　☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆☆r\n\r\n\r\n\r\n\r\n\r\n");

	int $i,$j,$result;
	string $doubledJoints;
	float $transXList[];float $transYList[];float $transZList[];
	select -hierarchy root;
	string $joints[] = `ls -sl -type "joint"`;
	spaceLocator -p 0 0 0 -n "jointPosChecker";
	for($jointItem in $joints){
		select -r $jointItem jointPosChecker;
		pointConstraint -offset 0 0 0 -weight 1;
		$transXList[$i] = `getAttr "jointPosChecker.tx"`;
		$transYList[$i] = `getAttr "jointPosChecker.ty"`;
		$transZList[$i] = `getAttr "jointPosChecker.tz"`;
		$i++;
	}
	for( $i=0 ; $i<size($transXList) ; $i++){
		for($j = ($i+1) ; $j <size($transXList) ; $j++){
			if($transXList[$i] == $transXList[$j] && $transYList[$i] == $transYList[$j] && $transZList[$i] == $transZList[$j]){
				$doubledJoints = ($doubledJoints + $joints[$i] + " - " + $joints[$j] + "\r\n");
//				setAttr ( $joints[$i] + ".tz" ) ($transZList[$i] + 0.001);
			}
		}
	}
	if ($doubledJoints != ""){
	/*
		confirmDialog -title "joint pos checker" -message ("以下のジョイントが、同じ座標に存在しています。\n" + $doubledJoints + "\nウェイトのコピーを行うには、骨の位置をずらして配置して下さい。")
		-button "OK" -defaultButton "OK"
		-cancelButton "OK" -dismissString "OK";
	*/
		print ("以下のジョイントが、同じ座標に存在しています。\n" + $doubledJoints + "\nウェイトのコピーを行うには、骨の位置をずらして配置して下さい。");
		$result = 1;
	}

	return $result;
}


//--------------------------------------------------------------------
proc GPoriginRename(int $mode){
	select -r rootOrig ;
	if ($mode == 0){
		print("rootOrig以下、ジョイント名の「J_」を「orig_j_」へリネームします\r\n");
		searchReplaceNames "J_" "orig_J_" "hierarchy";
		rename rootOrig|jointroot_000 orig_jointroot_000;
	}else{
		print("rootOrig以下、ジョイント名の「orig_j_」を「J_」へリネームします\r\n");
		searchReplaceNames "orig_J_" "J_" "hierarchy";
		rename orig_jointroot_000 jointroot_000;
	}
}


//--------------------------------------------------------------------
//ここから、GPMSWeightImportExport.melより引用
//--------------------------------------------------------------------

//-----------------------------------------------------------
global proc PDT_weightAssignToVtx(string$jntList[],float$weightList[],string$skinCluster,string$vtx)
{
//指定したバーテックスに指定したジョイントのウェイトを指定した数値で割り当てます。
//スピードを稼ぐ為、このプロシージャ内ではnormalizeは実行されません。
//プロシージャ外で実行して下さい（必須）。

int $listSize = `size $jntList`;

//eval用のワードを作成
string $word = "";
int $count;
	for($count=0;$count<$listSize;$count++)
	{
		$word = $word + " -tv " +  $jntList[$count] + " " + $weightList[$count];
	}
$word = "skinPercent" + $word + " " + $skinCluster + " " + $vtx;
eval $word;
}

//-----------------------------------------------------------
global proc float[] PDT_getWeightFromVtx(string$skinCluster,string$vtx)
{
//指定したバーテックスからウェイトのリストを取得します。
//リストの順番はPDT_getWeightedJntFromVtxプロシージャで取得出来るジョイントリストに
//対応します。

float $result[] = `skinPercent -q -v $skinCluster $vtx`;
return $result;
}
//-----------------------------------------------------------
global proc string[] PDT_getWeightedJntFromVtx(string$skinCluster,string$vtx)
{
//指定したバーテックスにウェイトをかけているジョイントのリストを取得します。

string $result[] = `skinPercent -q -t $skinCluster $vtx`;
return $result;
}
//-----------------------------------------------------------
global proc PDT_setJointWeighAllZero(string$skinCluster,string$vtx)
{
//$vtxのウェイトを全て0にセットします。
//ウェイトノーマライズは外されている必要があります。

//ジョイントリストを取得
string $jntList[] = `skinCluster -q -inf $skinCluster`;

int $listSize = `size $jntList`;

//eval用のワードを作成
string $word = "";
int $count;
	for($count=0;$count<$listSize;$count++)
	{
	$word = $word + " -tv " +  $jntList[$count] + " " + "0.0";
	}
$word = "skinPercent" + $word + " " + $skinCluster + " " + $vtx;
eval $word;
}
//-------------------------------------------------------------------
global proc string PDT_returnSkinClusterName(string $skin)
{
//引数$skinでスキンの名称を渡すと、スキンクラスタを返します

//$skinのシェイプを取得
string $skinShape[] = `listRelatives -pa -s $skin`;
//シーン中の全てのスキンクラスタを取得
string $skinClusterList[] = `ls -type "skinCluster"`;
//照合
string $result;
string $item;
	for($item in $skinClusterList)
	{
	string $geo[] = `skinCluster -q -g $item`;
	string $shape;
		for($shape in $skinShape)
		{
			if($geo[0] == $shape)
			{
			$result = $item;
			break;
			}
		}
	}
return $result;
}

//---------------------------------------------
global proc PDT_transferSkinWeight(string$sourceSkin , string$skin ){

	print ("[" + $sourceSkin + "]のウェイト情報を[" + $skin + "]へコピーします。\r\n");

//$pathのtxtファイルを開き、$skinの$skinClusterの全バーテックスにウェイトを設定します。
//スキンクラスタを自動で取得したい場合はサイズ0の文字列を$skinClusterとして指定して下さい。
	string $skinCluster;
	string $sourceSkinCluster;

//$skinのバーテックス数を取得
	int $vtxNumList[] = `polyEvaluate -v $skin`;
	int $vtxNum = $vtxNumList[0];

//スキンクラスタを取得
	$skinCluster = `PDT_returnSkinClusterName $skin`;
	$sourceSkinCluster = `PDT_returnSkinClusterName $sourceSkin`;

//ウェイトノーマライズを解除
	string $attr = $skinCluster + ".normalizeWeights";
	setAttr $attr 0;
	select -r $skin;
	skinPercent -normalize 0 $skinCluster;

//ジョイントリストを取得
	string $jntList[];
	clear $jntList;

//$skinのバーテックス数を取得
	int $vtxNumList[] = `polyEvaluate -v $skin`;
	int $vtxNum = $vtxNumList[0];

	int $i = 0;

	for( $i=0 ; $i<$vtxNum ; $i++){
//--バーテックスにウェイトを割り当て
		$vtx = ($sourceSkin + ".vtx[" + $i + "]");

		$jntList = `PDT_getWeightedJntFromVtx $sourceSkinCluster $vtx`;

		float $weightList[] = `PDT_getWeightFromVtx $sourceSkinCluster $vtx`;

		$vtx = ($skin + ".vtx[" + $i + "]");
		$jntList = `PDT_comvertJointNameFromOrig($jntList)`;
		//まず、スキンクラスタが持つ全ジョイントに対してこのバーテックスが持つウェイトを0にする
		PDT_setJointWeighAllZero $skinCluster $vtx;

		//正しいウェイトを割り当てる
		PDT_weightAssignToVtx $jntList $weightList $skinCluster $vtx;

	}

//ウェイトノーマライズをセット
	setAttr $attr 1;
	select -r $skin;
	skinPercent -normalize 1 $skinCluster;
	print ("ウェイトコピー完了。\r\n");

}
