		string $RTDSetup_frame = `frameLayout -labelAlign "top" -label "指定したフォルダのrigを使用し、RTD用のシーンを構築します。" -borderStyle "etchedIn" RTDSetup_frame`;
			string $RTDSetup_forms = `formLayout -numberOfDivisions 100`;
				string $tf_RTDSetup_1 = (`textFieldButtonGrp -cl3 left both right -cw3 100 440 100 -label "maya作業フォルダ" -text $charaRigDataPath -ann "" -buttonLabel "Edit" RTDSetup_exptTf`);
				string $tf_RTDSetup_2 = (`textFieldGrp -cl2 left both -cw2 100 120 -label "RTD名" -text $RTDName -ann "RTD名を入力して下さい。(例:rtd10000)" RTDSetup_RTDNameTf`);
				string $tf_RTDSetup_3A = (`textFieldGrp -cl2 left both -cw2 100 100 -label "使用キャラ1" -text $charaID[0] -ann "" RTDSetup_CharaIDATf`);
				string $tf_RTDSetup_3B = (`textFieldGrp -cl2 left both -cw2 60 100 -label "スケール値" -text $charaSize[0] -ann "" RTDSetup_CharaScaleATf`);
				string $tf_RTDSetup_4A = (`textFieldGrp -cl2 left both -cw2 100 100 -label "使用キャラ2" -text $charaID[1] -ann "" RTDSetup_CharaIDBTf`);
				string $tf_RTDSetup_4B = (`textFieldGrp -cl2 left both -cw2 60 100 -label "スケール値" -text $charaSize[1] -ann "" RTDSetup_CharaScaleBTf`);
				string $tf_RTDSetup_5 = (`textFieldGrp -cl2 left both -cw2 100 440 -label "背景モデル" -text $BGModel -ann "" RTDSetup_BGModelTf`);

				string $RTDSetup_b1 = `button -w 420 -h 30 -l "RTDシーン構築！" RTDSetupBtn`;

