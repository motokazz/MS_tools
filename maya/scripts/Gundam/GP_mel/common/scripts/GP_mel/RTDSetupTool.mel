//RTDSetupTool
//ひどい突貫工事を見た
//
//121109	ステージ変更
//121108	ひとまず起動可、エクスポートのことはまあ後で



//--------------------------------------------------------------------------------
global proc string getRTDTVersion(){
	string $RTDTversion = "ver0.04_20121109";
	return ($RTDTversion);
}


global proc RTDSetup_exec(string $charaRigDataPath ,string $workPath , string $rtdName , string $charaID[] ,float $charaSize[] ,string $BGModel){

	file -f -new;
	string $charaRigFullPath;

	global int $gUseScenePanelConfig;
	global string $gDynPaintEditorName;
	int $gUseScenePanelConfigBackup = $gUseScenePanelConfig;
	$gUseScenePanelConfig = 1;

//準備しておいた設定シーンデータを使用
	sysFile -md ($workPath);
	sysFile -copy ( $workPath + $rtdName + ".mb") (`getenv "GP_MAYA_ROOT"` + "/common/scripts/GP_mel/RTD/RTDPlaneScene.mb");
	file -f -options "v=0"  -ignoreVersion  -typ "mayaBinary" -o ( $workPath + $rtdName + ".mb");

	for($i=0 ; $i<size($charaID) ; $i++ ){
		$charaRigFullPath = ($charaRigDataPath + $charaID[$i] + "\\scenes\\" + $charaID[$i] + "_rigbase.mb" );
		GPRTDSetupTool_importRig($charaRigFullPath,$charaID[$i]);
		RTD_ScalingSystem($charaID[$i] , $charaSize[$i]);
	}
	
	catch( `file -i -gr -gn "BackGroundGroup" -f $BGModel` );
	select -r BackGroundGroup;
	createDisplayLayer -name "BackGround" -number 1 -nr;
	setAttr BackGround.displayType 2;

	setAttr "perspShape.farClipPlane" 1000000;
	setAttr "RTDCameraShape.farClipPlane" 1000000;
	lookThroughModelPanel RTDCamera modelPanel4;
	tearOffCopyItemCmd modelPanel modelPanel4;
	lookThroughModelPanel persp modelPanel4;
	setAttr "RTDCamera.scaleX" 50;
	setAttr "RTDCamera.scaleY" 50;
	setAttr "RTDCamera.scaleZ" 50;

	$gUseScenePanelConfig = $gUseScenePanelConfigBackup;
	confirmDialog -title "RTDSetup" -message "作業が正常に完了しました。\r\nRTDの制作作業を開始して下さい。";
}

//--------------------------------------------------------------------------------
//リグのリファレンス
//ws設定を行い、相対パスで作業する。
//--------------------------------------------------------------------------------
global proc GPRTDSetupTool_importRig( string $rigFullPassName , string $chrName ){
	print $rigFullPassName;
	string $tokenized[];
	int $j;
	string $loadedPass = "";
	tokenize $rigFullPassName "\\" $tokenized;
	for( $j=0 ; $j<size($tokenized) ; $j++ ){
		int $max = size($tokenized);
		$max-- ;
		if($j < $max ){
			$loadedPass = ($loadedPass + $tokenized[$j] + "/");
		}else{
			print $loadedPass;
			workspace -o $loadedPass;
			file -r -type "mayaBinary" -ignoreVersion -gl -loadReferenceDepth "all" -namespace ( $chrName + "_rigbase") -options "v=0" $tokenized[$j];
		}
	}
}



//rigに被せる形で、スケール対応階層を生成・数値設定を行うツール
//・rig_allのコントローラについて、スケール中と未スケール時の値を用意させ、RTD出力時にすり替えを行う。
//・スケール値初期設定と、変更時の対応
//・後出しでも付けられるようにしたい

//□スケールを行う親玉階層
//├■rigトップノード
//├■rigETCノード
//└□スケールキャンセル	(エクスプレッションで、絶対座標の取得を補助)
//　├□all_scaledSize	(単純なペアレント、スケール後のrig_allの絶対座標値を取得。)
//　└□all_originSize	(新規設定・更新時を除き、scaledSizeに追従。オフセット値を新規作成時に固定する)




global proc RTD_captureRigAnim(string $tgtChara){

	spaceLocator -name "rig_all_cptAnim";
	spaceLocator -name "rig_origin_cptAnim";
	spaceLocator -name "rig_location_cptAnim";
	cutKey -time ":" -hierarchy none -controlPoints 0 -shape 1 { $tgtChara + "_rigbase:rig_all"};
	pasteKey -time 1 -float 1 -option merge -copies 1 -connect 0 -timeOffset 0 -floatOffset 0 -valueOffset 0 {"rig_all_cptAnim"};
	cutKey -time ":" -hierarchy none -controlPoints 0 -shape 1 { $tgtChara + "_rigbase:rig_origin"};
	pasteKey -time 1 -float 1 -option merge -copies 1 -connect 0 -timeOffset 0 -floatOffset 0 -valueOffset 0 {"rig_origin_cptAnim"};
	cutKey -time ":" -hierarchy none -controlPoints 0 -shape 1 { $tgtChara + "_rigbase:rig_location"};
	pasteKey -time 1 -float 1 -option merge -copies 1 -connect 0 -timeOffset 0 -floatOffset 0 -valueOffset 0 {"rig_location_cptAnim"};
}

global proc RTD_backRigAnim(string $tgtChara){

	cutKey -time ":" -hierarchy none -controlPoints 0 -shape 1 { "rig_all_cptAnim"};
	pasteKey -time 1 -float 1 -option merge -copies 1 -connect 0 -timeOffset 0 -floatOffset 0 -valueOffset 0 {$tgtChara + "_rigbase:rig_all"};
	cutKey -time ":" -hierarchy none -controlPoints 0 -shape 1 { "rig_origin_cptAnim"};
	pasteKey -time 1 -float 1 -option merge -copies 1 -connect 0 -timeOffset 0 -floatOffset 0 -valueOffset 0 {$tgtChara + "_rigbase:rig_origin"};
	cutKey -time ":" -hierarchy none -controlPoints 0 -shape 1 { "rig_location_cptAnim"};
	pasteKey -time 1 -float 1 -option merge -copies 1 -connect 0 -timeOffset 0 -floatOffset 0 -valueOffset 0 {$tgtChara + "_rigbase:rig_location"};
}


global proc RTD_ScalingSystem(string $tgtChara,float $scalingSize){
//モーションカーブの取得
	catch (`RTD_captureRigAnim($tgtChara)`);

//物を揃える
	spaceLocator -n ($tgtChara + "_all_scaledSize");
	spaceLocator -n ($tgtChara + "_all_originSize");
	spaceLocator -n ($tgtChara + "_all_rootpos");
	select -r ($tgtChara + "_all_scaledSize") ($tgtChara + "_all_originSize") ($tgtChara + "_all_rootpos");
	group -n ($tgtChara + "_scaleCanseller"); xform -os -piv 0 0 0;
	select -r ($tgtChara + "_rigbase:rig") ($tgtChara + "_rigbase:etc") ($tgtChara + "_scaleCanseller");
	group -n ($tgtChara + "_scalingSystem"); xform -os -piv 0 0 0;

//セットアップ
	select -r ($tgtChara + "_rigbase:rig_all") ($tgtChara + "_all_scaledSize");
	parentConstraint -weight 1;
	string $exp = `getAttr ($tgtChara + "_all_scaledSize.ty")`;
	expression -s ( "translateX = " + $tgtChara + "_all_scaledSize.translateX;\r\ntranslateY = " + $tgtChara + "_all_scaledSize.translateY - (" + $exp + " * (" + $tgtChara + "_scalingSystem.scaleX - 1));\r\ntranslateZ = " + $tgtChara + "_all_scaledSize.translateZ;\r\nrotateX = " + $tgtChara + "_all_scaledSize.rotateX;\r\nrotateY = " + $tgtChara + "_all_scaledSize.rotateY;\r\nrotateZ = " + $tgtChara + "_all_scaledSize.rotateZ;")  -o ($tgtChara + "_all_originSize") -ae 1 -uc all -n ($tgtChara + "exp_rigScaling");
	expression -s ( "translateX = " + $tgtChara + "_all_scaledSize.translateX;\r\ntranslateY = " + $tgtChara + "_all_scaledSize.translateY - (" + $exp + " * " + $tgtChara + "_scalingSystem.scaleX );\r\ntranslateZ = " + $tgtChara + "_all_scaledSize.translateZ;\r\nrotateX = " + $tgtChara + "_all_scaledSize.rotateX;\r\nrotateY = " + $tgtChara + "_all_scaledSize.rotateY;\r\nrotateZ = " + $tgtChara + "_all_scaledSize.rotateZ;")  -o ($tgtChara + "_all_rootpos") -ae 1 -uc all -n ($tgtChara + "exp_rigBasepoint");
	expression -s ( "scaleX = 1 / " + $tgtChara + "_scalingSystem.scaleX;\r\nscaleY = 1 / " + $tgtChara + "_scalingSystem.scaleY;\r\nscaleZ = 1 / " + $tgtChara + "_scalingSystem.scaleZ;") -o ($tgtChara + "_scaleCanseller") -ae 1 -uc all -n ($tgtChara + "exp_rigScalingCansel");
	setAttr ($tgtChara + "_scalingSystem.sx") $scalingSize;
	setAttr ($tgtChara + "_scalingSystem.sy") $scalingSize;
	setAttr ($tgtChara + "_scalingSystem.sz") $scalingSize;
	catch (`RTD_backRigAnim($tgtChara)`);
}


//テキストフィールドのボタンから、データを指定された時の動作--------------------------------------------------------------------
global proc RTDSetup_setTextfData(string $textf , string $fileName, string $fileType){
	$fileName = `toNativePath( $fileName )`;
	if(endsWith($fileName,"\\") != 1){
		$fileName = ($fileName + "\\");
	}
	textFieldButtonGrp -e -text $fileName $textf;
}


global proc RTDSetupTool(){

	string $charaRigDataPath = "S:\\motion\\maya\\";
//	string $workPath = "L:\\RTD_test\\";
	string $RTDName = "rtd06100";
	string $BGModel = (`getenv "GP_MAYA_ROOT"` + "/common/scripts/GP_mel/RTD/EVENT_STAGE_TEMP.mb");
	string $charaID[] = {"chr4100","chr4280"};
	float $charaSize[] = {2.7 , 2.7};

/*
	string $savePathPrime = ("L:\\partsCheckProject\\scenes\\");
//	string $savePathPrime = ("L:\\partsCheckProject\\scenes\\" + `date -format "YYYY_MM_DD_hhmm"`);
	string $modelPath = "C:\\GP\\trunk\\resource\\original\\GP\\model\\";
	string $motionPath = "S:\\motion\\collada\\";
*/
