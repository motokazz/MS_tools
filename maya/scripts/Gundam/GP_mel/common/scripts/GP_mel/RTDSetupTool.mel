global proc RTDSetup_compose(){
	string $charaRigDataPath = `textFieldButtonGrp -q -text RTDSetup_exptTf` ;
	string $workPath = (`textFieldButtonGrp -q -text RTDSetup_exptTf` + `textFieldGrp -q -text RTDSetup_RTDNameTf` + "\\scenes\\");
	string $rtdName = `textFieldGrp -q -text RTDSetup_RTDNameTf`;
	string $charaID[] = {"" , ""};
	float $charaSize[] = {0 , 0};
	$charaID[0] = `textFieldGrp -q -text RTDSetup_CharaIDATf`;
	$charaID[1] = `textFieldGrp -q -text RTDSetup_CharaIDBTf`;
	$charaSize[0] = `textFieldGrp -q -text RTDSetup_CharaScaleATf`;
	$charaSize[1] = `textFieldGrp -q -text RTDSetup_CharaScaleBTf`;
	$BGModel = `textFieldGrp -q -text RTDSetup_BGModelTf`;

	string $check = "";
	string $sameNameFileList[] = `getFileList -filespec ( $workPath + $rtdName + ".mb")`;
	int $CNum = `size($sameNameFileList)`;
	print ( $workPath + $rtdName + ".mb");
	if($CNum != 0){
		$check = `confirmDialog -title "Confirm" -message "同名のRTDシーンデータが存在します。\r\n上書きしてよろしいですか？" -button "Yes" -button "No" -defaultButton "No" -cancelButton "No" -dismissString "No"`;
	}
	if($check != "No"){
		RTDSetup_exec($charaRigDataPath , $workPath , $rtdName , $charaID , $charaSize , $BGModel);
	}

}