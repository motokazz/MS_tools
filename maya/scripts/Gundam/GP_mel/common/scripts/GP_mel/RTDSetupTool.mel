					-attachControl $tf_RTDSetup_2 "top"  5 $tf_RTDSetup_1
					-attachForm $tf_RTDSetup_2 "left"   10
					-attachNone $tf_RTDSetup_2 "bottom"
					-attachForm $tf_RTDSetup_2 "right"  10

