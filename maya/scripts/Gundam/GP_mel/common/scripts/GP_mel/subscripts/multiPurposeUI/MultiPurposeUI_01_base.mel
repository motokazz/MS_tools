//立ち上げ時のUI構築

global proc GP2_dMPU_makeAddUI(string $filePath , string $srcFile , string $addUI[]){
	string $temp[];
	string $name , $type , $color , $ann , $command , $image;
	int $posX , $posY , $sizeX , $sizeY;
	for($i=0 ; $i < size($addUI) ; $i++){
		tokenize $addUI[$i] "@" $temp;
		$name = $temp[0];
		$type = $temp[1];
		$posX = int($temp[2]);
		$posY = int($temp[3]);
		$sizeX = int($temp[4]);
		$sizeY = int($temp[5]);
		$color = $temp[6];
		$ann = $temp[7];
		$image = $temp[8];
		$command = $temp[9];

			tokenize $color "," $temp;
			float $col[];
			$col[0] = float($temp[0]);
			$col[1] = float($temp[1]);
			$col[2] = float($temp[2]);
		GP2_dMPU_makeNewUI_2($name , $type , $posX , $posY , $sizeX , $sizeY , $command , $image , $col , $ann);
	}
}

global proc GP2_dMPU_buildTab( string $filePath , string $srcFile){
	string $fullPath = $filePath + "\\" + $srcFile;
	string $tabTitle = GP2_dMPU_loadData($fullPath , "title");
	string $tabBG = GP2_dMPU_loadData($fullPath , "use_BGImage");
//	string $rigPicker[] = GP2_dMPU_loadArrayData($fullPath , "controller");
	string $addAction[] = GP2_dMPU_loadArrayData($fullPath , "addAction");

	GP2_dMPU_makeBG($filePath , $srcFile , $tabBG);
//	GP2_dMPU_makeRigPick( $filePath , $srcFile , $rigPicker);
	GP2_dMPU_makeAddUI( $filePath , $srcFile , $addAction);
}

global proc GP2_dMPU_primalAct( string $filePath , string $srcFile ){
	string $actFile = ( `basenameEx($srcFile)` + "_primalAct" );
	string $fullPath = $filePath + "\\primalAct\\" + $actFile + ".mel";
	if(`filetest -r $fullPath`){
		eval( "source \"" + $actFile + "\"" );
//		source($actFile);
		eval($actFile);
	}
}

global proc GP2_dMPU_makeSavedUI(string $filePath){
	string $tabFileList[] = `getFileList -folder ($filePath + "\\") -filespec "*.csv"`;
	string $innerTabForm[];
	int $i;
	for($i=0 ; $i<size($tabFileList) ; $i++){
		$innerTabForm[$i] = `formLayout $tabFileList[$i]`;
		GP2_dMPU_buildTab( $filePath , $tabFileList[$i] );
		GP2_dMPU_primalAct( $filePath , $tabFileList[$i] );
		setParent ..;
	}
}


global proc GP2_devMultiPurposeUI(){
	string $filePath = GP2_dMPU_queFilePath();
	string $ver = dMPU_getVer();
	string $windowName = ("EditableUIWindow_" + $ver);
	if(`window -q -exists $windowName`){
		deleteUI -window $windowName;
	}
	window -h 640 -w 640 $windowName;
	string $menuLay = `menuBarLayout`;
		menu -label "File";
		menuItem -label "New" -c "GP2_dMPU_makeNewTabWindow()";
		menuItem -label "Save" -c "dMPU_saveTabCondition()";
//		menuItem -label "Open";
//		menuItem -label "Close tab";
		menu -label "mode";
		menuItem -label "Act" -c "dMPU_cleanSubwindow()";
		menuItem -label "Add" -c "addCtrlSelectWindow()";
		menuItem -label "Edit" -c "dMPU_editCtrlSortWindow()";
		menu -label "Help" -helpMenu true;
		menuItem -label "About...";
	setParent ..;

	string $form = `formLayout dMPU_globalForm`;
		string $menuForm = `formLayout dMPU_globalForm`;
			string $sep1 = `separator -hr 1 -st "in" -h 2`;

			string $iconLayout = `flowLayout -visible true -h 26 dMPU_toolIconList`;

//---------------------------------------------------------------------------------------------------------
				//デバッグ用フラグ
//---------------------------------------------------------------------------------------------------------

				checkBox -vis 0 -v 0 dMPU_debugFlag;

//---------------------------------------------------------------------------------------------------------

				iconTextButton -i ($filePath + "\\icon\\sysIcon_0.bmp") -c "GP2_dMPU_makeNewTabWindow()" dMPU_newFileBtn;
				iconTextButton -i ($filePath + "\\icon\\sysIcon_1.bmp") -c "dMPU_saveTabCondition()" dMPU_saveFileBtn;
				separator -hr 0 -st "in" -h 24 -w 2;
				iconTextRadioCollection dMPU_activeMode;
				iconTextRadioButton -i ($filePath + "\\icon\\sysIcon_10.bmp") -sl -onc "dMPU_cleanSubwindow()" dMPU_actUIBtn;
				iconTextRadioButton -i ($filePath + "\\icon\\sysIcon_11.bmp") -onc "addCtrlSelectWindow()" dMPU_addUIBtn;
				iconTextRadioButton -i ($filePath + "\\icon\\sysIcon_12.bmp") -onc "dMPU_editCtrlSortWindow()" dMPU_editUIBtn;
				separator -hr 0 -st "in" -h 24 -w 2;
				iconTextButton -i ($filePath + "\\icon\\sysIcon_20.bmp") -c "GP2_dMPU_getNewBGPath(1)" dMPU_changeBGBtn;
				separator -hr 0 -st "in" -h 24 -w 2;
				iconTextCheckBox -i ($filePath + "\\icon\\sysIcon_30.bmp") -cc "dMPU_recolSetting()" dMPU_reColSettingBtn;
				intField -v 0 -vis 0 dMPU_reColedJobIntFld;
				setParent ..;

			string $db = `iconTextButton -i ($filePath + "\\icon\\sysIcon_99.bmp") -dpc "GP2_dMPU_DropToDustBoxCB" dMPU_dustUIIcon`;
			string $sep2 = `separator -hr 1 -st "in" -h 2`;
		setParent ..;

		string $tabs = `tabLayout -cc "dMPU_reMakeECSWindow()" -innerMarginWidth 5 -innerMarginHeight 5 dMPU_globalTab`;
		formLayout -edit
			-attachForm $sep1 "top"     0
			 -attachForm $sep1 "left"   0
			 -attachNone $sep1 "bottom"
			 -attachForm $sep1 "right"  0

			-attachControl $iconLayout "top" 0 $sep1
			 -attachForm $iconLayout "left"  0
			 -attachNone $iconLayout "bottom"
			 -attachControl $iconLayout "right" 0 $db

			-attachControl $db "top"   0 $sep1
			 -attachNone $db "left"
			 -attachNone $db "bottom"
			 -attachForm $db "right"   0

			-attachControl $sep2 "top"  0 $iconLayout
			 -attachForm $sep2 "left"   0
			 -attachForm $sep2 "bottom" 0
			 -attachForm $sep2 "right"  0
			$menuForm;

		formLayout -edit
			-attachForm $menuForm "top"     0
			 -attachForm $menuForm "left"   0
			 -attachNone $menuForm "bottom"
			 -attachForm $menuForm "right"  0

			-attachControl $tabs "top"  0 $menuForm
			 -attachForm $tabs "left"   0
			 -attachForm $tabs "bottom" 0
			 -attachForm $tabs "right"  0
			 $form;
		GP2_dMPU_makeSavedUI($filePath);
	scriptJob -uiDeleted $windowName "dMPU_cleanSubwindow();";
 	showWindow $windowName;
}
