//---------------------------------------------------------------------------------------------------------
//基礎部分
//---------------------------------------------------------------------------------------------------------
global proc string GP2_dMPU_queFilePath(){
	string $res = (`getenv GP_MAYA_ROOT` + "/common/scripts/GP_mel/subscripts/devMultiUI");
	return $res;
}

global proc string dMPU_getVer(){
	string $ver = "0_72_130726";
	return $ver;
}

global proc string GP2_dMPU_loadData(string $fullPath , string $tgtData){
	string $res;
	string $temp[];

	$fileId = `fopen $fullPath "r"`;
	string $nextLine = `fgetline $fileId`;
	while ( size( $nextLine ) > 0 ) {
		if(gmatch( $nextLine , ($tgtData + "*"))){
			$res = $nextLine;
			break;
		}
		$nextLine = `fgetline $fileId`;
	}
	fclose $fileId;
	tokenize $res "," $temp;
	$res = $temp[1];
	return $res;
}

global proc string[] GP2_dMPU_loadArrayData(string $fullPath , string $tgtData){
	string $res[];

	$fileId = `fopen $fullPath "r"`;
	string $nextLine = `fgetline $fileId`;
	int $i , $flag;

	while ( size( $nextLine ) > 0 ) {
		if(gmatch( $nextLine , ("end of " + $tgtData + "*"))){
			$flag = 0;
		}else if($flag == 1){
			$res[$i] = $nextLine;
			$i++;
		}else if(gmatch( $nextLine , ($tgtData + "*"))){
			$flag = 1;
		}
		$nextLine = `fgetline $fileId`;
	}
	fclose $fileId;
	return $res;
}

global proc string dMPU_getUIObjectType(string $tgt){
	string $temp[];
	tokenize $tgt "_" $temp;
	return $temp[0];
}

global proc int dMPU_checkOptUseable(string $cmdUI , string $opt){
	string $helpMes = `help $cmdUI`;
	int $res = 0;
	if(gmatch($helpMes,("*" + $opt + " *"))){
		$res = 1;
	}
	if($cmdUI == "canvas" && $opt == "-dgc")	$res = 0;	//「ヘルプはあるっ・・・！ヘルプはあるがっ・・・！
	if($cmdUI == "canvas" && $opt == "-dpc")	$res = 0;	//　使用出来ないコマンドにもあえて記述しているっ・・・！」ふざくんな自動机爆発しろ
	return $res;
}


global proc dMPU_recolSetting(){
	int $reColorJob;
	string $ver = dMPU_getVer();
	string $windowName = ("EditableUIWindow_" + $ver);

	if(`iconTextCheckBox -q -v dMPU_reColSettingBtn`){
		$reColorJob = `scriptJob -parent $windowName -e "SelectionChanged" "dMPU_rePaintBySelection"`;
		intField -e -v $reColorJob dMPU_reColedJobIntFld;
	}else{
		$reColorJob = `intField -q -v dMPU_reColedJobIntFld`;
		scriptJob -kill $reColorJob -force;
	}
}


global proc GP2_dMPU_makeBG(string $filePath , string $srcFile , string $BGfile){
	$srcFile = `basenameEx($srcFile)`;
	string $temp[];
	tokenize $BGfile ":" $temp;
	int $x = int($temp[1]);
	int $y = int($temp[2]);

	string $bgImage = `image -image ($filePath + "\\" + $temp[0]) -w $x -h $y ("BG_" + $srcFile)`;

	image -e 
		-dragCallback GP2_dMPU_DragCB 
		-dropCallback GP2_dMPU_DropCB 
		$bgImage;
	string $form = `image -q -parent ("BG_" + $srcFile)`;
	formLayout -e -attachForm $bgImage "left" 0 $form;
	formLayout -e -attachForm $bgImage "top" 0 $form;

	columnLayout -vis (`checkBox -q -v dMPU_debugFlag`) ("BG_" + $srcFile + "posManageColLayout");
		rowLayout -nc 2 ("BG_" + $srcFile + "pMRow_00");
			intField -ann ("BG_" + $srcFile + "_aPXIF") -w 65 ("BG_" + $srcFile + "_aPXIF");
			intField -ann ("BG_" + $srcFile + "_aPYIF") -w 65 ("BG_" + $srcFile + "_aPYIF");
		setParent ..;
	setParent ..;
}



global proc GP2_dMPU_makeNewUI_2(string $name , string $type , int $posX , int $posY , int $sizeX , int $sizeY , string $command , string $image , float $col[] , string $ann){

	string $parentLayout = `setParent -q`;
	string $addOpt;
	int $i;

	string $optList[] = {"-c","-i","-w","-h","-bgc","-dgc","-dpc","-ann","-field"};
	string $optData[] = {("\"" + $command + "\""),fromNativePath("\"" + $image + "\""),$sizeX,$sizeY,($col[0] + " " + $col[1] + " " + $col[2]),"GP2_dMPU_DragFromUICB","GP2_dMPU_DroprToUICB",("\"" + $ann + "\""),true};
	for($i=0;$i<size($optList);$i++){
		if(dMPU_checkOptUseable($type , $optList[$i])){
			$addOpt = ($addOpt + " " + $optList[$i] + " " + $optData[$i]);
		}
	}

	string $UIcom = ($type + " " + $addOpt + " " + $name + ";");
	if(`checkBox -q -v dMPU_debugFlag`) print ($UIcom + "\r\n");
	eval $UIcom;

	string $ctrls[] = `layout -q -ca $parentLayout`;
	string $btn = $ctrls[size($ctrls) - 1];

	formLayout -e -attachForm $btn "left" $posX $parentLayout;
	formLayout -e -attachForm $btn "top" $posY $parentLayout;

	string $temp[] = `layout -q -ca $parentLayout`;

	setParent $temp[1];
		rowLayout -nc 5 ("posManageRow_" + $name);
			intField -w 65 -v $posX -ann ($name + "_posX") ($name + "_posX");
			intField -w 65 -v $posY -ann ($name + "_posY") ($name + "_posY");
			textField -w 65 -tx ($col[0] + "," + $col[1] + "," + $col[2]) -ann ($name + "_color") ($name + "_color");
			checkBox -w 65 -ann ($name + "_selected") ($name + "_selected");
			checkBox -w 65 -ann ($name + "_deleted") ($name + "_deleted");
	setParent $parentLayout;
}


