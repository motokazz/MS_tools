//出力ログ作成
//ネームスペース、モーション名、フレーム数(開始・終了)、mayaシーン名、作業者、作業日時を記録
global proc fbxExport_makeLog(string $iptChrNS , string $e_nme , int $max ,int $min, float $timer){
	string $motionName = basenameEx($e_nme);
	string $mayaFileName = `file -q -sceneName`;
	$mayaFileName = basename($mayaFileName,"");
	string $player = system("echo %USERNAME%");
	$player = startString($player,size($player)-2);
	string $workDate = `date`;
	string $newData = ($iptChrNS + "," + $motionName + "," + $min + "," + $max + "," + $mayaFileName + "," + $player + "," + $workDate + ",exportElapse:" + $timer + "[s]\r\n");

	string $saveData[] = fbxExport_loadLog();

	int $i , $reWriteFlag;
	for($i=0 ; $i<size($saveData) ; $i++){
		if(startsWith($saveData[$i] , ($iptChrNS + "," + $motionName))){
			$saveData[$i] = $newData;
			$reWriteFlag = 1;
		}
	}

	if($reWriteFlag == 0){
		$saveData[$i] = $newData;
		$i++;
	}
	$saveData[$i] = "end_of_List,,,,,,";

	fbxExport_saveLog($saveData);
}


global proc string[] fbxExport_loadLog(){
	string $logFileName = "M:\\Tools\\GP_mel\\common\\scripts\\GP_mel\\subscripts\\motionExporter\\log\\exportFBXWorkTool_ExportLog.csv";

	$fileId=`fopen $logFileName "r"`;
	string $nextLine = `fgetline $fileId`;
	string $loadedData[];
	int $i = 0;
	while ( size( $nextLine ) > 0 ) {
		if(gmatch( $nextLine , "end_of_List*")){
			break;
		}else{
			$loadedData[$i] = $nextLine;
		}
	    $nextLine = `fgetline $fileId`;
	    $i++;
	}
	fclose $fileId;
	return $loadedData;
}

global proc fbxExport_saveLog(string $saveData[]){
	string $logFileName = "M:\\Tools\\GP_mel\\common\\scripts\\GP_mel\\subscripts\\motionExporter\\log\\exportFBXWorkTool_ExportLog.csv";
	//string $logFileName = "\\\\192.168.6.99\\gp2\\design\\tool\\exportFBXWorkTool_ExportLog.csv";
	$fileId=`fopen $logFileName "w"`;
	int $i;
	for($i=0 ; $i<size($saveData) ; $i++){
		fprint $fileId $saveData[$i];
	}
	fclose $fileId;
}


//出力先調整
//出力モーションの一覧から、fbxファイルの宛先を取得する。
//基本的には「出力先」欄のパス + mopナンバーだが、
//全モーション行き場が無ければmopを付けない場所を返す。
//複数mopにまたがる場合はその数だけ返す。

global proc string[] fbxExport_getExportPath(){
	string $mop_exptPath[];
	string $temp ;//, $mop_csvFile;
//	int $mopID ;

	string $path = `textFieldButtonGrp -q -text eFT_exportTgtTf`;
	string $exportingList[] = exportFBX_getExportList(0);
	string $mopList[] = getMopList($exportingList,1);

	if(size($mopList) != 0){
		for($i=0 ; $i<size($mopList) ; $i++){
			$mop_exptPath[$i] = ($path + "mop" + $mopList[$i] + "/");
		}
	}else{
		$mop_exptPath[0] = $path;
	}

	return $mop_exptPath;
}

