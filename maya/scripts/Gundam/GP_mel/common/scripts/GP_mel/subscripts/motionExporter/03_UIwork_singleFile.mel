//モーション名チェック、結果に応じたUI操作
global proc eFT_checkMotionName( int $id ){

	//リセット
	button -e -label "" ("eFT_divExpMopIDBtn" + $id);
	textField -e -bgc 0.16 0.16 0.16 ("eFT_divExpNameTF" + $id);

	string $name = `textField -q -text ("eFT_divExpNameTF" + $id)`;

	if($name != ""){
		string $mopIDs[] = GP2_motionInfoLoad(0);
		string $motNames[] = GP2_motionInfoLoad(6);
		int $tgtIndex[] = getIndexFromMotionName( $name , $motNames);
		$tgtIndex = intArrayRemove({-1}, $tgtIndex);

		if(size($tgtIndex) == 0){			//モーション名に適合するmopなし
			textField -e -bgc 0.3 0.16 0.16 ("eFT_divExpNameTF" + $id);

		}else if(size($tgtIndex) == 1){			//一意のモーション
			int $p = $tgtIndex[0];
			button -e -label ("mop" + $mopIDs[$p]) ("eFT_divExpMopIDBtn" + $id);
			if(`checkBox -q -v eFT_baseModeChk`){textField -e -bgc 0.5 0.9 0.6 ("eFT_divExpNameTF" + $id);}	//加算ベース

		}else{			//複数件ヒット
			string $headers[] = GP2_motionInfoLoadArray({4,1,2,3,5});
			textScrollList -e -ra eFT_divExpSelMopTSL;
			for($item in $tgtIndex){
				textScrollList -e -a ("mop" + $mopIDs[$item] + "\t" + $headers[$item]) eFT_divExpSelMopTSL;
			}
			textScrollList -e -sc ("eFT_selectedMopAction(" + $id + ")") eFT_divExpSelMopTSL;
			if(`checkBox -q -v eFT_baseModeChk`){textField -e -bgc 0.5 0.9 0.6 ("eFT_divExpNameTF" + $id);}	//加算ベース

		}
	}
}

//UI挙動、eFT_divExpSelMopTSL用。選択した項目を、指定したIDのボタンにラベルとして貼り付け
global proc eFT_selectedMopAction(int $i){
	string $temp[];
	string $sel[] = `textScrollList -q -si eFT_divExpSelMopTSL`;
	tokenize $sel[0] "\t" $temp;
	button -e -label $temp[0] ("eFT_divExpMopIDBtn" + $i);
	eFT_autoSave_Settings();
	eFT_resetMopListAction();
}

//UI挙動、eFT_divExpSelMopTSL用。選択完了後のリセット
global proc eFT_resetMopListAction(){
	textScrollList -e -ra eFT_divExpSelMopTSL;
	textScrollList -e -a "複数mopIDに適応するモーション名が見つかった場合、ここにリストが表示されます。" eFT_divExpSelMopTSL;
	textScrollList -e -a "使用したいmopを選択し、mopIDボタンを押して下さい。" eFT_divExpSelMopTSL;
	textScrollList -e -a "強制入力コマンド: [ button -e -label \"(入力したいmopID)\" eFT_divExpMopIDBtn0 ;eFT_autoSave_Settings();] 0を変更すれば2段目以降を指定" eFT_divExpSelMopTSL;
	textScrollList -e -a "モーションリストの更新が間に合っていなかったり、csvに書き込まないモーション用(ブレンドのベース用など)。" eFT_divExpSelMopTSL;
	textScrollList -e -sc "" eFT_divExpSelMopTSL;
}

//tgtに適合する全てのmotNamesのインデックス配列を出力
global proc int[] getIndexFromMotionName(string $tgt , string $motNames[]){
	int $index[];
	int $i,$stock;
	for($i=0 ; $index[$i] != 1 ; $i++){
		$index[$i] = stringArrayFind( $tgt, ($stock + 1) , $motNames );
		if($index[$i] != -1) {
			$stock = $index[$i];
		}else{
			break;
		}
	}
	return $index;
}

//大典タブから任意列の情報を取得
global proc string[] GP2_motionInfoLoad(int $loadColumn){
	string $genInfo[] = `textScrollList -q -ai eFT_motionInfoTSL`;
	int $i=0;
	string $loadedData[];
	for($line in $genInfo){
		string $buffer[];
		tokenize $line "\t" $buffer;
		string $result = $buffer[$loadColumn];
		if( $result != "" ){
			$loadedData[$i] = $result;
		}else{
			if($i != 0){$loadedData[$i] = $loadedData[$i-1];}else{$loadedData[$i] = "";}
		}
		$i++;
	}
	return $loadedData;
}

//大典タブから任意列(複数可)の情報を取得、空欄だった際の処理が甘いので注意
global proc string[] GP2_motionInfoLoadArray(int $loadColumn[]){
	string $genInfo[] = `textScrollList -q -ai eFT_motionInfoTSL`;
	int $i=0;
	string $loadedData[];
	for($line in $genInfo){
		string $buffer[];
		tokenize $line "\t" $buffer;
		for($j=0 ; $j<size($loadColumn) ; $j++){
			int $p = $loadColumn[$j];
			$loadedData[$i] = ($loadedData[$i] + $buffer[$p] + "\t");
		}
		$i++;
	}
	return $loadedData;
}
