//GP2モーションエクスポータ
//3,単体ファイル出力用UI挙動

//ネームスペース(キャラリスト)複数取得
global proc string[] getMultiNameSpace(string $rootName){
	string $temp[] = `ls ("*:" + $rootName) ("*:*:" + $rootName) ("*:*:*:" + $rootName)`;
	string $NameSpace[];
	int $i;
	for($i = 0 ; $i < size($temp) ; $i++ ){
		$NameSpace[$i] = match( "^.*:" , $temp[$i]);
	}
	return $NameSpace;
}

//キャラリストを取得し配列
global proc setExpChrList(){
	textScrollList -e -removeAll eFT_expChrTsl;
	string $nameSpaceList[] = getMultiNameSpace(`textField -q -tx eFT_jointRootNameFld`);
	int $i;
	for($i=0 ; $i < size($nameSpaceList) ; $i++){
		textScrollList -e -a $nameSpaceList[$i] eFT_expChrTsl;
	}
	catchQuiet(`textScrollList -e -sii 1 eFT_expChrTsl`);
}

//単体⇔複数切り替え時処理、UIを解禁
global proc switch_eFTUI(){
	int $i , $actv;

//	int $actv = `checkBox -q -v eFT_divModeChk`;
	radioCollection -q -sl eFT_divModeRadCol;
	if(`radioCollection -q -sl eFT_divModeRadCol` == "eFT_divModeRad2"){
		$actv = 1;
	}else{
		$actv = 0;
	}


	for($i=0 ;$i<16 ; $i++){
		checkBox -e -en $actv ("eFT_divExpFlgChk" + $i);
		textField -e -en $actv ("eFT_divExpNameTF" + $i);
		floatField -e -en $actv ("eFT_divExpStTF" + $i);
		floatField -e -en $actv ("eFT_divExpEnTF" + $i);
		checkBox -e -en $actv ("eFT_divExpLpChk" + $i);
		button -e -en $actv ("eFT_divExpMopIDBtn" + $i);
	}
	intField -e -en $actv eFT_divExpTimeAssistTF;
	textField -e -en $actv eFT_divExpNameAssistTF;
	button -e -en $actv eFT_divExpNameClearBtn;
	if($actv){
		checkBox -e -en 0 eFT_loopModeChk;
	}else{
		checkBox -e -en 1 eFT_loopModeChk;
	}
	GP2_motExp_globalSave("multiExportSwitch");
}

//入力補助、複数ラインに文字列追加
global proc divExpNameAssist(){
	int $i;
	string $baseName = `textField -q -tx eFT_divExpNameAssistTF`;
	int $max = `intField -q -v eFT_divExpTimeAssistTF`;
	for($i=0 ; $i<$max ; $i++){
		textField -e -tx ($baseName + ($i+1)) ("eFT_divExpNameTF" + $i);
	}
	textField -e -tx "" eFT_divExpNameAssistTF;
}

//入力リセット
global proc divExpNameClear(){
	int $i;
	for($i=0 ; $i<16 ; $i++){
		textField -e -tx "" ("eFT_divExpNameTF" + $i);
		eFT_checkMotionName( $i );
	}
}

//アトリビュート追加コマンド
global proc eFT_addAttr(string $saveState , string $stateType , string $tgtNode){
	string $command = ("addAttr -ln \"" + $saveState + "\" " + $stateType + " " + $tgtNode + ";");
	eval($command);
	setAttr -e -keyable true ($tgtNode + "." + $saveState);
}

//出力設定ノード生成
global proc eFT_createSaveNode(string $saveNode){
	spaceLocator -n $saveNode;
	addAttr -ln "settingData_ver" -dt "string" ("|" + $saveNode);
	setAttr -e -keyable true  ("|" + $saveNode + ".settingData_ver");
	setAttr -type "string" ("|" + $saveNode + ".settingData_ver") 0.2;

	addAttr -ln "blendBaseFlag" -at "long" ("|" + $saveNode);
	setAttr -e -keyable true  ("|" + $saveNode + ".blendBaseFlag");
	setAttr ("|" + $saveNode + ".blendBaseFlag") 0;

	string $saveStates[] = {"ExportFlag","ExportName","startFrame","endFrame","loopFrag","mopID"};
	string $stateTypes[] = {"-at \"long\"","-dt \"string\"","-at \"double\"","-at \"double\"","-at \"long\"","-dt \"string\""};
	string $command;

	for($j=0 ; $j < 16 ; $j++){
		for($i=0 ; $i < size($saveStates) ; $i++){
			eFT_addAttr(($saveStates[$i]+"_"+$j) , $stateTypes[$i] , ("|" + $saveNode));
		}
	}
	setAttr ($saveNode + ".visibility") 0;
}

//セーブデータ更新手続き
global proc eFT_updateSaveNode(string $saveNode){
	string $saveStates[] = {"ExportFlag","ExportName","startFrame","endFrame","loopFrag","mopID"};
	string $stateTypes[] = {"-at \"long\"","-dt \"string\"","-at \"double\"","-at \"double\"","-at \"long\"","-dt \"string\""};
	string $command;

	if(`attributeQuery -node $saveNode -exists ("settingData_ver")` == 0){
		for($j=0 ; $j < 16 ; $j++){
			for($i=0 ; $i < size($saveStates) ; $i++){
				if(`attributeQuery -node $saveNode -exists ($saveStates[$i] + "_" + $j)` == 0){
					eFT_addAttr(($saveStates[$i]+"_"+$j) , $stateTypes[$i] , ("|" + $saveNode));
				}
			}
		}
	}else{
		float $saveDataVer = `getAttr ("|" + $saveNode + ".settingData_ver")`;
		if($saveDataVer < 0.2){
			addAttr -ln "blendBaseFlag" -at "long" ("|" + $saveNode);
			setAttr -e -keyable true  ("|" + $saveNode + ".blendBaseFlag");
			setAttr -type "string" ("|" + $saveNode + ".settingData_ver") 0.2;
		}
	}
	
	setAttr ($saveNode + ".visibility") 0;
}

//保存処理(未使用?))
global proc eFT_saveSettings(){
	string $saveNode = "exportFBXWorkTool_saveData";
	$response = `confirmDialog -title "FBX_export" 
		-message ("シーン中のオブジェクト「" + $saveNode + "」へ、\r\n出力設定を保存します。")
		-button "Yes" 
		-button "No"
		-defaultButton "Yes"
		-cancelButton "No"
		-dismissString "No"`;
	// check response

	if( $response == "Yes" ) {
		print("User says yes\n");
		eFT_autoSave_Settings();
	} else if( $response == "No" ) {
		print("User says no\n");
	}
}

//自動保存
global proc eFT_autoSave_Settings(){
	string $saveNode = "exportFBXWorkTool_saveData";
	if((`objExists $saveNode`) == 0){
		//セーブノードの新規作成
		eFT_createSaveNode($saveNode);
	}else{
		//セーブノードの更新
		eFT_updateSaveNode($saveNode);
	}
	int $i;
	for( $i=0 ; $i<16 ; $i++){
		setAttr ($saveNode + ".ExportFlag_" + $i) `checkBox -q -v ("eFT_divExpFlgChk" + $i)`;
		setAttr -type "string" ($saveNode + ".ExportName_" + $i) `textField -q -tx ("eFT_divExpNameTF" + $i)`;
		setAttr ($saveNode + ".startFrame_" + $i) `floatField -q -v ("eFT_divExpStTF" + $i)`;
		setAttr ($saveNode + ".endFrame_" + $i) `floatField -q -v ("eFT_divExpEnTF" + $i)`;
		setAttr ($saveNode + ".loopFrag_" + $i) `checkBox -q -v ("eFT_divExpLpChk" + $i)`;
		setAttr -type "string" ($saveNode + ".mopID_" + $i) `button -q -label ("eFT_divExpMopIDBtn" + $i)`;
	}
	setAttr ("|" + $saveNode + ".blendBaseFlag") `checkBox -q -v eFT_baseModeChk`;
}

