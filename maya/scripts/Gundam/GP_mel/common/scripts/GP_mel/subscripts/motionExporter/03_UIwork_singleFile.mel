//UI機能、出力チェック全on/off
global proc eFT_resetAllExpFlag(){
	int $c = `checkBox -q -v eFT_divExpFlgChk_all`;
	int $i;
	for($i=0 ; $i<16 ; $i++){
		checkBox -e -v $c ("eFT_divExpFlgChk" + $i);
	};
}

