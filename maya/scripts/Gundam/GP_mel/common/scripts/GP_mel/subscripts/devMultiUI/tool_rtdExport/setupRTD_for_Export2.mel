
//ここからrestore_Listボタン用
//キャラクターリストの更新
global proc selectFromChrList(){
	string $list[] = `textScrollList -q -si textScrollList_setupRTD_for_Export2_csv_RTDconverter_charaList0`;
	string $sel[];
	for($item in $list){
		string $temp[];
		tokenize $item " " $temp;
		if(size(`ls $temp[0]`)) $sel[size($sel)] = $temp[0];
	}
	select -r $sel;
}

global proc int getChrCount(string $catName){
	string $baseData[] = `textScrollList -q -ai textScrollList_setupRTD_for_Export2_csv_RTDconverter_charaList0`;
	string $temp[];
	string $catIDList[];
	for($i=0 ; $i < size($baseData) ; $i++){
		tokenize $baseData[$i] " " $temp;
		if(startsWith($temp[1],$catName)){
			$catIDList[size($catIDList)] = $temp[1];
		}
	}
	$catIDList = `sort $catIDList`;
	string $tmpID;
	for($i=0 ; $i < size($catIDList) ; $i++){
		if($i<10){
			$tmpID = $catName + "0" + $i;
		}else{
			$tmpID = $catName + $i;
		}
		if(stringArrayContains( $tmpID , $catIDList ) == 0){
			break;
		}
	}
	return $i;
}

global proc restoreListButtonAction(){
	string $command = "selectFromChrList";
	textScrollList -e -ra -ams 1 -sc $command textScrollList_setupRTD_for_Export2_csv_RTDconverter_charaList0;

	string $charaList[] = `ls "|RTD_root|chara_*"`;
	int $i;
	for($i=0 ; $i<size($charaList) ; $i++){
		$charaList[$i] = $charaList[$i] + "_root";
	}

	for($item in $charaList){
		textScrollList -e -a $item textScrollList_setupRTD_for_Export2_csv_RTDconverter_charaList0;
	}

	textField -e -text "chr000009" textField_setupRTD_for_Export2_csv_chara_ID_manager0;	//ms
	textField -e -text "chr01000" textField_setupRTD_for_Export2_csv_chara_ID_manager1;	//ma
	textField -e -text "chr0000" textField_setupRTD_for_Export2_csv_chara_ID_manager2;	//gimmick
	textField -e -text "chr00000" textField_setupRTD_for_Export2_csv_chara_ID_manager3;	//equip
	textField -e -text "chr000" textField_setupRTD_for_Export2_csv_chara_ID_manager4;	//avatar
}

