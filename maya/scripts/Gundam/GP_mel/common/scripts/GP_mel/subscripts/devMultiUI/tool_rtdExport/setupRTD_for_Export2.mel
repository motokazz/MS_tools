global proc setExptDirBtn(){
	string $tempPath = `textField -q -text textField_setupRTD_for_Export2_csv_GP2_folder_Path0`;
	string $prePath , $preName;
	if($prePath != ""){
		$preName = basename( $tempPath , "");
		$prePath = `dirname $tempPath`;
	}
	
	string $output_names[] = `fileDialog2 -fm 3 -cap "GP2のプロジェクトフォルダ\"trunk\"を指定" -ds 1 -dir $prePath -ff "*.*"`;
	textField -e -text $output_names[0] textField_setupRTD_for_Export2_csv_GP2_folder_Path0;
}