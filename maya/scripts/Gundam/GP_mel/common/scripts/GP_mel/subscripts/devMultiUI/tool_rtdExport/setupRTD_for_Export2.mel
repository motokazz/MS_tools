//exportCsv
//そうしょっちゅうやるものでは無い
global proc export_RTDCsvSet(){
	string $baseData[] = `textScrollList -q -ai textScrollList_setupRTD_for_Export2_csv_RTDconverter_charaList0`;

	int $i;
	string $temp[];
	for($i=0 ; $i < size($baseData) ; $i++){
		tokenize $baseData[$i] " " $temp;
		exportRTD_csv($temp[0] , $temp[1] , 0);
	}
	exportRTD_csv("camera1","camera",1);
	exportRTD_csv("RTD_root","RTD_locator",2);
}


global proc string makeCsvPath( string $castID , int $mode ){
	string $lastPath;
	string $tempPath = `textField -q -text textField_setupRTD_for_Export_csv_fbx_exportPathTF0`;
	string $prePath = `dirname $tempPath`;
	string $RTDID = `textField -q -text textField_setupRTD_for_Export2_csv_GP2_folder_Path1`;
	switch($mode){
		//chara
		case 0 :
			$lastPath = $prePath + "\\" + $RTDID + "_" + $castID + ".csv";
			break;
		case 1 :
			$lastPath = $prePath + "\\" + $RTDID + "_camera.csv";
			break;
		case 2 :
			$lastPath = $prePath + "\\" + $RTDID + ".csv";
			break;
	}
	return $lastPath;
}

global proc exportRTD_csv(string $exportNode , string $castID , int $mode){
	string $lastPath = makeCsvPath( $castID , $mode );
	string $tempPath = `textField -q -text textField_setupRTD_for_Export_csv_fbx_exportPathTF0`;
	string $prePath = `dirname $tempPath`;
	string $preName = basename( $tempPath , "");
	string $motionName = `textField -q -text textField_setupRTD_for_Export2_csv_GP2_folder_Path2`;
	string $headerName = `textField -q -text textField_setupRTD_for_Export2_csv_GP2_folder_Path3`;
	string $store[];
	$store[0] = "#ファイル名,出力時の別名,ベースポーズ出力指定,差分モーション指定,サンプリングFPS指定,ジョイント設定ファイル,開始フレーム,終了フレーム,ルート平行移動を0から開始する,出力タイプ,ルートノード名";
	//命名テンプレート・rtd000000_ms01.csv
	switch($mode){
		//chara
		case 0 :
			$store[1] = ("global," + $headerName + ",1,,30,../jointsetting.csv,,,0,," + $exportNode);
			$store[2] = ($preName + ",basepose,1,,,,,,,");
			$store[3] = ($preName + "," + $motionName + ",,,,,,,,");
			break;
		//camera
		case 1 :
			$store[1] = ("global,rtdcamera,1,,30,../jointsetting.csv,,,0,1,");
			$store[2] = ($preName + "," + $motionName + ",,,,,,,,");
			break;
		//rtdLocator
		case 2 :
			$store[1] = ("global,rtdlocator,1,,30,../jointsetting.csv,,,0,,RTD_root");
			$store[2] = ($preName + ",basepose,1,,,,,,,");
			$store[3] = ($preName + "," + $motionName + ",,,,,,,,");
			break;
	}

	$fileId=`fopen $lastPath "w"`;
	for ($loadedItem in $store){
		if (endsWith($loadedItem,"\n") == 0){
			$loadedItem = ($loadedItem + "\n");
		}
		fprint $fileId ($loadedItem);
	}
	fclose $fileId;
}

//export_RTDCsvSet();



//コンバート処理
//プロシージャ makeCsvPathを借りているので注意
global proc convert_RTDSet(){
	string $projPath = `textField -q -text textField_setupRTD_for_Export2_csv_GP2_folder_Path0`;
	string $baseData[] = `textScrollList -q -ai textScrollList_setupRTD_for_Export2_csv_RTDconverter_charaList0`;
	int $i;
	string $temp[];
	for($i=0 ; $i < size($baseData) ; $i++){
		tokenize $baseData[$i] " " $temp;
		$lastPath = makeCsvPath( $temp[1] , 0 );
		convertRTD($lastPath , $temp[1] , $projPath);
	}
	$lastPath = makeCsvPath("camera",1);
	convertRTD($lastPath , "camera" , $projPath);
	$lastPath = makeCsvPath("RTD_locator",2);
	convertRTD($lastPath , "rtdLocator" , $projPath);
}

global proc convertRTD(string $lastPath , string $type , string $projPath){
	string $command = ("call L:\\motion\\motionConverter\\fbxConverter.exe " + $lastPath);
	$command = toNativePath($command);
	system($command);
	string $temp[];
	tokenize $lastPath "." $temp;
	string $secondPath = "\\program\\resource\\original\\GP\\motion\\";
	string $fileName = `basenameEx($temp[0])`;

	if(startsWith($type,"ms")){	$secondPath = ($secondPath + "ms\\" + $fileName + ".hlk.org");
	}else if(startsWith($type,"ma")){	$secondPath = ($secondPath + "ma\\" + $fileName + ".hlk.org");
	}else if(startsWith($type,"gim")){	$secondPath = ($secondPath + "gimmick\\" + $fileName + ".hlk.org");
	}else if(startsWith($type,"eq")){	$secondPath = ($secondPath + "equip\\" + $fileName + ".hlk.org");
	}else if(startsWith($type,"avt")){	$secondPath = ($secondPath + "avatar\\" + $fileName + ".hlk.org");
	}else if(startsWith($type,"camera")){	$secondPath = ($secondPath + "camera\\" + `substitute "_camera" $fileName ""` + ".hlk.org");
	}else {	$secondPath = ($secondPath + "rtdLocator\\" + $fileName + ".hlk.org");}

	sysFile -cp ($projPath + $secondPath) ( $temp[0] + ".hlk.org" );
}

