//以下、setCharaButton用
global proc setCharaButton(int $cat){
	int $chrCount[];
	for($i=0 ; $i<5 ; $i++){
		$chrCount[$i] = 0;
	}

	//int $cat = 1;	//ここのみボタンごとに書き換え

	string $cat_list[] = {"ms" , "ma" , "gim" , "eq" , "avt" };
	string $ID_temp = `textField -q -text ("textField_setupRTD_for_Export2_csv_chara_ID_manager" + $cat)`;
	string $reSignTgt[] = `textScrollList -q -si textScrollList_setupRTD_for_Export2_csv_RTDconverter_charaList0`;
	int $reSignIndex[] = `textScrollList -q -sii textScrollList_setupRTD_for_Export2_csv_RTDconverter_charaList0`;
	string $temp[];
	string $newInfo;
	for($i=0 ; $i < size($reSignTgt) ; $i++ ){
		$chrCount[$cat] = getChrCount($cat_list[$cat]);
		tokenize $reSignTgt[$i] " " $temp;
		if($temp[1] != "" && startsWith($temp[1] , $cat_list[$cat]) ){
			$newInfo = ($temp[0] + " " + $temp[1] + " " + $ID_temp);
		}else{
			$newInfo = ($temp[0] + " " + $cat_list[$cat] + "0" + $chrCount[$cat] + " " + $ID_temp);
		}
		textScrollList -e -rii $reSignIndex[$i] textScrollList_setupRTD_for_Export2_csv_RTDconverter_charaList0;
		textScrollList -e -ap $reSignIndex[$i] $newInfo textScrollList_setupRTD_for_Export2_csv_RTDconverter_charaList0;
	}
}

