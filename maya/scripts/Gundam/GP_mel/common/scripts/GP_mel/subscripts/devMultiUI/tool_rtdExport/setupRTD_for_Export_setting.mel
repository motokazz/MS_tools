//以下、setCharaButton用
//charaListにて選択したキャラクターへのカテゴリ付け
global proc setCharaButton(int $cat){
	int $chrCount[];
	for($i=0 ; $i<5 ; $i++){
		$chrCount[$i] = 0;
	}

	//int $cat = 1;	//ここのみボタンごとに書き換え

	string $cat_list[] = {"ms" , "ma" , "gim" , "eq" , "avt" };
//	string $ID_temp = `textField -q -text ("textField_setupRTD_for_Export3_csv_chara_ID_manager" + $cat)`;
	string $ID_temp = `textField -q -text ("textField_setupRTD_for_Export3_csv_chara_ID_manager0")`;
	string $reSignTgt[] = `textScrollList -q -si textScrollList_setupRTD_for_Export3_csv_RTDconverter_charaList0`;
	int $reSignIndex[] = `textScrollList -q -sii textScrollList_setupRTD_for_Export3_csv_RTDconverter_charaList0`;
	string $temp[];
	string $newInfo;
	for($i=0 ; $i < size($reSignTgt) ; $i++ ){
		$chrCount[$cat] = getChrCount($cat_list[$cat]);	//分類内番号を決定

		tokenize $reSignTgt[$i] "\t" $temp;
		if($temp[3] != "" && startsWith($temp[3] , $cat_list[$cat]) ){
			//分類内番号指定済&変更なし、使用モデル情報を書き換え
			$newInfo = ($temp[0] + "\t" + $temp[1] + "\t" + $temp[2] + "\t" + $temp[3] + "\t" + $ID_temp);
		}else{
			//番号を新規追加
			if($chrCount[$cat] < 10){
				$newInfo = ($temp[0] + "\t" + $temp[1] + "\t" + $temp[2] + "\t" + $cat_list[$cat] + "0" + $chrCount[$cat] + "\t" + $ID_temp);
			}else{
				$newInfo = ($temp[0] + "\t" + $temp[1] + "\t" + $temp[2] + "\t" + $cat_list[$cat] + $chrCount[$cat] + "\t" + $ID_temp);
			}
		}
		textScrollList -e -rii $reSignIndex[$i] textScrollList_setupRTD_for_Export3_csv_RTDconverter_charaList0;
		textScrollList -e -ap $reSignIndex[$i] $newInfo textScrollList_setupRTD_for_Export3_csv_RTDconverter_charaList0;
	}
}

