
//キャラリストにて選択したノードを、maya上でも選択
global proc selectFromChrList(){
	string $list[] = `textScrollList -q -si textScrollList_setupRTD_for_Export3_csv_RTDconverter_charaList0`;
	string $sel[];
	for($item in $list){
		string $temp[];
		tokenize $item "\t" $temp;
		if(size(`ls $temp[0]`)) $sel[size($sel)] = $temp[0];
	}
	select -r $sel;
}

//自動ナンバリング用
global proc int getChrCount(string $catName){
	string $baseData[] = `textScrollList -q -ai textScrollList_setupRTD_for_Export3_csv_RTDconverter_charaList0`;
	string $temp[];
	string $catIDList[];
	for($i=0 ; $i < size($baseData) ; $i++){
		tokenize $baseData[$i] "\t" $temp;
		if(startsWith($temp[3],$catName)){
			$catIDList[size($catIDList)] = $temp[3];
		}
	}
	$catIDList = `sort $catIDList`;
	string $tmpID;
	for($i=1 ; $i < size($catIDList)+1 ; $i++){
		if($i<10){
			$tmpID = $catName + "0" + $i;
		}else{
			$tmpID = $catName + $i;
		}
		if(stringArrayContains( $tmpID , $catIDList ) == 0){
			break;
		}
	}
	return $i;
}

//ネームスペース(キャラリスト)複数取得
global proc string[] getMultiNameSpace(string $rootName){
	string $temp[] = `ls ("*:" + $rootName) ("*:*:" + $rootName) ("*:*:*:" + $rootName) ("*:*:*:*:" + $rootName) ("*:*:*:*:*:" + $rootName)`;
	string $NameSpace[];
	int $i;
	for($i = 0 ; $i < size($temp) ; $i++ ){
		$NameSpace[$i] = match( "^.*:" , $temp[$i]);
	}
	return $NameSpace;
}

//--------------
//RTDキャラリスト
//--------------
//・規格
//chrNo.	reference_NS	topNode	type	modelID

//■新規リスト作成
//chrNo.	1から順に
//ref.NS	topNodeに引っかかった物を一覧で
//topNode	一括取得

global proc restoreListButtonAction(){
	resetCharaList();
	string $charaList[] = getMultiNameSpace("root");
	int $id=1;
	string $charaID;

	for($item in $charaList){
		string $nameSpace;
		if(endsWith($item,":")){
			$nameSpace = startString($item,(size($item)-1));
		}else{
			$nameSpace = $item;
		}
		if($id<10){
			$charaID = ("chara_00" + $id);
		}else if($id<100){
			$charaID = ("chara_0" + $id);
		}
		textScrollList -e -a ($charaID + "\t" + $nameSpace + "\troot") textScrollList_setupRTD_for_Export3_csv_RTDconverter_charaList0;
		$id++;
	}
	setup_IDManagers();
	rtdExpt_loadGP2Path();
}

global proc resetCharaList(){
	string $command = "selectFromChrList";
	textScrollList -e -ra -ams 1 -sc $command textScrollList_setupRTD_for_Export3_csv_RTDconverter_charaList0;
}

global proc setup_IDManagers(){
	textField -e -text "使用するモデルのIDを入力" textField_setupRTD_for_Export3_csv_chara_ID_manager0;	//ms
}

//■リストに追加
global proc addListButtonAction(){
	string $nodeList[] = `ls -sl`;

	int $id=1;
	string $charaID;
	string $temp[];

	for($item in $nodeList){
		$charaID = rtdExpt_getCharaID();
		$temp = rtdExpt_divTail($item);
		textScrollList -e -a ($charaID + "\t" + $temp[1] + "\t" + $temp[0]) textScrollList_setupRTD_for_Export3_csv_RTDconverter_charaList0;
	}
	setup_IDManagers();
	sortListButtonAction();
}

//ネームスペースと末尾(ショートネーム)を返す
global proc string[] rtdExpt_divTail(string $nodeName){
	string $res[] , $temp[];
	tokenize $nodeName ":" $temp;
	int $c = (`size($temp)` - 1);
	$res[0] = $temp[$c];
	if($c != 0 ){
		$res[1] = $temp[0];
		for($i=1 ; $i<$c ; $i++){
			$res[1] = $res[1] + ":" + $temp[$i];
		}
	}else{
		$res[1] = "";
	}
	return $res;
}

//使用されていないキャラID(chara_00X)を返す
global proc string rtdExpt_getCharaID(){
	string $charaList[] = `textScrollList -q -ai textScrollList_setupRTD_for_Export3_csv_RTDconverter_charaList0`;
	string $IDList[] , $temp[];
	for($item in $charaList){
		tokenize $item "\t" $temp;
		$IDList[size($IDList)] = $temp[0];
	}
	int $id;
	string $charaID;
	for($id=1 ; $id < 100 ; $id++){
		if($id<10){	$charaID = ("chara_00" + $id);
		}else if($id<100){	$charaID = ("chara_0" + $id);	}
		if(stringArrayContains($charaID , $IDList) == 0){
			break;
		}
	}
	return $charaID;
}

//アトリビュート追加コマンド
global proc rtdExpt_addAttr(string $saveState , string $stateType , string $tgtNode){
	string $command = ("addAttr -ln \"" + $saveState + "\" " + $stateType + " " + $tgtNode + ";");
	eval($command);
	setAttr -e -keyable true ($tgtNode + "." + $saveState);
}

//出力設定ノード生成
global proc rtdExpt_createSaveNode(string $saveNode){
	spaceLocator -n $saveNode;

	string $dataList[] = {"settingData_ver" , "rtdID" , "camera" , "camera_aim" , "camera_up" , "motionName" , "header" , "cut"};

	for($item in $dataList){
		addAttr -ln $item -dt "string" ("|" + $saveNode);
		setAttr -e -keyable true  ("|" + $saveNode + "." + $item);
	}

	setAttr -type "string" ("|" + $saveNode + ".settingData_ver") 0.1;

	string $saveStates[] = {"charaID","nameSpace","rootNode","charaType","modelID"};
	string $stateTypes[] = {"-dt \"string\"","-dt \"string\"","-dt \"string\"","-dt \"string\"","-dt \"string\""};
	string $command;

	for($j=0 ; $j < 99 ; $j++){
		for($i=0 ; $i < size($saveStates) ; $i++){
			rtdExpt_addAttr(($saveStates[$i]+"_"+$j) , $stateTypes[$i] , ("|" + $saveNode));
		}
	}
	setAttr ($saveNode + ".visibility") 0;
}

//プリセット-サンプル
global proc rtdExpt_usePreset(){
	string $UIList[] = {"GP2_folder_Path1","GP2_folder_Path2","GP2_folder_Path3"};
	textField -e -tx "rtd900000" ("textField_setupRTD_for_Export3_csv_" + $UIList[0]);
	textField -e -tx "rtdTestmotion" ("textField_setupRTD_for_Export3_csv_" + $UIList[1]);
	textField -e -tx "rtd_test" ("textField_setupRTD_for_Export3_csv_" + $UIList[2]);
	rtdExpt_loadGP2Path();
}

//セーブデータ更新手続き
global proc rtdExpt_updateSaveNode(string $saveNode){
	string $saveStates[] = {"charaID","nameSpace","rootNode","charaType","modelID"};
	string $stateTypes[] = {"-dt \"string\"","-dt \"string\"","-dt \"string\"","-dt \"string\"","-dt \"string\""};
	string $command;

	for($j=0 ; $j < 99 ; $j++){
		for($i=0 ; $i < size($saveStates) ; $i++){
			if(`attributeQuery -node $saveNode -exists ($saveStates[$i] + "_" + $j)` == 0){
				rtdExpt_addAttr(($saveStates[$i]+"_"+$j) , $stateTypes[$i] , ("|" + $saveNode));
			}
		}
	}
	setAttr -type "string" RTDSetting_saveData.settingData_ver "0.2";
	setAttr ($saveNode + ".visibility") 0;
}


//リストデータを保存
global proc rtdExpt_SaveSettings(){
	source "GP2_Ut";
	string $saveNode = "RTDSetting_saveData";
	if((`objExists $saveNode`) == 0){
		//セーブノードの新規作成
		rtdExpt_createSaveNode($saveNode);
	}else{
		//セーブノードの更新
		rtdExpt_updateSaveNode($saveNode);
	}
	string $charaListData[] = `textScrollList -q -ai textScrollList_setupRTD_for_Export3_csv_RTDconverter_charaList0`;
	string $temp[];

	int $i;
	for( $i=0 ; $i<size($charaListData) ; $i++){
		$temp = tokenize_adv($charaListData[$i] , "\t");
		setAttr -type "string" ($saveNode + ".charaID_" + $i) $temp[0];
		setAttr -type "string" ($saveNode + ".nameSpace_" + $i) $temp[1];
		setAttr -type "string" ($saveNode + ".rootNode_" + $i) $temp[2];
		setAttr -type "string" ($saveNode + ".charaType_" + $i) $temp[3];
		setAttr -type "string" ($saveNode + ".modelID_" + $i) $temp[4];
	}
	string $dataList[] = { "rtdID" , "camera" , "camera_aim" , "camera_up" , "motionName" , "header" , "cut"};
	string $UIList[] = {"GP2_folder_Path1","cameraTf0","camera_aimTf0","camera_upTf0","GP2_folder_Path2","GP2_folder_Path3","cutTimingTf0"};
	for( $i=0 ; $i<size($dataList) ; $i++){
		setAttr -type "string" ($saveNode + "." + $dataList[$i]) `textField -q -tx ("textField_setupRTD_for_Export3_csv_" + $UIList[$i])`;
	}
}

//■リストデータをロード
global proc rtdExpt_loadSettings(string $saveNode){
	if((`objExists $saveNode`) == 0){
		confirmDialog -title "FBX_export" -message ("設定ファイル「" + $saveNode + "」が見つかりません。") -button "Yes" ;
	}else{
		int $i;
		string $dataLine;
		resetCharaList();
		string $dataLines[] = GP2RTDExpt_getCharaAttr($saveNode);
		for( $i=0 ; $i<99 ; $i++){
			if($dataLines[$i] != "") {
				textScrollList -e -a $dataLines[$i] textScrollList_setupRTD_for_Export3_csv_RTDconverter_charaList0;
			}else{
				break;
			}
		}

		string $sceneLine[] = GP2RTDExpt_getSceneAttr($saveNode);
		string $UIList[] = {"GP2_folder_Path1","cameraTf0","camera_aimTf0","camera_upTf0","GP2_folder_Path2","GP2_folder_Path3","cutTimingTf0"};
		for( $i=0 ; $i<size($UIList) ; $i++){
			textField -e -tx $sceneLine[$i] ("textField_setupRTD_for_Export3_csv_" + $UIList[$i]);
		}
	}
	rtdExpt_loadGP2Path();
}

//各キャラクターの設定をノードから読み込む
global proc string[] GP2RTDExpt_getCharaAttr(string $saveNode){
	string $dataLines[];
	int $i;
	for( $i=0 ; $i<99 ; $i++){
		if(`attributeQuery -node $saveNode -exists ("charaID_" + $i)`){
			string $tmp_ID = `getAttr ($saveNode + ".charaID_" + $i)`;
			if($tmp_ID != ""){
				$dataLines[$i] = ( $tmp_ID + "\t" + `getAttr ($saveNode + ".nameSpace_" + $i)` + "\t" + `getAttr ($saveNode + ".rootNode_" + $i)` + "\t" + `getAttr ($saveNode + ".charaType_" + $i)` + "\t" + `getAttr ($saveNode + ".modelID_" + $i)` );
			}
		}else{
			break;
		}
	}
	return $dataLines;
}

//シーン中の設定をノードから読み込む
global proc string[] GP2RTDExpt_getSceneAttr(string $saveNode){
	string $dataLines[];
	string $Attributes[] = {"rtdID","camera","camera_aim","camera_up","motionName","header","cut"};
	int $i;
	for($i=0 ; $i < size($Attributes) ; $i++){
		$dataLines[$i] = `getAttr ($saveNode + "." + $Attributes[$i])`;
	}
	return $dataLines;
}

global proc rtdExpt_loadGP2Path(){
	source "GP2_Ut";
	string $saveData = (`getenv "GP_MAYA_ROOT"` + "\\common\\scripts\\GP_mel\\csv\\GP2_mel_saveData.csv");
	string $accessed = "gp2_trunkPath";
	string $path = GP2_saveDataLoad( $saveData , $accessed );
	textField -e -tx $path textField_setupRTD_for_Export3_csv_GP2_folder_Path0;
}

//■リストから削除
global proc delListButtonAction(){
	string $selItm[] = `textScrollList -q -si textScrollList_setupRTD_for_Export3_csv_RTDconverter_charaList0`;
	for($item in $selItm){
		textScrollList -e -ri $item textScrollList_setupRTD_for_Export3_csv_RTDconverter_charaList0;
	}
}

//■リスト整頓
global proc sortListButtonAction(){
	string $charaList[] = `textScrollList -q -ai textScrollList_setupRTD_for_Export3_csv_RTDconverter_charaList0`;
	resetCharaList();
	string $sortList[] = `sort($charaList)`;
	for($item in $sortList){
		textScrollList -e -a $item textScrollList_setupRTD_for_Export3_csv_RTDconverter_charaList0;
	}
}

