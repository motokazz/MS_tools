//ヘルプ
global proc GPMSSceneCheckerHelp()
{
string $windowTitle = "GPSceneCheckerHelp";
string $windowObjName = $windowTitle + "WindowObj";

	if(`window -ex  $windowObjName` == 1)
	{
	deleteUI  $windowObjName;
	}

window -t $windowTitle $windowObjName;
columnLayout;
//--------------------------
text -l "Overview:";
text -l "This script checks a GP ";
text -l "scene.";
separator -w 110;
text -l "-- Reversed Parts";
text -l "   checks reversed parts.";

//--------------------------
//ウィンドウサイズを指定
window -e -w 150 -h 230 $windowObjName;
showWindow $windowObjName;
}
//-------------------------------------------------------------------------
//-------------------------------------------------------------------------
//ダイアログウィンドウ作成
{
//ウィンドウタイトルとウィンドウオブジェクト名
string $windowTitle = "GPMSSceneChecker";
string $windowObjName = $windowTitle + "WindowObj";

	if(`window -ex  $windowObjName` == 1)
	{
	deleteUI  $windowObjName;
	}

window -t $windowTitle $windowObjName;
string $layoutName = $windowObjName + "Layout";
columnLayout $layoutName;
//--------------------------
text -l "GP MS SceneChecker";
button -w 50 -c "GPMSSceneCheckerHelp"  -l "Help";
separator -w 110;
button -w 100 -c "GPCheckReversedParts"  -l "Reversed Parts";

//--------------------------
//ウィンドウサイズを指定
window -e -w 110 -h 150 $windowObjName;
showWindow $windowObjName;
}
