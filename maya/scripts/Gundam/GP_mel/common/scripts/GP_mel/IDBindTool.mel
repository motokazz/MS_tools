global proc IBT_closingWork(){
	if(size(`ls "layer_IBTSelected"`)){
		if(size(`ls "root"`)){
			select -r -hi root;
			editDisplayLayerMembers -noRecurse joint `ls -selection`;
		}
		delete layer_IBTSelected layer_IBTList;
		select -cl;
	}
}

