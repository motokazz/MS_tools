//誰か作って下さい
global proc IDBindToolWindow(string $fileName)
{
	source "GP2_Ut";
	string $ut = ("source \"" + `getenv "GP_MAYA_ROOT"` + "\\\\common\\\\scripts\\\\GP_mel\\\\subscripts\\\\GP2_Ut.mel\"");
	eval $ut;
	string $ut = ("source \"" + `getenv "GP_MAYA_ROOT"` + "\\\\common\\\\scripts\\\\GP_mel\\\\subscripts\\\\IDBind\\\\GP2_PickExcessJoints.mel\"");
	eval $ut;

	int $NumMax = 10;		//識別番号のマックス値。FAZZとか出たら増やす。

	string $title = "IDBindTool";
	string $SKwindow = "skintool";
//	string $fileName = IBT_getCsvName();
	

	if ( `window -exists $SKwindow` )
	{
		deleteUI	$SKwindow;
	}

	string $IBTversion = getIBTVersion();
	window  -t ( $title + "   " + $IBTversion ) -w 500 -h 730 $SKwindow;

	string $scene[] = `file -q -list`;
	string $charaID = `basenameEx($scene[0])`;

	string $form = `formLayout -numberOfDivisions 100`;

	string $headerLayout = `columnLayout IBT_headerLayout`;
		string $partsDivTgt = (`textScrollList -allowMultiSelection false -width 450 -height 70 -sc ("IBT_resetUICheckbox()")
	 		-append "通常モビルスーツ"
			-append "HG_0400_ハイゴッグ"
			-append "BA_0000_アークエンジェル"
//			-append "chr7000_アルヴァトーレ"
			-selectItem "通常モビルスーツ"
			 tsl_pdt_IBT`);
		separator -w 500 -h 15 -hr 1;
		string $charaIDtext = `text -label "(エクストラジョイント用)キャラクターID"`;
		string $charaIDtf = `textField -w 300 -text $charaID IBT_chrIDTF`;
	setParent ..;

	int $workLights = GP2_checkAccessRights();
	if($workLights){
	 		textScrollList -e -append "PGMS_登場演出用骨追加版" tsl_pdt_IBT;
	}
	string $work, $work2,$work3, $work4;
	string $IDAppendList,$numList;


	string $baseLayout = `rowLayout -numberOfColumns 2    -columnWidth2 300 200    -adjustableColumn 1    -columnAlign  1 "left"    -columnAttach 1 "both"     0    -columnAttach 2 "both"  0`;

		string $IDform = `formLayout -numberOfDivisions 100`;
			string $t0 = `text -label "ID　List"`;

			string $tsl = `textScrollList -h 400 -shi 1 -ann "選択されたフラグが下欄に入ります" IDList`;
			$IDAppendList= IDListGet($fileName);
			$work2= "textField -e -text `textScrollList -q -si IDList` IDName;";
			$work= ("textScrollList -e " + $IDAppendList + " -sc \"" + $work2 + "\" IDList" );
			eval( $work );

			string $tf = (`textField -text "追加したいフラグを選択するか、手入力して下さい" -ann "追加したいフラグを選択するか、手入力して下さい" IDName`);
			string $IDset = `columnLayout -w 300 -columnAttach left 5`;
				string $cbCol = `checkBox -label "選択をジョイントカラーへ反映" -ann "ジョイントを格納するレイヤーを新たに用意し、\r\nリストの選択に応じた色分け表示を行います。\r\nチェックを外す・ツールを閉じる事で元に戻ります。" -v 0 -h 18 -onc "IBT_Initialize_colLS()" -ofc "IBT_deActive_colLS()" recolModeCB`;
				string $cbOw = `checkBox -label "元のオブジェクト名を残さない" -v 1 -h 18 overWriteModeCB`;
				string $t1 = `text -label "選択オブジェクトをリネーム(ID追加)"`;
				string $b1 = `button -w 200 -h 30 -l "Edit ID" AddIDBtn`;
			setParent ..;
		setParent ..;

	formLayout -edit
		-attachForm		$t0		"top"		0
		-attachForm		$t0		"left"		0
		-attachNone		$t0		"bottom"
		-attachForm		$t0		"right"		0
	
		-attachControl	$tsl	"top"		0 $t0
		-attachForm		$tsl	"left"		0
		-attachControl	$tsl	"bottom"	0 $tf
		-attachForm		$tsl	"right"		0
	
		-attachNone		$tf		"top"
		-attachForm		$tf		"left"   0
		-attachControl	$tf		"bottom" 0 $IDset
		-attachForm		$tf		"right"  0

		-attachNone		$IDset	"top"
		-attachForm		$IDset	"left"   0
		-attachForm		$IDset	"bottom" 0
		-attachForm		$IDset	"right"  0
	$IDform;

		string $Numset = `columnLayout`;
			string $t4 = `text -label "Number　List"`;

			string $tsl2 = `textScrollList -w 200 -h 400 -shi 1 -ann "選択された識別番号が下欄に入ります" NumList`;
			$numList= numListGet($NumMax);
			$work4= "textField -e -text `textScrollList -q -si NumList` NumTextfield;";		//テキストフィールドに選択値を追加する機能
			$work3= ("textScrollList -e " + $numList + " -sc \"" + $work4 + "\" NumList" );	//リストへの項目追加、↑機能の組み込み
			eval( $work3 );

			string $tf2 = (`textField -w 200 -text "" -ann "追加したい識別番号を選択するか、手入力して下さい" NumTextfield`);
			string $t4_5 = `text  -h 36 -label ""`;
			string $t5 = `text -label "選択オブジェクトをリネーム(番号追加)"`;
			string $b2 = `button -w 200 -h 30 -l "Edit Number" CngIDBtn`;
		setParent ..;
	setParent ..;



	string $b3 = `button -w 400 -h 30 -l "MeshNode-Name Check" MeshNmBtn`;
	string $b4 = `button -w 400 -h 30 -l "Edit Weight" EditWtBtn`;
	string $b8 = `button -w 400 -h 30 -l "モデル・骨の状態をチェック" checkSceneBtn`;
	string $b5 = `button -w 400 -h 30 -l "状態チェック + 再バインド" ReBindBtn`;
	string $b6 = `button -w 400 -h 30 -l "Optimize Scene" OptiBtn`;
	string $b7 = `button -w 400 -h 30 -l "番号チェック用オブジェクト生成" numcheckBtn`;
	string $b9 = `button -w 400 -h 30 -l "GP2_PickExcessJoints" pickExcessBtn`;




	button -edit -command "addBindID( `textField -q -text IDName` , `IBT_getCsvName` );" -ann "選択中のオブジェクト名に、IDを設定します。既にIDが存在すれば書き換え、無ければ新規追加。" AddIDBtn;
	button -edit -command "addHideNum( `textField -q -text NumTextfield` );" -ann "選択中のオブジェクト名に、識別番号を設定します。既に番号が存在すれば書き換え、無ければ新規追加。" CngIDBtn;
	button -edit -command "meshRename( `ls -sl` );" -ann "parts下のオブジェクトの、transform・meshノード名を確認し、同名であればリネームします。\n正常に動作しない場合に使用して下さい。" MeshNmBtn;
	button -edit -command "IDBindExec(`IBT_getCsvName`);" -ann "IDに基づきウェイトを調整します。\nスムースバインドを行った状態で使用して下さい。" EditWtBtn;
	button -edit -command "GPRebind(int(`checkBox -q -v weightCopyFlag`));" -ann "parts以下のオブジェクトを複製し、再バインドします。\r\nシーンの状態をチェックし、骨などに問題があった場合はバインドされません。" ReBindBtn;
	button -edit -command "cleanUpScene 2;" -ann "Optimize機能を呼び出します。" OptiBtn;
	button -edit -command "makeNumCheck(`checkBox -q -v allCopyFlag`);" -ann "オブジェクト名末尾の、番号チェック用。番号に応じた位置に複製を作ります。" numcheckBtn;
	button -edit -command "GP2IDBND_check_global();" -ann "メッシュ・ジョイントの状態に関して、チェックのみを行います。" checkSceneBtn;
	button -edit -command "GP2_PickExcessJointsExec()" -ann "(バインド・optimize後用)対応するスキンクラスタを持たない、削除可能なジョイントを選択します。" pickExcessBtn;



	string $t2 = `text -label "メッシュノード名調整"`;
	string $t3 = `text -label "ウェイト値調整"`;
	string $t4 = `text -label "オブジェクトを再バインド"`;

	string $c1 = `checkBox -label "現モデルのウェイトをコピーする" weightCopyFlag`;
	string $c2 = `checkBox -label "全身を複製して並べる(高付加注意)" allCopyFlag`;

	formLayout -edit

	    -attachForm		$headerLayout	"top"    5
	    -attachForm		$headerLayout	"left"   5
	    -attachNone		$headerLayout	"bottom"
	    -attachNone		$headerLayout	"right"
/*
	    -attachControl	$IDset     "top"    5 $headerLayout
	    -attachForm		$IDset     "left"   5
	    -attachControl	$IDset     "bottom" 5 $t2
	    -attachControl	$IDset     "right" 5 $Numset

	    -attachControl	$Numset     "top"    5 $headerLayout
	    -attachNone		$Numset     "left"   
	    -attachControl	$Numset     "bottom" 5 $t2
	    -attachForm		$Numset     "right" 5 
*/
	    -attachControl	$baseLayout "top"    5 $headerLayout
	    -attachForm		$baseLayout "left"   5
	    -attachControl	$baseLayout "bottom" 5 $t2
	    -attachForm		$baseLayout "right" 5

	    -attachNone     $t2     "top"
	    -attachForm     $t2     "left"   5
	    -attachControl  $t2     "bottom" 0 $b3
	    -attachForm 	$t2     "right"  5

	    -attachNone     $b3     "top"
	    -attachForm     $b3     "left"   5
	    -attachControl  $b3     "bottom" 6 $t4
	    -attachForm 	$b3     "right"  5

	    -attachNone     	$t4     "top"
	    -attachForm     	$t4     "left"   5
	    -attachControl  	$t4     "bottom" 0 $b8
	    -attachForm 	$t4     "right"  5

	    -attachNone     	$b8     "top"
	    -attachForm     	$b8     "left"   5
	    -attachControl  	$b8     "bottom" 0 $c1
	    -attachForm 	$b8     "right"  5
	
	    -attachNone     	$c1     "top"
	    -attachForm     	$c1     "left"   5
	    -attachControl  	$c1     "bottom" 0 $b5
	    -attachForm 	$c1     "right"  5

	    -attachNone     	$b5     "top"
	    -attachForm     	$b5     "left"   5
	    -attachControl	$b5     "bottom" 6 $t3
	    -attachForm     	$b5     "right"  5

	    -attachNone     	$t3     "top"
	    -attachForm     	$t3     "left"   5
	    -attachControl  	$t3     "bottom" 0 $b4
	    -attachForm 	$t3     "right"  5

	    -attachNone     	$b4     "top"
	    -attachForm     	$b4     "left"   5
	    -attachControl     	$b4     "bottom" 5 $b6
	    -attachForm     	$b4     "right"  5

	    -attachNone     	$b6     "top"
	    -attachForm     	$b6     "left"   5
	    -attachControl	$b6     "bottom" 5 $c2
	    -attachForm     	$b6     "right"  5

	    -attachNone     	$c2     "top"
	    -attachForm     	$c2     "left"   5
	    -attachControl	$c2     "bottom" 5 $b7
	    -attachForm     	$c2     "right"  5

	    -attachNone     	$b7     "top"
	    -attachForm     	$b7     "left"   5
	    -attachControl	$b7     "bottom" 5 $b9
	    -attachForm     	$b7     "right"  5

	    -attachNone     	$b9     "top"
	    -attachForm     	$b9     "left"   5
	    -attachForm     	$b9     "bottom" 5
	    -attachForm     	$b9     "right"  5
	$form;

	showWindow $SKwindow;
	scriptJob -uiDeleted $SKwindow "IBT_closingWork();";
}

