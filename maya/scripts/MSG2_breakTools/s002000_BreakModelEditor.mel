	window -title "moBounding Box Ver1.2" -minimizeButton false -maximizeButton false moBoundingBoxWin;
	columnLayout -adjustableColumn true;
		checkBox -label "元のオブジェクトを削除" momsBME_checkBoxDelete;
		checkBox -label "階層構造を維持"  momsBME_checkBoxParent;
		checkBox -label "移動値を保持" momsBME_checkBoxTransform;
