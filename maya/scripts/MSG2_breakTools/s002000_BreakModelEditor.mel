//////////////////////////////////////////////////////////////////////
//バウンディングボックスを作る
//////////////////////////////////////////////////////////////////////
global proc momsBME_DoIt()
{
	string $dagPath[];
	if(momsBME_componentChecker()){
		$dagPath = momsBME_componentToObjName();
	}
	else{
		$dagPath = `ls -sl -o -l`;
	}
	if(!size($dagPath))error"何も選択されていません";

	//string $dagPath[] = momsBME_componentChecker() ? momsBME_componentToObjName() : `ls -sl -o -l`;
	//コンポーネントならmomsBME_componentToObjName()で、それ以外ならls-slでオブジェ名を代入
	//行数短くなるけど何も選択されてないときにエラーが出るので辞めた

	string $shortName = `match "[^|]*$" $dagPath[0]`;//バウンディングボックスの名前をこれにする

	string $parentGrp[] = `listRelatives -parent -fullPath $dagPath[0]`;//親グループ

	vector $bbCenter = momsBME_getCenter();//移動先の座標を求めて
	float $valx = $bbCenter.x;
	float $valy = $bbCenter.y;
	float $valz = $bbCenter.z;
	string $bboxName = momsBME_createBbox();//バウンディングボックスを作り
	move -worldSpace -moveXYZ $valx $valy $valz;//移動する

//	int $momsBME_checkBoxDelete = `checkBox -q -value momsBME_checkBoxDelete`;
//	int $momsBME_checkBoxParent = `checkBox -q -value momsBME_checkBoxParent`;
//	int $momsBME_checkBoxTransform = `checkBox -q -value momsBME_checkBoxTransform`;
//	if($momsBME_checkBoxDelete)delete $dagPath;//元のオブジェクトを削除
//	if(!$momsBME_checkBoxTransform)makeIdentity -apply true -translate true $bboxName;//移動値を保持(デフォルトが保持なので、チェックが入ってなかったらフリーズする)
	parent($bboxName,$parentGrp[0]);//元のオブジェクトがあったグループに移動
	
	string $newBboxName[] = `ls -sl -o`;
	rename $newBboxName[0] $shortName;//リネーム
}

//////////////////////////////////////////////////////////////////////
//オブジェクトの大きさのバウンディングボックスを作る
//////////////////////////////////////////////////////////////////////
global proc string momsBME_createBbox()
{
	float $bBox[] = momsBME_boxXYZ();
	polyCube -width ($bBox[3]-$bBox[0]) -height ($bBox[4]-$bBox[1]) -depth ($bBox[5]-$bBox[2]);
	string $bboxName[] = `ls -sl -l`;	
	return $bboxName[0];
}

//////////////////////////////////////////////////////////////////////
//選択オブジェクトのバウンディングボックス座標を返す
//
//(当初exactWorldBoundingBoxコマンドを使っていたけど
//アトリビュートに回転値が入ってると正確に値が取れないので変更した)
//////////////////////////////////////////////////////////////////////
global proc float[] momsBME_boxXYZ()
{
	float $VertexXYZ[];
	float $temp[];
	float $val;
	int $i;
	string $currentSelect[] = `ls -sl`;
	string $names[] = momsBME_groupChecker() ? momsBME_getNameList() : `ls -sl -l`;
	//グループならmomsBME_getNameList()で、それ以外ならls-slでオブジェ名を代入
	
	float $bboxXYZ[6];//バウンディングボックス座標（xmin、ymin、zmin、xmax、ymax、zmax）

	for($name in $names)//選択オブジェクト、もしくは選択頂点の全ての座標を$VertexXYZに代入
	{
		select $name;
		PolySelectConvert 3;//選択ノードを頂点に変換
		$temp = `xform -query -ws -t`;
		for($val in $temp)
		{
			$VertexXYZ[size($VertexXYZ)] = $val;
		}
		clear $temp;
	}

	$bboxXYZ[0] = $VertexXYZ[0];//X最小値
	$bboxXYZ[1] = $VertexXYZ[1];//X最小値
	$bboxXYZ[2] = $VertexXYZ[2];//Z最小値
	$bboxXYZ[3] = $VertexXYZ[0];//X最大値 １頂点しか選択してない時用に初期値代入
	$bboxXYZ[4] = $VertexXYZ[1];//Y最大値 １頂点しか選択してない時用に初期値代入
	$bboxXYZ[5] = $VertexXYZ[2];//Z最大値 １頂点しか選択してない時用に初期値代入

	for ($i = 0; $i < size($VertexXYZ); $i += 3)
	{
		$bboxXYZ[0] = `min $bboxXYZ[0] $VertexXYZ[$i]`;
		$bboxXYZ[3] = `max $bboxXYZ[3] $VertexXYZ[$i]`;
		$bboxXYZ[1] = `min $bboxXYZ[1] $VertexXYZ[($i + 1)]`;
		$bboxXYZ[4] = `max $bboxXYZ[4] $VertexXYZ[($i + 1)]`;
		$bboxXYZ[2] = `min $bboxXYZ[2] $VertexXYZ[($i + 2)]`;
		$bboxXYZ[5] = `max $bboxXYZ[5] $VertexXYZ[($i + 2)]`;
	}

	select $currentSelect;
	return $bboxXYZ;
}

//////////////////////////////////////////////////////////////////////
//選択範囲のセンターを求める
//////////////////////////////////////////////////////////////////////
global proc vector momsBME_getCenter()
{
	float $bbox[] = momsBME_boxXYZ();
	float $CenterX = ($bbox[3] - (($bbox[3] - $bbox[0])/2));//xの最大値からxの最小値を引いて一片の長さを求め、２分の一にして最大値から引く
	float $CenterY = ($bbox[4] - (($bbox[4] - $bbox[1])/2));
	float $CenterZ = ($bbox[5] - (($bbox[5] - $bbox[2])/2));
	vector $centerXYZ = <<$CenterX, $CenterY, $CenterZ>>;
	return $centerXYZ;
}

//////////////////////////////////////////////////////////////////////
//選択オブジェクトの名前を取得
//グループ以下の階層（グループ名を含めない)
//////////////////////////////////////////////////////////////////////
global proc string[] momsBME_getNameList()
{
	string $nameList[];//結果を入れる配列
	string $names[] = `listRelatives -fullPath -allDescendents -type mesh`;//選択階層以下のメッシュ名取得
	string $getParentName[];
	for($name in $names)
	{
		if(!`getAttr ($name + ".intermediateObject")`)//中間オブジェクトかどうかチェック。ヒストリ対応
		{
			$getParentName = `listRelatives -parent -fullPath $name`;//中間オブジェクトでなければmeshの親のtransformの名前を取得
			$nameList[`size $nameList`] = $getParentName[0];//配列に結果を格納
		}
	}
	return $nameList;
}

//////////////////////////////////////////////////////////////////////
//選択コンポーネントのオブジェクト名を返す
//////////////////////////////////////////////////////////////////////
global proc string[] momsBME_componentToObjName()
{
	string $nameList[];//結果を入れる配列
	string $names[] = `ls -sl -o -l`;
	string $getParentName[];
	for($name in $names)
	{
		if(!`getAttr ($name + ".intermediateObject")`)//中間オブジェクトかどうかチェック。ヒストリ対応
		{
			$getParentName = `listRelatives -parent -fullPath $name`;//中間オブジェクトでなければmeshの親のtransformの名前を取得
			$nameList[`size $nameList`] = $getParentName[0];//配列に結果を格納
		}
	}
	return $nameList;
}

//////////////////////////////////////////////////////////////////////
//選択されているものがグループなら1を返す
//////////////////////////////////////////////////////////////////////
global proc int momsBME_groupChecker()
{
	if (!size( `listRelatives -shapes` ))
	{
		if(momsBME_componentChecker())
		{
			return 0;
		}
		else
		{
			return 1;
		}
	}
	else
	{
		return 0;
	}
}

//////////////////////////////////////////////////////////////////////
//選択されているものがコンポーネントなら1を返す
//////////////////////////////////////////////////////////////////////
global proc int momsBME_componentChecker()
{
	string $componentNames[] = `filterExpand -sm 31 -sm 32 -sm 34 -sm 35`;//頂点、エッジ、フェース、ＵＶ
	if(size($componentNames))
	{
		return 1;
	}
	else
	{
		return 0;
	}
}

s002000_BreakModelEditor;