							button -w 50 -annotation "root と col 内のオブジェを選択" -label "select" -c "momsBME_selectSameName({\"root\",\"col\"})";
							iconTextButton -annotation "命名規則に沿ってリネームします" -style "iconAndTextHorizontal" -image "rvIPRRefresh.png" -label"リネーム" -c "momsBME_rename";
							setParent ..;
						separator -h 10 -style "single" -width 105;
						rowLayout -numberOfColumns 2 -adjustableColumn 2;
							button -w 50 -h 50 -annotation "col 内のオブジェを選択" -label "select" -c "momsBME_selectSameName({\"col\"})";
							columnLayout -rowSpacing 0 -adjustableColumn true;
								rowLayout -numberOfColumns 2 -adjustableColumn 2;
									radioCollection "momsBME_radioCollection_1" ;
										radioButton -label "hull" -select "momsBME_radioButton_hull";
										radioButton -label "mesh" "momsBME_radioButton_mesh";
									setParent ..;
