if(!`pluginInfo -q -loaded "hctMayaSceneExport.mll"`){
	loadPlugin "hctMayaSceneExport.mll";
}

global proc MS_copyToCollision(string $COM){
	string $SEL[] = `ls -sl -l`;
	if(!`size($SEL)`){
		return;
	}

	//テンポラリグループ作成
	string $TEMP_GROUP;
	$TEMP_GROUP=`group -name "MS_temp_zzzzz" -empty`;

	//対象トップグループ確認
	if(`objExists ("top_"+$COM)`){
		//対象トップグループ有り、グループを削除
		$SEL=`parent $SEL $TEMP_GROUP`;
		delete ("top_"+$COM);
	}

	//グループを作成
	string $NEWGROUP = `momsBME_createGroup($COM)`;
	print $NEWGROUP;

	//元オブジェクトを複製
	string $PARENTED_ROOT[]=`parent $SEL ($NEWGROUP+"|root")`;
	select -r $PARENTED_ROOT;

	//元モデルを対応するコリジョングループにコピー
	python("import s2000_tools.s002000_BreakModelEditor.MS_copyToCollision as MS_copyToCollision");
	python("reload(MS_copyToCollision)");
	string $PARENTED_COL[]=python("MS_copyToCollision.main()");
	select -r $PARENTED_COL;
	momsBME_addHavokAttr;

	//リネーム
	select -r $PARENTED_ROOT $PARENTED_COL;
	momsBME_rename;

	//フリーズ
	momsBME_freeze;

	//コリジョンをHIDE
	hide ($NEWGROUP+"|col");

	//テンポラリグループを削除
	delete $TEMP_GROUP;

}


global proc s002000_BreakModelEditor()
{
	if(`window -exists s002384_BreakModelEditorWin`)deleteUI s002384_BreakModelEditorWin;
	//windowPref -remove s002384_BreakModelEditorWin;//GUI初期化
	window -title "s002384_BreakModelEditor" -w 300 -h 619 -menuBar true -minimizeButton false -maximizeButton false s002384_BreakModelEditorWin;
	menu -label "help" -helpMenu true;
	menuItem -label "help" -command "momsBME_helpWin";

	columnLayout;

			columnLayout -rowSpacing 0 -adjustableColumn true;
				frameLayout -cll 1 -label "CreateGroup" -width 160 -marginWidth 5 -marginHeight 5 -borderStyle etchedOut;
					columnLayout -rowSpacing 3 -adjustableColumn true;
						button -label "破片" -annotation " [デブリ/db]　すぐに消える" -c "momsBME_createGroup(\"db\")";
						button -label "残骸" -annotation " [ブロークン/bk]　破壊時出現し、そのまま残り続ける" -c "momsBME_createGroup(\"bk\")";
						rowLayout -numberOfColumns 2 -adjustableColumn 2;
							button -w 100 -label "中間破壊モデル" -annotation " [ミドル/md]　破片とは違い、更に壊すことが出来るモデル" -c "momsBME_createGroup(\"md\")";
							button -label "+1" -annotation " [ミドル]中間破壊モデルは複数持つことが出来ます " -c "momsBME_createGroup(\"md\")";
							setParent ..;
						button -label "中間破壊モデル用破片" -annotation " [デブリ/db_md]　中間破壊モデルを壊した時に出る破片" -c "momsBME_createGroup(\"db_md\")";
						button -label "動的モデル" -annotation " [ダイナミック/dy]　破壊以外の行為で物理挙動させるモデル" -c "momsBME_createGroup(\"dy\")";
						button -label "中間破壊モデル出現位置" -annotation " [ヌルロケーター]　\n中間破壊モデルを出現させる座標を指定出来ます\nこのロケーターが無い場合は原点から出現します" -c "momsBME_createGroup(\"null\")";
