#IDマップ作成
def autoIDMap():
	sel = cmds.ls(sl=True)
	Materials = cmds.ls(mat=True)
	Materials.sort()
	i=0
	for each in Materials:
		if each == 'lambert1' or each == 'particleCloud1' or each == 'shaderGlow1':
			continue
		cmds.select(sel,r=True)
		try:
			selectInSelectedObjectWithMaterial(each)
			cmds.polyColorPerVertex(rgb=IDPallets[i])
		except:
			pass
		i+=1

autoIDMap()




