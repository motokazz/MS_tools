/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3Module (int $module)
{
	global string $FaceStudio3MainWindow;	
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	string $FS3ShapeNode = `getAttr ($FS3node[0]+".shape")`;	
	string $FS3Shapes[] = `listAnimatable $FS3ShapeNode`;
	int $Nshapes = `size $FS3Shapes`;
	
	if ( $module == 1 )
	{
		window -e -title "FaceStudio v.3.0  -  Animation Editor" $FaceStudio3MainWindow;
		columnLayout -e -vis on fs3_AETOOLS;
		//columnLayout -e -vis off fs3_SETOOLS;
		columnLayout -e -vis off fs3_GETOOLS;

		menu -e -vis off fs3_animationMenu;
		//menu -e -vis off fs3_shapeMenu;
		menu -e -vis off fs3_groupMenu;
		menu -e -en true -vis on fs3_animationMenu;
		//menu -e -en false -vis off fs3_shapeMenu;
		menu -e -en false -vis off fs3_groupMenu;

		for ($i=1;$i<$Nshapes;$i++)
		{
			mute -disable $FS3Shapes[$i];
			iconTextButton -e -vis on ( "fs3_keyshape" + $i );
			iconTextButton -e -vis on ("fs3_autokey" + $i);
			iconTextButton -e -vis on ("fs3_delkey" + $i);
			iconTextButton -e -vis on ("fs3_customkey" + $i);
		}

	}
/*	
	if ( $module == 2 )
	{
		window -e -title "FaceStudio v.3.0  -  Shapes Manager" $FaceStudio3MainWindow;
		columnLayout -e -vis off fs3_AETOOLS;
		//columnLayout -e -vis on fs3_SETOOLS;
		columnLayout -e -vis off fs3_GETOOLS;
		menu -e -vis off fs3_animationMenu;
		//menu -e -vis off fs3_shapeMenu;
		menu -e -vis off fs3_groupMenu;		
		menu -e -en false -vis off fs3_animationMenu;
		//menu -e -en true -vis on fs3_shapeMenu;
		menu -e -en false -vis off fs3_groupMenu;
		
		for ($i=1;$i<$Nshapes;$i++)
		{
			mute $FS3Shapes[$i];
			iconTextButton -e -vis off ( "fs3_keyshape" + $i );
			iconTextButton -e -vis off ("fs3_autokey" + $i);
			iconTextButton -e -vis off ("fs3_delkey" + $i);
			iconTextButton -e -vis off ("fs3_customkey" + $i);
		}
		FaceStudio3ResetAll;
	}
*/
	if ( $module == 3 )
	{
		window -e -title "FaceStudio v.3.0  -  Groups Manager" $FaceStudio3MainWindow;
		columnLayout -e -vis off fs3_AETOOLS;
		//columnLayout -e -vis off fs3_SETOOLS;
		columnLayout -e -vis on fs3_GETOOLS;
		//menu -e -vis off fs3_animationMenu;
		//menu -e -vis off fs3_shapeMenu;
		//menu -e -vis off fs3_groupMenu;		
		menu -e -en false fs3_animationMenu;
		//menu -e -en false -vis off fs3_shapeMenu;
		//menu -e -en true -vis on fs3_groupMenu;
		
		for ($i=1;$i<$Nshapes;$i++)
		{
			iconTextButton -e -vis off ( "fs3_keyshape" + $i );
			iconTextButton -e -vis off ("fs3_autokey" + $i);
			iconTextButton -e -vis off ("fs3_delkey" + $i);
			iconTextButton -e -vis off ("fs3_customkey" + $i);
		}
			
	}	
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc int FaceStudio3WriteUIFile (string $FSfile, string $fileType )
{
	global string $FaceStudio3MainWindow;	
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	string $header = "//FaceStudio3 UI File	- 2005, Guillaume ROCHERON\nglobal proc FaceStudio3UILoad ()\n{\n";

	select -r -ne $FS3node[0];
	
	string $check = `match ".fs3" $FSfile`;
	if ( $check != ".fs3" )
	{
		$FSfile = ( $FSfile + ".fs3" );	
	}
	
	file -typ "mayaAscii" -es $FSfile;

	$fileId=`fopen ($FSfile + ".ma") "r"`;
 	string $nextLine = `fgetline $fileId`;
	int $goWrite = 0;

	while ( size( $nextLine ) > 0 ) 
	{
 		$nextLine = `fgetline $fileId`;
		if ( `match "groupId" $nextLine` == "groupId" )
		{
			$goWrite = 1;		
		}
				
		if ( `match "lightLinker" $nextLine` == "lightLinker" )
		{
			break;	
		}
		if ( $goWrite == 1 )
		{
			$nextLine = `substitute "-ci true" $nextLine ""`;
 			$header = ( $header + $nextLine );
 		}
 	}	
 	
 	fclose $fileId; 
 	
	$header = ($header + "select -r -ne " + $FS3node[0] + ";\nrename \"FaceStudio3Import1\";\n}\n// End of FaceStudio3 UI File");

	
	$fileId=`fopen $FSfile "w"`;
 	fprint $fileId $header;
 	fclose $fileId;
 	
 	sysFile -del ($FSfile + ".ma");
 	print ("//FaceStudio3 : UI saved as " + $FSfile + "\n");
 	select -cl;
 	return 1;
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3ResetUI ()
{
	global string $FaceStudio3MainWindow;
	global string $FaceStudio3Console;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	
	string $alljobs[] = `scriptJob -lj`;
	for ($n=0;$n<size($alljobs);$n++)
	{
		string $test = `match "FaceStudio3Exit" $alljobs[$n]`;
		if ( $test == "FaceStudio3Exit" )
		{	
			string $jobfind = `substitute ":.*" $alljobs[$n] ""`;
			int $jobindex = $jobfind;
			scriptJob -k $jobindex;
			break;
		}
	}

	select -r -ne $FS3node[0];
	delete;
	select -r -ne $obj;
	FaceStudio3;
}	
	
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3WriteInfo ( string $type, string $value, string $obj )
{
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	if ( `attributeExists $type $FS3node[0]` == 0 )
	{
		addAttr -ln $type -dt "string" $FS3node[0];
	}	
	setAttr -type "string" ($FS3node[0] + "." + $type) $value;
}


/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3ReadGroups ()
{
	global string $FaceStudio3MainWindow;
		
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;

	string $FS3ShapeNode = `getAttr ($FS3node[0] + ".shape")`;	
	string $FS3Shapes[] = `listAnimatable $FS3ShapeNode`;
	
	string $groupList = `getAttr ( $FS3node[0] + ".groupsList")`;
	string $groupsList[] = stringToStringArray ( $groupList, " " );

	textScrollList -e -ra fs3_groupsList;	
	for ($i=0;$i<size($groupsList);$i++)
	{
		textScrollList -e -append $groupsList[$i] fs3_groupsList;
		string $groupMembers = `getAttr ( $FS3node[0] + ".g" + $groupsList[$i])`;
		string $members[] = stringToStringArray ( $groupMembers , " " );
		
		if (`columnLayout -exists ( "ColGroup" + $groupsList[$i])`)
			deleteUI ( "ColGroup" + $groupsList[$i]);
			
		columnLayout -bgc 0.4 0.7 0.5 -p GridGroup -w 65 -h 50 -adjustableColumn true ( "ColGroup" + $groupsList[$i]);
			iconTextButton 	-l ($groupsList[$i]) -bgc 0.4 0.7 0.5 -p  ( "ColGroup" + $groupsList[$i])
					-style "iconAndTextVertical" -w 50 -h 50
					-i1 ( `internalVar -upd` + "icons/FaceStudio3/fs3_unselgroup.bmp" )
					-c ("FaceStudio3ShowGroupLayout " + $groupsList[$i] + ";iconTextButton -e -i1 ( \`internalVar -upd\` + \"icons/FaceStudio3/fs3_selgroup.bmp\" ) groupButton" + $groupsList[$i] )
					( "groupButton" + $groupsList[$i]);
			text -bgc 0.4 0.7 0.5 -l $groupsList[$i] -p  ( "ColGroup" + $groupsList[$i]);

		if ( `frameLayout -exists ("ShapeLayout" + $groupsList[$i])`)
			deleteUI ("ShapeLayout" + $groupsList[$i]);
		frameLayout -h 434 -vis off -p ShapeLayout -l ($groupsList[$i] + " Shapes List") ("ShapeLayout" + $groupsList[$i]);
			scrollLayout -bgc 0.6 0.6 0.6  -cr true -w 455 -h 400 ("ScrollBlend" + $groupsList[$i]);
				columnLayout -p ("ScrollBlend" + $groupsList[$i]) ("ColBlend" + $groupsList[$i]);
				
					int $FS3nShapes = size ($members);
					$FS3nShapes = `max  $FS3nShapes 5`;
					gridLayout -bgc 0.6 0.6 0.6 -nc 5 -nr ($FS3nShapes / 5) -cw 87 -ch 130 -p ("ColBlend" + $groupsList[$i]) ("GridBlend"+$groupsList[$i]);

		for ($n=0;$n<size($members);$n++)
		{
			int $shapeIndex = `FaceStudio3GetShapeIndex $members[$n]`;
			string $shapeIcon = `getAttr ( $FS3node[0] + ".ShapeIcon" + $shapeIndex)`;
/*			
			int $test = `filetest -r $shapeIcon`;
			if ( $test == 0 )
			{
				print "//FaceStudio error : icon file doesn't exists... removed !";	
				$shapeIcon = "";
				setAttr -type "string" ( $FS3node[0] + ".ShapeIcon" + $shapeIndex) "";
			}
*/
			if ( $shapeIcon == "" )
			{
				$shapeIcon = ( `internalVar -upd` + "icons/FaceStudio3/fs3_noIcon.bmp" );
			}
			
			columnLayout -bgc 0.6 0.6 0.6 -p ("GridBlend"+ $groupsList[$i]) -h 40 -adjustableColumn false ( "ColNodes" + $groupsList[$i] + $shapeIndex );
				columnLayout -bgc 0.6 0.6 0.6 -adjustableColumn false ( "ColIcon" + $groupsList[$i] + $shapeIndex );					
					iconTextButton 	-l ( `substitute ( $FS3ShapeNode + "." ) $FS3Shapes[$shapeIndex] ""`)
							-c ( "setAttr -type \"string\" " + $FS3node[0] + ".CurrentBlend \"" + $shapeIndex + "\"")
							-dcc ("if (\`getAttr " + $FS3Shapes[$shapeIndex] + "\` == 1 ) { setAttr " + $FS3Shapes[$shapeIndex] + " 0; } else { setAttr " + $FS3Shapes[$shapeIndex] + " 1;}")
							-ann ( `substitute ( $FS3ShapeNode + "." )$FS3Shapes[$shapeIndex] ""`)
							-style "iconAndTextVertical" -w 87 -h 87
							-image1 $shapeIcon
					("BlendButton" + $groupsList[$i] + $shapeIndex );
					setParent ..;
																		
				columnLayout -bgc 0.6 0.6 0.6 -adjustableColumn false;
					attrFieldSliderGrp -bgc 0.6 0.6 0.6 -pre 2 -cw 1 1 -cw 2 30 -cw 3 55 -min 0 -max 1 -l "" -at $FS3Shapes[$shapeIndex] -cc ("setAttr -type \"string\" " + $FS3node[0] + ".CurrentBlend \"" + $i +"\"") ("FSctrl" + $groupsList[$i] + $shapeIndex );	
					rowLayout -nc 5 -cw5 15 15 15 15 15 -bgc 0.6 0.6 0.6 -p ( "ColNodes" + $groupsList[$i] + $shapeIndex );
					separator -st none -w 10 -h 10 -bgc 0.6 0.6 0.6 ;
					iconTextButton -w 15 -h 15 -bgc 1 0.3 0.3  -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_key.bmp") -ann "Add keyframe" -c ("setKeyframe " + $FS3Shapes[$shapeIndex]);
					iconTextButton -w 15 -h 15 -bgc 0.8 0.7 0.7 -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_autokeyoff.bmp") -ann "Auto Key : off" -c ("FaceStudio3AutoKey " + $shapeIndex + " fs3_autokey" + $groupsList[$i] + $shapeIndex)("fs3_autokey" + $groupsList[$i] + $shapeIndex );
					iconTextButton -w 15 -h 15 -bgc 0.8 0.5 0.5 -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_removekey.bmp") -ann "Remove all shape keys" -c ("FaceStudio3DeleteKey " + $shapeIndex );
					iconTextButton -w 15 -h 15 -bgc 0.9 0.9 1 -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_customize.bmp") -ann "Customize shape icon";
				setParent ..;
		}
	}
}


/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc int FaceStudio3GetShapeIndex ( string $shp )
{
	global string $FaceStudio3MainWindow;
		
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	string $blendNode = `getAttr ($FS3node[0] + ".shape")`;	
	string $FS3Shapes[] = `listAnimatable $blendNode`;
	
	for ($i=0;$i<size($FS3Shapes);$i++)
	{
		if ( $FS3Shapes[$i] == ($blendNode + "." + $shp) )
		{
			break;	
		}
	}
	return $i;
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3ReadCustom ()
{
	global string $FaceStudio3MainWindow;
		
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	
	if ( `attributeExists "custom1" $FS3node[0]` == 0 )
	{
		addAttr -ln "custom1" -dt "string" $FS3node[0];
		setAttr -type "string" ($FS3node[0] + ".custom1") "print \"//custom1 : empty.\"";				
		addAttr -ln "custom2" -dt "string" $FS3node[0];
		setAttr -type "string" ($FS3node[0] + ".custom2") "print \"//custom2 : empty.\"";
		addAttr -ln "custom3" -dt "string" $FS3node[0];
		setAttr -type "string" ($FS3node[0] + ".custom3") "print \"//custom3 : empty.\"";
		addAttr -ln "custom4" -dt "string" $FS3node[0];
		setAttr -type "string" ($FS3node[0] + ".custom4") "print \"//custom4 : empty.\"";		
		addAttr -ln "custom5" -dt "string" $FS3node[0];		
		setAttr -type "string" ($FS3node[0] + ".custom5") "print \"//custom5 : empty.\"";
	}

	string $custom;
	$custom = `getAttr ( $FS3node[0] + ".custom1" )`;
	iconTextButton -e -c $custom -ann $custom fs3_custom1; 

	$custom = `getAttr ( $FS3node[0] + ".custom2" )`;
	iconTextButton -e -c $custom -ann $custom fs3_custom2; 

	$custom = `getAttr ( $FS3node[0] + ".custom3" )`;
	iconTextButton -e -c $custom -ann $custom fs3_custom3; 

	$custom = `getAttr ( $FS3node[0] + ".custom4" )`;
	iconTextButton -e -c $custom -ann $custom fs3_custom4; 

	$custom = `getAttr ( $FS3node[0] + ".custom5" )`;
	iconTextButton -e -c $custom -ann $custom fs3_custom5; 	
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3ReadObjects ()
{
	global string $FaceStudio3MainWindow;
	global string $FaceStudio3Console;
		
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	
	select -r -ne $obj;

	string $toAdd = `getAttr ( $FS3node[0] + ".ViewObj")`;
	if ( $toAdd != "" )
	{
		string $listObj[] = stringToStringArray($toAdd, " ");
		for ($i=0;$i<size($listObj);$i++)
		{
			select -add $listObj[$i];			
		}
	}
	modelEditor -e -vs 1 FaceStudio3Pane;
	modelEditor -e -ss FaceStudio3Pane;
	select -cl;		
}


/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3ReadEyeControls ()
{
	global string $FaceStudio3MainWindow;	
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;	
	string $selShapeNode = `getAttr ( $FS3node[0] + ".shape" )`;

	string $control1 = `getAttr ( $FS3node[0] + ".EyeControl1")`;
	string $control2 = `getAttr ( $FS3node[0] + ".EyeControl2")`;

	toggleAutoLoad ("fs3_dopeOutlineEd") 1;
	toggleAutoLoad ("fs3_graphOutlineEd") 1;
	select -r -ne $selShapeNode;
	
	if ( $control1 != "" )
	{
		string $fs3_params[] = stringToStringArray($control1, " ");
		float $val1 = $fs3_params[2];
		float $val2 = $fs3_params[3];
		attrFieldSliderGrp -e -at (  $fs3_params[0] + "." +  $fs3_params[1] ) -min  $val1 -max  $val2 FShorieye;
		select -add  $fs3_params[0];
	}
	
	if ( $control2 != "" )
	{
		string $fs3_params[] = stringToStringArray($control2, " ");
		float $val1 = $fs3_params[2];
		float $val2 = $fs3_params[3];
		attrFieldSliderGrp -e -at (  $fs3_params[0] + "." + $fs3_params[1] ) -min  $val1 -max  $val2 FSvertieye;
		select -add  $fs3_params[0];		
	}
	toggleAutoLoad ("fs3_dopeOutlineEd") 0;
	toggleAutoLoad ("fs3_graphOutlineEd") 0;
	select -cl;
}


/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3ReadShapeIcons ()
{
	global string $FaceStudio3MainWindow;	
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	string $selShapeNode = `getAttr ( $FS3node[0] + ".shape" )`;
	string $FS3Shapes[] = `listAnimatable $selShapeNode`;
	
	for ($i=1;$i<size($FS3Shapes);$i++)
	{
		string $icon = `getAttr ( $FS3node[0] + ".ShapeIcon" + $i)`;
//		int $test = `filetest -r $icon`;
//		if ( $test == 0 )
//		{
//			setAttr -type "string" ( $FS3node[0] + ".ShapeIcon" + $i ) "";
//			$icon = "";
//			print "//FaceStudio error : icon file doesn't exists... removed !";	
//		}		
		if ( $icon != "" )
		{
			iconTextButton -e -i1 $icon ("BlendButton" + $i);		
		}	
	}
	
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
global proc FaceStudio3ReadSound ()
{
	global string $FaceStudio3MainWindow;
	global string $gPlayBackSlider;
		
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	
	int $foffset = `getAttr ( $FS3node[0] + ".soundOffset" )`;
	string $FS3sound = `getAttr ( $FS3node[0] + ".sound" )`;
	
	int $test = `filetest -r $FS3sound`;
	if ( $test == 0 )
	{
		setAttr -type "string" ( $FS3node[0] + ".sound" ) "";
		$FS3sound = "";
		print "//FaceStudio error : sound file doesn't exists... removed !";	
	}

	string $sounds[] = `ls -type "audio"`;
	if ( $sounds[0] != "" )
	{
		select -r $sounds;
		delete;
	}
	if ( $FS3sound != "" )
	{
		sound -offset $foffset  -file $FS3sound;	
		string $sounds[] = `ls -type "audio"`;
		select -r $sounds;
		rename FaceStudio3Sound;		
		soundControl -e -sound "FaceStudio3Sound" -displaySound 1  FS3scrubPort;
		timeControl -e -sound "FaceStudio3Sound" -displaySound 1 $gPlayBackSlider;		
 	}
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3AssignCustomFunctions ()
{

	global string $FaceStudio3MainWindow;
		
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;	

	string $custom;

	$custom = `textFieldGrp -q -text custom_txt1`;
	iconTextButton -e -c $custom -ann $custom fs3_custom1;
	FaceStudio3WriteInfo "custom1" $custom $obj;

	$custom = `textFieldGrp -q -text custom_txt2`;
	iconTextButton -e -c $custom -ann $custom fs3_custom2;
	FaceStudio3WriteInfo "custom2" $custom $obj;

	$custom = `textFieldGrp -q -text custom_txt3`;
	iconTextButton -e -c $custom -ann $custom fs3_custom3;
	FaceStudio3WriteInfo "custom3" $custom $obj;

	$custom = `textFieldGrp -q -text custom_txt4`;
	iconTextButton -e -c $custom -ann $custom fs3_custom4;
	FaceStudio3WriteInfo "custom4" $custom $obj;

	$custom = `textFieldGrp -q -text custom_txt5`;
	iconTextButton -e -c $custom -ann $custom fs3_custom5;
	FaceStudio3WriteInfo "custom5" $custom $obj;

}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3FilterObjectList ()
{
	global string $FaceStudio3MainWindow;	
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;	
	string $listObj[];
	
	string $toAdd = `getAttr ( $FS3node[0] + ".ViewObj")`;
	if ($toAdd != "" )
	{
		 $listObj = stringToStringArray($toAdd, " ");

		for ($i=0;$i<size($listObj);$i++)
		{
			textScrollList -e -ri $listObj[$i] FS3listObj;
			textScrollList -e -w 245 -h 240 -append $listObj[$i] FS3viewObj;
		}
	} else
	{
		textScrollList -e -w 245 -h 240 -ra FS3viewObj;
	}
	textScrollList -e -ri $obj FS3listObj;
	
}

global proc FaceStudio3AddToList ()
{
	string $FS3list[] = `textScrollList -q -si  FS3listObj`;
	for ($i=0;$i<size($FS3list);$i++)
	{
		textScrollList -e -ri $FS3list[$i] FS3listObj;
		textScrollList -e -append $FS3list[$i] FS3viewObj;	
	}
	$FS3list = `textScrollList -q -ai  FS3viewObj`;
	$FS3list = `sort $FS3list`;
	textScrollList -e -ra FS3viewObj;
	for ($i=0;$i<size($FS3list);$i++)
	{
		textScrollList -e -w 245 -h 240 -append $FS3list[$i] FS3viewObj;	
	}
}

global proc FaceStudio3RemFromList ()
{
	string $FS3list[] = `textScrollList -q -si  FS3viewObj`;
	for ($i=0;$i<size($FS3list);$i++)
	{
		textScrollList -e -ri $FS3list[$i] FS3viewObj;
		textScrollList -e -append $FS3list[$i] FS3listObj;	
	}
	$FS3list = `textScrollList -q -ai  FS3listObj`;
	$FS3list = `sort $FS3list`;
	textScrollList -e -ra FS3listObj;
	for ($i=0;$i<size($FS3list);$i++)
	{
		textScrollList -e -w 245 -h 240 -append $FS3list[$i] FS3listObj;	
	}

}

global proc FaceStudio3DisplayObjects ()
{
	global string $FaceStudio3MainWindow;	
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	string $listObj[] = `textScrollList -q -ai  FS3viewObj`;
	
	string $objToAdd =  stringArrayToString( $listObj, " ");

	
	for ($i=0;$i<size($listObj);$i++)
	{
		FaceStudio3WriteInfo ( "ViewObj" ) $objToAdd $obj;
	}
	if ( $objToAdd == "" )
	{
		FaceStudio3WriteInfo ( "ViewObj" ) "" $obj;		
	}
	select -r -ne $listObj;
	select -add $obj;
	modelEditor -e -ss FaceStudio3Pane;

	select -cl;	
}

global proc FaceStudio3CustomParent ( int $mode )
{
	global string $FaceStudio3MainWindow;	
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3camera = `modelEditor -q -cam FaceStudio3Pane`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	string $FS3parent;
		
	if ( $mode == 2 )
	{
		string $cParent = `getAttr ( $FS3node[0] + ".parent" )`;
		setAttr -type "string" ( $FS3node[0] + ".CustomParent" ) "";
		$FS3parent = $cParent;
	}
	else
	{
		string $objParent[] = `textScrollList -q -si  FS3parentObj`;
		setAttr -type "string" ( $FS3node[0] + ".CustomParent" ) $objParent[0];
		$FS3parent = $objParent[0];
	}
	parent -w $FS3camera;
	parent $FS3camera $FS3parent;
	button -e -l $FS3parent -w 220 -h 30 FS3parentBt;
}
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3ApplyViewSettings () 
{
	global string $FaceStudio3MainWindow;	

	int $ligthning = `checkBoxGrp -q -v1 fs3viewligth`;
	if ( $ligthning == 1 )
	{
		modelEditor -e -dl "all" FaceStudio3Pane;	
	}
	else
	{
		modelEditor -e -dl "default" FaceStudio3Pane;			
	}

	int $showAll =  `checkBoxGrp -q -v1 fs3viewdisplay`;
	if ( $showAll == 1 )
	{
		modelEditor -e -vs 0 FaceStudio3Pane;		
	}
	else
	{		
		FaceStudio3ReadObjects;
	}
	
	setAttr "FaceStudio3View.focalLength" `floatSliderGrp -q -v fs3viewfocal`;
	modelEditor -e -wos `checkBoxGrp -q -v1 fs3viewwire` FaceStudio3Pane;			
	modelEditor -e -xr `checkBoxGrp -q -v1 fs3viewxray` FaceStudio3Pane;			
	modelEditor -e -sdw `checkBoxGrp -q -v1 fs3viewshadow` FaceStudio3Pane;			
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3ApplyEyeSliderLink () 
{
	
	global string $FaceStudio3MainWindow;	
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	string $selShapeNode = `getAttr ( $FS3node[0] + ".shape" )`;

	
	string $obj1[] = `textScrollList -q -si FS3listObjLink1`;
	string $obj2[] = `textScrollList -q -si FS3listObjLink2`;
	
	string $attr1[] = `textScrollList -q -si FS3listObjAttrib1`;	
	string $attr2[] = `textScrollList -q -si FS3listObjAttrib2`;

	float $min1 = `floatFieldGrp -q -v1 fs3_eye_s1_min`;
	float $max1 = `floatFieldGrp -q -v1 fs3_eye_s1_max`;

	float $min2 = `floatFieldGrp -q -v1 fs3_eye_s2_min`;
	float $max2 = `floatFieldGrp -q -v1 fs3_eye_s2_max`;
	
	toggleAutoLoad ("fs3_dopeOutlineEd") 1;
	toggleAutoLoad ("fs3_graphOutlineEd") 1;
	select -r -ne $selShapeNode;

	if ( $obj1[0] != "None" )
	{
		attrFieldSliderGrp -e -en true -bgc 0.6 0.4 0.1 -at ( $obj1[0] + "." + $attr1[0] ) -min $min1 -max $max1 FShorieye;
		FaceStudio3WriteInfo ( "EyeControl1" ) ( $obj1[0] + " " + $attr1[0] + " " + $min1 + " " + $max1 ) $obj;
		select -add $obj1;
	}
	else
	{
		FaceStudio3WriteInfo ( "EyeControl1" ) "" $obj;
		attrFieldSliderGrp -e -en false FShorieye;			
	}	
	
	if ( $obj2[0] != "None" )
	{
		attrFieldSliderGrp -e -en true -bgc 0.6 0.4 0.1 -at ( $obj2[0] + "." + $attr2[0] ) -min $min2 -max $max2 FSvertieye;		
		FaceStudio3WriteInfo ( "EyeControl2" ) ( $obj2[0] + " " + $attr2[0] + " " + $min2 + " " + $max2 ) $obj;
		select -add $obj2;
	}
	else
	{
		FaceStudio3WriteInfo ( "EyeControl2" ) "" $obj;				
		attrFieldSliderGrp -e -en false FSvertieye;			
	}	
	toggleAutoLoad ("fs3_dopeOutlineEd") 0;
	toggleAutoLoad ("fs3_graphOutlineEd") 0;
	select -cl;

}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3ApplyVideoSettings ()
{
	global string $gAECurrentTab;
	global string $FaceStudio3MainWindow;	
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
		
	int $fext = `checkBoxGrp -q -v1 fs3_frameExt`;
	int $foffset = `intFieldGrp -q -v1 fs3_offset`;	
	string $videofile = `textField -q -tx fs3_video`;

	setAttr "FaceStudio3VideoPlane.useFrameExtension" $fext;
	setAttr "FaceStudio3VideoPlane.frameOffset" $foffset;

	setAttr -type "string" ($FS3node[0] + ".videoExt") $fext;
	setAttr -type "string" ($FS3node[0] + ".videoOffset") $foffset;
	
	if ( $videofile != "none" )
	{
		setAttr -type "string" FaceStudio3VideoPlane.imageName $videofile;
	}

	string $sel[] = `ls -sl`;
	select -r FaceStudio3VideoCam;
	ShowAttributeEditorOrChannelBox;
	commitAENotes($gAECurrentTab);window -e -vis 0 AEWindow;
	select -r $sel;
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3ApplySoundSettings ()
{
	global string $FaceStudio3MainWindow;
	global string $gPlayBackSlider;
	
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
		
	int $foffset = `intFieldGrp -q -v1 fs3_soundOffset`;	
	string $soundfile = `textField -q -tx fs3_sound`;

	setAttr -type "string" ($FS3node[0] + ".soundOffset") $foffset;
	string $sounds[] = `ls -type "audio"`;
	if ( $sounds[0] != "" )
	{
		select -r $sounds;
		delete;
	}
	if ( $soundfile != "none" )
	{
 		sound -offset $foffset  -file $soundfile;
		string $sounds[] = `ls -type "audio"`;
		select -r $sounds;
		rename FaceStudio3Sound;
		soundControl -e -sound "FaceStudio3Sound" -displaySound 1  FS3scrubPort;
 		timeControl -e -sound "FaceStudio3Sound" -displaySound true $gPlayBackSlider;				
 	}
}

