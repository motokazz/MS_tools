/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
global proc FaceStudio3PickVideo ()
{
	global string $FaceStudio3MainWindow;
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;

	string $video = `fileDialog -dm "*.tga; *.bmp; *.iff; *.tif"`;

	if ( $video != "" )
	{
		textField -e -tx $video fs3_video;
		setAttr -type "string" (  $FS3node[0] +".video" ) $video;
	}
}
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3PickSound ()
{
	global string $FaceStudio3MainWindow;
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;

	string $sound = `fileDialog -dm "*.wav; *.aifff"`;
	if ( $sound != "" )
	{
		textField -e -tx $sound fs3_sound;
		setAttr -type "string" (  $FS3node[0] +".sound" ) $sound;
	}
}
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
global proc FaceStudio3Exit ()
{
	global string $FaceStudio3MainWindow;	
	global string $gMainWindow;
			
	if (`window -exists $FaceStudio3MainWindow`)
	{	
		window -e -vis off $FaceStudio3MainWindow;
	}			
	
	if (`objExists FaceStudio3View`)
		delete FaceStudio3View;

	if (`objExists FaceStudio3VideoCam`)
		delete FaceStudio3VideoCam;

	if (`objExists FaceStudio3Sound`)
		delete FaceStudio3Sound;
		
	window -e -tlc 0 0 $gMainWindow;
		
	select -cl;
	print "//FaceStudio3 : Closed...\n";
}
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3MainMenu ()
{
	global string $gMainWindow;
	if ( `menu -exists FaceStudio3Menu` ) deleteUI FaceStudio3Menu;
	if ( $gMainWindow != "" )
	{
		setParent $gMainWindow;
		menu -label "FaceStudio3" -tearOff true FaceStudio3Menu;
			menuItem -label "Launch..." -command "FaceStudio3";
			menuItem -d true;
			menuItem -label "FaceStudio Objects" -subMenu true -pmc "FaceStudio3ListObjects" FS3menuListObj;
				setParent ..;
			menuItem -label "Clean Scene"  -command "FaceStudio3CleanDialog" -p  FaceStudio3Menu;
			menuItem -d true -p  FaceStudio3Menu;
 			menuItem -label "Help" -c ( "launch -web ( \`internalVar -usd`\ + \"FaceStudio3/Documentation/FaceStudio3Manual.html\")" )  -p  FaceStudio3Menu;
			menuItem -label "About..."  -command "FaceStudio3About" -p  FaceStudio3Menu;
	}
	
	string $alljobs[] = `scriptJob -lj`;
	for ($n=0;$n<size($alljobs);$n++)
	{
		string $test = `match "FaceStudio3CheckMode" $alljobs[$n]`;
		if ( $test == "FaceStudio3CheckMode" )
		{	
			string $jobfind = `substitute ":.*" $alljobs[$n] ""`;
			int $jobindex = $jobfind;
			scriptJob -k $jobindex;
		}
	}
	scriptJob -event "MenuModeChanged" FaceStudio3CheckMode;
}	
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3CheckMode ()
{
	global string $gMayaMode;
	if ( $gMayaMode == "Animation" )
	{
		menu -e -vis on FaceStudio3Menu;	
	}
	else
	{
		menu -e -vis off FaceStudio3Menu;	
	}
	
}
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3ListObjects ()
{
	string $sel[] = `ls -sl`;
	int $test = 0;
	
	if ( `objExists "FaceStudio3Attributes"` )
	{
		$test = 1;
	}
	
	for ($i=1;$i<=100;$i++)
	{
		if ( `objExists ("FaceStudio3Attributes"+$i)` )
		{
			$test = 1;
			break;
		}
	}
	
	if ( $test == 1 )
	{
		select -r "FaceStudio3Attribute*";
		string $FS3nodes[] = `ls -sl`;
		for ( $i=0;$i<=100;$i++)
		{
			if ( `menuItem -exists ("FS3menuMemberObj"+$i)` )
				deleteUI ("FS3menuMemberObj"+$i);
		}
		for ( $i=0;$i<size($FS3nodes);$i++)
		{
			string $FSobj[] = `listConnections ( $FS3nodes[$i] + ".connection")` ;
			menuItem -l $FSobj[0] -p FS3menuListObj -c ("select -r " + $FSobj[0] ) ("FS3menuMemberObj"+$i) ;	
		}
	}
	else
	{
		if ( `menuItem -exists ("FS3menuMemberObj1")` )
			deleteUI ("FS3menuMemberObj1");
		menuItem -l "none" -p FS3menuListObj ("FS3menuMemberObj1");
	}	
	select -r $sel;
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3Install ()
{
	global string $FaceStudio3Console;

	FaceStudio3ConsoleMessage ("// Start install...");
	string $usp = (`internalVar -usd` + "userSetup.mel" );
	int $test = `filetest -r  $usp`;
	if ( $test == 0 )
	{
		FaceStudio3ConsoleMessage ("// userSetup file doesn't exists. Creating new one...");	
		$fileId=`fopen $usp "w"`;
 		fwrite $fileId "source FaceStudio3; FaceStudio3MainMenu;";
 		fclose $fileId;
	}
	else
	{
		FaceStudio3ConsoleMessage ("// userSetup file exists. Modifying it...");
		$fileId=`fopen $usp "r"`;	
		string $testExist = 0;
		string $nextLine = `fgetline $fileId`;
 		while ( size( $nextLine ) > 0 )
 		{ 
 			string $isWrite = `match "FaceStudio3" $nextLine`;
 			if ( $isWrite == "FaceStudio3" )
 			{
 				FaceStudio3ConsoleMessage ("// FaceStudio already registered");
 				$testExist = 1;
 				break;
 			}
 			$nextLine = `fgetline $fileId`;
 		}	
 		fclose $fileId;
 		if ( $testExist == 0 )
 		{
 			FaceStudio3ConsoleMessage ("// Registering FaceStudio...");
			$fileId=`fopen $usp "r"`;	
			string $nextLine = `fgetline $fileId`;
			string $record;
	 		while ( size( $nextLine ) > 0 )
	 		{ 
	 			$record = ( $record + $nextLine );
	 			$nextLine = `fgetline $fileId`;
	 		}
	 		fclose $fileId; 			
			$record = ( $record + "source FaceStudio3; FaceStudio3MainMenu;" );
			$fileId=`fopen $usp "w"`;
 			fwrite $fileId $record;
 			fclose $fileId;			
 		}
	}
	FaceStudio3ConsoleMessage ("// Menu added in Animation tab");
	FaceStudio3MainMenu;
	FaceStudio3ConsoleMessage ("// Install completed !");
}