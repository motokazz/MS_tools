/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3ResetAll () 
{	
	global string $FaceStudio3MainWindow;
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;	
	string $selShapeNode = `getAttr ( $FS3node[0] + ".shape" )`;
	string $FS3Shapes[] = `listAnimatable $selShapeNode`;

	for ($i=1;$i<size ($FS3Shapes);$i++)
	{
		setAttr $FS3Shapes[$i] 0;		
	}			
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3DeleteAllKey ()
{
	global string $FaceStudio3MainWindow;	
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;	
	string $selShapeNode = `getAttr ( $FS3node[0] + ".shape" )`;
	string $FS3Shapes[] = `listAnimatable $selShapeNode`;
		
	string $FSconfirm = `confirmDialog 	-title "Delete" -message "Delete All Keys ?"
    						-button "Yes" -button "No" -defaultButton "No"
    						-cancelButton "No" -dismissString "No"`;
	if ( $FSconfirm == "Yes" )
	{
		for ($i=1;$i<size ($FS3Shapes);$i++)
		{
			int $FSkeyCount = `keyframe -q -kc $FS3Shapes[$i]`;
			if ( $FSkeyCount != 0 ) 
			{
				selectKey -r -k  $FS3Shapes[$i];
				cutKey -clear;
			}
		}
	}
}
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3Iconize ()
{
	global string $FaceStudio3MainWindow;	
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;	
	string $selShapeNode = `getAttr ( $FS3node[0] + ".shape" )`;
	string $FS3Shapes[] = `listAnimatable $selShapeNode`;

	float $currentBGcolor[] = `displayRGBColor -q -c background`;
	int $frame = `currentTime -q`;
	int $currentShapeIndex = `getAttr ($FS3node[0] + ".CurrentBlend")`;
	int $currentImageFormat = `getAttr defaultRenderGlobals.imageFormat`;

 	string $currentShape = `iconTextButton -q -l ("BlendButton" + $currentShapeIndex)`;
	string $iconPath = (`internalVar -usd` + "FaceStudio3/UI_icons/" + $obj + "_" + $FS3node[0] + "/");
	string $iconFile = ( $iconPath + $currentShape );
	
	sysFile -md $iconPath;

	setAttr "defaultRenderGlobals.imageFormat" 20;
	displayRGBColor -c background 0.6 0.75 0.8;


	for ($i=1;$i<size ($FS3Shapes);$i++)
	{
		mute $FS3Shapes[$i];
	}
	
	modelEditor -e -av FaceStudio3Pane;
	playblast -orn off -st $frame -et $frame -w 87 -h 87 -p 100 -v off -fo -fmt image -cf ( $iconFile + ".bmp");
	displayRGBColor -c background $currentBGcolor[0] $currentBGcolor[1] $currentBGcolor[2];
	
	for ($i=1;$i<size ($FS3Shapes);$i++)
	{
		mute -disable $FS3Shapes[$i];
	}

	setAttr "defaultRenderGlobals.imageFormat" $currentImageFormat;
	
	FaceStudio3WriteInfo ("ShapeIcon" + $currentShapeIndex) ( $iconFile + ".bmp" ) $obj;		

	deleteUI ("BlendButton" + $currentShapeIndex);
	string $FS3nomShape = `substitute ( $selShapeNode + "." ) $FS3Shapes[$currentShapeIndex] ""`;
	iconTextButton 	-l $FS3nomShape
			-c ( "setAttr -type \"string\" " + $FS3node[0] + ".CurrentBlend \"" + $currentShapeIndex + "\";")
			-dcc ("if (\`getAttr " + $FS3Shapes[$currentShapeIndex] + "\` == 1 ) { setAttr " + $FS3Shapes[$currentShapeIndex] + " 0; } else { setAttr " + $FS3Shapes[$currentShapeIndex] + " 1;}")		
			-ann ( `substitute ( $selShapeNode + "." )$FS3Shapes[$currentShapeIndex] ""`)
			-style "iconAndTextVertical" -w 87 -h 87
			-image1 ( $iconFile + ".bmp" )
			-p ( "ColIcon" + $currentShapeIndex ) 
			("BlendButton" + $currentShapeIndex);								
	FaceStudio3ReadGroups;

	print "//FaceStudio3 : iconize done.\n";
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3AutoIconize (int $onlyUndefined)
{
	global string $FaceStudio3MainWindow;
	global string $FaceStudio3Console;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;	
	string $selShapeNode = `getAttr ( $FS3node[0] + ".shape" )`;
	string $FS3Shapes[] = `listAnimatable $selShapeNode`;
 	
 	columnLayout -e -vis off ShapeLayout;

	for ($i=1;$i<size ($FS3Shapes);$i++)
	{
		FaceStudio3ResetAll;
		if ( $onlyUndefined == 0 )
		{
			setAttr	-type "string" ($FS3node[0] + ".CurrentBlend") $i;
			setAttr ( $FS3Shapes[$i] ) 1;
			FaceStudio3Iconize;
		}
		else
		{
			string $check = `getAttr ($FS3node[0] + ".ShapeIcon" + $i)`;
			if ( $check == "" )
			{
				setAttr	-type "string" ($FS3node[0] + ".CurrentBlend") $i;
				setAttr ( $FS3Shapes[$i] ) 1;	
				FaceStudio3Iconize;
			}			
		}
	}
 	columnLayout -e -vis on ShapeLayout;

}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3AutoKey (int $shapeIndex, string $shapebutton) {
	
	global string $FaceStudio3MainWindow;
	global string $FaceStudio3Console;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;	
	string $selShapeNode = `getAttr ( $FS3node[0] + ".shape" )`;
	string $FS3Shapes[] = `listAnimatable $selShapeNode`;
	
	string $status = `iconTextButton -q -ann $shapebutton`;

	string $btslider = ("FSctrl" + (`substitute "fs3_autokey" $shapebutton ""`) );

	if ( $status == "Auto Key : off" ) {
		attrFieldSliderGrp -e -cc ("setKeyframe " + $FS3Shapes [$shapeIndex]) $btslider;
		iconTextButton -e -w 15 -h 15 -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_autokeyon.bmp")-ann "Auto Key : on" $shapebutton;

	} 
	else 
	{
		attrFieldSliderGrp -e -cc ("") $btslider;
		iconTextButton -e -w 15 -h 15 -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_autokeyoff.bmp") -ann "Auto Key : off" $shapebutton;
	}
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3DeleteKey (int $shapeIndex) 
{
	global string $FaceStudio3MainWindow;
	global string $FaceStudio3Console;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;	
	string $selShapeNode = `getAttr ( $FS3node[0] + ".shape" )`;
	string $FS3Shapes[] = `listAnimatable $selShapeNode`;

	string $confirm = `confirmDialog 	-title "Delete" -message ("Delete all \"" + $FS3Shapes[$shapeIndex] + "\" keys ?")
    						-button "Yes" -button "No" -defaultButton "No"
    						-cancelButton "No" -dismissString "No"`;

	if ( $confirm == "Yes" ) 
	{	
		int $FSkeyCount = `keyframe -q -kc $FS3Shapes[$shapeIndex]`;
		if ( $FSkeyCount != 0 ) 
		{
			selectKey -r -k $FS3Shapes[$shapeIndex];
			cutKey -clear;	
		}
	}
}
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
global proc FaceStudio3CustomizeIcons ( int $shapeIndex) 
{
	global string $FaceStudio3MainWindow;
	global string $FaceStudio3Console;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;	
	string $selShapeNode = `getAttr ( $FS3node[0] + ".shape" )`;
	string $FS3Shapes[] = `listAnimatable $selShapeNode`;
	
	string $FS3icon = `fileDialog -dm "*.bmp"`;
	if ( $FS3icon != "" )
	{
		FaceStudio3WriteInfo ("ShapeIcon" + $shapeIndex) ( $FS3icon ) $obj;		

	deleteUI ("BlendButton" + $shapeIndex);
	string $FS3nomShape = `substitute ( $selShapeNode + "." ) $FS3Shapes[$shapeIndex] ""`;
	iconTextButton 	-l $FS3nomShape
			-c ( "setAttr -type \"string\" " + $FS3node[0] + ".CurrentBlend \"" + $shapeIndex + "\";")
			-ann ( `substitute ( $selShapeNode + "." )$FS3Shapes[$shapeIndex] ""`)
			-style "iconAndTextVertical" -w 87 -h 87
			-image1 ( $FS3icon )
			-p ( "ColIcon" + $shapeIndex ) 
			("BlendButton" + $shapeIndex);								
	FaceStudio3ReadGroups;
	}
}
