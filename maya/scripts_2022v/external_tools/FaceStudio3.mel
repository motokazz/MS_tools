global proc FaceStudioKeyEye (string $controlIndex) 
{
	
	global string $FaceStudio3MainWindow;
	global string $FaceStudio3Console;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	
	string $fs3_attr = `attrFieldSliderGrp -q -at ("FS" + $controlIndex + "eye")`;
	if ($fs3_attr != "" )
	{
		setKeyframe $fs3_attr;
	}
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudioAutoKeyEye (string $controlIndex)
{
	
	global string $FaceStudio3MainWindow;
	global string $FaceStudio3Console;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	
	string $fs3_attr = `attrFieldSliderGrp -q -at ("FS" + $controlIndex + "eye")`; 
	float $min = `attrFieldSliderGrp -q -min ("FS" + $controlIndex + "eye")`; 
	float $max = `attrFieldSliderGrp -q -max ("FS" + $controlIndex + "eye")`; 

	string $status = `iconTextButton -q -ann ("FS3autokey" + $controlIndex)`;

	if ($fs3_attr != "" )
	{
		if ( $status == "Auto Key : off" ) 
		{
			attrFieldSliderGrp -e -min $min -max $max -cc ("setKeyframe " + $fs3_attr) ("FS" + $controlIndex + "eye");
			iconTextButton -e -w 15 -h 15 -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_autokeyon.bmp")-ann "Auto Key : on" 	("FS3autokey" +  $controlIndex);

		}
		else 
		{
			attrFieldSliderGrp -e -min $min -max $max -cc ("") ("FS" + $controlIndex + "eye");
			iconTextButton -e -w 15 -h 15 -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_autokeyoff.bmp") -ann "Auto Key : off" ("FS3autokey" + $controlIndex);
		}
	}	
	
}

global proc FaceStudioRemoveKeyEye (string $controlIndex)
{
	global string $FaceStudio3MainWindow;
	global string $FaceStudio3Console;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	
	string $fs3_attr = `attrFieldSliderGrp -q -at ("FS" + $controlIndex + "eye")`; 
	
	string $confirm = `confirmDialog 	-title "Delete" -message ("Delete all \"" + $fs3_attr + "\" keys ?")
    						-button "Yes" -button "No" -defaultButton "No"
    						-cancelButton "No" -dismissString "No"`;

	if ( $confirm == "Yes" ) 
	{	
		int $FSkeyCount = `keyframe -q -kc $fs3_attr`;
		if ( $FSkeyCount != 0 ) 
		{
			selectKey -r -k $fs3_attr;
			cutKey -clear;	
		}
	}
		
}
