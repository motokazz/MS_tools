/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
global proc FaceStudio3Playblast ()
{
	modelEditor -e -av FaceStudio3Pane;
	performPlayblast 4;
	window -e -t "FaceStudio v.3.0  - Playblast" OptionBoxWindow;
}
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
global proc FaceStudio3SoundOnOff ()
{
	global string $gPlayBackSlider;
	string $statu = `iconTextButton -q -ann fs3_soundonoff`;
	if ( $statu == "sound on" )
	{	
		iconTextButton -e -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_soundoff.bmp") fs3_soundonoff;
		iconTextButton -e -ann "sound off" fs3_soundonoff;
		if (`objExists FaceStudio3Sound` )
		{
			soundControl -e -sound "FaceStudio3Sound" -displaySound 0  FS3scrubPort;
			timeControl -e -sound "FaceStudio3Sound" -displaySound 0 $gPlayBackSlider;	
		}
	}
	else
	{
		iconTextButton -e -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_soundon.bmp") fs3_soundonoff;			
		iconTextButton -e -ann "sound on" fs3_soundonoff;
		if (`objExists FaceStudio3Sound` )
		{
			soundControl -e -sound "FaceStudio3Sound" -displaySound 1  FS3scrubPort;
			timeControl -e -sound "FaceStudio3Sound" -displaySound 1 $gPlayBackSlider;	
		}
	}
}
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3GroupCreate ()
{
	global string $FaceStudio3MainWindow;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
		
	string $groupName = `textFieldGrp -q -tx fs3_groupname`;
	string $allgroups[] = `textScrollList -q -ai fs3_groupsList`;
	string $Nodegroups = `getAttr ($FS3node[0] + ".groupsList")`;
	
	if (( $groupName == "" ) || ( $groupName == "noname" ))
	{
		print "//FaceStudio3 : no valid group name\n";
		return;	
	}
	for ($i=1;$i<=10;$i++)
	{
		$groupName = `substitute " " $groupName "_"`;
	}
	for ($i=0;$i<size($allgroups);$i++)
	{
		if ( $groupName == $allgroups[$i] )
		{
			print "//FaceStudio3 :this group already exists\n";
			return;
		}	
	}
	
	textScrollList -e -append $groupName fs3_groupsList;
	setAttr -type "string" ($FS3node[0] + ".groupsList") ( $Nodegroups + " " + $groupName );
	
	addAttr -ln ("g" + $groupName) -dt "string" $FS3node[0];
	
	if (`objExists ( "ColGroup" + $groupName)`)
		deleteUI ( "ColGroup" + $groupName);
			
	// group menu
	columnLayout -bgc 0.4 0.7 0.5 -p GridGroup -w 65 -h 50 -adjustableColumn true ( "ColGroup" + $groupName);
		iconTextButton 	-l ($groupName) -bgc 0.4 0.7 0.5 -p  ( "ColGroup" + $groupName)
				-style "iconAndTextVertical" -w 50 -h 50
				-i1 ( `internalVar -upd` + "icons/FaceStudio3/fs3_unselgroup.bmp" )
				-c ("iconTextButton -e -i1 ( \`internalVar -upd\` + \"icons/FaceStudio3/fs3_selgroup.bmp\" ) groupButton" + $groupName )
				( "groupButton" + $groupName);
		text -bgc 0.4 0.7 0.5 -l $groupName -p  ( "ColGroup" + $groupName);	

	// group layout
	
	FaceStudio3ReadGroups; 		
}

global proc FaceStudio3GroupRename ()
{
	global string $FaceStudio3MainWindow;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
		
	string $groupName[] = `textScrollList -q -si fs3_groupsList`;
	string $allgroups[] = `textScrollList -q -ai fs3_groupsList`;	
	string $newName = `textFieldGrp -q -tx fs3_groupnewname`;
	string $Nodegroups = `getAttr ($FS3node[0] + ".groupsList")`;
	
	if ( $groupName[0] == "" )
	{
		print "//FaceStudio3 : no group selected\n";
		return;
	}
	
	if ( $newName == "" )
	{
		print "//FaceStudio3 : no valid group name\n";
		return;
	}
	
	for ($i=1;$i<=10;$i++)
	{
		$newName = `substitute " " $newName "_"`;
	}
	
	if ( $newName == $groupName[0] )
	{
		return;	
	}
	
	int $pos = 1;
	for ($i=0;$i<size($allgroups);$i++)
	{
		if ( $newName == $allgroups[$i] )
		{
			print "//FaceStudio3 :this group already exists\n";
			return;
		}
		if ( $allgroups[$i] == $groupName[0] )
		{
			$pos = $i + 1;	
		}		
	}
	textScrollList -e -ri $groupName[0] fs3_groupsList;
	textScrollList -e -ap $pos $newName fs3_groupsList;
	
	string $listGroup[] = stringToStringArray($Nodegroups, " ");
	for ($i=0;$i<size($listGroup);$i++)
	{
		if ( $listGroup[$i] == $groupName[0] )
		{
			 $listGroup[$i] = $newName;
		}
	}
	$Nodegroups = stringArrayToString( $listGroup , " ");
	setAttr -type "string" ($FS3node[0] + ".groupsList") $Nodegroups;
	
	string $members = `getAttr ($FS3node[0] + ".g" + $groupName[0])`;
	deleteAttr ($FS3node[0] + ".g" + $groupName[0]);
	addAttr -ln ("g" + $newName) -dt "string" $FS3node[0];
	setAttr -type "string" ($FS3node[0] + ".g" + $newName) $members;
	
	if (`columnLayout -exists ( "ColGroup" + $groupName[0])`)
		deleteUI ( "ColGroup" + $groupName[0]);

	if ( `frameLayout -exists ("ShapeLayout" + $groupName[0])`)
		deleteUI ("ShapeLayout" + $groupName[0]);
			
	FaceStudio3ReadGroups;			
}

global proc FaceStudio3GroupDelete ()
{
	global string $FaceStudio3MainWindow;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
		
	string $groupName[] = `textScrollList -q -si fs3_groupsList`;
	string $Nodegroups = `getAttr ($FS3node[0] + ".groupsList")`;
	
	string $confirm = `confirmDialog 	-title "FaceStudio v.3.0  -  Delete group" -message "Delete this group ?"
 						-button "Yes" -button "No" -defaultButton "No"
 						-cancelButton "No" -dismissString "No"`;

	if ( $confirm == "Yes" )
	{
		textScrollList -e -ri $groupName fs3_groupsList;
	
		string $allgroups[] = `textScrollList -q -ai fs3_groupsList`;
		string $Nodegroups = "";
		
		for ($i=0;$i<size($allgroups);$i++)
		{
			$Nodegroups = ( $Nodegroups + " " + $allgroups[$i] );
		}
		setAttr -type "string" ($FS3node[0] + ".groupsList") $Nodegroups;
		deleteAttr ($FS3node[0] + ".g" + $groupName[0]);

		if (`columnLayout -exists ( "ColGroup" + $groupName[0])`)
			deleteUI ( "ColGroup" + $groupName[0]);

		deleteUI ("ShapeLayout" + $groupName[0]);
						
		FaceStudio3ReadGroups;			
	}	
}

global proc FaceStudio3AddToGroup ()
{
	global string $FaceStudio3MainWindow;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;

	string $FS3ShapeNode = `getAttr ($FS3node[0] + ".shape")`;	
	string $FS3Shapes[] = `listAnimatable $FS3ShapeNode`;
		
	string $toAdd[] = `textScrollList -q -si fs3_shapeList`;
	string $groupName[] = `textScrollList -q -si fs3_groupsList`;
	
	string $groupMembers = `getAttr ( $FS3node[0] + ".g" + $groupName[0])`;
	string $members[] = stringToStringArray ( $groupMembers , " " );
	
	string $newList = $groupMembers;
	
	int $checkAdd;
	for ($i=0;$i<size($toAdd);$i++)
	{
		$checkAdd = 0;
		for ($n=0;$n<size($members);$n++)
		{
			if ( $toAdd[$i] == $members[$n] )
			{
				$checkAdd = 1;
			}
		}
		if ( $checkAdd == 0 )
		{
			$newList = ( $newList + " " + $toAdd[$i] );
		}
	}
	setAttr -type "string" ( $FS3node[0] + ".g" + $groupName[0]) $newList;
	FaceStudio3ShowGroupList;
	
	$members = stringToStringArray ( $newList , " " );
	for ($n=0;$n<size($members);$n++)
	{	
		int $shapeIndex = `FaceStudio3GetShapeIndex $members[$n]`;
		string $shapeIcon = `getAttr ( $FS3node[0] + ".ShapeIcon" + $shapeIndex)`;
		if ( $shapeIcon == "" )
		{
			$shapeIcon = ( `internalVar -upd` + "icons/FaceStudio3/fs3_noIcon.bmp" );
		}
	
		if ( `columnLayout -exists ( "ColNodes" + $groupName[0] + $shapeIndex )` )
			deleteUI ( "ColNodes" + $groupName[0] + $shapeIndex );
			
		columnLayout -bgc 0.6 0.6 0.6 -p ("GridBlend"+ $groupName[0]) -h 40 -adjustableColumn false ( "ColNodes" + $groupName[0] + $shapeIndex );
			columnLayout -bgc 0.6 0.6 0.6 -adjustableColumn false ( "ColIcon" + $groupName[0] + $shapeIndex );					
				iconTextButton 	-l ( `substitute ( $FS3ShapeNode + "." ) $FS3Shapes[$shapeIndex] ""`)
						-c ( "setAttr -type \"string\" " + $FS3node[0] + ".CurrentBlend \"" + $shapeIndex + "\"")
						-dcc ("if (\`getAttr " + $FS3Shapes[$shapeIndex] + "\` == 1 ) { setAttr " + $FS3Shapes[$shapeIndex] + " 0; } else { setAttr " + $FS3Shapes[$shapeIndex] + " 1;}")
						-ann ( `substitute ( $FS3ShapeNode + "." )$FS3Shapes[$shapeIndex] ""`)
						-style "iconAndTextVertical" -w 87 -h 87
						-image1 $shapeIcon
				("BlendButton" + $groupName[0] + $shapeIndex );
				setParent ..;
																		
			columnLayout -bgc 0.6 0.6 0.6 -adjustableColumn false;
				attrFieldSliderGrp -bgc 0.6 0.6 0.6 -pre 2 -cw 1 1 -cw 2 30 -cw 3 55 -min 0 -max 1 -l "" -at $FS3Shapes[$shapeIndex] -cc ("setAttr -type \"string\" " + $FS3node[0] + ".CurrentBlend \"" + $shapeIndex +"\"") ("FSctrl" + $groupName[0] + $shapeIndex );	
				rowLayout -nc 5 -cw5 15 15 15 15 15 -bgc 0.6 0.6 0.6 -p ( "ColNodes" + $groupName[0] + $shapeIndex );
				separator -st none -w 10 -h 10 -bgc 0.6 0.6 0.6 ;
				iconTextButton -w 15 -h 15 -bgc 1 0.3 0.3  -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_key.bmp") -ann "Add keyframe" -c ("setKeyframe " + $FS3Shapes[$shapeIndex]);
				iconTextButton -w 15 -h 15 -bgc 0.8 0.7 0.7 -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_autokeyoff.bmp") -ann "Auto Key : off" -c ("FaceStudio3AutoKey " + $shapeIndex + " fs3_autokey" + $groupName[0] + $shapeIndex) ("fs3_autokey" + $groupName[0] + $shapeIndex);
				iconTextButton -w 15 -h 15 -bgc 0.8 0.5 0.5 -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_removekey.bmp") -ann "Remove all shape keys" -c ("FaceStudio3DeleteKey " + $shapeIndex );
				iconTextButton -w 15 -h 15 -bgc 0.9 0.9 1 -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_customize.bmp") -ann "Customize shape icon";
			setParent ..;	
	}
}

global proc FaceStudio3RemFromGroup ()
{
	global string $FaceStudio3MainWindow;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;

	string $FS3ShapeNode = `getAttr ($FS3node[0] + ".shape")`;	
	string $FS3Shapes[] = `listAnimatable $FS3ShapeNode`;
		
	string $toRem[] = `textScrollList -q -si fs3_memberList`;
	string $groupName[] = `textScrollList -q -si fs3_groupsList`;

	string $groupMembers[] = `textScrollList -q -ai fs3_memberList`;
	
	for ($n=0;$n<size($groupMembers);$n++)
	{
		int $shapeIndex = `FaceStudio3GetShapeIndex $groupMembers[$n]`;		
		if ( `columnLayout -exists ( "ColNodes" + $groupName[0] + $shapeIndex )` )
			deleteUI ( "ColNodes" + $groupName[0] + $shapeIndex );
	}
	
	textScrollList -e -ri $toRem[0] fs3_memberList;
	$groupMembers = `textScrollList -q -ai fs3_memberList`;
	string $members = stringArrayToString ( $groupMembers , " " );
	setAttr -type "string" ( $FS3node[0] + ".g" + $groupName[0]) $members;

	for ($n=0;$n<size($groupMembers);$n++)
	{	
		int $shapeIndex = `FaceStudio3GetShapeIndex $groupMembers[$n]`;
		string $shapeIcon = `getAttr ( $FS3node[0] + ".ShapeIcon" + $shapeIndex)`;
		if ( $shapeIcon == "" )
		{
			$shapeIcon = ( `internalVar -upd` + "icons/FaceStudio3/fs3_noIcon.bmp" );
		}
				
		columnLayout -bgc 0.6 0.6 0.6 -p ("GridBlend"+ $groupName[0]) -h 40 -adjustableColumn false ( "ColNodes" + $groupName[0] + $shapeIndex );
			columnLayout -bgc 0.6 0.6 0.6 -adjustableColumn false ( "ColIcon" + $groupName[0] + $shapeIndex );					
				iconTextButton 	-l ( `substitute ( $FS3ShapeNode + "." ) $FS3Shapes[$shapeIndex] ""`)
						-c ( "setAttr -type \"string\" " + $FS3node[0] + ".CurrentBlend \"" + $shapeIndex + "\"")
						-dcc ("if (\`getAttr " + $FS3Shapes[$shapeIndex] + "\` == 1 ) { setAttr " + $FS3Shapes[$shapeIndex] + " 0; } else { setAttr " + $FS3Shapes[$shapeIndex] + " 1;}")
						-ann ( `substitute ( $FS3ShapeNode + "." )$FS3Shapes[$shapeIndex] ""`)
						-style "iconAndTextVertical" -w 87 -h 87
						-image1 $shapeIcon
				("BlendButton" + $groupName[0] + $shapeIndex );
				setParent ..;
																		
			columnLayout -bgc 0.6 0.6 0.6 -adjustableColumn false;
				attrFieldSliderGrp -bgc 0.6 0.6 0.6 -pre 2 -cw 1 1 -cw 2 30 -cw 3 55 -min 0 -max 1 -l "" -at $FS3Shapes[$shapeIndex] -cc ("setAttr -type \"string\" " + $FS3node[0] + ".CurrentBlend \"" + $shapeIndex +"\"") ("FSctrl" + $groupName[0] + $shapeIndex );	
				rowLayout -nc 5 -cw5 15 15 15 15 15 -bgc 0.6 0.6 0.6 -p ( "ColNodes" + $groupName[0] + $shapeIndex );
				separator -st none -w 10 -h 10 -bgc 0.6 0.6 0.6 ;
				iconTextButton -w 15 -h 15 -bgc 1 0.3 0.3  -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_key.bmp") -ann "Add keyframe" -c ("setKeyframe " + $FS3Shapes[$shapeIndex]);
				iconTextButton -w 15 -h 15 -bgc 0.8 0.7 0.7 -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_autokeyoff.bmp") -ann "Auto Key : off" -c ("FaceStudio3AutoKey " + $shapeIndex + " fs3_autokey" + $groupName[0] + $shapeIndex) ("fs3_autokey" + $groupName[0] + $shapeIndex);
				iconTextButton -w 15 -h 15 -bgc 0.8 0.5 0.5 -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_removekey.bmp") -ann "Remove all shape keys" -c ("FaceStudio3DeleteKey " + $shapeIndex );
				iconTextButton -w 15 -h 15 -bgc 0.9 0.9 1 -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_customize.bmp") -ann "Customize shape icon";
			setParent ..;	
	}	
}

global proc FaceStudio3ShowGroupList ()
{
	global string $FaceStudio3MainWindow;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
		
	string $selGroup[] = `textScrollList -q -si fs3_groupsList`;
	string $gmembers = `getAttr ( $FS3node[0] + ".g" + $selGroup[0])`;
	string $groupMembers[] = stringToStringArray ( $gmembers, " ");

	textScrollList -e -ra fs3_memberList;
	for ($i=0;$i<size($groupMembers);$i++)
	{
		textScrollList -e -append $groupMembers[$i] fs3_memberList;
	}
	
}

global proc FaceStudio3ShowGroupLayout (string $selgroup)
{
	global string $FaceStudio3MainWindow;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	
	string $currentLayout = `getAttr ( $FS3node[0] + ".currentLayout")`;
	string $gmembers = `getAttr ( $FS3node[0] + ".groupsList")`;
	string $groupMembers[] = stringToStringArray ( $gmembers, " ");
	
	for ($i=0;$i<size($groupMembers);$i++)
	{
		iconTextButton -e -i1 ( `internalVar -upd` + "icons/FaceStudio3/fs3_unselgroup.bmp" ) ("groupButton" + $groupMembers[$i] );
	}
	iconTextButton -e -i1 ( `internalVar -upd` + "icons/FaceStudio3/fs3_unselgroup.bmp" ) ("groupButton1");
	
	frameLayout -e -vis off $currentLayout;	
	frameLayout -e -vis on ("ShapeLayout" + $selgroup );
	setAttr -type "string" ( $FS3node[0] + ".currentLayout") ("ShapeLayout" + $selgroup );
}

