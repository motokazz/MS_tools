//////// INIT ////////

global string $FaceStudio3MainWindow = "FaceStudio3AnimationEdit";
global string $FaceStudio3Console = "FaceStudio3Console";

source "FaceStudio3UI.mel";
source "FaceStudio3UILoad.mel";

print "//FaceStudio v.3.0 Initialized...\n";

///////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3 ()
{
	global string $FaceStudio3MainWindow;
	global string $FaceStudio3Console;
	
	// maya version check
	float $version =  `about -version`;
	if ( $version < 6 )
	{
		FaceStudio3ConsoleMessage "//Error : Maya 6 or higher is required";
		return;		
	}

	// check selection type
	string $sel[] = `ls -sl`;
	string $selShape[];
	
	
	if ( size ($sel) == 0 )
	{
		FaceStudio3ConsoleMessage "//Error : please select an object";
		return;	
	}
	string $selType = `nodeType $sel[0]`;

	if ( $selType == "mesh" )
	{
		$selShape[0] = $sel[0];	
	}
	else
	{
		if ( $selType == "transform" )
		{
			$selShape = `listRelatives -s -f $sel[0]`;
		}
		else
		{
			FaceStudio3ConsoleMessage "//Error : the selection is not a mesh";
			return;	
		}
	}
	FaceStudio3ConsoleMessage ("//Init : working on " + $selShape[0]);

	// parent detection
	string $selParent[];
	string $listSkin  = `findRelatedSkinCluster $sel[0]`;

	if ($listSkin == "")
	{
		$selParent[0] = $sel[0];
		FaceStudio3ConsoleMessage "//Warning : no joint found.";	
	}
	else
	{
		string $listJoints[] = `skinPercent -q -t $listSkin ( $sel[0] + ".vtx[*]")`;
		int $Njoints = size ($listJoints);
		$selParent[0] = $listJoints[$Njoints-1];
	}
	
	
	// shape node detection
	string $getShape[] = `listHistory $sel[0]`;
	string $getShapeType;
	string $selShapeNode;
	
	for ($i=0;$i<size($getShape);$i++)
	{
		$getShapeType = `nodeType $getShape[$i]`;
		if ( $getShapeType == "blendShape" ) {
			$selShapeNode = $getShape[$i];
			break;
		}
	}
	if ( $selShapeNode == "" ) {
		FaceStudio3ConsoleMessage "//Error : no blendShape node";
		return;
	}
	FaceStudio3ConsoleMessage ( "//Init : shape node is " + $selShapeNode );

	string $FS3Shapes[] =  `listAnimatable $selShapeNode`;
	int $Nshape = size ($FS3Shapes);
	FaceStudio3ConsoleMessage ( "//Init : " + $Nshape + " shapes");


	// registering informations
	FaceStudio3ConsoleMessage ( "//Init : registering informations" );
	
	string $FS3node[];
	if (`attributeExists "FaceStudio3Node" $sel[0]` == 0 )
	{
		addAttr -ln ("FaceStudio3Node") -dt "string" $sel[0];		
		
	}
	$FS3node = `listConnections ($sel[0] + ".FaceStudio3Node" )`;
	if ($FS3node[0] == "")
	{
		createNode groupId -n "FaceStudio3Attributes1";
		$FS3node = `ls -sl`;		
		addAttr -ln ("connection") -dt "string" $FS3node[0];				
		connectAttr -f ($FS3node[0] + ".connection")  ($sel[0] + ".FaceStudio3Node");
	}
	
	FaceStudio3WriteInfo "shape" $selShapeNode $sel[0];
	FaceStudio3WriteInfo "parent" $selParent[0] $sel[0];
	FaceStudio3WriteInfo "CurrentBlend" "1" $sel[0];

	if ( `attributeExists "sound" $FS3node[0]` == 0 )
	{
		addAttr -ln ("sound") -dt "string" $FS3node[0];
		addAttr -ln ("soundOffset") -dt "string" $FS3node[0];
		setAttr -type "string" ( $FS3node[0] + ".soundOffset" ) "0";							
	}

	if ( `attributeExists "video" $FS3node[0]` == 0 )
	{
		string $defaultVideo = ( `internalVar -upd` + "icons/FaceStudio3/fs3_video.bmp");
		addAttr -ln ("video") -dt "string" $FS3node[0];	
		setAttr -type "string" ( $FS3node[0] + ".video" ) $defaultVideo;			
	}
	
	if ( `attributeExists "videoExt" $FS3node[0]` == 0 )
	{
		addAttr -ln ("videoExt") -dt "string" $FS3node[0];
		setAttr -type "string" ( $FS3node[0] + ".videoExt" ) "0";		
	}

	if ( `attributeExists "videoOffset" $FS3node[0]` == 0 )
	{
		addAttr -ln ("videoOffset") -dt "string" $FS3node[0];
		setAttr -type "string" ( $FS3node[0] + ".videoOffset" ) "0";		
	}		
	
	if ( `attributeExists "EyeControl1" $FS3node[0]` == 0 )
	{
		FaceStudio3WriteInfo "EyeControl1" "" $sel[0];
	}
	if ( `attributeExists "EyeControl2" $FS3node[0]` == 0 )
	{
		FaceStudio3WriteInfo "EyeControl2" "" $sel[0];
	}
	
	if ( `attributeExists "ViewObj" $FS3node[0]` == 0 )
	{
		FaceStudio3WriteInfo "ViewObj" "" $sel[0];
	}
	
	if ( `attributeExists "CustomParent" $FS3node[0]` == 0 )
	{
		FaceStudio3WriteInfo "CustomParent" "" $sel[0];
	}

	string $FS3Shapes[] = `listAnimatable $selShapeNode`;
	for ($i=1;$i<size($FS3Shapes);$i++)
	{
		if ( `attributeExists ("ShapeIcon" + $i) $FS3node[0]` == 0 )
		{
			FaceStudio3WriteInfo ("ShapeIcon" + $i) "" $sel[0];		
		}
	}
	FaceStudio3WriteInfo "currentLayout" "ShapeLayout1" $sel[0];
	if ( `attributeExists "groupsList" $FS3node[0]` == 0 )
	{
		FaceStudio3WriteInfo "groupsList" "" $sel[0];
	}
		
	string $customParent = `getAttr ($FS3node[0] + ".CustomParent")`;
	if ( $customParent == "" )
	{
		$customParent = $selParent[0];	
	}
	
	FaceStudio3ConsoleMessage("//Init : parent is " + $customParent );
	
	// camera building
	string $FS3camera = "FaceStudio3View";
	string $customParent = `getAttr ($FS3node[0] + ".CustomParent")`;
	if ( $customParent == "" )
	{
		$customParent = $selParent[0];	
	}
	float $FS3camPos[];
	if ( `objExists $FS3camera `) 
		delete ( $FS3camera +"*");
	camera;
	rename $FS3camera;
	hide $FS3camera;
	pointConstraint $sel[0] $FS3camera;
	orientConstraint $customParent $FS3camera;
	delete -constraints $FS3camera;

	$FS3camPos = `getAttr ($FS3camera + ".translate" )`;
	camera -e -wci $FS3camPos[0] $FS3camPos[1] $FS3camPos[2] $FS3camera;
	setAttr ( $FS3camera + ".focalLength" ) 100;
	select -r $sel[0];
	viewFit $FS3camera;
	
	parent $FS3camera $customParent;

	// UI building
	
	string $alljobs[] = `scriptJob -lj`;
	for ($n=0;$n<size($alljobs);$n++)
	{
		string $test = `match "FaceStudio3Exit" $alljobs[$n]`;
		if ( $test == "FaceStudio3Exit" )
		{	
			string $jobfind = `substitute ":.*" $alljobs[$n] ""`;
			int $jobindex = $jobfind;
			scriptJob -k $jobindex;
			break;
		}
	}
	
	FaceStudio3ConsoleMessage ( "//Init : building Editors" );		
	FaceStudio3MainUI $sel[0];

	
	// configuration reading

	FaceStudio3ReadConfiguration;

	FaceStudio3ConsoleMessage ( "//Init : FaceStudio3 initialized !" );
	pause -sec 2;
	showWindow $FaceStudio3MainWindow;

	scriptJob -uid $FaceStudio3MainWindow "FaceStudio3Exit";		

	window -e -vis off $FaceStudio3Console;
}
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3ReadConfiguration ()
{
	FaceStudio3ConsoleMessage ( "//Init : reading configuration..." );
	FaceStudio3ReadGroups;
	FaceStudio3ReadCustom;
	FaceStudio3ReadObjects;
	FaceStudio3ReadSound;
	FaceStudio3ReadEyeControls;
	FaceStudio3ReadShapeIcons;	
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3ReadUIFile (string $FSfile )
{
	global string $FaceStudio3MainWindow;
	global string $FaceStudio3Console;
		
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;

	$fileId=`fopen ($FSfile) "r"`;
	string $check = `fgetline $fileId`;
	string $fs3cmd;

 	if ( `match "//FaceStudio3 UI File" $check` != "//FaceStudio3 UI File"   )
 	{
 		print "//FaceStudio3 error: wrong file\n";
	  	fclose $fileId;
 		return;	
 	}
	
  	string $nextLine = $check;
 	while ( size( $nextLine ) > 0 ) 
	{
 		$nextLine = `fgetline $fileId`;
		$fs3cmd = $fs3cmd + $nextLine;
	}
  	fclose $fileId;

	string $fs3loadFile = (`internalVar -usd` + "FaceStudio3UILoad.mel" );
	$fileId=`fopen  $fs3loadFile "w"`;
	fprint $fileId "// PLEASE DON'T DELETE THIS FILE //\n";	
 	fprint $fileId $fs3cmd ;
	fclose $fileId;	
 	
	select -r -ne $FS3node[0];
	delete;

	eval ( "source \"FaceStudio3UILoad.mel\"" );
	FaceStudio3UILoad;

	select -r -ne "FaceStudio3Import1";
	rename $FS3node[0];
		
	string $FS3NewNode[] = `ls -sl`;
	connectAttr -f ($FS3NewNode[0] + ".connection")  ($obj + ".FaceStudio3Node");
	
	FaceStudio3ReadConfiguration;
	FaceStudio3ConsoleMessage ( "//Init : UI file loaded" );

	pause -sec 1;
	window -e -vis off $FaceStudio3Console;
}

