global proc FaceStudio3SwitchPort ()
{
	int $scrub = `columnLayout -q -vis FS3timeLayout`;
	if ( $scrub == 1 )
	{
		columnLayout -e -vis off FS3timeLayout;
		columnLayout -e -vis on FS3soundLayout;
		iconTextButton -e -i1  ( `internalVar -upd`+ "icons/FaceStudio3/fs3_switchT.bmp") FS3switchPort;
	}
	else
	{
		columnLayout -e -vis on FS3timeLayout;
		columnLayout -e -vis off FS3soundLayout;
		iconTextButton -e -i1  ( `internalVar -upd`+ "icons/FaceStudio3/fs3_switchS.bmp") FS3switchPort;
	}
}
