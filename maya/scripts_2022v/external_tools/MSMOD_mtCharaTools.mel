	//Set Keyフレーム内の列設定=============================================================

	frameLayout -labelVisible 0 -borderStyle "etchedOut" -height 48 -marginWidth 5 -marginHeight 2;

		rowColumnLayout -numberOfColumns 4 -columnWidth 1 70 -columnWidth 2 60 -columnWidth 3 150 -columnWidth 4 60;

			checkBox -label "AutoKey" 
				 -onc "autoKeyframe -state true; shelfButton -e -i ( $usdImage + \"buttonSetkey2.bmp\" ) buttonSetKey;"
				 -ofc "autoKeyframe -state false; shelfButton -e -i ( $usdImage + \"buttonSetkey1.bmp\" ) buttonSetKey;";
				 //↑2回buttonの高さをeditしないとカラーのリフレッシュがされない

			shelfButton -h 40 -i ( $usdImage + "buttonAllSetkey1.bmp" ) -c "charaSetSelect; setKeyframe -breakdown 0; select -cl;";
			shelfButton -h 40 -i ( $usdImage + "buttonSetkey1.bmp" ) -c "SetKey;" buttonSetKey;
			shelfButton -h 40 -i ( $usdImage + "buttonDeletekey1.bmp" ) -c "int $currTime = `currentTime -q`; cutKey -clear -t $currTime;";

		setParent ..;

	setParent ..;

	//Playbackフレーム内の列設定=============================================================

	frameLayout -labelVisible 0 -borderStyle "etchedOut" -height 46 -marginWidth 5 -marginHeight 2;

		rowColumnLayout -numberOfColumns 7 -columnWidth 1 45 -columnWidth 2 45 -columnWidth 3 45 -columnWidth 4 70 -columnWidth 5 45 -columnWidth 6 45 -columnWidth 7 45;

			shelfButton -w 45 -h 36 -i ( $usdImage + "buttonStartFrame.bmp" ) -c "playButtonStart;";
			shelfButton -w 45 -h 36 -i ( $usdImage + "buttonPreFrame.bmp" ) -c "playButtonStepBackward;";
			shelfButton -w 45 -h 36 -i ( $usdImage + "buttonPreKey.bmp" ) -c "currentTime -edit `findKeyframe -timeSlider -which previous`;";
			iconTextCheckBox -w 70 -h 36 -i ( $usdImage + "buttonPlayback1.bmp" ) -si ( $usdImage + "buttonPlayback2.bmp" ) -onc "play -forward true;" -ofc "play -state off;";
			shelfButton -w 45 -h 36 -i ( $usdImage + "buttonNextKey.bmp" ) -c "currentTime -edit `findKeyframe -timeSlider -which next`;";
			shelfButton -w 45 -h 36 -i ( $usdImage + "buttonNextFrame.bmp" ) -c "playButtonStepForward;";
			shelfButton -w 45 -h 36 -i ( $usdImage + "buttonEndFrame.bmp" ) -c "playButtonEnd;";

		setParent ..;

	setParent ..;


setParent ..;


//==================================================================================================
//■ウインドウ実行
//==================================================================================================

	showWindow $windowmtCharaTools;
	window -e -w 358 -h 576 mtCharaToolsUI;

//==================================================================================================
//■ユーザースクリプトパスにスクリプトフォルダーを作る
//==================================================================================================

	string $usdCharaTools = $usdScript + "mtCharaTools/"; //mtCharaToolsフォルダの定義
	string $usdPoseList = $usdScript + "mtCharaTools/poselist/"; //poselistフォルダの定義
	string $usdPoseBodyList = $usdScript + "mtCharaTools/poselist/body/"; //bodyフォルダの定義
	string $usdPoseFaceList = $usdScript + "mtCharaTools/poselist/face/"; //faceフォルダの定義
	string $usdPoseBodyDdyList = $usdScript + "mtCharaTools/poselist/body/ddy/"; //body/ddyフォルダの定義
	string $usdPoseBodyApeList = $usdScript + "mtCharaTools/poselist/body/ape/"; //body/apeフォルダの定義
	string $usdPoseBodyOthList = $usdScript + "mtCharaTools/poselist/body/other/"; //body/otherフォルダの定義
	string $usdPoseFaceDdyList = $usdScript + "mtCharaTools/poselist/face/ddy/"; //face/ddyフォルダの定義


	//mtCharaToolsフォルダがない場合は作成する==================================================
	if (`filetest -d $usdCharaTools` == 0 )
	{
		sysFile -md $usdCharaTools;
		warning ("新規フォルダ==[" + $usdCharaTools + "]==を作成しました。");
	}

	//poselistフォルダがない場合は作成する======================================================
	if (`filetest -d $usdPoseList` == 0 )
	{
		sysFile -md $usdPoseList;
		warning ("新規フォルダ==[" + $usdPoseList + "]==を作成しました。");
	}

	//bodyフォルダがない場合は作成する==========================================================
	if (`filetest -d $usdPoseBodyList` == 0 )
	{
		sysFile -md $usdPoseBodyList;
		warning ("新規フォルダ==[" + $usdPoseBodyList + "]==を作成しました。");
	}

	//faceフォルダがない場合は作成する==========================================================
	if (`filetest -d $usdPoseFaceList` == 0 )
	{
		sysFile -md $usdPoseFaceList;
		warning ("新規フォルダ==[" + $usdPoseFaceList + "]==を作成しました。");
	}

	//body/ddyフォルダがない場合は作成する======================================================
	if (`filetest -d $usdPoseBodyDdyList` == 0 )
	{
		sysFile -md $usdPoseBodyDdyList;
		warning ("新規フォルダ==[" + $usdPoseBodyDdyList + "]==を作成しました。");
	}

	//body/apeフォルダがない場合は作成する======================================================
	if (`filetest -d $usdPoseBodyApeList` == 0 )
	{
		sysFile -md $usdPoseBodyApeList;
		warning ("新規フォルダ==[" + $usdPoseBodyApeList + "]==を作成しました。");
	}

	//body/otherフォルダがない場合は作成する======================================================
	if (`filetest -d $usdPoseBodyOthList` == 0 )
	{
		sysFile -md $usdPoseBodyOthList;
		warning ("新規フォルダ==[" + $usdPoseBodyOthList + "]==を作成しました。");
	}

	//face/ddyフォルダがない場合は作成する======================================================
	if (`filetest -d $usdPoseFaceDdyList` == 0 )
	{
		sysFile -md $usdPoseFaceDdyList;
		warning ("新規フォルダ==[" + $usdPoseFaceDdyList + "]==を作成しました。");
	}

//==================================================================================================
//■ロード関係
//==================================================================================================

	loadPref;		//リファレンスのロード
	importPoseList;		//体ポーズリストを読み込む

//==================================================================================================
//■実行用melのパスを指定する
//==================================================================================================

	string $proceduresPath = "D:/sarux/tools/maya/scripts/_character/mtCharaTools/";

	string $sourceProcedures=("source \""+$proceduresPath+"mtGetRigSelect.mel\"");
	eval ($sourceProcedures);

	string $sourceProcedures=("source \""+$proceduresPath+"mtGetFaceRigSelect.mel\"");
	eval ($sourceProcedures);

	string $sourceProcedures=("source \""+$proceduresPath+"mtPoseStore.mel\"");
	eval ($sourceProcedures);

	string $sourceProcedures=("source \""+$proceduresPath+"mtFacePoseStore.mel\"");
	eval ($sourceProcedures);

	string $sourceProcedures=("source \""+$proceduresPath+"mtRigNameRule.mel\"");
	eval ($sourceProcedures);

