//==================================================================================================
//■スクリプトジョブ「defaultSwitch」内で実行するプロシージャの設定
//==================================================================================================

global proc defaultSwitch()
{

//■mtCharaToolsUIウインドウがなければ実行しない====================================================

	if ((`window -exists mtCharaToolsUI` )== false )
	{
		return;
	}

//■defaultSwitchの内容=============================================================================

	string $currPanel = `getPanel -withFocus`;
	if ("" != $currPanel && ("modelPanel" == `getPanel -to $currPanel`))
	{

		//NoLightの状態を取得しスイッチに反映する

			string $switchNoLight = `modelEditor -q -displayLights $currPanel`;
			switch ($switchNoLight)
			{
				case "none" :

					iconTextCheckBox -e -value true itcbViewNoLight;
					break;

				case "default" :

					iconTextCheckBox -e -value false itcbViewNoLight;
					break;

				default: break;
			}

		//X-Rayの状態を取得しスイッチに反映する

			int $switchXRay = `modelEditor -q -xray $currPanel`;
			switch ($switchXRay)
			{
				case 0 :

					iconTextCheckBox -e -value false itcbViewXray;
					break;

				case 1 :

					iconTextCheckBox -e -value true itcbViewXray;
					break;

				default: break;
			}

		//ShowJointの状態を取得しスイッチに反映する

			int $switchJoint = `modelEditor -q -joints $currPanel`;
			switch ($switchJoint)
			{
				case 0 :

					iconTextCheckBox -e -value false itcbShowJoint;
					break;

				case 1 :

					iconTextCheckBox -e -value true itcbShowJoint;
					break;

				default: break;
			}

		//ShowIkの状態を取得しスイッチに反映する

			int $switchIk = `modelEditor -q -ikHandles $currPanel`;
			switch ($switchIk)
			{
				case 0 :

					iconTextCheckBox -e -value false itcbShowIk;
					break;

				case 1 :

					iconTextCheckBox -e -value true itcbShowIk;
					break;

				default: break;
			}

		//ShowLocatorの状態を取得しスイッチに反映する

			int $switchLocator = `modelEditor -q -locators $currPanel`;
			switch ($switchLocator)
			{
				case 0 :

					iconTextCheckBox -e -value false itcbShowLocator;
					break;

				case 1 :

					iconTextCheckBox -e -value true itcbShowLocator;
					break;

				default: break;
			}

		//ShowPolygonの状態を取得しスイッチに反映する

			int $switchPolygon = `modelEditor -q -polymeshes $currPanel`;
			switch ($switchPolygon)
			{
				case 0 :

					iconTextCheckBox -e -value false itcbShowPolygon;
					break;

				case 1 :

					iconTextCheckBox -e -value true itcbShowPolygon;
					break;

				default: break;
			}

		//ShowLightの状態を取得しスイッチに反映する

			int $switchLight = `modelEditor -q -lights $currPanel`;
			switch ($switchLight)
			{
				case 0 :

					iconTextCheckBox -e -value false itcbShowLight;
					break;

				case 1 :

					iconTextCheckBox -e -value true itcbShowLight;
					break;

				default: break;
			}

	}
}

//==================================================================================================
//■スクリプトジョブ「manipSwitch」内で実行するプロシージャの設定
//==================================================================================================

global proc manipSwitch()
{

//■mtCharaToolsUIウインドウがなければ実行しない====================================================

	if ((`window -exists mtCharaToolsUI` )== false )
	{
		return;
	}

//■manipSwitchの内容===============================================================================

	string $getManp = `currentCtx`;
	int $getTransMode = `manipMoveContext -q -mode Move`;
	int $getRotMode = `manipRotateContext -q -mode Rotate`;

	switch ($getManp)
	{

		case "moveSuperContext" :

			iconTextCheckBox -e -value true buttonTrans;
			iconTextCheckBox -e -value false buttonRot;
			iconTextCheckBox -e -value false buttonScale;
			iconTextCheckBox -e -value false buttonSelect;

			iconTextCheckBox -e -value true buttonFddy_Trans;
			iconTextCheckBox -e -value false buttonFddy_Rot;
			iconTextCheckBox -e -value false buttonFddy_Scale;
			iconTextCheckBox -e -value false buttonFddy_Select;

			switch ($getTransMode)
			{

				case 0 :

					iconTextCheckBox -e -value false buttonGlobal;
					iconTextCheckBox -e -value true buttonLocal;

					iconTextCheckBox -e -value false buttonFddy_Global;
					iconTextCheckBox -e -value true buttonFddy_Local;

					break;

				case 2 :

					iconTextCheckBox -e -value true buttonGlobal;
					iconTextCheckBox -e -value false buttonLocal;

					iconTextCheckBox -e -value true buttonFddy_Global;
					iconTextCheckBox -e -value false buttonFddy_Local;

					break;

				default :

					iconTextCheckBox -e -value false buttonGlobal;
					iconTextCheckBox -e -value false buttonLocal;

					iconTextCheckBox -e -value false buttonFddy_Global;
					iconTextCheckBox -e -value false buttonFddy_Local;

					break;

			}

			break;

		case "RotateSuperContext" :

			iconTextCheckBox -e -value false buttonTrans;
			iconTextCheckBox -e -value true buttonRot;
			iconTextCheckBox -e -value false buttonScale;
			iconTextCheckBox -e -value false buttonSelect;

			iconTextCheckBox -e -value false buttonFddy_Trans;
			iconTextCheckBox -e -value true buttonFddy_Rot;
			iconTextCheckBox -e -value false buttonFddy_Scale;
			iconTextCheckBox -e -value false buttonFddy_Select;

			switch ($getRotMode)
			{

				case 0 :

					iconTextCheckBox -e -value false buttonGlobal;
					iconTextCheckBox -e -value true buttonLocal;

					iconTextCheckBox -e -value false buttonFddy_Global;
					iconTextCheckBox -e -value true buttonFddy_Local;

					break;

				case 1 :

					iconTextCheckBox -e -value true buttonGlobal;
					iconTextCheckBox -e -value false buttonLocal;

					iconTextCheckBox -e -value true buttonFddy_Global;
					iconTextCheckBox -e -value false buttonFddy_Local;

					break;

				default :

					iconTextCheckBox -e -value false buttonGlobal;
					iconTextCheckBox -e -value false buttonLocal;

					iconTextCheckBox -e -value false buttonFddy_Global;
					iconTextCheckBox -e -value false buttonFddy_Local;

					break;

			}

			break;

		case "scaleSuperContext" :

			iconTextCheckBox -e -value false buttonTrans;
			iconTextCheckBox -e -value false buttonRot;
			iconTextCheckBox -e -value true buttonScale;
			iconTextCheckBox -e -value false buttonSelect;

			iconTextCheckBox -e -value false buttonFddy_Trans;
			iconTextCheckBox -e -value false buttonFddy_Rot;
			iconTextCheckBox -e -value true buttonFddy_Scale;
			iconTextCheckBox -e -value false buttonFddy_Select;

			iconTextCheckBox -e -value false buttonGlobal;
			iconTextCheckBox -e -value false buttonLocal;

			iconTextCheckBox -e -value false buttonFddy_Global;
			iconTextCheckBox -e -value false buttonFddy_Local;

			break;

		case "selectSuperContext" :

			iconTextCheckBox -e -value false buttonTrans;
			iconTextCheckBox -e -value false buttonRot;
			iconTextCheckBox -e -value false buttonScale;
			iconTextCheckBox -e -value true buttonSelect;

			iconTextCheckBox -e -value false buttonFddy_Trans;
			iconTextCheckBox -e -value false buttonFddy_Rot;
			iconTextCheckBox -e -value false buttonFddy_Scale;
			iconTextCheckBox -e -value true buttonFddy_Select;

			iconTextCheckBox -e -value false buttonGlobal;
			iconTextCheckBox -e -value false buttonLocal;

			iconTextCheckBox -e -value false buttonFddy_Global;
			iconTextCheckBox -e -value false buttonFddy_Local;

			break;

		default :

			iconTextCheckBox -e -value false buttonTrans;
			iconTextCheckBox -e -value false buttonRot;
			iconTextCheckBox -e -value false buttonScale;
			iconTextCheckBox -e -value false buttonSelect;

			iconTextCheckBox -e -value false buttonFddy_Trans;
			iconTextCheckBox -e -value false buttonFddy_Rot;
			iconTextCheckBox -e -value false buttonFddy_Scale;
			iconTextCheckBox -e -value false buttonFddy_Select;

			iconTextCheckBox -e -value false buttonGlobal;
			iconTextCheckBox -e -value false buttonLocal;

			iconTextCheckBox -e -value false buttonFddy_Global;
			iconTextCheckBox -e -value false buttonFddy_Local;

			break;

	}

}

//==================================================================================================
//■GlobalモードとLocalモードの切り替え
//==================================================================================================

global proc axisGlobalMode()
{

	string $getManp = `currentCtx`;

	switch ($getManp)
	{

		case "moveSuperContext" :

			iconTextCheckBox -e -value false buttonLocal;
			iconTextCheckBox -e -value false buttonFddy_Local;
			manipMoveContext -e -mode 2 Move;
			break;

		case "RotateSuperContext" :

			iconTextCheckBox -e -value false buttonLocal;
			iconTextCheckBox -e -value false buttonFddy_Local;
			manipRotateContext -e -mode 1 Rotate;
			break;

		default :

			iconTextCheckBox -e -value false buttonGlobal;
			iconTextCheckBox -e -value false buttonLocal;
			iconTextCheckBox -e -value false buttonFddy_Global;
			iconTextCheckBox -e -value false buttonFddy_Local;
			break;

	}

}

global proc axisLocalMode()
{

	string $getManp = `currentCtx`;

	switch ($getManp)
	{

		case "moveSuperContext" :

			iconTextCheckBox -e -value false buttonGlobal;
			iconTextCheckBox -e -value false buttonFddy_Global;
			manipMoveContext -e -mode 1 Move;
			break;

		case "RotateSuperContext" :

			iconTextCheckBox -e -value false buttonGlobal;
			iconTextCheckBox -e -value false buttonFddy_Global;
			manipRotateContext -e -mode 0 Rotate;
			break;

		default :

			iconTextCheckBox -e -value false buttonGlobal;
			iconTextCheckBox -e -value false buttonLocal;
			iconTextCheckBox -e -value false buttonFddy_Global;
			iconTextCheckBox -e -value false buttonFddy_Local;
			break;

	}

}

//==================================================================================================
//■Wire設定
//==================================================================================================
global proc viewWire()
{
//カレントアクティブなModeling Panelを選択する======================================================

	string $currPanel = `getPanel -withFocus`;
	if ("" != $currPanel && ("modelPanel" == `getPanel -to $currPanel`))
	{
		modelEditor -e -displayAppearance "wireframe" $currPanel;
		editMenuUpdate MayaWindow|mainEditMenu;
	}
}

//==================================================================================================
//■Shade設定
//==================================================================================================
global proc viewShade()
{
//カレントアクティブなModeling Panelを選択する======================================================

	string $currPanel = `getPanel -withFocus`;
	if ("" != $currPanel && ("modelPanel" == `getPanel -to $currPanel`))
	{

		int $switchNoLight = `iconTextCheckBox -q -value itcbViewNoLight`;

		switch ($switchNoLight) //NoLightスイッチがonかoffかで振り分ける
		{
			case 0: //NoLightスイッチがoffの場合はShadeビューにする

				modelEditor -e -displayAppearance "smoothShaded" -displayTextures off -displayLights "default" $currPanel;
				editMenuUpdate MayaWindow|mainEditMenu;
				break;

			case 1: //NoLightスイッチがonの場合はShade+NoLightビューにする

				modelEditor -e -displayAppearance "smoothShaded" -displayTextures off -displayLights "none" $currPanel;
				editMenuUpdate MayaWindow|mainEditMenu;
				break;

			default: break;
		}
	}
}

//==================================================================================================
//■Texture設定
//==================================================================================================
global proc viewTexture()
{
//カレントアクティブなModeling Panelを選択する======================================================

	string $currPanel = `getPanel -withFocus`;
	if ("" != $currPanel && ("modelPanel" == `getPanel -to $currPanel`))
	{
		viewShade; //一度viewShade()を実行しないとなぜかテクスチャが更新されない

		modelEditor -e -displayAppearance "smoothShaded" -displayTextures on $currPanel;
		editMenuUpdate MayaWindow|mainEditMenu;
	}

}

//==================================================================================================
//■+Wire設定
//==================================================================================================
global proc toggleAddWire()
{
//カレントアクティブなModeling Panelを選択する======================================================

	string $currPanel = `getPanel -withFocus`;
	if ("" != $currPanel && ("modelPanel" == `getPanel -to $currPanel`))
	{

		//wireframeOnShadedの現在ステータスを取得しトグルする================================

		int $AddWireOnOff = `modelEditor -q -wireframeOnShaded $currPanel`;

		switch ($AddWireOnOff)
		{
			case 0: //wireframeOnShadedがoffのときはonにする

				modelEditor -e -wireframeOnShaded 1 $currPanel;
				editMenuUpdate MayaWindow|mainEditMenu;
				break;

			case 1: //wireframeOnShadedがonのときはoffにする

				modelEditor -e -wireframeOnShaded 0 $currPanel;
				editMenuUpdate MayaWindow|mainEditMenu;
				break;

			default: break;
		}
	}
}

//==================================================================================================
//■No Light設定
//==================================================================================================

//■NoLightを無効にする=============================================================================
global proc toggleNoLightFalse()
{
//カレントアクティブなModeling Panelを選択する======================================================

	string $currPanel = `getPanel -withFocus`;
	string $WireOnOff = `modelEditor -q -displayAppearance $currPanel`;

	if ($WireOnOff != "wireframe") //フォーカス中のModelingPanelがwireframe以外のときに下記を実行する
	{

		if ("" != $currPanel && ("modelPanel" == `getPanel -to $currPanel`))
		{
			string $NoLightOnOff = `modelEditor -q -displayLights $currPanel`;

			int $TextureOnOff = `modelEditor -q -displayTextures $currPanel`;

			switch ($TextureOnOff)
			{

				case 0: //テクスチャ表示でない場合はShadeビューにする

					modelEditor -e -displayAppearance "smoothShaded" -displayTextures off -displayLights "default" $currPanel;
					editMenuUpdate MayaWindow|mainEditMenu;
					break;

				case 1: //テクスチャ表示のときはTextureビューにする

					modelEditor -e -displayAppearance "smoothShaded" -displayTextures on -displayLights "default" $currPanel;
					editMenuUpdate MayaWindow|mainEditMenu;
					break;

				default: break;
			}

		}
	}
}

