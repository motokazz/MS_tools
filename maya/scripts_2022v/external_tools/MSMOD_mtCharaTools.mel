	columnLayout;

		frameLayout  -labelVisible false -borderStyle "etchedOut" -w 295 -h 60 -marginHeight 10;

			rowColumnLayout -numberOfColumns 1 -columnWidth 1 295;

				text -label "mtCharaTools" -align "center";
				text -label "version 2.0.0" -align "center";

			setParent ..;

		setParent ..;

		frameLayout  -labelVisible false -borderStyle "etchedOut" -w 295 -h 150 -marginHeight 10;

			rowColumnLayout -numberOfColumns 1 -columnWidth 1 295;

				text -label "ヘルプ：ノーツに簡易マニュアルがあります。" -align "center";

			setParent ..;

		setParent ..;

		frameLayout -labelVisible false -borderStyle "etchedOut" -w 295 -h 45 -marginHeight 10 -marginWidth 50;

