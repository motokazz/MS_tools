				button -label "OK" -c "deleteUI -window mtCThelpUI;";

			setParent ..;

		setParent ..;

//■ウインドウ実行==================================================================================

	showWindow $windowMtCThelp;
	window -e -w 300 -h 285 mtCThelpUI;

}

//==================================================================================================
//■リファレンスのロード
//==================================================================================================
global proc loadPref()
{

	string $usdScript = `internalVar -usd`;
	string $prefFilePath = $usdScript +"mtCharaTools/pref.mel";
	int $filePrefNames = `fopen ($prefFilePath) "r"`;
	string $prefData[];
	int $lineNo;

	//ファイルの存在
	if (`filetest -r $prefFilePath` == 0 )
	{
		//optionMenu -e -select 1 CharacterSetList;
		//tabLayout -e -selectTabIndex 1 mainTabs;
		//optionMenu -e -select 1 poseBodyList;
		//optionMenu -e -select 1 poseFaceList;
	}

	else
	{
		//1行ずつ読み込む
		for( $lineNo = 1; $lineNo < 5; $lineNo++)
		{
			$prefData[$lineNo] = `fgetline $filePrefNames`;

			//「\n」がある場合は削除する
			string $bufferPref[];
			int $numTokens;
			$numTokens = `tokenize $prefData[$lineNo] "\n" $bufferPref`;

			if ($numTokens = 1)
			{
				$prefData[$lineNo] = $bufferPref[0];
			}

			//メインタブの選択
			if ($lineNo == 1)
			{
				if (`optionMenu -q -numberOfItems CharacterSetList` < ((int) $prefData[$lineNo]))
				{
					optionMenu -e -select 1 CharacterSetList;
				}
				else
				{
					optionMenu -e -select ((int) $prefData[$lineNo]) CharacterSetList;
				}
			}

			//メインタブの選択
			if ($lineNo == 2)
			{
				tabLayout -e -selectTabIndex ((int) $prefData[$lineNo]) mainTabs;
			}

			//体ポーズのフォルダ選択
			if ($lineNo == 3)
			{
				if (`optionMenu -q -numberOfItems poseBodyList` < ((int) $prefData[$lineNo]))
				{
					optionMenu -e -select 1 poseBodyList;
				}
				else
				{
					optionMenu -e -select ((int) $prefData[$lineNo]) poseBodyList;
				}
			}

			//顔ポーズのフォルダ選択
			if ($lineNo == 4)
			{
				if (`optionMenu -q -numberOfItems poseFaceList` < ((int) $prefData[$lineNo]))
				{
					optionMenu -e -select 1 poseFaceList;
				}
				else
				{
					optionMenu -e -select ((int) $prefData[$lineNo]) poseFaceList;
				}
			}
		}
	}

	fclose $filePrefNames;
}

//==================================================================================================
//■リファレンスのセーブ
//==================================================================================================
global proc savePref()
{

	string $usdScript = `internalVar -usd`;
	int $filePrefNames = `fopen ($usdScript +"mtCharaTools/pref.mel") "w"`;

	int $getCharSetNo = `optionMenu -q -select CharacterSetList`;
	int $getMainTabNo = `tabLayout -q -selectTabIndex mainTabs`;
	int $getBodyPoseFolderNo = `optionMenu -q -select poseBodyList`;
	int $getFacePoseFolderNo = `optionMenu -q -select poseFaceList`;

	string $prefList = ((string) $getCharSetNo) + "\n" + ((string) $getMainTabNo) + "\n" + ((string) $getBodyPoseFolderNo) + "\n" + ((string) $getFacePoseFolderNo) + "\n";

	print $prefList;

	fwrite $filePrefNames $prefList;
	fclose $filePrefNames;

}

//==================================================================================================
//■ウインドウ設定
//==================================================================================================
global proc mtCharaTools()
{

//■mtCharaToolsUIが存在すればmtCharaTools()を実行しない============================================

	if ((`window -exists mtCharaToolsUI` )== true )
	{
		warning "すでにCharaToolsウインドウは開かれています。\n";
		return;
	}

//■パスの設定======================================================================================

	global string $usdImage = "D:/sarux/tools/maya/scripts/_character/mtCharaTools/images/";//イメージパス(-command内で使用するためにglobalにする)
	string $usdMel = "D:/sarux/tools/maya/scripts/_character/mtCharaTools/";		//melファイルパス
	string $usdScript = `internalVar -usd`; 						//ユーザースクリプトパスの取得

//■スクリプトジョブの削除==========================================================================

	//同じScriptJobが存在すれば削除する（常にScriptJobを一つにする）============================

	global int $LNDautoSaveFileFlag1 = 0;
	global int $LNDautoSaveFileFlag2 = 0;

	//スクリプトジョブ「defaultSwitch」の有無を検索し、存在すれば削除する
	if (0 != $LNDautoSaveFileFlag1)
	{
		scriptJob -kill $LNDautoSaveFileFlag1;
		$LNDautoSaveFileFlag1 = 0;
	}

	//スクリプトジョブ「manipSwitch」の有無を検索し、存在すれば削除する
	if (0 != $LNDautoSaveFileFlag2)
	{
		scriptJob -kill $LNDautoSaveFileFlag2;
		$LNDautoSaveFileFlag2 = 0;
	}

	$LNDautoSaveFileFlag1 = `scriptJob -event "ModelPanelSetFocus" "defaultSwitch"`;
	$LNDautoSaveFileFlag2 = `scriptJob -event "ToolChanged" "manipSwitch"`;

//■シーン上のSetノードを検索し配列に格納する=======================================================

	string $allObjectSets[] = `ls -et objectSet`;	//シーン上の全てのSetノードをリストする
	string $outLinerSets[];			//Outlinerに表示されているSet名格納用文字列配列
	int $i;

	int $setsCounter = 0; 

	for ( $thisSet in $allObjectSets )
	{

	 // 各SetがOutlinerに表示されているかどうかを確認し、表示されている場合には、$outLinerSets文字列配列に追加する
	 if ( `setFilterScript ($thisSet)` )
		{
			 $outLinerSets[$setsCounter] = $thisSet;
			 $setsCounter++; 
		}
	}

//■ユーザースクリプトパスにrignames.melをコピーする================================================

	string $rignamesFile = $usdScript + "mtCharaTools/rignames.mel";
	string $rignamesFddyFile = $usdScript + "mtCharaTools/rignames_Fddy.mel";
	string $prefFile = $usdScript + "mtCharaTools/pref.mel";
	string $rignamesSourceFile = "//fs03/Js-sd/saru/next/user/matsuya/mel/mtCharaTools/rignames.mel";
	string $rignamesSourceFddyFile = "//fs03/Js-sd/saru/next/user/matsuya/mel/mtCharaTools/rignames_Fddy.mel";
	string $prefSourceFile = "//fs03/Js-sd/saru/next/user/matsuya/mel/mtCharaTools/pref.mel";
/*
	//ソースファイルがない場合は終了=============================================================
	if (`filetest -r $rignamesSourceFile` == 0 )
	{
		warning "体リグ名リストを作成できませんでした。";
		return;
	}

	if (`filetest -r $rignamesSourceFddyFile` == 0 )
	{
		warning "顔リグ名リストを作成できませんでした。";
		return;
	}

	if (`filetest -r $prefSourceFile` == 0 )
	{
		warning "プリファレンスファイルを作成できませんでした。";
		return;
	}

	//ソースファイルをユーザーにコピーする======================================================
	if (`filetest -f $rignamesFile` == 0 )
	{
		sysFile -copy $rignamesFile $rignamesSourceFile;
		warning ("体リグ命名規則ファイル==[" + $rignamesFile + "]==を作成しました。");
	}

	if (`filetest -f $rignamesFddyFile` == 0 )
	{
		sysFile -copy $rignamesFddyFile $rignamesSourceFddyFile;
		warning ("顔リグ命名規則ファイル==[" + $rignamesFddyFile + "]==を作成しました。");
	} 

	if (`filetest -f $prefFile` == 0 )
	{
		sysFile -copy $prefFile $prefSourceFile;
		warning ("プリファレンスファイル==[" + $prefFile + "]==を作成しました。");
	} 
*/
//■体リグリストrignames.melを読み込む==============================================================

	//変数設定==================================================================================

	global string $rigName[];	//リグ名を格納する配列変数
	int $lineNo; 			//リグ名のライン番号用変数

	//ファイルオープンし、$fileRigNamesに格納する===============================================
	int $fileRigNames = `fopen ($usdScript +"mtCharaTools/rignames.mel") "r"`;

	//fgetlineで$fileRigNames内を一行ずつ読み込み、サイズが存在すれば繰り返す===================

	for( $lineNo = 1; $lineNo < 158; $lineNo++)
	{
		$rigName[$lineNo] = `fgetline $fileRigNames`;

		//「\n」がある場合は削除する
		string $bufferRNR[];
		int $numTokens;
		$numTokens = `tokenize $rigName[$lineNo] "\n" $bufferRNR`;

		if ($numTokens = 1)
		{
			$rigName[$lineNo] = $bufferRNR[0];
		}
	}

	fclose $fileRigNames; //$fileRignamesを閉じる

//■ダディの顔リグリストrignames_Fddy.melファイル読み込み設定=======================================

	//変数設定==================================================================================

	global string $rigNameFddy[];	//リグ名を格納する配列変数
	int $lineNoFddy;	  	//リグ名のライン番号用変数

	//ファイルオープンし、$fileRigNamesFddyに格納する===============================================
	int $fileRigNamesFddy = `fopen ($usdScript +"mtCharaTools/rignames_Fddy.mel") "r"`;

	//fgetlineで$fileRigNames内を一行ずつ読み込み、サイズが存在すれば繰り返す===================

	for( $lineNoFddy = 1; $lineNoFddy < 48; $lineNoFddy++)
	{
		$rigNameFddy[$lineNoFddy] = `fgetline $fileRigNamesFddy`;

		//「\n」がある場合は削除する
		string $bufferRNRFddy[];
		int $numTokensFddy;
		$numTokensFddy = `tokenize $rigNameFddy[$lineNoFddy] "\n" $bufferRNRFddy`;

		if ($numTokensFddy = 1)
		{
			$rigNameFddy[$lineNoFddy] = $bufferRNRFddy[0];
		}
	}

	fclose $fileRigNamesFddy; //$fileRignamesFddyを閉じる

//■ウインドウとメニューバーの内容==================================================================

string $windowmtCharaTools = `window -title "mtCharaTools ver2.0" -sizeable false -menuBar true mtCharaToolsUI`;

	menu -label "ファイル" -tearOff false;
		menuItem -label "終了" -c ( "savePref; scriptJob -kill $LNDautoSaveFileFlag1; scriptJob -kill $LNDautoSaveFileFlag2; deleteUI " + $windowmtCharaTools );

	menu -label "表示" -tearOff false;
		menuItem -label "フレームレート（ビュー）" -checkBox off -c "ToggleFrameRate;　editMenuUpdate MayaWindow|mainEditMenu;" menuFrameRateView;

	menu -label "設定" -tearOff true;
		menuItem -label "アニメーション設定" -subMenu true;
			radioMenuItemCollection;
			menuItem -label "24frame/s" -radioButton off -c "frameRate24;" manuFrameRate24;
			menuItem -label "30frame/s" -radioButton on -c "frameRate30;" manuFrameRate30;
			menuItem -label "60frame/s" -radioButton off -c "frameRate60;" manuFrameRate60;
			menuItem -divider true;
			radioMenuItemCollection;
			menuItem -label "毎フレームで再生する" -radioButton off -c "playbackOptions -playbackSpeed 0;" menuPlayBackSpeed0;
			menuItem -label "リアルタイムで再生する" -radioButton on -c "playbackOptions -playbackSpeed 1;" menuPlayBackSpeed1;
			setParent -menu ..;

		menuItem -label "Playblast設定..." -c "performPlayblast 4;";
		menuItem -label "リグ規則設定..." -c "mtRigNameRule;";
		menuItem -divider true;
		menuItem -label "マニピュレータ設定を使う" -checkBox on menuManipSwitch;
		menuItem -label "リグ選択用Hotkeyを割り当てる" -c "mtMakeHotkey;";

	menu -label "ヘルプ" -tearOff false;
		menuItem -label "ヘルプ" -c "mtCThelp;";

//現在のビュー上のフレームレート表示を取得し、表示のフレームレート（ビュー）のチェックを変更する====

	int $menuFrameRateViewSet = `optionVar -q frameRateVisibility`;

	switch ($menuFrameRateViewSet)
	{
		case 0:
			menuItem -e -checkBox off menuFrameRateView; //チェックなし
		break;

		case 1:
			menuItem -e -checkBox on menuFrameRateView; //チェックあり
		break;

	}

//現在のフレームレートを取得し、アニメーション設定のフレームレートのチェックを変更する==============

	int $frameRateSet = currentTimeUnitToFPS();

	switch ($frameRateSet)
	{
		case 24:
			menuItem -e -radioButton on manuFrameRate24;
		break;

		case 30:
			menuItem -e -radioButton on manuFrameRate30;
		break;

		case 60:
			menuItem -e -radioButton on manuFrameRate60;
		break;
	}

//現在のプレイバックスピードを取得し、アニメーション設定のプレイバックスピードのチェックを変更する==

	int $playbackSpeedSet = `playbackOptions -q -playbackSpeed`;

	switch ($playbackSpeedSet)
	{
		case 0:
			menuItem -e -radioButton on menuPlayBackSpeed0; //毎フレームで　再生する
		break;

		case 1:
			menuItem -e -radioButton on menuPlayBackSpeed1; //リアルタイムで再生する
		break;

	}

//■エディターの内容================================================================================

columnLayout; //行の宣言

	//Character Set Selectフレーム内の列設定====================================================

	rowColumnLayout -numberOfColumns 2 -columnWidth 1 260 -columnWidth 2 93 ;

		frameLayout -label " キャラクター指定 " -labelAlign "center" -borderStyle "etchedOut" -width 260 -height 47 -marginWidth 5 -marginHeight 2;

			rowColumnLayout -numberOfColumns 2 -columnWidth 1 170 -columnWidth 2 70

				columnLayout;

				optionMenu -w 170 CharacterSetList;

					menuItem -label "--- no Selected ---";

				//取得したSets名をリストに表示する
				for($i = 0; $i < $setsCounter; $i++)
				{

					//Setの名前に$rigName[3]があるものだけをリストに表示する

					string $matchSets = `match $rigName[1] $outLinerSets[$i]`;

					if( $matchSets == $rigName[1] )
					{
						menuItem -label $outLinerSets[$i];
					}
				}

				shelfButton -i ( $usdImage + "buttonUpdate.bmp" ) -h 26 -c ( "deleteUI " + $windowmtCharaTools +"; mtCharaTools;" );

			setParent ..;

		setParent ..;

		frameLayout -labelVisible false -borderVisible false -width 93 -height 47 -marginWidth 4;

			rowColumnLayout -numberOfRows 2 -rowOffset 1 "top" 5 -rowHeight 1 30;

				shelfButton -i ( $usdImage + "buttonExport1.bmp" ) -hi ( $usdImage + "buttonExport2.bmp" ) -w 81 -c "mtPosAnmCopy($rigName[2], $rigName[3], $rigName[4], $rigName[98], $rigName[99], $rigName[100], \"loc_position\");";
				checkBox -label "位置固定" -onc "mtPosLockTgl($rigName[2], $rigName[3], $rigName[4], $rigName[98], $rigName[99], $rigName[100], 1);" -ofc "mtPosLockTgl($rigName[2], $rigName[3], $rigName[4], $rigName[98], $rigName[99], $rigName[100], 0);" checkPosLockTgl;

			setParent ..;

		setParent ..;

	setParent ..;

	//View Managerフレーム内の列設定=============================================================

	frameLayout -label " 表示設定 " -labelAlign "center" -borderStyle "etchedOut" -height 45 -marginWidth 5 -marginHeight 2;

		rowColumnLayout -numberOfColumns 11 -columnWidth 1 48 -columnWidth 2 48 -columnWidth 3 48 -columnWidth 4 48
				-columnWidth 5 21 -columnWidth 6 21 -columnWidth 7 21 -columnWidth 8 21 -columnWidth 9 21 -columnWidth 10 21 -columnWidth 11 21;

			shelfButton -i ( $usdImage + "buttonWire.bmp" ) -c "viewWire;" -h 20 -ann "WireFrame表示";
			shelfButton -i ( $usdImage + "buttonShade.bmp" ) -c "viewShade;" -h 20 -ann "Shade表示";
			shelfButton -i ( $usdImage + "buttonTexture.bmp" ) -c "viewTexture;" -h 20 -ann "Shade+Texture表示";
			shelfButton -i ( $usdImage + "buttonWirePlus.bmp" ) -c "toggleAddWire;" -h 20 -ann "非選択時にWireFrame表示をトグルする";
			iconTextCheckBox -w 21 -h 21 -ann "ライトなし" -i ( $usdImage + "switchViewNoLight1.bmp" ) -si ( $usdImage + "switchViewNoLight2.bmp" ) -onc "toggleNoLightTrue;" -ofc "toggleNoLightFalse;" itcbViewNoLight;
			iconTextCheckBox -w 21 -h 21 -ann "X-ray表示" -i ( $usdImage + "switchViewXray1.bmp" ) -si ( $usdImage + "switchViewXray2.bmp" ) -onc "toggleXray;" -ofc "toggleXray;" itcbViewXray;
			iconTextCheckBox -w 21 -h 21 -ann "Joint表示" -i ( $usdImage + "switchViewJoint1.bmp" ) -si ( $usdImage + "switchViewJoint2.bmp" ) -onc "showJoint;" -ofc "showJoint;" itcbShowJoint;
			iconTextCheckBox -w 21 -h 21 -ann "IkHandle表示" -i ( $usdImage + "switchViewIk1.bmp" ) -si ( $usdImage + "switchViewIk2.bmp" ) -onc "showIk;" -ofc "showIk;" itcbShowIk;
			iconTextCheckBox -w 21 -h 21 -ann "Locator表示" -i ( $usdImage + "switchViewLocator1.bmp" ) -si ( $usdImage + "switchViewLocator2.bmp" ) -onc "showLocator;" -ofc "showLocator;" itcbShowLocator;
			iconTextCheckBox -w 21 -h 21 -ann "Polygon表示" -i ( $usdImage + "switchViewPolygon1.bmp" ) -si ( $usdImage + "switchViewPolygon2.bmp" ) -onc "showPolygon;" -ofc "showPolygon;" itcbShowPolygon;
			iconTextCheckBox -w 21 -h 21 -ann "Light表示" -i ( $usdImage + "switchViewLight1.bmp" ) -si ( $usdImage + "switchViewLight2.bmp" ) -onc "showLight;" -ofc "showLight;" itcbShowLight;

		setParent ..;

	setParent ..;

	//Select Filterとタブの列設定===============================================================

	rowColumnLayout -numberOfColumns 2 -columnWidth 1 100 -columnWidth 2 250; //Select Filter(左側)が幅100、タブ(右側)が幅250に設定

		rowColumnLayout -numberOfRows 5 -rowHeight 1 135 -rowHeight 2 55 -rowHeight 3 70 -rowHeight 4 41 -rowHeight 5 41 ; //各フレームの高さ設定

			//ウインドウフレーム------------------------------------------------------------
			frameLayout -label " ウインドウ " -labelAlign "center" -borderStyle "etchedOut"  -marginWidth 5 -marginHeight 2;

				rowColumnLayout -numberOfColumns 1 -columnWidth 1 81;
					shelfButton -h 22 -i ( $usdImage + "buttonAnmGraph.bmp" ) -c "GraphEditor;";
					shelfButton -h 22 -i ( $usdImage + "buttonDopesheet.bmp" ) -c "DopeSheetEditor;";
					shelfButton -h 22 -i ( $usdImage + "buttonTraxEditor.bmp" ) -c "CharacterAnimationEditor;";
					shelfButton -h 22 -i ( $usdImage + "buttonOutliner.bmp" ) -c "OutlinerWindow;";
					shelfButton -h 22 -i ( $usdImage + "buttonHyperGraph.bmp" ) -c "HypergraphHierarchyWindow;";
				setParent ..;

			setParent ..;

			//選択モードフレーム------------------------------------------------------------
			frameLayout -label " 選択モード " -labelAlign "center" -borderStyle "etchedOut" -marginWidth 5 -marginHeight 3;

				columnLayout;
					radioCollection radioSelectMode;
					radioButton -label "Single" -select;
					radioButton -label "Multi";
				setParent ..;

			setParent ..;

			//フォーカスフレーム--------------------------------------------------------
			frameLayout -label " フォーカス " -labelAlign "center" -borderStyle "etchedOut"  -marginWidth 5 -marginHeight 3;

				columnLayout;
					radioCollection radioCamForcus;
					radioButton -label "No Forcus" -select;
					radioButton -label "Aim Forcus";
					radioButton -label "Cam Forcus";
				setParent ..;

			setParent ..;

			//フレームレートフレーム--------------------------------------------------------
			frameLayout -label " フレームレート " -labelAlign "center" -borderStyle "etchedOut"  -marginWidth 5 -marginHeight 3;

				columnLayout;
					string $frameRate = currentTimeUnitToFPS();
					text -label ("    " + $frameRate  + " frame/s") textFrameRate;
				setParent ..;

			setParent ..;

			//Playblastボタン--------------------------------------------------------
			frameLayout -labelVisible 0  -borderStyle "etchedOut"  -marginWidth 5 -marginHeight 8;
				rowColumnLayout -numberOfColumns 1 -columnWidth 1 80;
					shelfButton -i ( $usdImage + "buttonPlayblast.bmp" ) -height 20 -c "playblast;";
				setParent ..;

			setParent ..;

		setParent ..;

		//タブ設定--------------------------------------------------------------------------

		string $form = `formLayout`;
		string $tabs = `tabLayout -innerMarginWidth 5 -innerMarginHeight 5 mainTabs`;

			//タブの大きさの設定--------------------------------------------------------
			formLayout -edit
				-attachForm $tabs "top"		5
				-attachForm $tabs "left"	0
				-attachForm  $tabs "bottom"	0
				-attachForm $tabs "right"	0
			$form;

			//タブ1の設定---------------------------------------------------------------
			string $tab1 = `formLayout`;

				string $buttonTrans = `iconTextCheckBox -w 33 -h 15 -ann "移動モード" -i ( $usdImage + "buttonTrans1.bmp" ) -si ( $usdImage + "buttonTrans2.bmp" ) -onc "buildTranslateMM; MarkingMenuPopDown;" -ofc "buildSelectMaskMM; MarkingMenuPopDown;" buttonTrans`;
				string $buttonRot = `iconTextCheckBox -w 33 -h 15 -ann "回転モード" -i ( $usdImage + "buttonRot1.bmp" ) -si ( $usdImage + "buttonRot2.bmp" ) -onc "buildRotateMM; MarkingMenuPopDown;" -ofc "buildSelectMaskMM; MarkingMenuPopDown;" buttonRot`;
				string $buttonScale = `iconTextCheckBox -w 33 -h 16 -ann "スケールモード" -i ( $usdImage + "buttonScale1.bmp" ) -si ( $usdImage + "buttonScale2.bmp" ) -onc "buildXYZScaleMM; MarkingMenuPopDown;" -ofc "buildSelectMaskMM; MarkingMenuPopDown;" buttonScale`;
				string $buttonGlobal = `iconTextCheckBox -w 33 -h 15 -ann "グローバルモード" -i ( $usdImage + "buttonGlobal1.bmp" ) -si ( $usdImage + "buttonGlobal2.bmp" ) -onc "axisGlobalMode;" buttonGlobal`;
				string $buttonLocal = `iconTextCheckBox -w 33 -h 15 -ann "ローカルモード" -i ( $usdImage + "buttonLocal1.bmp" ) -si ( $usdImage + "buttonLocal2.bmp" ) -onc "axisLocalMode;" buttonLocal`;
				string $buttonSelect = `iconTextCheckBox -w 33 -h 16 -ann "選択モード" -i ( $usdImage + "buttonSelect1.bmp" ) -si ( $usdImage + "buttonSelect2.bmp" ) -onc "buildSelectMaskMM; MarkingMenuPopDown;" buttonSelect`;

				string $buttonSelCharAll = `shelfButton -w 52 -h 16 -ann "リグの全てを選択する" -i ( $usdImage + "buttonSelCharAll1.bmp" ) -hi ( $usdImage + "buttonSelCharAll2.bmp" ) -c "charaSetSelect(\"set\");"`;
				string $buttonSelBodyAll = `shelfButton -w 52 -h 16 -ann "リグの全てを選択する" -i ( $usdImage + "buttonSelBodyAll1.bmp" ) -hi ( $usdImage + "buttonSelBodyAll2.bmp" ) -c "charaSetSelect(\"RigPv_\");"`;
				string $buttonSelClear = `shelfButton -w 52 -h 16 -ann "選択を解除する" -i ( $usdImage + "buttonSelClear1.bmp" ) -hi ( $usdImage + "buttonSelClear2.bmp" ) -c "select -cl;"`;

				string $buttonPosROT = `shelfButton -w 33 -h 15 -ann "全体を回転する" -i ( $usdImage + "buttonPosROT1.bmp" ) -hi ( $usdImage + "buttonPosROT2.bmp" ) -c "mtGetRigSelect($rigName[2], $rigName[3], $rigName[4], $rigName[98], $rigName[99], $rigName[100], \"Rotate\", $rigName[102]);"`;
				string $buttonPosTRS = `shelfButton -w 33 -h 15 -ann "全体を移動する" -i ( $usdImage + "buttonPosTRS1.bmp" ) -hi ( $usdImage + "buttonPosTRS2.bmp" ) -c "mtGetRigSelect($rigName[2], $rigName[3], $rigName[4], $rigName[98], $rigName[99], $rigName[100], \"Trans\", $rigName[102]);"`;
				string $buttonHead = `shelfButton -w 33 -h 15 -ann "頭部" -i ( $usdImage + "buttonHead1.bmp" ) -hi ( $usdImage + "buttonHead2.bmp" ) -c "mtGetRigSelect($rigName[2], $rigName[3], $rigName[4], $rigName[8], $rigName[9], $rigName[10], $rigName[11], $rigName[12]);"`;
				string $buttonNeck = `shelfButton -w 33 -h 15 -ann "首" -i ( $usdImage + "buttonNeck1.bmp" ) -hi ( $usdImage + "buttonNeck2.bmp" ) -c "mtGetRigSelect($rigName[2], $rigName[3], $rigName[4], $rigName[13], $rigName[14], $rigName[15], $rigName[16], $rigName[17]);"`;
				string $buttonChest = `shelfButton -w 33 -h 15 -ann "胸" -i ( $usdImage + "buttonChest1.bmp" ) -hi ( $usdImage + "buttonChest2.bmp" ) -c "mtGetRigSelect($rigName[2], $rigName[3], $rigName[4], $rigName[18], $rigName[19], $rigName[20], $rigName[21], $rigName[22]);"`;
				string $buttonSpine = `shelfButton -w 33 -h 15 -ann "腹" -i ( $usdImage + "buttonSpine1.bmp" ) -hi ( $usdImage + "buttonSpine2.bmp" ) -c "mtGetRigSelect($rigName[2], $rigName[3], $rigName[4], $rigName[23], $rigName[24], $rigName[25], $rigName[26], $rigName[27]);"`;
				string $buttonWaist = `shelfButton -w 52 -h 15 -ann "腰" -i ( $usdImage + "buttonWaist1.bmp" ) -hi ( $usdImage + "buttonWaist2.bmp" ) -c "mtGetRigSelect($rigName[2], $rigName[3], $rigName[4], $rigName[28], $rigName[29], $rigName[30], $rigName[31], $rigName[32]);"`;
				string $buttonHip = `shelfButton -w 33 -h 15 -ann "尻" -i ( $usdImage + "buttonHip1.bmp" ) -hi ( $usdImage + "buttonHip2.bmp" ) -c "mtGetRigSelect($rigName[2], $rigName[3], $rigName[4], $rigName[33], $rigName[34], $rigName[35], $rigName[36], $rigName[37]);"`;
				string $buttonShouldR = `shelfButton -w 33 -h 15 -ann "右肩" -i ( $usdImage + "buttonShouldR1.bmp" ) -hi ( $usdImage + "buttonShouldR2.bmp" ) -c "mtGetRigSelect($rigName[2], $rigName[3], $rigName[4], $rigName[38], $rigName[39], $rigName[40], $rigName[41], $rigName[42]);"`;
