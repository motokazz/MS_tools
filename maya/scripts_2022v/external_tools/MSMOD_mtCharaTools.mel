//==================================================================================================
//■フレームレート設定
//==================================================================================================
global proc frameRate24()
{
	currentUnit -time film;
	text -e -label "    24 frame/s" textFrameRate;
	editMenuUpdate MayaWindow|mainEditMenu;
}

global proc frameRate30()
{
	currentUnit -time ntsc;
	text -e -label "    30 frame/s" textFrameRate;
	editMenuUpdate MayaWindow|mainEditMenu;
}

global proc frameRate60()
{
	currentUnit -time ntscf;
	text -e -label "    60 frame/s" textFrameRate;
	editMenuUpdate MayaWindow|mainEditMenu;
}

//==================================================================================================
//■setに含まれるノードを選択する（Rig_、Pv_、RigF_などを検索し、該当するノードを選択）
//==================================================================================================
global proc charaSetSelect(string $selRigType)
{
	string $setName = `optionMenu -q -v CharacterSetList`;

	if ($setName == "--- no Selected ---")
	{
		warning "【操作ヘルプ】キャラクターセットを選択してください。";
		return;
	}

	else if (`objExists $setName` == 0)
	{
		warning ("【注意】キャラクターセット " + $setName + " がありません。");
		return;
	}

	select -clear;

	//セットに含まれるノードのリストを取得する
	//※取得できる文字列はフルパス（ root|joint1|joint2 )である場合がある
	string $setMembers[] = `sets -q $setName`;

	//各ノードに対して$nodeNameと同じかどうかの判定を行う
	for ( $thisSetMember in $setMembers )
	{
		//$thisSetMember 文字列がフルパスである場合が考えられるので「tokenize」MELコマンドを利用して、ノード名のみを取得する
		string $buffers[];
  		string $setMemberNodeName;
  		int $tokenNumber = `tokenize $thisSetMember "|" $buffers`;

		//$tokenNumberの値が1を超えていない場合には、$thisSetMember 文字列はフルパスではない

		//$setMemberNodeName文字列にフルパスを含まないノード名を格納する
		if ( $tokenNumber > 1 )
		{
			$setMemberNodeName = $buffers[ $tokenNumber - 1] ;
		}
		else
		{
			$setMemberNodeName = $thisSetMember;
		}

		int $rigNameStrValid = 0;

		//正規表現で「Rig_」「Pv_」「RigF_」を含む文字列を検索し、該当するノードを選択する
		switch ($selRigType)
		{
			case "Rig_":

				$rigNameStrValid = isValidString($setMemberNodeName, "([_:0-9]*)(Rig_)([a-zA-Z0-9]+)");
				break;

			case "RigPv_":

				$rigNameStrValid = isValidString($setMemberNodeName, "([_:0-9]*)([Rig_|Pv_]*)([a-zA-Z0-9]+)"); //Rig_とPv_を検索
				break;

			case "RigF_":

				$rigNameStrValid = isValidString($setMemberNodeName, "([_:0-9]*)(RigF_)([a-zA-Z0-9]+)");
				break;

			case "set":

				select -r $setName;
				break;

			default:
				break;
		}

		if( $rigNameStrValid == 1 )
		{
			select -add $thisSetMember;
		}
	}

}

//==================================================================================================
//■顔と体ポーズリストにポーズmelを読み込んで表示する
//==================================================================================================
global proc importPoseList()
{
	//キャラ選択リストでキャラ名（フォルダ名）を取得する
	string $bodyCharName = `optionMenu -q -v poseBodyList`;
	string $faceCharName = `optionMenu -q -v poseFaceList`;

	string $bufferMel[];		//「.mel」名用$buffer配列変数を定義
	string $melNameSet;		//mel名の格納用
	string $poseFileListMel;	//リスト内から抽出するデータの格納用
	global string $iconTextButtonName;

	string $usdScript = `internalVar -usd`;							//ユーザースクリプトパスの取得
	string $usdBodyPoseList = $usdScript + "mtCharaTools/poselist/body/" + $bodyCharName + "/";	//poselist/body/フォルダの定義
	string $usdFacePoseList = $usdScript + "mtCharaTools/poselist/face/" + $faceCharName + "/";	//poselist/face/フォルダの定義
	string $bodyPoseFileList[] = `getFileList -folder $usdBodyPoseList -filespec "*.mel"`;		//melリストを取得
	string $facePoseFileList[] = `getFileList -folder $usdFacePoseList -filespec "*.mel"`;		//melリストを取得

	//体リストを全削除して初期化する============================================================

	textScrollList -e -removeAll bodyPoseListField;

	for ($poseFileListMel in $bodyPoseFileList)
	{
		//「.mel」より前半部分を切り出す
		tokenize $poseFileListMel "." $bufferMel;
		$melNameSet = $bufferMel[0];

		textScrollList -e -appendPosition 100 $melNameSet bodyPoseListField;	//リストフィールドにポーズ名を追加する
	}

	//顔ポーズのUIを削除し、再び登録後にリストを加える==========================================
	deleteUI facePoseListField;
	shelfLayout -w 230 -cw 51 -ch 60 -p facePoseListForm facePoseListField;

	for ($poseFileListMel in $facePoseFileList)
	{
		//「.mel」より前半部分を切り出す
		tokenize $poseFileListMel "." $bufferMel;
		$melNameSet = $bufferMel[0];

		$iconTextButtonName = "iconFacePoseCheckBox_" + $melNameSet;
		iconTextButton -parent facePoseListField -label $melNameSet -mh 2 -style "iconAndTextVertical" -image1 ($usdFacePoseList + $melNameSet + ".bmp") -c ("source \"" + $usdFacePoseList + $melNameSet + ".mel\"") $iconTextButtonName;
	}

}

//==================================================================================================
//■体ポーズリストで選択したポーズを削除する
//==================================================================================================
global proc deletePose()
{

//■リストを何も選択していない場合は何もしない======================================================

	string $nonSelectedPose[] = `textScrollList -q -selectItem bodyPoseListField`;

	if ($nonSelectedPose[0] == "")
	{
		return;
	}

//■ポーズ削除の実行================================================================================

	string $bufferPose[];		//「Pose名」用$buffer配列変数を定義
	global string $melNameSet;	//mel名の格納用
	string $charNameSet;		//キャラ名の格納用
	string $poseListMel;		//リスト内から抽出するポーズの格納用

	//キャラ選択リストでキャラ名（フォルダ名）を取得する
	string $charName = `optionMenu -q -v poseBodyList`;

	string $usdScript = `internalVar -usd`;							//ユーザースクリプトパスの取得
	string $usdPoseList = $usdScript + "mtCharaTools/poselist/body/" + $charName + "/";	//poselist/body/フォルダの定義
	string $poseFileList[] = `getFileList -folder $usdPoseList -filespec "*.mel"`;		//melリストを取得

	string $selectedPose[] = `textScrollList -q -selectItem bodyPoseListField`;

	//melファイル名を決定
	$melNameSet = ($usdPoseList + $selectedPose[0] + ".mel");

//■deletePoseUIが存在すればdeletePose()を実行しない==============================================

	if ((`window -exists deletePoseUI` )== true )
	{
		return;
	}

//■ウインドウ設定==================================================================================

	string $windowDeletePose = `window -title "ポーズの削除" -sizeable false -menuBar true deletePoseUI`;

	columnLayout;

		frameLayout  -labelVisible false -borderStyle "etchedOut" -w 295 -h 40 -marginHeight 10;

			rowColumnLayout -numberOfColumns 1 -columnWidth 1 295;

				text -label ($selectedPose[0] + " を削除します。" ) -align "center";

			setParent ..;

		setParent ..;

		frameLayout -labelVisible false -borderStyle "etchedOut" -w 295 -h 38 -marginWidth 35 -marginHeight 5;

			rowColumnLayout -numberOfColumns 2 -columnWidth 1 100 -columnWidth 2 100 -columnSpacing 2 15;

				button -label "OK" -c "sysFile -delete $melNameSet; deleteUI -window deletePoseUI; importPoseList; textScrollList -e -selectIndexedItem 1 bodyPoseListField;";
				button -label "キャンセル" -c "deleteUI -window deletePoseUI;";

			setParent ..;

		setParent ..;

//■ウインドウ実行==================================================================================

	showWindow $windowDeletePose;
	window -e -w 300 -h 110 deletePoseUI;

}

//==================================================================================================
//■体ポーズリストで選択したポーズをリネームするUI
//==================================================================================================
global proc renamePoseUI()
{

//■リストを何も選択していない場合は何もしない======================================================

	string $nonSelectedPose[] = `textScrollList -q -selectItem bodyPoseListField`;

	if ($nonSelectedPose[0] == "")
	{
		return;
	}

//■ポーズmel名の取得===============================================================================

	string $bufferPose[];		//「Pose名」用$buffer配列変数を定義
	global string $melNameSet;	//名前変更前のmel名の格納用
	global string $melRenameSet;	//名前変更後のmel名の格納用
	string $poseListMel;		//リスト内から抽出するポーズの格納用

	//キャラ選択リストでキャラ名（フォルダ名）を取得する
	string $charName = `optionMenu -q -v poseBodyList`;

	string $usdScript = `internalVar -usd`;							//ユーザースクリプトパスの取得
	string $usdPoseList = $usdScript + "mtCharaTools/poselist/body/" + $charName + "/";	//poselist/body/フォルダの定義
	string $poseFileList[] = `getFileList -folder $usdPoseList -filespec "*.mel"`;		//melリストを取得

	//選択したポーズ名を取得する================================================================

	string $selectedPose[] = `textScrollList -q -selectItem bodyPoseListField`;

	//名前変更前のmelファイル名を決定
	$melNameSet = ($usdPoseList + $selectedPose[0] + ".mel");

//■mtCharaToolsUIが存在すればdeletePose()を実行しない==============================================

	if ((`window -exists renamePoseUI` )== true )
	{
		return;
	}

//■ウインドウ設定==================================================================================

	string $windowRenamePose = `window -title "ポーズの名前変更" -sizeable false -menuBar true renamePoseUI`;

	columnLayout;

		frameLayout  -labelVisible false -borderStyle "etchedOut" -w 341 -h 40 -marginHeight 10;

			rowColumnLayout -numberOfColumns 1 -columnWidth 1 341;

				text -label ($nonSelectedPose[0] + " の名前を変更してください。") -align "center";

			setParent ..;
		setParent ..;

		frameLayout  -label " 変更前の名前" -labelAlign "center" -borderStyle "etchedOut" -w 341 -h 60 -marginHeight 15;

			rowColumnLayout -numberOfColumns 2  -columnWidth 1 120 -columnWidth 1 120;

				text -label "ポーズ名：" -align "right";
				text -label $selectedPose[0] namePoseName;

			setParent ..;
		setParent ..;

		frameLayout  -label " 変更後の名前" -labelAlign "center" -borderStyle "etchedOut" -w 341 -h 70 -marginHeight 15;

			rowColumnLayout -numberOfColumns 2  -columnWidth 1 120 -columnWidth 1 120;

				text -label "ポーズ名：" -align "right";
				textField -text $selectedPose[0] renamePoseName;

			setParent ..;
		setParent ..;


		frameLayout -labelVisible false -borderStyle "etchedOut" -w 341 -h 38 -marginWidth 50 -marginHeight 5;

			rowColumnLayout -numberOfColumns 2 -columnWidth 1 100 -columnWidth 2 100 -columnSpacing 2 30;

				button -label "OK" -c "renamePose(0);" renameOk1;
				button -label "キャンセル" -c "deleteUI -window renamePoseUI;" renameCancel1;

			setParent ..;

		setParent ..;

		frameLayout -labelVisible false -borderStyle "etchedOut" -marginWidth 30 -marginHeight 8;

			rowColumnLayout -numberOfColumns 3 -columnWidth 1 100 -columnWidth 2 100 -columnWidth 3 100;

				text -label "上書きしますか？";
				button -label "OK" -c "renamePose(1);";
				button -label "キャンセル" -c "window -e -w 346 -h 240 renamePoseUI; textField -e -en true renameCharName; textField -e -en true renamePoseName; button -e -en true renameOk1; button -e -en true renameCancel1;";

			setParent ..;

		setParent ..;

//■ウインドウ実行==================================================================================

	showWindow $windowRenamePose;
	window -e -w 346 -h 240 renamePoseUI;

}

//==================================================================================================
//■体ポーズmelをリネームする
//==================================================================================================
global proc renamePose(int $Compel)
{

//■mel名をリネームする=============================================================================
	string $namePoseName = `text -q -label namePoseName`;
	string $renamePoseName = `textField -q -text renamePoseName`;

	//キャラ選択リストでキャラ名（フォルダ名）を取得する
	string $charName = `optionMenu -q -v poseBodyList`;

	string $usdScript = `internalVar -usd`;							//ユーザースクリプトパスの取得
	string $usdPoseList = $usdScript + "mtCharaTools/poselist/body/" + $charName + "/";	//poselist/body/フォルダの定義
	string $poseFileList[] = `getFileList -folder $usdPoseList -filespec "*.mel"`;		//melリストを取得

	string $melNameSet = ($usdPoseList + $namePoseName + ".mel");
	string $melRenameSet = ($usdPoseList + $renamePoseName + ".mel");

	if ($renamePoseName == "")
	{
		warning "変更する名前がありません。";
		return;
	}

	//もし既存のファイルがあった場合（上書き処理）==============================================

	if ($Compel == 0)
	{

		string $melFileList[] = `getFileList -folder $usdPoseList -fs "*.mel"`;
		string $melFile;
		string $melName = $renamePoseName + ".mel";

		for ($melFile in $melFileList)
		{

			if ($melFile == $melName)
			{

				//ボタンを入力不可にする
				textField -e -en false renamePoseName;
				button -e -en false renameOk1;
				button -e -en false renameCancel1;

				//ウインドウを拡張する
				window -e -w 346 -h 282 renamePoseUI;
				return;

			}
		}
	}

	//ポーズmelのファイル名をリネームする=======================================================

	sysFile -rename $melRenameSet $melNameSet;

//■リネームしたmelの2行目を変更する================================================================

	string $lineMel;
	string $poseCommand = ""; //記録するコマンド
	int $lineNo;
	int $lineSize = 1; //初期値を1にしないとfor文がスルーされる

//melを開く=========================================================================================

	int $filePoseMelr = `fopen $melRenameSet "r"`;

//fgetlineで$filePoseMelr内を一行ずつ読み込み、サイズが存在すれば繰り返す===========================

	for( $lineNo = 1; $lineSize > 0; $lineNo++)
	{
		$lineMel = `fgetline $filePoseMelr`;
		$lineSize = `size $lineMel`;

		//2行目を書き換える
		if ($lineNo == 2)
		{
			$lineMel = "//ポーズ名　　=" + $renamePoseName + "\n";
		}

		$poseCommand = $poseCommand + $lineMel;

	}

	fclose $filePoseMelr ; //$filePoseMelrを閉じる

//■2行目を変更したコマンドをmelに書き込む===================================================

	//melに書き込む=============================================================================

	print "書き込みました\n";
	int $filePoseMelw = `fopen $melRenameSet "w"`;
	fwrite $filePoseMelw $poseCommand;
	fclose $filePoseMelw ; //$filePoseMelwを閉じる

//■ポーズリストからリネームしたポーズを選択する====================================================

	importPoseList;
	string $selectPose = $renamePoseName;
	selectPose($selectPose);
	deleteUI -window renamePoseUI;

}

//==================================================================================================
//■体ポーズリストで選択したmelのヘッダを取得し表示する
//==================================================================================================
global proc getPoseHeader()
{

//■選択したポーズからmelのパスとファイル名を取得する===============================================

	string $melNameSet = `getPoseFile`;

//■ヘッダを取得する================================================================================

	//変数設定==================================================================================

	global string $poseHeader[]; //ヘッダを格納する配列変数
	int $headerNo; 		     //ヘッダのライン番号用変数

	//ファイルオープンし、$filePoseMelに格納する================================================
	int $filePoseMel = `fopen $melNameSet "r"`;

	//fgetlineで$filePoseMel内を一行ずつ読み込み、サイズが存在すれば繰り返す====================

	for( $headerNo = 1; $headerNo < 6; $headerNo++)
	{
		$poseHeader[$headerNo] = `fgetline $filePoseMel`;

		//「\n」がある場合は削除する
		string $bufferHeader1[];
		int $numTokens2;
		$numTokens1 = `tokenize $poseHeader[$headerNo] "\n" $bufferHeader1`;

		if ($numTokens1 = 1)
		{
			$poseHeader[$headerNo] = $bufferHeader1[0];
		}

		//「=」から後半を取得する
		string $bufferHeader2[];
		int $numTokens2;
		$numTokens2 = `tokenize $poseHeader[$headerNo] "=" $bufferHeader2`;

		if ($numTokens2 = 1)
		{
			$poseHeader[$headerNo] = $bufferHeader2[1];
		}

	}

	fclose $filePoseMel; //$filePoseMelを閉じる

//■パス名の最後のオブジェクト名を取得する==========================================================

	string $lastNodeName[];
	string $pathNodeName = $poseHeader[3];
	tokenize($pathNodeName, "|", $lastNodeName);
	int $sizeNode = size($lastNodeName);
	$sizeNode--;

//■取得したヘッダを表示する========================================================================

	text -e -label $poseHeader[1] headerChar;
	text -e -label $poseHeader[2] headerPose;
	text -e -label $lastNodeName[$sizeNode] headerNode;
	text -e -label $poseHeader[4] headerHier;
	text -e -label ($poseHeader[5] + "  " + $poseHeader[6]) headerDateTime;
}

//==================================================================================================
//■体ポーズmelを実行する
//==================================================================================================
global proc setPose()
{

	string $setName = `optionMenu -q -v CharacterSetList`;

	if ($setName == "--- no Selected ---")
	{
		warning "【操作ヘルプ】キャラクターセットを選択してください。";
		return;
	}

	else if (`objExists $setName` == 0)
	{
		warning ("【注意】キャラクターセット " + $setName + " がありません。");
		return;
	}

	//選択したポーズからmelのパスとファイル名を取得する
	string $melNameSet = `getPoseFile`;

	//テキストフィールドの「選択ノード名」を取得する
	string $headerNodeStr = `text -q -label headerNode`;

	//「headerNode名」用$buffer配列変数を定義
	string $bufferHeaderNode[];

	//"("より前半部分を切り出す（文字列「(複数選択)」を取り除くため）
	tokenize $headerNodeStr "(" $bufferHeaderNode;
	string $headerNodeTok = $bufferHeaderNode[0];

	//キャラセット名からリファレンス名を取得する
	string $refName = `mtGetRefName`;

	//「選択ノード名」を設定する（リファレンス対応）
	string $selectNode = $refName + $headerNodeTok;

	//「選択ノード名」がシーン上にあるか調べる
	if (`objExists $selectNode` == 0)
	{

		warning ("このシーンには [" + $selectNode + "] がありません。または階層構造が違います。");
		return;

	}

	//ポーズmelを実行する
	eval( "source \"" + $melNameSet + "\"" );

}

//==================================================================================================
//■体ポーズmelのファイルを開く
//==================================================================================================
global proc openPose()
{

	string $melNameSet = `getPoseFile`; //選択したポーズからmelのパスとファイル名を取得する

	eval("system(\"load " + $melNameSet + "\")");

}


//==================================================================================================
//■体ポーズリストで選択したポーズからパスとmelファイルを設定する
//==================================================================================================
global proc string getPoseFile()
{

//■ポーズmel名の取得===============================================================================

	//フォルダ選択リストでフォルダ名を取得する
	string $charBodyName;
	string $charFaceName;

	int $selTab = `tabLayout -q -selectTabIndex mainTabs`;

	//体フォルダか顔フォルダか
	if ( $selTab == 2 )
	{
		$charBodyName = `optionMenu -q -v poseBodyList`;
	}
	else if ( $selTab == 5 )
	{
		$charFaceName = `optionMenu -q -v poseFaceList`;
	}

	string $bufferPose[];		//「Pose名」用$buffer配列変数を定義
	global string $melNameSet;	//mel名の格納用
	global string $charNameSet;	//キャラ名の格納用
	string $poseListMel;		//リスト内から抽出するポーズの格納用

	string $usdScript = `internalVar -usd`;	
						//ユーザースクリプトパスの取得
	string $usdBodyPoseList = $usdScript + "mtCharaTools/poselist/body/" + $charBodyName + "/";	//poselist/body/フォルダの定義
	string $usdFacePoseList = $usdScript + "mtCharaTools/poselist/body/" + $charFaceName + "/";	//poselist/face/フォルダの定義

	string $bodyPoseFileList[] = `getFileList -folder $usdBodyPoseList -filespec "*.mel"`;		//melリストを取得
	string $facePoseFileList[] = `getFileList -folder $usdFacePoseList -filespec "*.mel"`;

	//選択したポーズ名を取得する================================================================

	string $selectedBodyPose[] = `textScrollList -q -selectItem bodyPoseListField`;

	//名前変更前のmelファイル名を決定
	$melNameSet = ($usdBodyPoseList + $selectedBodyPose[0] + ".mel");

	//ファイル名を返り値に設定する
	return $melNameSet;

}

//==================================================================================================
//■体ポーズリストから該当するポーズを選択する
//==================================================================================================
global proc selectPose(string $selectPose)
{

	textScrollList -e -selectItem $selectPose bodyPoseListField;

}

//==================================================================================================
//■ヘルプウインドウ設定
