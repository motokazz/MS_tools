		text -height 15 -bgc 1 0.5 0.5 -align "left" -font "boldLabelFont" -label " Set Doors and Hood/Trunk options before pressing the Rig Vehicle Button";
		text -height 5 -bgc 1 0.5 0.5 -label " ";
