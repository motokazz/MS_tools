		textField -height 25 -text "BodyWork_GrpN_1" "VehicleBodyShellTxField";
		button -bgc 0.7 1 0.7 -label  "BodyShell   >>" -height 20
			-command "$TempSel = `ls - sl`; $DVYVehicleList[3] = $TempSel[0]; textField -edit -text $TempSel VehicleBodyShellTxField;";	
	
	setParent $Tab01;
		
//***********************************************************************************	
// Create a collapsible frame layout for Vehicle type Radio Button Collection.
	
		string $SetupVehTypeFrame = `frameLayout -borderStyle "etchedOut" -collapsable true -collapse true
												 -label "  Vehicle Type Section (Not available yet)"` ;
		
// Define the layout for the controls for the Vehicle type Radio Button Collection.
		string $SetupVehTypeColumn = `columnLayout -adjustableColumn true -cat "both" 1 "SetupVehTypeColumn"`;		

		
// Title Section for Vehicle Type Selection.
		separator -height 5 ;
		text -bgc 1 1 .85 -height 5 -label "" ;	//Space
		text -bgc 1 1 .85 -align "left" -label "    Please Select the Vehicle Type. If you are Unsure of the type or style of the Vehicle please to see Help Section for more Info.";
		text -bgc 1 1 .85 -height 5 -label "" ;	//Spacer
		separator -height 5 -style "double";
		text -height 5 -label "" ;	//Spacer
		
		setParent.. ;
	setParent.. ;	
			
//***********************************************************************************	
		
	setParent $Tab01 ;
//***********************************************************************************	
//	Vehicle Type Radio button selection Group
//	This will set various selection options on each tab.
		
// Create a Non collapsible frame layout for Vehicle type Radio Button Collection.
	
	string $SetupVehTypeFrameC = `frameLayout -collapsable false -label "  Vehicle Type Section" -labelVisible false` ;

// Define the layout for the controls for the Vehicle type Radio Button Collection.

	string $SetupVehTypeColumnC = `columnLayout -adjustableColumn true -cat "both" 1 "SetupVehTypeColumnC"`;		
	
	text -height 5 -label "" ;	//Spacer			
		
// Radio Collection Group
	
	string $VehicleTypeRadioCol = `radioButtonGrp -enable false -numberOfRadioButtons 4
		 		-label "Vehicle Type :-" -cal 1 "right" 
				-columnWidth5 90 100 90 80 110
				-labelArray4 "Car" "Truck only"  "Trailer" "Truck + Trailer"`;

		text -height 2 -label "" ;	//Spacer

		radioButtonGrp -numberOfRadioButtons 4 -enable false -shareCollection $VehicleTypeRadioCol
			 		-label "" -cal 1 "left" 
					-columnWidth5 90 100 90 80 110
					-labelArray4  "Steerable Trailer" "Bike" "Trike" "Unicycle" ;
		
		text -height 2 -label "" ;	//Spacer	

		radioButtonGrp -numberOfRadioButtons 4 -enable false -shareCollection $VehicleTypeRadioCol
			 		-label "" -cal 1 "left" 
					-columnWidth5 90 100 90 80 110
					-labelArray4 "Half Tracked"  "Full Tracked" "Other"	"????"  
			"VehicleTypeRadioButtons";
			
// End of Radio Collection Group
		
	text  -height 2 -label "";		// Spacer		
			
// End of Vehicle Type Selection Frame
			
	setParent $Tab01 ;
			
//***********************************************************************************	
		
	setParent $Tabs;
	
//++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
//	
//							Start of Wheels Tab
//
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++			
	
	global string $WheelsFrame, $WheelsFrontFrame, $WheelsRearFrame, $WheelsFrameC, $WheelsInfoFrameC, $WheelsFrontFrameC, $WheelsRearFrameC;

	$Tab02 = `columnLayout -enable true -adjustableColumn true -cat "both" 5 "Wheels"`;	
	
//***********************************************************************************	
		
//***********************************************************************************	
// Wheels CheckBox Section to enable the Wheels Tab.
	
	checkBox -label "Enable Wheels Section" -align "left" 
		-onCommand 
					"checkBoxGrp -edit -enable true WheelsOptionsCheck; frameLayout -edit -collapse true $WheelsInfoFrameC; frameLayout -edit -collapse true $WheelsFrontFrameC; frameLayout -edit -collapse true $WheelsRearFrameC;"
			
		-offCommand	
					"frameLayout -edit -enable false -vis false -collapse false $WheelsFrontFrame; frameLayout -edit -enable false -vis false -collapse false $WheelsRearFrame; checkBoxGrp -edit -value1 false WheelsOptionsCheck; checkBoxGrp -edit -value2 false WheelsOptionsCheck; checkBoxGrp -edit -enable false WheelsOptionsCheck; frameLayout -edit -collapse false $WheelsInfoFrameC; frameLayout -edit -collapse false $WheelsFrontFrameC; frameLayout -edit -collapse false $WheelsRearFrameC;"
			WheelsEnableCheck;						  

	// End of Wheels "Checkbox" Section. If not selected then no Door Options will be setup.
		
//***********************************************************************************	
			
	// Wheels Options "CheckBox Section Section to enable front and rear Wheels and the type of opening required.	
		checkBoxGrp -numberOfCheckBoxes 2 -labelArray2 "Front Wheels" "Rear Wheels" 
					-label "Wheels Options Buttons" 
					-enable1 false -enable2 false 
					-cw 1 130 -cal 1 "right" -cw 2 110 -cw 3 110 
					
				-onCommand1 "frameLayout -edit -enable true -vis true -collapse false $WheelsFrontFrame;"
				-onCommand2 "frameLayout -edit -enable true -vis true -collapse false $WheelsRearFrame;"
				
				-offCommand1 "frameLayout -edit -enable false -vis false -collapse false $WheelsFrontFrame;"
				-offCommand2 "frameLayout -edit -enable false -vis false -collapse false $WheelsRearFrame;"
			WheelsOptionsCheck;
	
	setParent..;	
	setParent $Tab02;
	
// End of Wheels Options "Checkbox" Sectin. If not selected then no Wheels Options will be setup.


//***********************************************************************************	
// Create a collapsible frame layout for Wheels Info Section.
	$WheelsInfoFrameC = `frameLayout -borderStyle "etchedOut" -enable true -vis true -collapsable true -collapse false -label "  Wheels Info"` ;
				
// Define the layout of controls added to the Wheels Info Frame.
	string $WheelsInfoColumnC = `columnLayout -cat "both" 5 -cal "center" -adjustableColumn true "WheelInfo:"`;

		separator -bgc 1 1 0.85 -h 10 -style "double";
		text -height 5 -bgc 1 0.5 0.5 -label " ";
		text -height 20 -bgc 1 0.5 0.5 -font "boldLabelFont" -align "left" 
			-label " This Tab is not activated if the Wheels Checkbox has not been selected on the Setup Tab:";
		separator -bgc 1 1 0.85 -h 10 -style "double";
		text -height 40 -bgc 1 1 0.85 -align "left" 
			-label " This section will set up both Suspension and rotation for the Front and Rear Wheels. Also the scripts will set up steering\n for both Axle sets. The steering will default to Front steering only but this can be swapped to Rear only or Rear can be\n activated also. (See Help files for more info):";
		text -height 5 -bgc 1 1 0.85 -label " ";
		separator -h 10 -style "double";
		
	setParent $Tab02;

		
//***********************************************************************************	
	// Create a collapsible frame layout
		string $WheelsFrontFrameC = `frameLayout -borderStyle "etchedIn" -label "  Front Wheels Help Section"
									-vis true -labelVisible true -enable true
									-collapsable true -collapse false`;
	
	// Define the layout of controls added to the window.
		string $WheelsFrontColumnC = `columnLayout -cat "both" 5 -cal "center" -adjustableColumn true "FrontWheelInfo:"`;

		separator -h 10 -style "double";
		text -height 5 -bgc 1 1 0.85 -label " ";
		text -height 40 -bgc 1 1 0.85 -align "left" 
			-label " Select the Group node for each Wheel in turn.\n Then set the number of axles for the Front Wheels.\n Setting to Zero will force scripts to only set up other Wheel Groups:";
		text -height 5 -bgc 1 1 0.85 -label " ";
		separator -h 10 -style "double";
		
	setParent $Tab02;
	
	// Create a Non Collapsible frame for the Front Wheels Section.
	string $WheelsFrontFrame = `frameLayout -labelVisible false -label "  Front Wheels Section"
										 		-vis false -enable false -collapsable false` ;
		
		rowColumnLayout -nc 1 -cw 1 610 
						-cat 1 "both" 10 -cal 1 "center" "FrontWheelRig";	
		
		text -height 2 " ";
		separator -h 10 -style "double";

// Int Slider Group for Front Axle count
		
		intSliderGrp -cal 1 "right" -cal 2 "center" -cal 3 "right"
					-adjustableColumn 3
					-columnWidth3 110 50 150
					-label "No. of Front Axles :-" 
					-field true
					-minValue 0 
					-maxValue 10
					-step 1
					-value 1
				FrontAxleSlider;
		
		separator -h 10 -style "double";
		text -height 2 " ";
			
		rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 50 -cal 1 "center" "VehicleList1";	

			textField -height 25 -text "LfFr_Wheel_Grp_1" "LfFr_WheelTxField";
			text -height 2 " ";
			button -bgc 0.7 1 0.7 -label "Left Front Wheel Group >>" -height 20
				-command "$TempSel = `ls - sl`; $DVYVehicleList[4] = $TempSel[0]; textField -edit -text $TempSel LfFr_WheelTxField;";	
			text -height 2 " ";
			
			textField -height 25 -text "RtFr_Wheel_Grp_1" "RtFr_WheelTxField";
			text -height 2 " ";
			button -bgc 0.7 1 0.7 -label "Right Front Wheel Group >>" -height 20
				-command "$TempSel = `ls - sl`; $DVYVehicleList[5] = $TempSel[0]; textField -edit -text $TempSel RtFr_WheelTxField;";	
			text -height 2 " ";
		
	setParent $Tab02;

//***********************************************************************************	
// Create a collapsible frame layout
	
	string $WheelsRearFrameC = `frameLayout -borderStyle "etchedOut" -label "  Rear Wheels Help Section"
									-vis true -labelVisible true -enable true -collapsable true -collapse false`;
	
// Define the layout of controls added to the window.
	
	string $WheelsRearColumnC = `columnLayout -cat "both" 5 -cal "center" -adjustableColumn true "RearWheelInfo:"`;

		separator -h 10 -style "double";
		text -height 5 -bgc 1 1 0.85 -label " ";
		text -height 40 -bgc 1 1 0.85 -align "left" 
			-label " Select the Group node for each Wheel in turn.\n Then set the number of axles for the Rear Wheels.\n Setting to Zero will force scripts to only set up other Wheel Groups:";
		text -height 5 -bgc 1 1 0.85 -label " ";
		separator -h 10 -style "double";
		
	setParent $Tab02;
		
	// Create a Non Collapsible frame for the Rear Wheels Section.
	string $WheelsRearFrame = `frameLayout -labelVisible false -label "Rear Wheels Section" -vis false -enable false -collapsable false` ;

	string $WheelsRearColumn = `rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 10 -cal 1 "center" "RearWheelRig"`;	
		
		text -height 2 " ";
		separator -h 10 -style "double";

		intSliderGrp -cal 1 "right" -cal 2 "center" -cal 3 "right"
					-adjustableColumn 3
					-columnWidth3 110 50 150
					-label "No. of Rear Axles :-" 
					-field true
					-minValue 0 
					-maxValue 10
					-step 1
					-value 1
				RearAxleSlider;
			
			separator -h 10 -style "double";
			text -height 2 " ";
	
		rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 50 -cal 1 "center" "VehicleList2";	

			textField -height 25 -text "LfRr_Wheel_Grp_1" "LfRr_WheelTxField";
			text -height 2 " ";
			button -bgc 0.7 1 0.7 -label "Left Rear Wheel Group >>" -height 20
				-command "$TempSel = `ls - sl`; $DVYVehicleList[6] = $TempSel[0]; textField -edit -text $TempSel LfRr_WheelTxField;";	
			text -height 2 " ";
		
			textField -height 25 -text "RtRr_Wheel_Grp_1" "RtRr_WheelTxField";
			text -height 2 " ";
			button -bgc 0.7 1 0.7 -label "Right Rear Wheel Group >>" -height 20
				-command "$TempSel = `ls - sl`; $DVYVehicleList[7] = $TempSel[0]; textField -edit -text $TempSel RtRr_WheelTxField;";	
			text -height 2 " ";
		
		setParent $Tab02;
	setParent $Tabs;	
	
//++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
//	
//							Start of Front and Rear Door Tab
//
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++			
	global string $DoorsInfoFrameC, $DoorsFrontFrameC, $DoorsRearFrameC, $DoorsFrontFrame, $DoorsRearFrame;
		
		
	$Tab03 = `columnLayout -enable false -adjustableColumn true -cat "both" 1 "Doors"`;	
//***********************************************************************************	
		
//***********************************************************************************	
// Doors CheckBox Section to enable the Doors Tab.
	
	checkBox -label "Enable Doors Section" -align "left" 
		-onCommand 
				"checkBoxGrp -edit -enable true DoorsOptionsCheck; frameLayout -edit -collapse true $DoorsFrontFrameC; frameLayout -edit -collapse true $DoorsRearFrameC; frameLayout -edit -collapse true $DoorsInfoFrameC; checkBoxGrp -edit -enable3 false DoorsOptionsCheck; checkBoxGrp -edit -enable4 false DoorsOptionsCheck;"
			
		-offCommand	
				"frameLayout -edit -enable false -vis false -collapse false $DoorsFrontFrame; frameLayout -edit -enable false -vis false -collapse false $DoorsRearFrame; frameLayout -edit -collapse false $DoorsInfoFrameC; checkBoxGrp -edit -value1 false DoorsOptionsCheck; checkBoxGrp -edit -value2 false DoorsOptionsCheck; checkBoxGrp -edit -value3 false DoorsOptionsCheck; checkBoxGrp -edit -value4 false DoorsOptionsCheck; checkBoxGrp -edit -enable false DoorsOptionsCheck; frameLayout -edit -collapse false $DoorsFrontFrameC; frameLayout -edit -collapse false $DoorsRearFrameC;"
			DoorsEnableCheck;						  

	// End of Doors "Checkbox" Section. If not selected then no Door Options will be setup.
//***********************************************************************************	
			
	// Doors Options "CheckBox Section Section to enable front and rear Doors and the type of opening required.	
		checkBoxGrp -numberOfCheckBoxes 4 -labelArray4 "Front Doors" "Rear Doors" "Front Windows" "Rear Windows"
					-label "Doors Options Buttons" 
					-enable1 false -enable2 false -enable3 false -enable4 false 
					-cw 1 130 -cal 1 "right"
					-cw 2 130 -cal 2 "left"
					-cw 3 130 -cal 3 "left"
					-cw 4 130 -cal 4 "left"
					
				-onCommand1 "frameLayout -edit -enable true -vis true -collapse false $DoorsFrontFrame; textField -edit -enable false -vis false LfFr_WindowTxField; textField -edit -enable false -vis false RtFr_WindowTxField; button -edit -enable false -vis false LfFr_WindowButton; button -edit -enable false -vis false RtFr_WindowButton; checkBoxGrp -edit -enable3 true DoorsOptionsCheck; checkBoxGrp -edit -value3 false DoorsOptionsCheck;"
				
				-onCommand2 "frameLayout -edit -enable true -vis true -collapse false $DoorsRearFrame; textField -edit -enable false -vis false LfRr_WindowTxField; textField -edit -enable false -vis false RtRr_WindowTxField; button -edit -enable false -vis false LfRr_WindowButton; button -edit -enable false -vis false RtRr_WindowButton; checkBoxGrp -edit -enable4 true DoorsOptionsCheck; checkBoxGrp -edit -value4 false DoorsOptionsCheck;"

				-onCommand3 "textField -edit -enable true -vis true LfFr_WindowTxField; textField -edit -enable true -vis true RtFr_WindowTxField; button -edit -enable true -vis true LfFr_WindowButton; button -edit -enable true -vis true RtFr_WindowButton;"
							 
				-onCommand4 "textField -edit -enable true -vis true LfRr_WindowTxField; textField -edit -enable true -vis true RtRr_WindowTxField; button -edit -enable true -vis true LfRr_WindowButton; button -edit -enable true -vis true RtRr_WindowButton;"
				
				-offCommand1 "frameLayout -edit -enable false -vis false -collapse false $DoorsFrontFrame; textField -edit -enable false -vis false LfFr_WindowTxField; textField -edit -enable false -vis false RtFr_WindowTxField; button -edit -enable false -vis false LfFr_WindowButton; button -edit -enable false -vis false RtFr_WindowButton; checkBoxGrp -edit -value3 false -enable3 false DoorsOptionsCheck;"
							  
				-offCommand2 "frameLayout -edit -enable false -vis false -collapse false $DoorsRearFrame; textField -edit -enable false -vis false LfRr_WindowTxField; textField -edit -enable false -vis false RtRr_WindowTxField; button -edit -enable false -vis false LfRr_WindowButton; button -edit -enable false -vis false RtRr_WindowButton; checkBoxGrp -edit -value4 false -enable4 false DoorsOptionsCheck;"
							  
				-offCommand3 "textField -edit -enable false -vis false LfFr_WindowTxField; textField -edit -enable false -vis false RtFr_WindowTxField; button -edit -enable false -vis false LfFr_WindowButton; button -edit -enable false -vis false RtFr_WindowButton;"
							  
				-offCommand4 "textField -edit -enable false -vis false LfRr_WindowTxField; textField -edit -enable false -vis false RtRr_WindowTxField; button -edit -enable false -vis false LfRr_WindowButton; button -edit -enable false -vis false RtRr_WindowButton;"
			DoorsOptionsCheck;
	
	setParent $Tab03;
	
// End of Doors Options "Checkbox" Sectin. If not selected then no Doors Options will be setup.
	
//***********************************************************************************	
// Create a collapsible frame layout for Doors Info Section.
	$DoorsInfoFrameC = `frameLayout -borderStyle "etchedOut" -enable true -vis true -collapsable true -collapse false -label "  Doors Info"` ;
				
// Define the layout of controls added to the Doors Info Frame.
	string $DoorsInfoColumnC = `columnLayout -cat "both" 5 -cal "center" -adjustableColumn true "DoorsInfo:"`;

		separator -bgc 1 1 0.85 -h 5 -style "double";
		text -height 5 -bgc 1 0.5 0.5 -label " ";
		text -height 17 -bgc 1 0.5 0.5 -font "boldLabelFont" -align "left" 
			-label " This Tab is not activated if the Doors Checkbox has not been selected on the Setup Tab:";
		separator -bgc 1 1 0.85 -h 8 -style "double";
		text -height 25 -bgc 1 1 0.85 -align "left" 
			-label " This section will set up both Front and Rear Door Hinged opening and also `sliding` opening windows. The Scripts will install\n controllers for each item to be set up and generate Spheres to be positioned for hinge positions etc. (See Help files for more info):";
		separator -h 10 -bgc 1 1 0.85 -style "double";
		text -height 15 -bgc 1 0.5 0.5 -align "left" -font "boldLabelFont"
			-label	" Once all fields have been loaded then press the `Set Hinge and Handle Button` to load the Spheres.";
		text -height 15 -bgc 1 0.5 0.5 -align "left" -font "boldLabelFont"
			-label	" If wrong Hinge Location/orientation is chosen please undo this step and reset correct hinge positions\n before proceding. This is to ensure Joint Orientations are correctly set.";
		text -height 15 -bgc 1 0.5 0.5 -align "left" -font "boldLabelFont"
			-label	" Note:- Position and Angle adjustment is allowed but not `swapping` over of spheres etc. ";
		text -height 2 -bgc 1 0.5 0.5 -label " ";
		separator -h 5 -style "double";
		
	setParent $Tab03;
		
		
//***********************************************************************************	
// Create a collapsible frame layout
	$DoorsFrontFrameC = `frameLayout -borderStyle "etchedIn" -label "  Front Doors Help Section"
									 -labelVisible true -enable true -collapsable true `;
	
// Define the layout of controls added to the window.
		
	string $DoorsFrontColumnC = `columnLayout -cat "both" 5 -cal "center" -adjustableColumn true "FrontDoorInfo:"`;

		separator -h 5 -style "double";
		text -height 3 -bgc 1 1 0.85 -label " ";
		text -height 53 -bgc 1 1 0.85 -align "left" 
			-label " Select the Radio Button for each door hinge position. Select the Group node for each Door Group Node in turn and Press\n button to load item. Once all fields have been loaded then press the `Set Hinge and Handle Button` to load the Spheres\n used to set the Hinge etc positions. Set the Blue sphere to exact hinge position, then set handle position.\n Also the hinge angle can be set by rotating the Blue Sphere.";
		text -height 40 -bgc 1 1 0.85 -align "left" 
			-label " If Window Operation is required then select each window in turn and press the Button to load the item. Then set the\n Green Sphere for the bottom of the window and the yellow for the Top. Also the Green Sphere can be rotated to adjust\n the slide angle of the window:";
		text -height 2 -bgc 1 1 0.85 -label " ";
		separator -h 5 -style "double";
		
	setParent $Tab03;
		
// Row Setup for the Front Door Hinge Positions.

// Create a Non Collapsible frame for the Rear Doors Section.

	string $DoorsFrontFrame = `frameLayout -labelVisible false -label "Front Doors Section" -vis false -enable false -collapsable false` ;

	string $DoorsFrontColumn = `rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 10 -cal 1 "center" "FrontDoorRig"`;	

		text -height 5 -label " ";

// Front Door Hinge Radio Button Group	
		
		radioButtonGrp 	-columnWidth5 150 100 100 100 100
				-cal 1 "left" 
				-numberOfRadioButtons 4 
				-label " Front Door Hinge Position:-" 
				-select 1
				-labelArray4 "Front" "Rear" "Top" "Bottom"
			FrDoorRadioButtons;	

	rowColumnLayout -nc 2 -cw 1 300 -cat 1 "both" 10 -cal 1 "center" -cw 2 300 -cat 2 "both" 10 -cal 2 "center" ;
		
		textField -height 25 -text "LfFr_Door_GrpN_1" "LfFr_DoorTxField";
		textField -enable false -vis false -height 25 -text "LfFr_Window_1" "LfFr_WindowTxField";
		
		button -bgc 0.7 1 0.7 -label "Left Front Door Group >>" -height 20
			-command "$TempSel = `ls - sl`; $DVYVehicleList[8] = $TempSel[0]; textField -edit -text $TempSel LfFr_DoorTxField;";	
		button -enable false -vis false -bgc 0.7 1 0.7 -label "Left Front Window >>" -height 20
			-command "$TempSel = `ls - sl`; $DVYVehicleList[9] = $TempSel[0]; textField -edit -text $TempSel LfFr_WindowTxField;"
			LfFr_WindowButton;	

		textField -height 25 -text "RtFr_Door_GrpN_1" "RtFr_DoorTxField";
		textField -enable false -vis false -height 25 -text "RtFr_Window_1" "RtFr_WindowTxField";

		button -bgc 0.7 1 0.7 -label "Right Front Door Group >>" -height 20
			-command "$TempSel = `ls - sl`; $DVYVehicleList[10] = $TempSel[0]; textField -edit -text $TempSel LfFr_DoorTxField;";	
		button -enable false -vis false -bgc 0.7 1 0.7 -label "Right Front Window >>" -height 20
			-command "$TempSel = `ls - sl`; $DVYVehicleList[11] = $TempSel[0]; textField -edit -text $TempSel RtFr_WindowTxField;"
			RtFr_WindowButton;	
		
	setParent $Tab03;
		
//***********************************************************************************	
// Create a collapsible frame layout
		string $DoorsRearFrameC = `frameLayout -borderStyle "etchedIn" -label "  Rear Doors Help Section"
									-vis true -labelVisible true -enable true -collapsable true -collapse false`;
	
// Define the layout of controls added to the window.
		string $DoorsRearColumnC = `columnLayout -cat "both" 5 -cal "center" -adjustableColumn true "RearDoorInfo:"`;

		separator -h 5 -style "double";
		text -height 3 -bgc 1 1 0.85 -label " ";
		text -height 53 -bgc 1 1 0.85 -align "left" 
			-label " Select the Radio Button for each door hinge position. Select the Group node for each Door Group Node in turn and Press\n button to load item. Once all fields have been loaded then press the `Set Hinge and Handle Button` to load the Spheres\n used to set the Hinge etc positions. Set the Blue sphere to exact hinge position, then set handle position.\n Also the hinge angle can be set by rotating the Blue Sphere.";
		text -height 40 -bgc 1 1 0.85 -align "left" 
			-label " If Window Operation is required then select each window in turn and press the Button to load the item. Then set the\n Green Sphere for the bottom of the window and the yellow for the Top. Also the Green Sphere can be rotated to adjust\n the slide angle of the window:";
		separator -h 5 -style "double";
		
	setParent $Tab03;
	
//***********************************************************************************	
// Create a Non Collapsible frame for the Rear Doors Section.
	
	string $DoorsRearFrame = `frameLayout -labelVisible false -vis false -enable false -collapsable false
										  -label "Rear Doors Section"` ;

	string $DoorsRearColumn = `rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 10 -cal 1 "center" "RearDoorRig"`;	
		
		text -height 5 -label " ";
	
// Rear Door Hinge Radio Button Group	
	
		radioButtonGrp 	-columnWidth5 150  100 100 100 100
				-cal 1 "left" 
				-numberOfRadioButtons 4 
				-label " Rear Door Hinge Position:-" 
				-select 1
				-labelArray4 "Front" "Rear" "Top" "Bottom"
			RrDoorRadioButtons;	

		
// End of Rear Doors Radio Button Group	
//***********************************************************************************	
		
	rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 10 -cal 1 "center" "VehicleBody3";	
		text -height 5 -label " ";
		
	rowColumnLayout -nc 2 -cw 1 300 -cat 1 "both" 10 -cal 1 "center" -cw 2 300 -cat 2 "both" 10 -cal 2 "center" ;
		
		textField -height 25 -text "LfRr_Door_GrpN_1" "LfRr_DoorTxField";
		textField -enable false -vis false -height 25 -text "LfRr_Window_1" "LfRr_WindowTxField";
		
		button -bgc 0.7 1 0.7 -label "Left Rear Door Group >>" -height 20
			-command "$TempSel = `ls - sl`; $DVYVehicleList[12] = $TempSel[0]; textField -edit -text $TempSel LfRr_DoorTxField;";	
		button  -enable false -vis false -bgc 0.7 1 0.7 -label "Left Rear Window >>" -height 20
			-command "$TempSel = `ls - sl`; $DVYVehicleList[13] = $TempSel[0]; textField -edit -text $TempSel LfRr_WindowTxField;"
			LfRr_WindowButton;	

		textField -height 25 -text "RtRr_Door_GrpN_1" "RtRr_DoorTxField";
		textField  -enable false -vis false -height 25 -text "RtRr_Window_1" "RtRr_WindowTxField";

		button -bgc 0.7 1 0.7 -label "Right Rear Door Group >>" -height 20
			-command "$TempSel = `ls - sl`; $DVYVehicleList[14] = $TempSel[0]; textField -edit -text $TempSel LfRr_DoorTxField;";	
		button  -enable false -vis false -bgc 0.7 1 0.7 -label "Right Rear Window >>" -height 20
			-command "$TempSel = `ls - sl`; $DVYVehicleList[15] = $TempSel[0]; textField -edit -text $TempSel RtRr_WindowTxField;"
			RtRr_WindowButton;	

		setParent..;
	setParent $Tab03;
	
		separator -h 10 -style "double";
		
	rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 50 -cal 1 "center" "VehicleBody4";	
		
		text -height 2 " ";
		button -height 25 -bgc 1.0 0.8 0.0 -label "Set Door Hinge, Handle and Window Positions"
			-command "DVY_Doors;"
				DoorButton;	

	setParent $Tabs;	
	
//++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
//	
//							Start of Front Hood and Rear Trunk Tab
//
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++			
	
	global string $HoodsInfoFrameC, $HoodsFrontFrameC, $HoodsRearFrameC, $HoodsFrontFrame, $HoodsRearFrame;
	global string $TrunkRearFrame, $TailRearFrame, $SplitTailRearFrame, $RearTailDoorsFrame;
		 
	$Tab04 = `columnLayout -enable false -adjustableColumn true -cat "both" 1 "Hood and Trunk"`;	
	
//***********************************************************************************	
// Hood and Trunk/Tailgate  CheckBox Section to enable the Hood and Trunk Tab.
	
	checkBox -label "Enable Hoods Section" -align "left" 
		-onCommand "checkBoxGrp -edit -enable true HoodsOptionsCheck; frameLayout -edit -collapse true $HoodsInfoFrameC; frameLayout -edit -collapse true $HoodsFrontFrameC; frameLayout -edit -collapse true $HoodsRearFrameC;"
			
		-offCommand	"frameLayout -edit -enable false -vis false -collapse false $HoodsFrontFrame; frameLayout -edit -enable false -vis false -collapse false $TrunkRearFrame; checkBoxGrp -edit -value1 false HoodsOptionsCheck; checkBoxGrp -edit -value2 false HoodsOptionsCheck; checkBoxGrp -edit -value3 false HoodsOptionsCheck; checkBoxGrp -edit -value4 false HoodsOptionsCheck; checkBoxGrp -edit -enable false HoodsOptionsCheck; frameLayout -edit -collapse false $HoodsInfoFrameC; frameLayout -edit -collapse false $HoodsFrontFrameC; frameLayout -edit -collapse false $HoodsRearFrameC;"
			HoodsEnableCheck;						  

// End of Hoods "Checkbox" Section. If not selected then no Hood Options will be setup.
		
//***********************************************************************************	
// Hoods Options "CheckBox Section Section to enable Rear Trunk and the type of opening required.	
	
		checkBoxGrp -numberOfCheckBoxes 4 -label "Hood and Trunk Options Buttons:" 
					-labelArray4 "Front Hood" "Rear Trunk" "Rear Tailgate" "Split Tailgate or Rear Doors"
					-enable1 false -enable2 false -enable3 false -enable4 false 
					-cw 1 180 -cal 1 "right"
					-cw 2 80 -cal 2 "left"
					-cw 3 80 -cal 3 "left" 
					-cw 4 90 -cal 4 "left"
					-cw 5 150 -cal 5 "left"
					
				-onCommand1 "frameLayout -edit -enable true -vis true -collapse false $HoodsFrontFrame;"
				
				-onCommand2 "frameLayout -edit -enable true -vis true $TrunkRearFrame; checkBoxGrp -edit -value3 false -enable3 false HoodsOptionsCheck; checkBoxGrp -edit -value4 false -enable4 false HoodsOptionsCheck;"
  //						 checkBox -edit -value false SplitTailWindowEnableCheck;"

				-onCommand3 "frameLayout -edit -enable true -vis true $TailRearFrame; checkBoxGrp -edit -value2 false -enable2 false HoodsOptionsCheck; checkBoxGrp -edit -value4 false -enable4 false HoodsOptionsCheck;"
  //						 checkBox -edit -enable true -value false SplitTailWindowEnableCheck;"
							 
				-onCommand4 "frameLayout -edit -enable true -vis true $SplitTailRearFrame; textField -edit -enable false -vis false Rr_TailWinTxField; checkBoxGrp -edit -value2 false -enable2 false HoodsOptionsCheck; checkBoxGrp -edit -value3 false -enable3 false HoodsOptionsCheck; checkBox -edit -enable true -value false SplitTailWindowEnableCheck;"
//							 button -edit -enable false -vis false Rr_TailWindowButton;"
							 
				-offCommand1 "frameLayout -edit -enable false -vis false -collapse false $HoodsFrontFrame; textField -edit -enable false -vis false LfFr_WindowTxField; textField -edit -enable false -vis false RtFr_WindowTxField; checkBoxGrp -edit -value3 false HoodsOptionsCheck; checkBox -edit -value false -enable false SplitTailWindowEnableCheck; checkBox -edit -value false -enable false TailWindowEnableCheck;"
							  
				-offCommand2 "frameLayout -edit -enable false -vis false $TrunkRearFrame; checkBoxGrp -edit -enable3 true HoodsOptionsCheck; checkBoxGrp -edit -enable4 true HoodsOptionsCheck; checkBox -edit -value false -enable false SplitTailWindowEnableCheck; checkBox -edit -value false -enable false TailWindowEnableCheck;"
							  
				-offCommand3 "frameLayout -edit -enable false -vis false $TailRearFrame; checkBoxGrp -edit -enable2 true HoodsOptionsCheck; checkBoxGrp -edit -enable4 true HoodsOptionsCheck; checkBox -edit -value false -enable false SplitTailWindowEnableCheck; checkBox -edit -value false -enable false TailWindowEnableCheck; textField -edit -enable false -vis false Rr_TailWinTxField; button -edit -enable false -vis false Rr_TailWindowButton;"
							  
				-offCommand4 "frameLayout -edit -enable false -vis false $SplitTailRearFrame; checkBoxGrp -edit -enable2 true HoodsOptionsCheck; checkBoxGrp -edit -enable3 true HoodsOptionsCheck; checkBox -edit -value false -enable false SplitTailWindowEnableCheck; checkBox -edit -value false -enable false TailWindowEnableCheck; textField -edit -enable false -vis false Rr_TailWinTxField; button -edit -enable false -vis false Rr_TailWindowButton;"
				HoodsOptionsCheck;
	
	setParent $Tab04;
	
// End of Hoods Options "Checkbox" Sectin. If not selected then no Hoods Options will be setup.
//***********************************************************************************	
// Create a collapsible frame layout for Doors Info Section.
	$HoodsInfoFrameC = `frameLayout -borderStyle "etchedOut" -enable true -vis true -collapsable true -collapse false -label "  Front Hood, Trunk, Tailgate and Rear Doors Info"` ;
				
// Define the layout of controls added to the Doors Info Frame.
	string $HoodsInfoColumnC = `columnLayout -cat "both" 5 -cal "center" -adjustableColumn true "HoodsInfo:"`;

		separator -bgc 1 1 0.85 -h 5 -style "double";
		text -height 5 -bgc 1 0.5 0.5 -label " ";
		text -height 17 -bgc 1 0.5 0.5 -font "boldLabelFont" -align "left" 
			-label " This Tab is not activated if the Hood and Trunk Checkbox has not been selected on the Setup Tab:";
		separator -bgc 1 1 0.85 -h 8 -style "double";
		text -height 15 -bgc 1 1 0.85 -align "left" 
			-label " This section will set up both Front Hood and Rear Trunk, Tailaget or Split Rear Doors hinged opening and also `sliding` opening";
		text -height 15 -bgc 1 1 0.85 -align "left" 
			-label " windows (where required). The Scripts will install controllers for each item to be set up and generate Spheres to be positioned ";
		text -height 15 -bgc 1 1 0.85 -align "left" 
			-label " for hinge positions etc. (See Help files for more info):";
		text -height 5 -bgc 1 0.5 0.5 -align "left" -label " ";
		text -height 15 -bgc 1 0.5 0.5 -align "left" -font "boldLabelFont"
			-label	" Once all fields have been loaded then press the `Set Hinge and Handle Button` to load the Spheres.";
		text -height 15 -bgc 1 0.5 0.5 -align "left" -font "boldLabelFont"
			-label	" If wrong Hinge Location/orientation is chosen please undo this step and reset correct hinge positions\n before proceding. This is to ensure Joint Orientations are correctly set.";
		text -height 15 -bgc 1 0.5 0.5 -align "left" -font "boldLabelFont"
			-label	" Note:- Position and Angle adjustment is allowed but not `swapping` over of spheres etc. ";
		text -height 5 -bgc 1 0.5 0.5 -label " ";
		separator -h 5 -style "double";
		
	setParent $Tab04;
	
//***********************************************************************************	
// Create a collapsible frame layout
	$HoodsFrontFrameC = `frameLayout -borderStyle "etchedIn" -label "  Front Hood Help Section"
									 -labelVisible true -enable true -collapsable true `;
	
// Define the layout of controls added to the window.
		
	string $HoodsFrontColumnC = `columnLayout -cat "both" 5 -cal "center" -adjustableColumn true "FrontHoodInfo:"`;

		separator -bgc 1 1 0.85 -h 10 -style "double";
		text -height 55 -bgc 1 1 0.85 -align "left" 
			-label " Select the Radio Button for The Front Hood hinge position. Select the Group node for Front Hood Group Node in turn and Press\n button to load item. Once all fields have been loaded then press the `Set Hinge and Handle Button` to load the Spheres\n used to set the Hinge etc positions. Set the Blue sphere to exact hinge position, then set handle position.\n Also the hinge angle can be set by rotating the Blue Sphere.";
		text -height 2 -bgc 1 1 0.85 -label " ";
		separator -h 10 -style "double";
		
	setParent $Tab04;
		
//***********************************************************************************	
// Create a Non Collapsible frame for the Rear Hoods Section.

	string $HoodsFrontFrame = `frameLayout -labelVisible false -label "Front Hoods Section" -vis false -enable false -collapsable false` ;

	string $HoodsFrontColumn = `rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 10 -cal 1 "center" "FrontHoodRig"`;	

		text -height 2 -label " ";

// Front Hood Hinge Radio Button Group	
		
		radioButtonGrp 	-columnWidth5 150 100 100 100 100 -label " Front Hood Hinge Position:-" 
				-labelArray4 "Front" "Rear" "Left" "Right"
				-cal 1 "left" 
				-numberOfRadioButtons 4 
				-select 2
			FrHoodRadioButtons;	
		
		textField -height 20 -text "Fr_Hood_GrpN_1" "Fr_HoodTxField";
		text -height 2 " ";		text -height 2 " ";
		
		button -bgc 0.7 1 0.7 -label "Front Hood Group >>" -height 20
			-command "$TempSel = `ls - sl`; $GroupD_A[0] = $TempSel[0]; textField -edit -text $TempSel Fr_HoodTxField;";	
		
	setParent $Tab04;
		
//***********************************************************************************	
// Create a collapsible frame layout
	
	string $HoodsRearFrameC = `frameLayout -borderStyle "etchedIn" -vis true -labelVisible true -enable true -collapsable true
										   -collapse false -label "  Rear Trunk, Tailgate and Rear Doors Help Section"`;
	
// Define the layout of controls added to the window.
	
	string $HoodsRearColumnC = `columnLayout -cat "both" 5 -cal "center" -adjustableColumn true "RearHoodInfo:"`;

		separator -h 10 -style "double";
		text -height 5 -bgc 1 1 0.85 -label " ";
		text -height 15 -bgc 1 1 0.85 -align "left" 
			-label " Depending on CheckBox selected various fields will be shown. Also Radio Buttons will appear for various hinge positions etc.";
		text -height 15 -bgc 1 1 0.85 -align "left" 
			-label " If `Standard` Trunk Lid chosen select Radio Button for Hinge Positon and select item for field or use default field name.";
		text -height 15 -bgc 1 1 0.85 -align "left" 
			-label " If `Tailgate` style chosen then an option to set up a Window will also appear. Select item to load field etc.";
		text -height 15 -bgc 1 1 0.85 -align "left" 
			-label " If `Split Tailgate or Rear Doors` is chosen then various options (including Windows) will appear to set hinge etc. positions.";
		text -height 15 -bgc 1 1 0.85 -align "left"
			-label " If Window Operation is required then select window press the Button to load the item. Then set the Green Sphere for the bottom";
		text -height 18 -bgc 1 1 0.85 -align "left" 
			-label " of the window and the yellow for the Top. Also the Green Sphere can be rotated to adjust the slide angle of the window:";
		separator -h 10 -style "double";
		
	setParent $Tab04;
	
//***********************************************************************************			
// Create a Non Collapsible frame for the Rear Trunk Lid Section.
	
	string $TrunkRearFrame = `frameLayout -labelVisible false -label "Rear Trunk Section" -vis false -enable false -collapsable false` ;

	string $TrunkRearColumn = `rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 10 -cal 1 "center" "RearTrunkRig"`;	
		
		text -height 2 -label " ";
	
// Rear Hood Hinge Radio Button Group	
	
		radioButtonGrp 	-columnWidth5 150 80 80 80 80 -label " Rear Trunk Lid Hinge Position:-"
				-labelArray4 "Front" "Rear" "Left" "Right"
				-cal 1 "left" 
				-numberOfRadioButtons 4 
				-select 1
			RrHoodRadioButtons;	
		
// End of BodyShell Hood Radio Button Group	
//***********************************************************************************	
//	Rear Trunklid Section
		
	rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 10 -cal 1 "center" "Trunk1";	
		
		textField -height 20 -text "Rr_Trunk_GrpN_1" "Rr_TrunkTxField";

		button -bgc 0.7 1 0.7 -label "Rear Trunk Lid Group >>" -height 20
			-command "$TempSel = `ls - sl`; $DVYVehicleList[16] = $TempSel[0]; textField -edit -text $TempSel Rr_TrunkTxField;";	
		
		setParent..;
	setParent $Tab04;
	
//***********************************************************************************	
// Create a Non Collapsible frame for the Rear Tailgate Section.
	
	string $TailRearFrame = `frameLayout -labelVisible false -label "Rear Tail Section" -vis false -enable false -collapsable false` ;

	string $TailRearColumn = `rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 10 -cal 1 "center" "RearTailRig"`;	
		
// Tailgate Window CheckBox Section.
	
	checkBox -enable false -vis false -label "Enable Tailgate Window" -align "left" 
		-onCommand "textField -edit -enable true -vis true Rr_TailWinTxField; button -edit -enable true -vis true Rr_TailWindowButton;"
			
		-offCommand	"textField -edit -enable false -vis false Rr_TailWinTxField; button -edit -enable false -vis false Rr_TailWindowButton;"
			TailWindowEnableCheck;						  
	text -height 5 -label " ";

// End of Tailgate Window.
		
//***********************************************************************************	
// Rear Tailgate Hinge Radio Button Group	
	
	radioButtonGrp 	-columnWidth5 150 80 80 80 80 -label " Rear Tailgate Hinge Position:-" 
				-labelArray4 "Top" "Bottom" "Left" "Right"
				-cal 1 "left" 
				-numberOfRadioButtons 4 
				-select 1
			RrTailRadioButtons;	
		
// End of Rear Tailgate Hinge Radio Button Group	
//***********************************************************************************	
		
	rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 10 -cal 1 "center" "Tail1";	
		
		textField -height 20 -text "Rr_Tailgate_GrpN_1" "Rr_TailTxField";
		button -bgc 0.7 1 0.7 -label "Rear Tailgate Group >>" -height 20
			-command "$TempSel = `ls - sl`; $DVYVehicleList[17] = $TempSel[0]; textField -edit -text $TempSel Rr_TailTxField;";	
		
		textField -enable false -vis false -height 20 -text "Rr_TailgateWindow_1" "Rr_TailWinTxField";
		button -enable false -vis false -bgc 0.7 1 0.7 -label "Rear Tailgate Window >>" -height 20
			-command "$TempSel = `ls - sl`; $DVYVehicleList[18] = $TempSel[0]; textField -edit -text $TempSel Rr_TailWinTxField;"
			Rr_TailWindowButton;
		
		setParent..;
	setParent $Tab04;
	
//***********************************************************************************	
// Create a Non Collapsible frame for the Rear SplitTailgate Section.
	
	string $SplitTailRearFrame = `frameLayout -labelVisible false  -vis false -enable false -collapsable false
											  -label "Rear SplitTail Section"`;
	
	string $SplitTailRearColumn = `rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 10 -cal 1 "center" "RearSplitTailRig"`;	
		
		text -height 2 -label " ";
		
//***********************************************************************************	
// Rear Hood Hinge Radio Button Group	
	
	radioButtonGrp 	-columnWidth5 150 120 100 100 120 -label " SplitTailgate Hinge Position:-" 
					-labelArray4 "Top and Bottom" "Top and Left" "Top and Right" "Left and Right Doors"
					-cal 1 "left" 
					-numberOfRadioButtons 4 
			-onCommand1 "textField -edit -enable true -vis true Rr_TopTailTxField; textField -edit -enable true -vis true Rr_BotTailTxField; button -edit -enable true -vis true Rr_SplitTailTopButton; button -edit -enable true -vis true Rr_SplitTailBotButton;"
//						  checkBox -edit -enable true -vis true SplitTailWindowEnableCheck;"
						  
			-onCommand2 "textField -edit -enable true -vis true Rr_TopTailTxField; textField -edit -enable true -vis true Rr_BotTailTxField; button -edit -enable true -vis true Rr_SplitTailTopButton; button -edit -enable true -vis true Rr_SplitTailBotButton;"
// 						  checkBox -edit -enable true -vis true SplitTailWindowEnableCheck;"
						  
			-onCommand3 "textField -edit -enable true -vis true Rr_TopTailTxField; textField -edit -enable true -vis true Rr_BotTailTxField; button -edit -enable true -vis true Rr_SplitTailTopButton; button -edit -enable true -vis true Rr_SplitTailBotButton;"
//						  checkBox -edit -enable true -vis true SplitTailWindowEnableCheck;"
						  
			-onCommand4 "textField -edit -enable true -vis true LfRr_TailDoorTxField; textField -edit -enable true -vis true RtRr_TailDoorTxField; button -edit -enable true -vis true LfRr_TailDoorButton; button -edit -enable true -vis true RtRr_TailDoorButton;"
//						  checkBox -edit -enable false -vis false -value false SplitTailWindowEnableCheck;"
						  
			-offCommand1 "textField -edit -enable false -vis false Rr_TopTailTxField; textField -edit -enable false -vis false Rr_BotTailTxField; textField -edit -enable false -vis false Rr_SplitTailWinTxField; button -edit -enable false -vis false Rr_SplitTailWindowButton; button -edit -enable false -vis false Rr_SplitTailTopButton; button -edit -enable false -vis false Rr_SplitTailBotButton; checkBox -edit -enable false -value false SplitTailWindowEnableCheck;"
						  
			-offCommand2 "textField -edit -enable false -vis false Rr_TopTailTxField; textField -edit -enable false -vis false Rr_BotTailTxField; textField -edit -enable false -vis false Rr_SplitTailWinTxField; button -edit -enable false -vis false Rr_SplitTailWindowButton; button -edit -enable false -vis false Rr_SplitTailTopButton; button -edit -enable false -vis false Rr_SplitTailBotButton; checkBox -edit -enable false -value false SplitTailWindowEnableCheck;"
						  
			-offCommand3 "textField -edit -enable false -vis false Rr_TopTailTxField; textField -edit -enable false -vis false Rr_BotTailTxField; textField -edit -enable false -vis false Rr_SplitTailWinTxField; button -edit -enable false -vis false Rr_SplitTailWindowButton; button -edit -enable false -vis false Rr_SplitTailTopButton; button -edit -enable false -vis false Rr_SplitTailBotButton; checkBox -edit -enable false -value false SplitTailWindowEnableCheck;"
						  
			-offCommand4 "textField -edit -enable false -vis false LfRr_TailDoorTxField; textField -edit -enable false -vis false RtRr_TailDoorTxField; textField -edit -enable false -vis false Rr_SplitTailWinTxField; button -edit -enable false -vis false Rr_SplitTailWindowButton; button -edit -enable false -vis false LfRr_TailDoorButton; button -edit -enable false -vis false RtRr_TailDoorButton;"
						  
			RrSplitTailRadioButtons;	
		
// End of BodyShell Hood Radio Button Group	
//***********************************************************************************	
	
// Split Tailgate Window CheckBox Section.
	
	checkBox -enable false -vis false -label "Enable Tailgate Window" -align "left" 
