		-offCommand	"textField -edit -enable false -vis false Rr_SplitTailWinTxField; button -edit -enable false -vis false Rr_SplitTailWindowButton;"
			SplitTailWindowEnableCheck;		
	
	text -height 2 -label " ";

	// End of Tailgate Window.
//***********************************************************************************	
		
	rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 10 -cal 1 "center" "SplitTail1";	
		text -height 2 -label " ";
		
		textField -enable false -vis false -height 20 -text "Rr_TopTailgate_GrpN_1" "Rr_TopTailTxField";
		button -enable false -vis false -bgc 0.7 1 0.7 -label "Rear TopTailgate Group >>" -height 20
				-command "$TempSel = `ls - sl`; $DVYVehicleList[19] = $TempSel[0]; textField -edit -text $TempSel Rr_TopTailTxField;"
			Rr_SplitTailTopButton;
		
		textField -enable false -vis false -height 20 -text "Rr_TailgateWindow_1" "Rr_SplitTailWinTxField";
		button -enable false -vis false -bgc 0.7 1 0.7 -label "Rear Tailgate Window >>" -height 20
				-command "$TempSel = `ls - sl`; $DVYVehicleList[20] = $TempSel[0]; textField -edit -text $TempSel Rr_SplitTailWinTxField;"
			Rr_SplitTailWindowButton;
		
		textField -enable false -vis false -height 20 -text "LfRr_TailDoor_GrpN_1" "LfRr_TailDoorTxField";
		button -enable false -vis false -bgc 0.7 1 0.7 -label "Left Rear TailDoor Group >>" -height 20
				-command "$TempSel = `ls - sl`; $DVYVehicleList[21] = $TempSel[0]; textField -edit -text $TempSel LfRr_TailDoorTxField;"
			LfRr_TailDoorButton;
		
		textField -enable false -vis false -height 20 -text "Rr_BotTailgate_GrpN_1" "Rr_BotTailTxField";
		button -enable false -vis false -bgc 0.7 1 0.7 -label "Rear Bottom Tailgate Group >>" -height 20
				-command "$TempSel = `ls - sl`; $DVYVehicleList[22] = $TempSel[0]; textField -edit -text $TempSel Rr_BotTailTxField;"
			Rr_SplitTailBotButton;
		
		textField -enable false -vis false -height 20 -text "RtRr_TailDoor_GrpN_1" "RtRr_TailDoorTxField";
		button -enable false -vis false -bgc 0.7 1 0.7 -label "Right Rear TailDoor Group >>" -height 20
				-command "$TempSel = `ls - sl`; $DVYVehicleList[23] = $TempSel[0]; textField -edit -text $TempSel RtRr_TailDoorTxField;"
			RtRr_TailDoorButton;
		text -height 2 " ";
		
		setParent..;
	setParent $Tab04;
//***********************************************************************************	
	
	separator -h 10 -style "double";
	
	rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 50 -cal 1 "center" "VehicleBody5";
	
		text -height 2 " ";
		button -height 25 -bgc 0.0 1.0 0.7 -label "Set Hood and Trunk/Tailgate/Rear Doors Hinge, Handle and Window Positions"
			-command "DVY_HoodandTrunk;"
				HoodButton;	
		text -height 2 " ";

		
	setParent $Tabs ;

//---------------------------------------------------------------------------------------------
//	
//							End of Hood and Trunk Tab
//
//---------------------------------------------------------------------------------------------
	

//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
//	
//							Start Of Ancillaries Tab Layout
//
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
	
	
	// Start Of Initial Ancillaries Tab Layout..
	
	global string $AncillariesInfoFrameC;			global string $AncillariesInfoFrame;
	global string $AncillariesFrontWipersFrameC;	global string $AncillariesFrontWipersFrame;
	global string $AncillariesRearWipersFrameC;		global string $AncillariesRearWipersFrame;
	global string $AncillariesFrontSeatsFrameC;		global string $AncillariesFrontSeatsFrame;
	global string $AncillariesRearSeatsFrameC;		global string $AncillariesRearSeatsFrame;
	
	string $Tab05 = `columnLayout -adjustableColumn true -columnAttach "both" 1 "Ancillaries"`;		
		
	string $AncillariesRowLayout = `rowLayout -numberOfColumns 2
								-columnWidth 1 140 -columnAlign 1 "left" -columnAttach 1 "both" 1
								-columnWidth 2 420 -columnAlign 2 "left" -columnAttach 2 "both" 1
							"AncillariesRow"`;	
		
	checkBox -label "Enable Ancillary Section" -align "left" 
			-onCommand "checkBoxGrp -edit -enable true AncillariesOptionsCheck; frameLayout -edit -collapse true $AncillariesInfoFrameC; frameLayout -edit -collapse true $AncillariesFrontWipersFrameC; frameLayout -edit -collapse true $AncillariesRearWipersFrameC; frameLayout -edit -collapse true $AncillariesFrontSeatsFrameC; frameLayout -edit -collapse true $AncillariesRearSeatsFrameC;"
				
			-offCommand	"checkBoxGrp -edit -enable false AncillariesOptionsCheck; frameLayout -edit -collapse false $AncillariesInfoFrameC; frameLayout -edit -collapse false $AncillariesFrontWipersFrameC; frameLayout -edit -collapse false $AncillariesRearWipersFrameC; frameLayout -edit -collapse false $AncillariesFrontSeatsFrameC; frameLayout -edit -collapse false $AncillariesRearSeatsFrameC;"
		AncillariesEnableCheck;
		
	// End of Ancillaries "Checkbox" Section. If not selected then no Ancillaries Options will be setup.	
		checkBoxGrp -numberOfCheckBoxes 4 -labelArray4 "FrontWipers" "FrontSeats" "RearSeats" "RearWipers"
					-label "Ancillary Options" 
					-enable1 false -enable2 false -enable3 false -enable4 false
					-columnWidth 1 90 -columnAlign 1 "right"
					-columnWidth 2 80
					-columnWidth 3 80 
					-columnWidth 4 80
					-columnWidth 5 80
		
				-onCommand1 "frameLayout -edit -enable false -visible true -collapse false $AncillariesFrontWipersFrame;"
				-onCommand2 "frameLayout -edit -enable false -visible true -collapse false $AncillariesFrontSeatsFrame;"
				-onCommand3 "frameLayout -edit -enable false -visible true -collapse false $AncillariesRearSeatsFrame;"
				-onCommand4 "frameLayout -edit -enable false -visible true -collapse false $AncillariesRearWipersFrame;"

				-offCommand1 "frameLayout -edit -enable true -visible false -collapse false $AncillariesFrontWipersFrame;"
				-offCommand2 "frameLayout -edit -enable true -visible false -collapse false $AncillariesFrontSeatsFrame;"
				-offCommand3 "frameLayout -edit -enable true -visible false -collapse false $AncillariesRearSeatsFrame;"
				-offCommand4 "frameLayout -edit -enable true -visible false -collapse false $AncillariesRearWipersFrame;"
			
			AncillariesOptionsCheck;
/*
				-onCommand1 "frameLayout -edit -enable true -visible true -collapse false $AncillariesFrontWipersFrame;"
				-onCommand2 "frameLayout -edit -enable true -visible true -collapse false $AncillariesFrontSeatsFrame;"
				-onCommand3 "frameLayout -edit -enable true -visible true -collapse false $AncillariesRearSeatsFrame;"
				-onCommand4 "frameLayout -edit -enable true -visible true -collapse false $AncillariesRearWipersFrame;"
*/
	
	setParent $Tab05 ;
		
	// End of Ancillaries "Checkbox" Section. If not selected then no Ancillaries will be setup.	
		
	// Ancillaries Title Section 
		
	// BodyShell Title Section 
		separator -bgc 1 1 0.85 -h 10 -style "double";
		text -height 5 -bgc 1 0.5 0.5 -label " ";
		text -height 20 -bgc 1 0.5 0.5 -font "boldLabelFont" -align "left" 
			-label " This Tab is not yet available for use:";
		separator -bgc 1 1 0.85 -h 10 -style "double";
		text -height 5 -label "" ;	//Spacer
		separator -height 5 -style "double" ;
		text -bgc .8 .8 1 -height 20 -align "center" -font "boldLabelFont" -label "Tab for setting up Ancillaries layout etc.";
		separator -height 5 -style "double";
		text -height 5 -label "" ;	//Spacer
		
	// Create a collapsible frame layout for Ancillaries Info Section.
		string $AncillariesInfoFrameC = `frameLayout -borderStyle "etchedOut" -label "  Ancillaries Info"
										-labelVisible true -visible true -enable true
										-collapsable true -collapse false` ;
				
	// Define the layout of controls added to the Ancillaries Info Frame.
		string $AncillariesInfoColumnC = `columnLayout -adjustableColumn true -columnAttach "both" 1 "AncillariesInfoColumnC"`;	

	
	//Title and Info Section for the "Ancillaries Title Section". 
		separator -height 5 ;
		text -bgc 1 1 .85 -height 10 -label "" ;	//Space
		text -bgc 1 1 .85 -align "left" -label "  To Activate this Tab please use CheckBox labelled \"Enable Ancillaries Section\".\n  Then select the CheckBoxes for the sections you wish to setup.\n  Then select each part of the relevant Ancillaries Group and press the corresponding \"OK  >>\" Button.";
		text -bgc 1 1 .85 -height 10 -label "" ;	//Spacer
		separator -height 5 -style "double";
		text -height 10 -label "" ;	//Spacer
		
	setParent $Tab05;
	
	// End of Ancillaries Title and Info Inroduction.

	
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
//	
//						Start of Front Wipers Section
//
//+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
		

	// Create a collapsible frame layout for Ancillaries FrontWipers Section Info.
		string $AncillariesFrontWipersFrameC = `frameLayout -borderStyle "etchedOut" -label " Front Wipers Section"
											-labelVisible true -visible true -enable true
											-collapsable true -collapse false` ;
		
	// Define the layout of controls added to the window.
		string $AncillariesFrontWipersColumnC = `columnLayout -adjustableColumn true -columnAttach "both" 1 "AncillariesFrontWipersColumnC"`;		

	// Spacer and Front Wipers Titles.
		separator -height 5 ;
		text -bgc 1 1 .85 -height 5 -label "" ;	//Space
		text -bgc 1 1 .85 -align "left" -label "  Front Wipers:- Select number of Front Wipers in use.\n  Then select the Front Wipers arm and the FrontWiper Blades." ;
		text -bgc 1 1 .85 -height 5 -label "" ;	//Spacer
		separator -height 5 -style "double";
		text -height 5 -label "" ;	//Spacer
	
	setParent $Tab05;
		
	// Create a Non collapsible frame layout for Ancillaries FrontWipers Section.
		string $AncillariesFrontWipersFrame = `frameLayout -label "  FrontWipers Section"
