		setParent $Tabs;	
	setParent $RigPaneLayout;
	
//***********************************************************************************	
// 	Section for Main Buttons.
	
	columnLayout -cat "both" 2 -cal "center" -adjustableColumn true "ButtonsPanel:";
		
		separator -h 5 -style "double";
		
//***********************************************************************************	
// 	Rig Vehicle
		
	rowColumnLayout -nc 3 -cw 1 100 -cw 2 100 -cw 3 410
			-cat 1 "both" 5 -cal 1 "center"
			-cat 2 "both" 5 -cal 2 "center"
			-cat 3 "both" 5 -cal 3 "center"
		"VehicleBody4";	
		text -height 5 -label " "; text -height 5 -label " "; text -height 5 -label " ";
		button -enable false -height 25 -bgc 0.7 1.0 0.7 -label "Save Settings" -command ""
				Vehicle_SaveButton;	
		button -enable false -height 25 -bgc 1.0 1.0 0.7 -label "Load Settings" -command ""
				Vehicle_LoadButton;	
		button -height 25 -bgc 0.7 0.7 1 -label "Rig Vehicle (after setting hinges etc. (if required)" -command "DVY_RigVehicle($GroupV_A, $DVYdata);"
				Vehicle_Builder;	
		text -height 5 -label " "; text -height 5 -label " "; text -height 5 -label " ";
		
	setParent..;	
	
//***********************************************************************************	
// 	Rig	Wheels to Ground Plane
	
	rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 5 -cal 1 "center" "VehicleRig";	

		separator -h 10 -style "double";
		text -height 5 -label " ";
		text -height 30 -bgc 1 0.85 0.85 -align "left" 
			-label " To setup Auto wheel control to the Ground generate an object named GroundPlane. Once constructed ensure rig is at default\n position, press button and script will set up ground control. See help file for more info:";
		separator -h 5 -style "double";

	setParent..;
	
	rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 50 -cal 1 "center" "VehicleRigButton";	

		button -height 25 -bgc 1 0.5 0.5  -label "Rig Wheels to Ground Plane" -command "DVY_FloorRig;"
				Floor_Rig;	
		text -height 5 " ";
		
	setParent..;	
//***********************************************************************************	
//	Rig Controller to Motion Path
	
	rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 5 -cal 1 "center" "VehiclePath";	

		separator -h 5 -style "double";
		text -height 5 -label " ";
		text -height 30 -bgc 0.85 1 0.85 -align "left" 
			-label " To setup Vehicle to Motion Path. Select Rig_Controller and Motion Path. This will set up and parent a locator under the\n Vehicle Top Node and constrain Rig Controls. See help file for more info:";
		separator -h 5 -style "double";

	setParent..;
	
	rowColumnLayout -nc 1 -cw 1 610 -cat 1 "both" 50 -cal 1 "center" "VehiclePathButton";	

		button -height 25 -bgc 0.5 1 0.5  -label "Attach Vehicle to Motion Path" -command "DVY_MotionPath;"
				D_Motion_Path;	
		text -height 5 " ";

	setParent..;		
//***********************************************************************************	
//	Show the Vehicle Rigger window.
	
	showWindow DVY_VehicleRigWindow;
}