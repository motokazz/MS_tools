// Create a collapsible frame layout
	
	string $SetupHelpFrameC = `	frameLayout -collapsable true -collapse false 
											-label "  BodyShell Help Section"` ;	
		
// Create a collapsable Frame for Setup Info.
	
	string $SetupHelpColumnC = `columnLayout -adjustableColumn true -cat "both" 2 "SetupHelpColumnC"`;	

		separator -h 5 -style "double";
		text -height 5 -label " ";
		text -height 5 -bgc 1 1 0.85 -label " ";
		text -bgc 1 1 0.85 -align "left" 
			-label " Select the Top node and press button, then the Group node for the BodyShell Group and also the Body Geometry Group.";
