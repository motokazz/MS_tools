global proc AriSO_PushMakePreviewButton(){
	string $fullPathSet[]=AriSO_DirectryMarge("full");
	for($fullPath in $fullPathSet){
		AriMakePreview($fullPath,"");
	}
}
global proc string[] AriSO_DirectryMarge(string $mode){
	global string $AriFixRootPathTF;
	global string $AriFixRightPathTX;
	global string $AriFixLeftPathTX;
	global string $AriFixLeftSL;
	global string $AriFixRightSL;
	string $fullPath;
	string $fullPathSet[];
	string $rootPath = `textField -q -text $AriFixRootPathTF`;
	string $leftPath=`text -q -l $AriFixLeftPathTX`;
	string $rightPath=`textField -q -text $AriFixRightPathTX`;
	string $selects[]=`textScrollList -q -selectItem $AriFixRightSL`; 
	if($mode=="select"){
		$fullPathSet=$selects;
	}
	if($mode=="left"){
		$fullPathSet[0]=$rootPath+$leftPath;	
	}
	if($mode=="right"){
		$fullPathSet[0]=$rootPath+$leftPath+$rightPath;	
	}
	if($mode=="full"){
		$fullPath=$rootPath+$leftPath+$rightPath;	
		int $i=0;
		for($sel in $selects){
			$fullPathSet[$i]=$fullPath+$sel;
			$i++;
		}
	}
	return $fullPathSet;
}
global proc AriMakePreview(string $mbPath,string $savePath){
	string $currentScene=`file -q -sceneName`;
	print $mbPath;
	if(!endsWith($mbPath,".mb") && !endsWith($mbPath,".ma"))return;
	if($currentScene != $mbPath){
		file -f -options "v=0"  -o $mbPath;
		$currentScene=`file -q -sceneName`;
		string $selectPanel =`getPanel -wf`;
		lookThroughModelPanel persp $selectPanel;
		viewFit -f 1;
		DisplayShadedAndTextured;
	}
	string $sepa[];
	tokenize $currentScene "/" $sepa;
	string $senesName=$sepa[size($sepa)-1];
	int $fileNameSize=size($senesName);
	$savePath = startString($mbPath,(size($mbPath)-$fileNameSize));
	$savePath=$savePath+"prev";
	string $saveName=$savePath+"/"+$senesName+".png";
	string $saveName_s=$savePath+"/"+$senesName+"_s.png";
	print $saveName;
	if(!`filetest -d $savePath`){
		print `sysFile -md $savePath`;
	}
	setAttr "defaultRenderGlobals.imageFormat" 32;
	playblast -frame `currentTime -q` -wh 600 400 -orn false  -rfn  -fmt "image" -viewer false  -cf  $saveName;
	playblast -frame `currentTime -q` -wh 200 200 -orn false  -rfn  -fmt "image" -viewer false  -cf  $saveName_s;
}
global proc AriSceneOpenAllCloseWindow()
{	
	string $window[] =`lsUI -windows`;
	for($loop in $window) if($loop != "scriptEditorPanel1Window" 
							&& $loop != "learningMoviesLaunchWnd"
							&& $loop != "ColorEditor"
							&& $loop != "MayaWindow"
							&& $loop != "AriSceneOpener"
							&& $loop != "CommandWindow"
							&& $loop != "gozwin"
							&& $loop != "nexFloatWindow"
							&& $loop != "AriEditorScript")deleteUI $loop;
}
