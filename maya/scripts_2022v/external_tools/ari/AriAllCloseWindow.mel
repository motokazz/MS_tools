//--------------------------------------------------------------------------
//
// ScriptName : AriAllCloseWindow
// Contents   : Maya上で開いているウィンドウをすべて閉じます。
// Author     : Arinosu
// LastUpdate : 2016/03/03 閉じたウィンドウ名と数を表示
//                         別のMEL AriCompactToolSettingsWindowの表示がおかしくなるバグ修正
//              2014/06
// Note       : GoZや2014からのモデリングツールキットもウィンドウ扱いなので、それらは閉じないようにしています。
//
//--------------------------------------------------------------------------
global proc AriAllCloseWindow()
{	
	string $window[] =`lsUI -windows`;
	int $total=0;
	print("\n\n---------------------------------------------\n");
	for($win in $window){
		if(!`window -ex $win`){
			continue;
		}
		if(    $win != "learningMoviesLaunchWnd"
			&& $win != "ColorEditor"
			&& $win != "MayaWindow"
			&& $win != "CommandWindow"
			&& $win != "gozwin"
			&& $win != "nexFloatWindow"
			&& $win != "AriCompactToolSettingsWindow"
			){
				string $title=`window -q -title $win`; 
				print ($title+"  ("+$win+")\n");
				deleteUI $win;
				$total++;
		}
	}
	print("---------------------------------------------\n");
	print ($total +" Windows Close\n");
}
