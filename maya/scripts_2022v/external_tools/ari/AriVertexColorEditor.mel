global proc ARIVertexEditorVectorColorSet(){
	global string $ARIVerVectorColorSlider[];
	string $selectObj[] = `ls -sl`;
	string $vertexList[] = `polyListComponentConversion -tvf $selectObj`;
	$vertexList = `filterExpand -selectionMask 70 $vertexList`;
	vector $verVector;
	vector $lightVector;
	float $minColor[] =`colorSliderGrp -q -rgb  $ARIVerVectorColorSlider[0]`;
	float $maxColor[] =`colorSliderGrp -q -rgb  $ARIVerVectorColorSlider[1]`;
	float $minAngle=`floatSliderGrp -q -v $ARIVerVectorColorSlider[3]`;
	float $maxAngle=`floatSliderButtonGrp -q -v $ARIVerVectorColorSlider[4]`;
	if($minAngle!=0)$minAngle=$minAngle*3.14159/180;
	if($maxAngle!=0)$maxAngle=$maxAngle*3.14159/180;
	float $lightVec[];
	$lightVec[0] =`floatFieldGrp -q -v1 $ARIVerVectorColorSlider[5]`;
	$lightVec[1] =`floatFieldGrp -q -v2 $ARIVerVectorColorSlider[5]`;
	$lightVec[2] =`floatFieldGrp -q -v3 $ARIVerVectorColorSlider[5]`;
	$lightVector=<<$lightVec[0],$lightVec[1],$lightVec[2]>>;
	for($ver in $vertexList){
		float $nor[]=`polyNormalPerVertex -q -xyz $ver`;
		$verVector=<<$nor[0],$nor[1],$nor[2]>>;
		float $verAngle=angle ($lightVector,$verVector);
		float $a=1/($maxAngle-$minAngle);
		float $b=0-$minAngle*$a;
		float $colorPower=1-($a*$verAngle+$b);
		if($colorPower>1)$colorPower=1;
		if($colorPower<0)$colorPower=0;
		float $makeColor[];
		$makeColor[0]= $minColor[0]+(($maxColor[0]-$minColor[0])*$colorPower);
		$makeColor[1]= $minColor[1]+(($maxColor[1]-$minColor[1])*$colorPower);
		$makeColor[2]= $minColor[2]+(($maxColor[2]-$minColor[2])*$colorPower);
		polyColorPerVertex -cla 0 -r $makeColor[0] $ver;
		polyColorPerVertex -cla 0 -g $makeColor[1] $ver;
		polyColorPerVertex -cla 0 -b $makeColor[2] $ver;
	}
	ARIVertexEditorChangeSelect;
}
global proc ARIVertexEditorMathSet(){
	global string $ARIVerMathTextField;
	string $text=`textField -q $ARIVerMathTextField`;
	string $selectObj[] = `ls -sl`;
	string $vertexList[] = `polyListComponentConversion -tvf $selectObj`;
	$vertexList = `filterExpand -selectionMask 70 $vertexList`;
	for($ver in $vertexList){
		float $nor[]=`polyColorPerVertex -q -rgb $ver`;
		float $makeColor[];
		int $i=0;
		for($input in $nor){
			$makeColor[$i]=pow(0.5+$input,1.2)-0.5;
			if($makeColor[$i]>2)$makeColor[$i]=2;
			if($makeColor[$i]<0)$makeColor[$i]=0;
			$i++;
		}
		polyColorPerVertex -cla 0 -r $makeColor[0] $ver;
		polyColorPerVertex -cla 0 -g $makeColor[1] $ver;
		polyColorPerVertex -cla 0 -b $makeColor[2] $ver;
	}
	ARIVertexEditorChangeSelect;
}
global proc  float [] rgb255_to_hsv (int $r_255,int $g_255,int $b_255){
	float $hsvfl[];
	vector $rgb=<<$r_255/255.0,$g_255/255.0,$b_255/255.0>>;
	vector $hsv=rgb_to_hsv($rgb);
	$hsvfl[0]=$hsv.x*360;
	$hsvfl[1]=$hsv.y;
	$hsvfl[2]=$hsv.z;
	return $hsvfl;
}
global proc string AriIntToString(int $int){
	string $string=(" "+$int);
	if($int>=1000)$string=($int);
	if($int<100)$string=(" 0"+$int);
	if($int<10)	$string=(" 00"+$int);
	if($int<0)	$string=($int);
	return $string;
}
