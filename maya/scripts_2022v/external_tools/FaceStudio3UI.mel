global proc FaceStudio3CleanDialog ()
{
	global string $FaceStudio3MainWindow;

	string $FaceStudio3Clean = "FaceStudio3ExitWi";
	if (`window -exists $FaceStudio3Clean` )
		deleteUI $FaceStudio3Clean;	

	window -tlb on -s off  -width 258 -height 450  -title "FaceStudio v.3.0 Clean" $FaceStudio3Clean; 
		frameLayout -lv off -h 100;
		columnLayout -adjustableColumn true;
			image -w 250 -h 350 -i (`internalVar -upd` + "icons/FaceStudio3/FaceStudio3.bmp") FS3initPic;
			separator -bgc 0.6 0.6 0.6 -st none -h 8;
			text -bgc 0.6 0.6 0.6 -l "Do you want to delete all FaceStudio nodes ?";
			separator -bgc 0.6 0.6 0.6 -st none -h 8;
			rowLayout -nc 2 -cw2 125 125;
				columnLayout;
					button -bgc 1 1 1 -w 125 -h 36 -l "Yes" 
							-c ( 
							"window -e -vis off " + $FaceStudio3Clean + ";" +
							"if (catchQuiet  (\`select -r \"FaceStudio3Attribute*\"\`)) { print \"//FaceStudio3 : no FaceStudio3 node\";  } else { delete; } if (\`objExists FaceStudio3Sound\`) delete FaceStudio3Sound"
							);
					setParent ..;
				columnLayout;
					button -bgc 1 1 1 -w 122 -h 36 -l "No" -c ( 	"window -e -vis off " + $FaceStudio3Clean );
					setParent ..;

	showWindow $FaceStudio3Clean;
}