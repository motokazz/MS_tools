global proc FaceStudio3ResetUIDialog ()
{
	string $FaceStudio3Reset = "FaceStudio3ResetWin";
	if (`window -exists $FaceStudio3Reset` )
		deleteUI $FaceStudio3Reset;	

	window -tlb on -s off  -width 258 -height 450  -title "FaceStudio v.3.0 - Reset UI" $FaceStudio3Reset; 
		frameLayout -lv off -h 100;
		columnLayout -adjustableColumn true;
			image -w 250 -h 350 -i (`internalVar -upd` + "icons/FaceStudio3/FaceStudio3.bmp") FS3initPic;
			separator -bgc 0.6 0.6 0.6 -st none -h 8;
			text -bgc 0.6 0.6 0.6 -l "Do you want to reset UI ?";
			separator -bgc 0.6 0.6 0.6 -st none -h 8;
			rowLayout -nc 2 -cw2 125 125;
				columnLayout;
					button -bgc 1 1 1 -w 125 -h 36 -l "Yes" 
							-c ( 
							"window -e -vis off " + $FaceStudio3Reset + ";" +
							"FaceStudio3ResetUI"					
							);
					setParent ..;
				columnLayout;
					button -bgc 1 1 1 -w 122 -h 36 -l "No" -c ( 	"window -e -vis off " + $FaceStudio3Reset );
					setParent ..;

	showWindow $FaceStudio3Reset;	
}

