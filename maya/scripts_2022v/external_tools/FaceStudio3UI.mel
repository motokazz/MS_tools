/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3CustomButtonUI (string $obj)
{
	string $FaceStudio3CustomButtonWindow = "FaceStudio3CustomButton_window";
	if (`window -exists $FaceStudio3CustomButtonWindow` )
		deleteUI $FaceStudio3CustomButtonWindow;	

	window -tlb off -s off  -width 550 -height 256 -bgc 0.6 0.6 0.6 -title "FaceStudio v.3.0  - Custom Functions Buttons" $FaceStudio3CustomButtonWindow; 	
		columnLayout -bgc 0.6 0.6 0.6 -adjustableColumn true;
			separator -bgc 0.6 0.6 0.6 -st none -h 20;
			textFieldGrp -cw2 60 450 -l "Custom1" -text `iconTextButton -q -c fs3_custom1` -bgc 0.6 0.6 0.6  custom_txt1;
			separator -bgc 0.6 0.6 0.6 -st none -h 10;
			textFieldGrp -cw2 60 450 -l "Custom2" -text `iconTextButton -q -c fs3_custom2` -bgc 0.6 0.6 0.6  custom_txt2;
			separator -bgc 0.6 0.6 0.6 -st none -h 10;
			textFieldGrp -cw2 60 450 -l "Custom3" -text `iconTextButton -q -c fs3_custom3` -bgc 0.6 0.6 0.6  custom_txt3;
			separator -bgc 0.6 0.6 0.6 -st none -h 10;
			textFieldGrp -cw2 60 450 -l "Custom4" -text `iconTextButton -q -c fs3_custom4` -bgc 0.6 0.6 0.6  custom_txt4;
			separator -bgc 0.6 0.6 0.6 -st none -h 10;
			textFieldGrp -cw2 60 450 -l "Custom5" -text `iconTextButton -q -c fs3_custom5` -bgc 0.6 0.6 0.6  custom_txt5;
			separator -bgc 0.6 0.6 0.6 -st none -h 20;
			rowLayout -nc 2 -cw2 275 275 -bgc 0.6 0.6 0.6;
				columnLayout -adjustableColumn true;
					button -bgc 1 1 1 -l "Apply" -c ( "FaceStudio3AssignCustomFunctions; window -e -vis off " + $FaceStudio3CustomButtonWindow ) -w 275 -h 40;
					setParent ..;
				columnLayout -adjustableColumn true;
					button -bgc 1 1 1 -l "Cancel" -c ( "window -e -vis off " + $FaceStudio3CustomButtonWindow ) -w 275 -h 40;
					setParent ..;
	showWindow $FaceStudio3CustomButtonWindow;

}

