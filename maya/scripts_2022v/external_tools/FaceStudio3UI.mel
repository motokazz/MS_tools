global proc FaceStudio3LinkEyeSliders ()
{

	global string $FaceStudio3MainWindow;	
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;	


	string $FS3listObj[] = `ls -g`;
	$FS3listObj = `sort $FS3listObj`;	

	string $FaceStudio3LinkEyes = "FaceStudio3LinkEyesWindow";
	if (`window -exists $FaceStudio3LinkEyes` )
		deleteUI $FaceStudio3LinkEyes;	

	window -tlb off -s off  -width 550 -height 340 -bgc 0.6 0.6 0.6 -title "FaceStudio v.3.0  -  Link Eyes Controls" $FaceStudio3LinkEyes; 	
		columnLayout -bgc 0.6 0.6 0.6 -adjustableColumn true;
			separator -bgc 0.6 0.6 0.6 -st none -h 20;
			rowLayout -bgc 0.6 0.6 0.6 -nc 4 -cw4 245 30 160 100 ;
				columnLayout -w 245 -adjustableColumn true -bgc 0.6 0.6 0.6;
					text -l "1st Slider Link" -bgc 0.6 0.6 0.6;
					textScrollList -ams false -w 245 -h 120 FS3listObjLink1;

					text -l "2rd Slider Link" -bgc 0.6 0.6 0.6;
					textScrollList -ams false -w 245 -h 120 FS3listObjLink2;

					textScrollList -e -append "None" FS3listObjLink1;
					textScrollList -e -append "None" FS3listObjLink2;

					for ( $i=0;$i<size($FS3listObj);$i++ )
					{
						string $objShape[] = `listRelatives -p $FS3listObj[$i]`;						
						textScrollList -e -w 245 -h 120 -append $objShape[0] FS3listObjLink1;
						textScrollList -e -w 245 -h 120 -append $objShape[0] FS3listObjLink2;
					}	

					textScrollList -e -sii 1 FS3listObjLink1;
					textScrollList -e -sii 1 FS3listObjLink2;

				setParent ..;
				separator -st none -bgc 0.6 0.6 0.6 -h 10;
				columnLayout -w 245 -adjustableColumn true -bgc 0.6 0.6 0.6;
					text -l "1st Link Attribute" -bgc 0.6 0.6 0.6;
					textScrollList -ams false -w 140 -h 120 FS3listObjAttrib1;
					text -l "2rd  Link Attribute" -bgc 0.6 0.6 0.6;
					textScrollList -ams false -w 140 -h 120 FS3listObjAttrib2;

					textScrollList -e -append "translateX" FS3listObjAttrib1;
					textScrollList -e -append "translateY" FS3listObjAttrib1;
					textScrollList -e -append "translateZ" FS3listObjAttrib1;
					textScrollList -e -append "rotateX" FS3listObjAttrib1;
					textScrollList -e -append "rotateY" FS3listObjAttrib1;
					textScrollList -e -append "rotateZ" FS3listObjAttrib1;
					textScrollList -e -append "scaleX" FS3listObjAttrib1;
					textScrollList -e -append "scaleY" FS3listObjAttrib1;
					textScrollList -e -append "scaleZ" FS3listObjAttrib1;

					textScrollList -e -append "translateX" FS3listObjAttrib2;
					textScrollList -e -append "translateY" FS3listObjAttrib2;
					textScrollList -e -append "translateZ" FS3listObjAttrib2;
					textScrollList -e -append "rotateX" FS3listObjAttrib2;
					textScrollList -e -append "rotateY" FS3listObjAttrib2;
					textScrollList -e -append "rotateZ" FS3listObjAttrib2;
					textScrollList -e -append "scaleX" FS3listObjAttrib2;
					textScrollList -e -append "scaleY" FS3listObjAttrib2;
					textScrollList -e -append "scaleZ" FS3listObjAttrib2;

					textScrollList -e -sii 1 FS3listObjAttrib1;
					textScrollList -e -sii 1 FS3listObjAttrib2;

				setParent ..;
				columnLayout -w 245 -adjustableColumn true -bgc 0.6 0.6 0.6;
					text -l "1st Slider Values" -bgc 0.6 0.6 0.6;
					floatFieldGrp -v1 -1 -l "Min" -cw2 30 60 -bgc 0.6 0.6 0.6 fs3_eye_s1_min;
					floatFieldGrp -v1 1 -l "Max" -cw2 30 60 -bgc 0.6 0.6 0.6 fs3_eye_s1_max;
					separator -st none -h 75 -bgc 0.6 0.6 0.6;
					text -l "2rd Slider Values" -bgc 0.6 0.6 0.6;
					floatFieldGrp -v1 -1 -l "Min" -cw2 30 60 -bgc 0.6 0.6 0.6 fs3_eye_s2_min;
					floatFieldGrp -v1 1 -l "Max" -cw2 30 60 -bgc 0.6 0.6 0.6 fs3_eye_s2_max;
					separator -st none -h 25 -bgc 0.6 0.6 0.6;
					button -l "Apply" -h 25 -bgc 1 1 1 -c ( "FaceStudio3ApplyEyeSliderLink;window -e -vis off " + $FaceStudio3LinkEyes );
					button -l "Cancel" -h 25 -bgc 1 1 1 -c ( "window -e -vis off " + $FaceStudio3LinkEyes );


	string $val = `getAttr ( $FS3node[0] + ".EyeControl1")`;
	if ( $val != "" )
	{
		string $vals[] = stringToStringArray( $val, " ");
		textScrollList -e -si $vals[0] FS3listObjLink1;
		textScrollList -e -si $vals[1] FS3listObjAttrib1;
		float $num = $vals[2];
		floatFieldGrp -e -v1 $num fs3_eye_s1_min;
		float $num = $vals[3];
		floatFieldGrp -e -v1 $num fs3_eye_s1_max;
	}

	string $val = `getAttr ( $FS3node[0] + ".EyeControl2")`;
	if ( $val != "" )
	{
		string $vals[] = stringToStringArray( $val, " ");	
		textScrollList -e -si $vals[0] FS3listObjLink2;
		textScrollList -e -si $vals[1] FS3listObjAttrib2;
		float $num = $vals[2];		
		floatFieldGrp -e -v1 $num fs3_eye_s2_min;
		float $num = $vals[3];
		floatFieldGrp -e -v1 $num fs3_eye_s2_max;
	}

	showWindow $FaceStudio3LinkEyes;	
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3CameraSettingUI ()
{
	global string $FaceStudio3MainWindow;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;	
	
	string $FaceStudio3CamSettings = "FaceStudio3CamSettingWindow";
	if (`window -exists $FaceStudio3CamSettings` )
		deleteUI $FaceStudio3CamSettings;	

	window -tlb off -s off  -width 350 -height 285  -title "FaceStudio v.3.0  -  View Settings" $FaceStudio3CamSettings;
		columnLayout -bgc 0.6 0.6 0.6 -adjustableColumn true;
			separator -bgc 0.6 0.6 0.6 -st none -h 20;
			frameLayout -l "Parameters";
				columnLayout -bgc 0.6 0.6 0.6 ;
				separator -bgc 0.6 0.6 0.6 -st none -h 10;
				floatSliderGrp -bgc 0.6 0.6 0.6 -fmn 10 -fmx 1000 -cw3 90 60 150 -field true -l "Camera Focal" -v ( `getAttr FaceStudio3ViewShape.focalLength`) fs3viewfocal;
				separator -bgc 0.6 0.6 0.6 -st none -h 10;
				int $dvalue = `modelEditor -q -vs FaceStudio3Pane`;
				int $dcheckbox;
				if ( $dvalue == 0 )
				{
					$dcheckbox = 1;	
				}
				checkBoxGrp -bgc 0.6 0.6 0.6 -cw2 135 100 -v1 $dcheckbox -l "Display all objects" fs3viewdisplay;
				separator  -bgc 0.6 0.6 0.6 -w 350 -h 10;
				string $lvalue = `modelEditor -q -dl FaceStudio3Pane`;
				int $lcheckbox;
				if ($lvalue=="all")
				{
					$lcheckbox = 1;	
				}
				
				checkBoxGrp -bgc 0.6 0.6 0.6 -cw2 135 100 -v1 $lcheckbox -l "Ligthning" fs3viewligth;
				checkBoxGrp -bgc 0.6 0.6 0.6 -cw2 135 100 -v1 `modelEditor -q -wos FaceStudio3Pane` -l "Wireframe on shaded" fs3viewwire;
				checkBoxGrp -bgc 0.6 0.6 0.6 -cw2 135 100 -v1 `modelEditor -q -xr FaceStudio3Pane` -l "X-Ray" fs3viewxray;
				checkBoxGrp -bgc 0.6 0.6 0.6 -cw2 135 100 -v1 `modelEditor -q -sdw FaceStudio3Pane` -l "Hardware shadows" fs3viewshadow;
				setParent ..; setParent ..;
				separator -bgc 0.6 0.6 0.6 -st none -h 10;

				separator -bgc 0.6 0.6 0.6 -st none -h 5;
				rowLayout -nc 2 -cw2 122 222;
					text -bgc 0.6 0.6 0.6 -l "        View Parent             ";
					columnLayout -adjustableColumn true;
						button -bgc 1 1 1 -w 220 -h 30 -l "auto"  -c "FaceStudio3CustomParentUI" FS3parentBt;
						setParent ..;
					setParent ..;
				separator -bgc 0.6 0.6 0.6 -st none -h 5;

				rowLayout -nc 2 -cw2 172 172;
					columnLayout -adjustableColumn true;
						button -l "Apply" -bgc 1 1 1 -w 172 -h 40 -c ("FaceStudio3ApplyViewSettings;window -e -vis off " + $FaceStudio3CamSettings);
					setParent ..;	
					columnLayout -adjustableColumn true;
						button -l "Cancel" -bgc 1 1 1 -w 172 -h 40 -c ("window -e -vis off " + $FaceStudio3CamSettings );
					setParent ..;
					
				string $camParent = `getAttr ( $FS3node[0] + ".CustomParent")`;
				if ( $camParent == "" )
				{
					$camParent = `getAttr ( $FS3node[0] + ".parent")`;
				}
				button -e -w 220 -h 30 -l $camParent FS3parentBt;
					
	showWindow $FaceStudio3CamSettings;	
}
