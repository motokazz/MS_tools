}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3VideoWindow ()
{
	global string $FaceStudio3MainWindow;
	global string $gAECurrentTab;

	string $FaceStudio3VideoWindow = "FaceStudio3VideoWindow";
	
	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	
	string $defaultVideo = `getAttr ($FS3node[0] + ".video")`;
	int $useFrameExt = `getAttr ($FS3node[0] + ".videoExt")`;
	int $videoOffset = `getAttr ($FS3node[0] + ".videoOffset")`;

	if (`window -exists $FaceStudio3VideoWindow` == 0 )
	{
		if (`objExists FaceStudio3VideoCam` == 0 )
		{
			camera;
			rename FaceStudio3VideoCam;
			createNode "imagePlane";
			rename FaceStudio3VideoPlane;
			connectAttr FaceStudio3VideoPlane.message FaceStudio3VideoCamShape.imagePlane[0];	
			setAttr FaceStudio3VideoPlane.displayOnlyIfCurrent on;
			setAttr FaceStudio3VideoPlane.displayMode 2;
			setAttr -type "string" FaceStudio3VideoPlane.imageName $defaultVideo;
			setAttr "FaceStudio3VideoCam.v" 0;
			setAttr "FaceStudio3VideoPlane.useFrameExtension" $useFrameExt;
			setAttr "FaceStudio3VideoPlane.frameOffset" $videoOffset;
		}
		
		select -r -ne FaceStudio3VideoCam;
		window -t "FaceStudio v.3.0  -  Video Reference View" -menuBar true -w 300 -h 250 $FaceStudio3VideoWindow;
		menu -l "Video";
			menuItem -l "Video Settings" -c "FaceStudio3VideoSettingsWindow";
			menuItem -l "Close" -c ("window -e -vis off " + $FaceStudio3VideoWindow ) ;

		frameLayout -labelVisible off;
			modelEditor 	-cam "FaceStudio3VideoCam" -ca true
					-grid 0
					-vs 1;
		select -cl;
	}
	showWindow $FaceStudio3VideoWindow;
	select -r FaceStudio3VideoCam;
	ShowAttributeEditorOrChannelBox;
	commitAENotes($gAECurrentTab);window -e -vis 0 AEWindow;
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3VideoSettingsWindow ()
{	
	global string $FaceStudio3MainWindow;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	
	string $video = `getAttr ( $FS3node[0] + ".video" )`;
	string $defaultVideo = ( `internalVar -upd` + "icons/FaceStudio3/fs3_video.bmp");

	if ( $video == $defaultVideo )
		{ $video = "none"; }
	
	string $FaceStudio3VideoSettingsWindow = "FaceStudio3VideoSettingsWindow";
	if (`window -exists $FaceStudio3VideoSettingsWindow` )
		deleteUI $FaceStudio3VideoSettingsWindow;	
		
	window -tlb off -s off  -width 550 -height 185 -bgc 0.6 0.6 0.6 -title "FaceStudio v.3.0  -  Video Settings" $FaceStudio3VideoSettingsWindow; 	
		columnLayout -bgc 0.6 0.6 0.6 -adjustableColumn true;
			separator -st none -h 30 -bgc 0.6 0.6 0.6;
			rowLayout -nc 3 -cw3 55 435 50;
				text -h 22 -bgc 0.6 0.6 0.6 -l "Sequence  ";
				textField -tx $video -en off -w 435 fs3_video;
				button -l "     ..." -w 52 -bgc 1 1 1.0 -c "FaceStudio3PickVideo";
			setParent ..;
			separator -st none -h 15 -bgc 0.6 0.6 0.6;
			checkBoxGrp -cw2 170 100 -l "Use Frame Extension" -v1 (`getAttr "FaceStudio3VideoPlane.useFrameExtension"`) -bgc 0.6 0.6 0.6 fs3_frameExt;
			separator -st none -h 8 -bgc 0.6 0.6 0.6;
			intFieldGrp -cw2 97 50 -l "Offset" -v1 (`getAttr "FaceStudio3VideoPlane.frameOffset"`) -bgc 0.6 0.6 0.6 fs3_offset;
			separator -st none -h 15 -bgc 0.6 0.6 0.6;
			rowLayout -nc 2 -cw2 275 275;
				columnLayout;
					button -l "Apply" -w 275 -h 30 -bgc 1 1 1 -c ("FaceStudio3ApplyVideoSettings; window -e -vis off " + $FaceStudio3VideoSettingsWindow);
				setParent ..;
				columnLayout;
					button -l "Cancel" -w 275 -h 30 -bgc 1 1 1 -c ("window -e -vis off " + $FaceStudio3VideoSettingsWindow);
				setParent ..;
	showWindow $FaceStudio3VideoSettingsWindow;
	
}
