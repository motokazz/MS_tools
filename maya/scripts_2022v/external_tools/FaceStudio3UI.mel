/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3CustomParentUI ()
{
	string $FS3listObj[] = `ls -g`;
	$FS3listObj = `sort $FS3listObj`;
	
	string $FS3listJoint[] = `ls -type "joint"`;
	$FS3listJoint = `sort $FS3listJoint`;

	string $FaceStudio3CustomParentWindow = "FaceStudio3CustomParentWin";
	if (`window -exists $FaceStudio3CustomParentWindow` )
		deleteUI $FaceStudio3CustomParentWindow;	
	window -tlb off -s off  -width 280 -height 340 -bgc 0.6 0.6 0.6 -title "FaceStudio v.3.0  -  View parent" $FaceStudio3CustomParentWindow; 		
		columnLayout -bgc 0.6 0.6 0.6 -adjustableColumn true;
			separator -bgc 0.6 0.6 0.6 -st none -h 10;
			textScrollList -ams false -w 247 -h 240 FS3parentObj;

			for ( $i=0;$i<size($FS3listJoint);$i++ )
			{
				textScrollList -e -w 277 -h 240 -append $FS3listJoint[$i] FS3parentObj;
			}

			for ( $i=0;$i<size($FS3listObj);$i++ )
			{
				string $objShape[] = `listRelatives -p $FS3listObj[$i]`;
				if ( $objShape[0] != "" )
				{
					textScrollList -e -w 277 -h 240 -append $objShape[0] FS3parentObj;
				}
			}
		textScrollList -e -sii 1 FS3parentObj;
		separator -st none -h 5 -bgc 0.6 0.6 0.6;
		rowLayout -nc 3 -cw3 92 92 92;
			columnLayout -adjustableColumn true;
				button -l "Apply" -w 92 -h 40 -bgc 1 1 1 -c ("FaceStudio3CustomParent 1;window -e -vis off " + $FaceStudio3CustomParentWindow) ;				
				setParent ..;
			columnLayout -adjustableColumn true;
				button -l "Auto" -w 92 -h 40 -bgc 1 1 1 -c ("FaceStudio3CustomParent 2;window -e -vis off " + $FaceStudio3CustomParentWindow) ;				
				setParent ..;
			columnLayout -adjustableColumn true;
				button -l "Cancel" -w 92 -h 40 -bgc 1 1 1 -c ("window -e -vis off " + $FaceStudio3CustomParentWindow);				
				setParent ..;
				
	showWindow $FaceStudio3CustomParentWindow;
}
