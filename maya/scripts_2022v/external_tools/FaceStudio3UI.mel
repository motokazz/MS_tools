global proc FaceStudio3InitConsole ()
{
	global string $FaceStudio3Console;
	if (`window -exists $FaceStudio3Console` )
		deleteUI $FaceStudio3Console;	

	window -tlb on -s off  -width 258 -height 450  -title "FaceStudio v.3.0 Startup Console" $FaceStudio3Console; 
		frameLayout -lv off -h 100;
		columnLayout -adjustableColumn false;
			image -w 250 -h 350 -i (`internalVar -upd` + "icons/FaceStudio3/FaceStudio3.bmp") FS3initPic;
			textScrollList -w 250 -h 70 FaceStudio3StartStatus;
	showWindow $FaceStudio3Console;
}
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3ConsoleMessage ( string $message )
{
	
	global string $FaceStudio3Console;
	if (`window -exists $FaceStudio3Console` == 0)
		FaceStudio3InitConsole;
			
	textScrollList -e -append $message FaceStudio3StartStatus;
	textScrollList -e -si $message FaceStudio3StartStatus;
	image -e -w 250 -h 350 -i (`internalVar -upd` + "icons/FaceStudio3/FaceStudio3.bmp") FS3initPic;
}
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3MainUI (string $obj)
{
	global string $FaceStudio3MainWindow;
	global string $FaceStudio3ShapeWindow;
	global string $FaceStudio3GroupWindow;
	global string $gMainWindow;

	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	string $FS3ShapeNode = `getAttr ($FS3node[0]+".shape")`;
	string $FS3Shapes[] = `listAnimatable $FS3ShapeNode`;

	select -r -ne $obj;

	if (`window -exists $FaceStudio3MainWindow` )
		deleteUI $FaceStudio3MainWindow;

	window -dtg $obj -tlb off  -mxb off -s off -tlc 100 300 -width 830 -height 870 -menuBar true -bgc 0.6 0.6 0.6 -title "FaceStudio v.3.0  -  Animation Editor" $FaceStudio3MainWindow;
 		menu -label "File" -tearOff true;
 			menuItem -label "Reset UI Layout" -c "FaceStudio3ResetUIDialog";
 			menuItem -divider true; 		 				
 			menuItem -label "Open UI Layout" -c "FaceStudio3LoadDialog";
 			menuItem -label "Save UI Layout" -c "FaceStudio3SaveDialog";
 			menuItem -divider true;
 			menuItem -label "Exit" -c ("FaceStudio3ExitDialog");

		menu -label "Module" -tearOff true;
 			menuItem -label "Animation Editor" -c "FaceStudio3Module 1";
 			//menuItem -label "Shapes Manager"  -c "FaceStudio3Module 2";
 			menuItem -label "Groups Manager"  -c "FaceStudio3Module 3";
 			//menuItem -divider true;
 			menuItem -label "Video Synchro" -c "FaceStudio3VideoWindow"; 		
 									
 		menu -label "Animation" -tearOff true fs3_animationMenu;
 			menuItem -label "Key All" -c "FaceStudio3KeyAll";
 			menuItem -label "Reset All Shapes" -c "FaceStudio3ResetAll";
 			menuItem -label "Remove All Keys" -c "FaceStudio3DeleteAllKey";
 			menuItem -divider true; 		 			
			menuItem -label "Create Playblast" -c "FaceStudio3Playblast"; 					
 			
 		menu -label "Shapes" -en off -vis off -tearOff true fs3_shapeMenu;

 		menu -label "Groups" -en off -vis off -tearOff true fs3_groupMenu;

 		menu -label "Options"  -tearOff true -pmc ( "if (\`objExists FaceStudio3Sound\`) { menuItem -e -en on FS3remSoundMenu; } else { menuItem -e -en off FS3remSoundMenu; }");

 			menuItem -divider true; 		
 			menuItem -label "Auto Iconize" -c "FaceStudio3AutoIconizeDialog"; 		
 			menuItem -divider true; 		
 			menuItem -label "Include/Exclude object(s)" -c ( "FaceStudio3ObjectsUI " + $obj ); 		
 			menuItem -divider true; 		
 			menuItem -label "Edit Custom Functions" -c ( "FaceStudio3CustomButtonUI " + $obj ); 		
 			menuItem -divider true; 				
			menuItem -label "View Settings" -c "FaceStudio3CameraSettingUI"; 					
 			menuItem -divider true; 
 			radioMenuItemCollection;		
 			menuItem -label "View : Wireframe" -rb 0 -c 	(
									"modelEditor -e -displayAppearance wireframe FaceStudio3Pane"						
 									)
 									FS3bt_W;
 			menuItem -label "View : Shaded" -rb 1 -c	(
									"modelEditor -e -displayAppearance smoothShaded -dtx off FaceStudio3Pane"						
 									)
 									FS3bt_S;
 			menuItem -label "View : Textured" -rb 0 -c	(
									"modelEditor -e -displayAppearance smoothShaded -dtx on FaceStudio3Pane"						
 									)
 									FS3bt_T;
 			menuItem -divider true; 		
 			radioMenuItemCollection;		
			menuItem -label "DopeSheet Editor" -rb 1 -c 	(
									"frameLayout -e -vis on FSdope; frameLayout -e -vis off FSgraph"
 									)
 									FS3bt_GE;
 			menuItem -label "GraphEditor Editor" -rb 0 -c	(
									"frameLayout -e -vis off FSdope; frameLayout -e -vis on FSgraph"
 									)
 									FS3bt_DS;
			menuItem -divider true;
			menuItem -label "Sound" -sm true;	
 				menuItem -label "Sound Settings" -c "FaceStudio3SoundSettingsWindow";
				menuItem -label "Remove Sound" -c ("delete FaceStudio3Sound; setAttr -type \"string\"" + $FS3node[0] + ".sound \"\";" ) FS3remSoundMenu;
				setParent ..;
				
 			
		menu -label "Help" -helpMenu true;
 			menuItem -label "Help" -c ( "launch -web ( \`internalVar -usd`\ + \"FaceStudio3/Documentation/FaceStudio3Manual.html\")" );
 			menuItem -label "About..." -c "FaceStudio3About";
 			

		columnLayout -adjustableColumn false -bgc 0.6 0.6 0.6 fs3_GLOBALLAYOUT;

			rowLayout -nc 4 -cw4 35 110 110 110 -bgc 0.4 0.25 0.15;
					separator -st none -bgc 0.4 0.25 0.15;		
					iconTextButton -ann "switch to wireframe view" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_wire.bmp") -w 110 -h 25
							-c (	"modelEditor -e -displayAppearance wireframe FaceStudio3Pane;" +
								"menuItem -e -rb 1 FS3bt_W;" 
							);
					iconTextButton -ann "switch to shaded view" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_shaded.bmp") -w 110 -h 25
							-c (	"modelEditor -e -displayAppearance smoothShaded -dtx off FaceStudio3Pane;" +				
								"menuItem -e -rb 1 FS3bt_S;" 								
							);

					rowLayout -nc 4 -cw4 110 48 48 500 -bgc 0.6 0.6 0.6;
						iconTextButton -ann "switch to textured view" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_textured.bmp") -w 110 -h 25
								-c (	"modelEditor -e -displayAppearance smoothShaded -dtx on FaceStudio3Pane;" +
									"menuItem -e -rb 1 FS3bt_T;"									
								);
						iconTextButton -ann "custom function : empty" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_custom1.bmp") -w 48 -h 25 fs3_custom1;
						iconTextButton -ann "custom function : empty" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_custom2.bmp") -w 48 -h 25 fs3_custom2;
						rowLayout -nc 5 -cw5 48 48 48 110 110 -bgc 0.6 0.6 0.6;
							iconTextButton -ann "custom function : empty" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_custom3.bmp") -w 48 -h 25 fs3_custom3;
							iconTextButton -ann "custom function : empty" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_custom4.bmp") -w 48 -h 25 fs3_custom4;
							iconTextButton -ann "custom function : empty"- i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_custom5.bmp") -w 48 -h 25 fs3_custom5;
							iconTextButton -ann "creates an icon for the current shape" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_iconize.bmp") -c "FaceStudio3Iconize" -w 110 -h 25;
							iconTextButton -ann "auto-create icons for all shapes" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_autoiconize.bmp") -w 110 -h 25 -c "FaceStudio3AutoIconizeDialog";
						setParent ..;
					setParent ..;
			setParent ..;

			rowLayout -nc 3 -cw3 35 330 455 -bgc 0.4 0.25 0.15 fs3row;
				columnLayout -bgc  0.4 0.25 0.15;
					iconTextButton -bgc 0.13 0.13 0.13 -ann "selection manipulator" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_select.bmp") -w 35 -h 32 -c "SelectTool";
					iconTextButton -bgc 0.13 0.13 0.13 -ann "translate manipulator" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_move.bmp") -w 35 -h 32 -c "MoveTool";
					iconTextButton -bgc 0.13 0.13 0.13 -ann "rotate manipulator" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_rotate.bmp") -w 35 -h 32 -c "RotateTool";
					iconTextButton -bgc 0.13 0.13 0.13 -ann "scale manipulator" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_scale.bmp") -w 35 -h 32 -c "ScaleTool";	
					iconTextButton -bgc 0.13 0.13 0.13 -ann "sound on" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_soundon.bmp") -c "FaceStudio3SoundOnOff" -w 35 -h 32 fs3_soundonoff;	
					iconTextButton -bgc 0.13 0.13 0.13 -ann "key selection" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_keyselected.bmp") -c ( "if ( size (\`ls -sl\`) != 0 ) { setKeyframe; } ") -w 35 -h 32;	
					iconTextButton -bgc 0.13 0.13 0.13 -ann "outliner" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_outliner.bmp") -c "OutlinerWindow" -w 35 -h 32;	
					iconTextButton -bgc 0.13 0.13 0.13 -ann "connection ed." -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_cnx.bmp") -c "ConnectionEditor" -w 35 -h 32;	
					iconTextButton -bgc 0.13 0.13 0.13 -ann "expression ed." -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_exp.bmp") -c "ExpressionEditor" -w 35 -h 32;	

					iconTextButton -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_max.bmp") 
							-w 35 -h 32 -bgc 0.13 0.13 0.13 
							-c ( "window -e -tlc 0 0 " + $gMainWindow )
							-ann "Show Maya main window"
								;
					iconTextButton -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_min.bmp") 
							-w 35 -h 32 -bgc 0.13 0.13 0.13 
							-c ( "window -e -tlc 0 10000 " + $gMainWindow )
							-ann "Hide Maya main window"
								;	
			setParent ..;

				if ( `paneLayout -exists FaceStudio3Pane`)
					deleteUI FaceStudio3Pane;
					
				paneLayout -w 330 -h 434 FaceStudio3Pane;
					modelEditor 	-cam "FaceStudio3View" 
							-vs on
							-grid 0
							-cameras 0
							-displayAppearance "smoothShaded"
							-displayTextures off 
							FaceStudio3Pane;
 					setParent ..;
 				columnLayout -bgc 0.6 0.6 0.6 ShapeLayout;
					frameLayout -h 434 -p ShapeLayout -l "All Shapes List" ShapeLayout1;
						scrollLayout -bgc 0.5 0.65 0.8  -cr true -w 455 -h 400 ScrollBlend;
							columnLayout -p ScrollBlend ColBlend;
								int $FS3nShapes = size ($FS3Shapes);
								 $FS3nShapes = `max  $FS3nShapes 5`;
								gridLayout -bgc 0.5 0.65 0.8 -nc 5 -nr ($FS3nShapes / 5) -cw 87 -ch 130 GridBlend;
 								for ($i=1;$i<size($FS3Shapes);$i++)
								{
				
									columnLayout -bgc 0.5 0.65 0.8 -p GridBlend -h 40 -adjustableColumn false ( "ColNodes" + $i );
										columnLayout -bgc 0.5 0.65 0.8 -adjustableColumn false ( "ColIcon" + $i );
										string $FS3nomShape = `substitute ( $FS3ShapeNode + "." ) $FS3Shapes[$i] ""`;
										iconTextButton 	-l $FS3nomShape
											-c ( "setAttr -type \"string\" " + $FS3node[0] + ".CurrentBlend \"" + $i + "\";")
											-dcc ("if (\`getAttr " + $FS3Shapes[$i] + "\` == 1 ) { setAttr " + $FS3Shapes[$i] + " 0; } else { setAttr " + $FS3Shapes[$i] + " 1;}")
											-ann ( `substitute ( $FS3ShapeNode + "." )$FS3Shapes[$i] ""`)
											-style "iconAndTextVertical" -w 87 -h 87
											-image1 ( `internalVar -upd` + "icons/FaceStudio3/fs3_noIcon.bmp" )
											("BlendButton" + $i);
										setParent ..;
																		
										columnLayout -bgc 0.5 0.65 0.8 -adjustableColumn false ( "ColShapeTools" + $i );
										attrFieldSliderGrp -bgc 0.5 0.65 0.8 -pre 2 -cw 1 1 -cw 2 30 -cw 3 55 -min 0 -max 1 -l "" -at $FS3Shapes[$i] -cc ("setAttr -type \"string\" " + $FS3node[0] + ".CurrentBlend \"" + $i +"\"") ("FSctrl" + $i);	
										rowLayout -nc 5 -cw5 15 15 15 15 15 -bgc 0.5 0.65 0.8 -p ( "ColNodes" + $i );
										separator -st none -w 10 -h 10 -bgc 0.5 0.65 0.8 ;
										iconTextButton -w 15 -h 15 -bgc 1 0.3 0.3  -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_key.bmp") -ann "Add keyframe" -c ("setKeyframe " + $FS3Shapes[$i]) ( "fs3_keyshape" + $i );
										iconTextButton -w 15 -h 15 -bgc 0.8 0.7 0.7 -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_autokeyoff.bmp") -ann "Auto Key : off" -c ("FaceStudio3AutoKey " + $i + " fs3_autokey" + $i )("fs3_autokey" + $i);
										iconTextButton -w 15 -h 15 -bgc 0.8 0.5 0.5 -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_removekey.bmp") -ann "Remove all shape keys" -c ("FaceStudio3DeleteKey " + $i ) ("fs3_delkey" + $i);
										iconTextButton -w 15 -h 15 -bgc 0.9 0.9 1 -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_customize.bmp") -ann "Customize shape icon" -c ( "FaceStudio3CustomizeIcons " + $i ) ("fs3_customkey" + $i);
										setParent ..;

								}
 								setParent ..;
					setParent fs3row;
					setParent ..;				

			// ANIMATION ED. TOOLS
			
			columnLayout -bgc 0.6 0.6 0.6 -p fs3_GLOBALLAYOUT fs3_AETOOLS;
			
			rowLayout -nc 5 -cw5 35 110 110 110 110 -bgc 0.4 0.25 0.15;
				separator -st none -bgc 0.4 0.25 0.15;		
				iconTextButton -c ( "FaceStudio3ObjectsUI " + $obj ) -ann "Add/Remove objects to the FaceStudio view" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_include.bmp") -w 110 -h 25;
				iconTextButton -ann "Make a playblast of the face" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_playblast.bmp") -c "FaceStudio3Playblast" -w 110 -h 25;
				iconTextButton -ann "Adjust FaceStudio camera" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_settings.bmp") -w 110 -h 25 -c "FaceStudio3CameraSettingUI";
				rowLayout -nc 5 -cw5 67 67 110 110 110 -bgc 0.6 0.6 0.6;
					iconTextButton -ann "Switch to graphEditor" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_grapheditor.bmp") -w 67 -h 25
							-c "frameLayout -e -vis off FSdope; frameLayout -e -vis on FSgraph";
					iconTextButton -ann "Switch to dopeSheet" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_dopesheet.bmp") -w 67 -h 25
							-c "frameLayout -e -vis on FSdope; frameLayout -e -vis off FSgraph";
					iconTextButton -ann "Key all shapes" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_keyall.bmp") -w 110 -h 25 -c "FaceStudio3KeyAll";
					iconTextButton -ann "Set all shapes to 0" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_resetall.bmp") -w 110 -h 25 -c "FaceStudio3ResetAll";
					iconTextButton -ann "Delete all shapes keys" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_deleteall.bmp") -w 110 -h 25 -c "FaceStudio3DeleteAllKey";
				setParent ..;
			setParent ..;
				
			rowLayout -nc 2 -cw2 600 230;
				columnLayout fs3time;
					frameLayout -label " Time Attributes :"  -w 600 -h 310 FSdope;
						if ( `scriptedPanel -ex fs3_dope` == 1 )
							deleteUI fs3_dope;
						
						if ( `scriptedPanel -ex fs3_graph` == 1 )
							deleteUI fs3_graph;
						
						select -r -ne $FS3ShapeNode;
						string $DopeSheetPane = `scriptedPanel -typ dopeSheetPanel fs3_dope` ;

						toggleAutoLoad ($DopeSheetPane + "OutlineEd") 0;
						dopeSheetEditor -e -hb off ($DopeSheetPane + "DopeSheetEd");

						setParent fs3time;
					frameLayout -vis off -label " Time Attributes :"  -w 600 -h 310 FSgraph;
						string $GraphEditorPane = `scriptedPanel -typ graphEditor fs3_graph` ; 
						toggleAutoLoad ($GraphEditorPane + "OutlineEd") 0;
						select -cl;
						setParent fs3time; setParent ..;
					
					columnLayout -adjustableColumn true fs3groups;
						frameLayout -p fs3groups -w 200 -h 115 -l "Eyes Control" EyeFrameLayout;
							columnLayout -p EyeFrameLayout -h 140  -bgc 0.6 0.4 0.1 fs3colEye;
								rowLayout -p fs3colEye -h 90  -bgc 0.6 0.4 0.1 -nc 2 -cw2 85 120 fs3eyerow1;
									columnLayout -p fs3eyerow1  -bgc 0.6 0.4 0.1;
										separator -st none -h 8 -bgc 0.6 0.4 0.1;
										iconTextButton 	-l "Eyes Control"
												-c ( "")
												-ann "Eyes Control"
												-style "iconAndTextVertical" -w 87 -h 87
												-image1 ( `internalVar -upd` + "icons/FaceStudio3/fs3_eye.bmp" )
												("EyeButton");								
									setParent ..;
									columnLayout -p fs3eyerow1 -bgc 0.6 0.4 0.1;
										separator -st none -w 200 -h 8 -bgc 0.6 0.4 0.1;
										iconTextButton 	-ann "switch to wireframe view" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_linkeye.bmp") -w 136 -h 20
												-c "FaceStudio3LinkEyeSliders";			

										separator -st none -w 200 -h 8 -bgc 0.6 0.4 0.1;

										rowLayout -h 50 -bgc 0.6 0.4 0.1 -nc 2 -cw2 90 120 fs3eyerow1;
											attrFieldSliderGrp -l "" -bgc 0.6 0.4 0.1 -pre 2 -cw 1 1 -cw 2 33 -cw 3 55 -min 0 -max 1 ("FShorieye");	
											columnLayout -p fs3eyerow1 -bgc 0.6 0.4 0.1;
												rowLayout -bgc 0.6 0.4 0.1 -nc 3 -cw3 15 15 15;
													iconTextButton -w 15 -h 15 -bgc 0.6 0.4 0.1  -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_key.bmp") -ann "Set Key" -c ("FaceStudioKeyEye hori");
													iconTextButton -w 15 -h 15 -bgc 0.6 0.4 0.1  -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_autokeyoff.bmp") -ann "Auto Key : off" -c ("FaceStudioAutoKeyEye hori") FS3autokeyhori;
													iconTextButton -w 15 -h 15 -bgc 0.6 0.4 0.1  -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_removekey.bmp") -ann "Remove Keys" -c ("FaceStudioRemoveKeyEye hori");	
												setParent ..;
											setParent ..;
										setParent ..;
										separator -st none -w 200 -h 8 -bgc 0.6 0.4 0.1;

										rowLayout -h 50 -bgc 0.6 0.4 0.1 -nc 2 -cw2 90 120 fs3eyerow2;
											attrFieldSliderGrp -l "" -bgc 0.6 0.4 0.1 -pre 2 -cw 1 1 -cw 2 33 -cw 3 55 -min 0 -max 1 ("FSvertieye");	
											columnLayout -p fs3eyerow2 -bgc 0.6 0.4 0.1;
												rowLayout -bgc 0.6 0.4 0.1 -nc 3 -cw3 15 15 15;
													iconTextButton -w 15 -h 15 -bgc 0.6 0.6 0.6  -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_key.bmp") -ann "Set Key" -c ("FaceStudioKeyEye verti");
													iconTextButton -w 15 -h 15 -bgc 0.6 0.6 0.6  -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_autokeyoff.bmp") -ann "Auto Key : off" -c ("FaceStudioAutoKeyEye verti") FS3autokeyverti;
													iconTextButton -w 15 -h 15 -bgc 0.6 0.6 0.6  -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_removekey.bmp") -ann "Remove Keys" -c ("FaceStudioRemoveKeyEye verti");	
												setParent ..;	
											setParent ..;
										setParent ..;
									setParent ..;

						frameLayout -p fs3groups -h 196 -l "Shapes Groups" GroupFrameLayout;
							scrollLayout -bgc 0.4 0.7 0.5  -cr true -w 220 -h 310 ScrollGroup;
							columnLayout -bgc 0.4 0.7 0.5 -p ScrollGroup fs3group;
								gridLayout -bgc 0.4 0.7 0.5 -nc 3 -nr 5 -cw 65 -ch 80 GridGroup;
									columnLayout -bgc 0.4 0.7 0.5 -p GridGroup -w 65 -h 50 -adjustableColumn true ( "ColGroup1");
										iconTextButton 	-l ("All Shapes") -bgc 0.4 0.7 0.5
												-style "iconAndTextVertical" -w 50 -h 50
												-image1 ( `internalVar -upd` + "icons/FaceStudio3/fs3_selgroup.bmp" )
												-c ("FaceStudio3ShowGroupLayout 1; frameLayout -e -vis on ShapeLayout1;iconTextButton -e -i1 ( \`internalVar -upd\` + \"icons/FaceStudio3/fs3_selgroup.bmp\" ) groupButton1" )
												groupButton1; 

										text -bgc 0.4 0.7 0.5 -l "All Shapes";
									setParent ..;
									
						setParent fs3time;
						setParent ..;
				setParent ..;
				rowLayout -nc 5 -cw5 50 663 50 30 30;
					rowLayout -nc 2 -cw2 20 30;					
						iconTextButton  -i1  ( `internalVar -upd`+ "icons/FaceStudio3/fs3_switchS.bmp")  -w 20 -h 30 -c "FaceStudio3SwitchPort" FS3switchPort;
						intFieldGrp -w 30 -h 30 -v1 `playbackOptions -q -ast`  -cc ("playbackOptions -e -min \`intFieldGrp -q -v1 fs3_st\` -ast \`intFieldGrp -q -v1 fs3_st\`") fs3_st;
						setParent ..;
					columnLayout -adjustableColumn true FS3barLayout;
							columnLayout -adjustableColumn true FS3timeLayout;
							timePort -bgc 0.6 0.6 0.6 -w 663 -h 30 -gt true FS3timePort;
							setParent ..;

							columnLayout -adjustableColumn true -vis off FS3soundLayout;
 							soundControl -width 663 -height 30 -displaySound false -waveform both -pc "soundControl -e -beginScrub FS3scrubPort" -rc "soundControl -e -endScrub FS3scrubPort" FS3scrubPort;							
 							setParent ..;
 							
						setParent ..;
						
					intFieldGrp -w 50 -h 30 -v1 `playbackOptions -q -aet` -cc ("playbackOptions -e -max \`intFieldGrp -q -v1 fs3_et\` -aet \`intFieldGrp -q -v1 fs3_et\`") fs3_et;

					iconTextButton -ann "Play backward" -i1 ( `internalVar -upd`+ "icons/FaceStudio3/fs3_playback.bmp") -w 30 -h 30
