/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3SoundSettingsWindow ()
{	
	global string $FaceStudio3MainWindow;

	string $obj = `window -q -dtg $FaceStudio3MainWindow`;
	string $FS3node[] = `listConnections ($obj + ".FaceStudio3Node")`;
	
	string $FS3sound = `getAttr ( $FS3node[0] + ".sound" )`;
	int $FS3soundOffset = `getAttr ( $FS3node[0] + ".soundOffset" )`;
	
	if ( $FS3sound == "" )
		{ $FS3sound = "none"; }
	
	string $FaceStudio3SoundSettingsWindow = "FaceStudio3SoundSettingWindow";
	if (`window -exists $FaceStudio3SoundSettingsWindow` )
		deleteUI $FaceStudio3SoundSettingsWindow;	
		
	window -tlb off -s off  -width 550 -height 165 -bgc 0.6 0.6 0.6 -title "FaceStudio v.3.0  -  Sound Settings" $FaceStudio3SoundSettingsWindow; 	
		columnLayout -bgc 0.6 0.6 0.6 -adjustableColumn true;
			separator -st none -h 30 -bgc 0.6 0.6 0.6;
			rowLayout -nc 3 -cw3 55 435 50;
				text -h 22 -bgc 0.6 0.6 0.6 -l "   Sound    ";
				textField -tx $FS3sound -en off -w 435 fs3_sound;
				button -l "     ..." -w 52 -bgc 1 1 1.0 -c "FaceStudio3PickSound";
			setParent ..;
			separator -st none -h 15 -bgc 0.6 0.6 0.6;
			intFieldGrp -cw2 97 50 -l "Offset" -v1 $FS3soundOffset -bgc 0.6 0.6 0.6 fs3_soundOffset;
			separator -st none -h 15 -bgc 0.6 0.6 0.6;
			rowLayout -nc 2 -cw2 275 275;
				columnLayout;
					button -l "Apply" -w 275 -h 30 -bgc 1 1 1 -c ("FaceStudio3ApplySoundSettings; window -e -vis off " + $FaceStudio3SoundSettingsWindow);
				setParent ..;
				columnLayout;
					button -l "Cancel" -w 275 -h 30 -bgc 1 1 1 -c ("window -e -vis off " + $FaceStudio3SoundSettingsWindow);
				setParent ..;
	showWindow $FaceStudio3SoundSettingsWindow;
	
}
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3ObjectsUI (string $obj)
{
	
	string $FS3listObj[] = `ls -g`;
	$FS3listObj = `sort $FS3listObj`;
	
	string $FaceStudio3ObjectsWindow = "FaceStudio3ObjectsWindow";
	if (`window -exists $FaceStudio3ObjectsWindow` )
		deleteUI $FaceStudio3ObjectsWindow;	
	window -tlb off -s off  -width 550 -height 340 -bgc 0.6 0.6 0.6 -title "FaceStudio v.3.0  -  Viewed Objects" $FaceStudio3ObjectsWindow; 	
		columnLayout -bgc 0.6 0.6 0.6 -adjustableColumn true;
			separator -bgc 0.6 0.6 0.6 -st none -h 10;
			rowLayout -bgc 0.6 0.6 0.6 -nc 3 -cw3 245 50 250;
				columnLayout -w 245 -adjustableColumn true -bgc 0.6 0.6 0.6;
					text -l "Scene Objects" -bgc 0.6 0.6 0.6;
					textScrollList -ams true -w 245 -h 240 FS3listObj;
					for ( $i=0;$i<size($FS3listObj);$i++ )
					{
						string $objShape[] = `listRelatives -p $FS3listObj[$i]`;
						if ( $objShape[0] != "" )
						{
							textScrollList -e -w 245 -h 240 -append $objShape[0] FS3listObj;
						}
						else
						{
							textScrollList -e -w 245 -h 240 -append $FS3listObj[$i] FS3listObj;
						}
					}
				setParent ..;
				columnLayout  -bgc 0.6 0.6 0.6;
					separator -st none -h 80  -bgc 0.6 0.6 0.6;
					button 	-ann "add objects to view" -l ">>" -w 50 -h 50 -bgc 1 1 1
						-c "FaceStudio3AddToList";
					
					button -ann "remove objects from view" -l "<<" -w 50 -h 50 -bgc 1 1 1
						-c "FaceStudio3RemFromList";

				setParent ..;					
				columnLayout -adjustableColumn true -bgc 0.6 0.6 0.6;
					text -l "Viewed Objects" -bgc 0.6 0.6 0.6;	
					textScrollList -ams true -w 245 -h 240 FS3viewObj;
				setParent ..;	
			setParent ..;
			separator -st none -h 5 -bgc 0.6 0.6 0.6;
			rowLayout -nc 2 -cw2 274 274;
				columnLayout -adjustableColumn true;
					button -l "Apply" -w 274 -h 40 -bgc 1 1 1 -c ("FaceStudio3DisplayObjects;window -e -vis off " + $FaceStudio3ObjectsWindow) ;				
				setParent ..;
				columnLayout -adjustableColumn true;
					button -l "Cancel" -w 274 -h 40 -bgc 1 1 1 -c ("window -e -vis off " + $FaceStudio3ObjectsWindow);				
				setParent ..;
	
	FaceStudio3FilterObjectList;
	showWindow $FaceStudio3ObjectsWindow;
}
