global proc FaceStudio3About ()
{
	global string $FaceStudio3Console;
	
	FaceStudio3InitConsole;
	FaceStudio3ConsoleMessage "- contact : guils_r@hotmail.com";
	FaceStudio3ConsoleMessage "- web : http://www.cgguils.fr.st";
	window -e -title "FaceStudio v.3.0  About..." $FaceStudio3Console;
	FaceStudio3ConsoleMessage "                             -------------";
	FaceStudio3ConsoleMessage "Please contact me to report any bug, send any";
	FaceStudio3ConsoleMessage "comment or suggestion.";
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
global proc FaceStudio3LoadDialog ()
{
	string $fs3defaultPath = ( `internalVar -usd` + "FaceStudio3/UI_save/" );
	string $fs3loadFile = `fileDialog -dm ($fs3defaultPath + "*.fs3")`;
	if ( $fs3loadFile != "" )
	{	
		FaceStudio3ReadUIFile $fs3loadFile;
	}
}
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3SaveDialog ()
{
	string $fs3defaultPath = ( `internalVar -usd` + "FaceStudio3/UI_save/" );
 	fileBrowserDialog -tm "Save your UI as myUI.fs3 for example" -ds 2 -m 2 -fc "FaceStudio3WriteUIFile" -fl ("FaceStudio3UI (*.fs3), *.fs3") -wt "FaceStudio3  -  Save UI" -an "Save" -om "ExportActive";	
}

