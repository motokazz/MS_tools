/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

global proc FaceStudio3GroupCreateUI ()
{
	string $FaceStudio3GroupCreate = "FaceStudio3GroupCreateWin";
	if (`window -exists $FaceStudio3GroupCreate` )
		deleteUI $FaceStudio3GroupCreate;	

	window -tlb off -s off  -width 300 -height 115  -title "FaceStudio v.3.0  -  Create a group" $FaceStudio3GroupCreate;
		columnLayout -bgc 0.6 0.6 0.6 -adjustableColumn true;		
			separator -st none -h 20 -bgc 0.6 0.6 0.6;
			textFieldGrp -bgc 0.6 0.6 0.6 -l "Name" -cw2 50 250 -tx "noname" fs3_groupname;
			separator -st none -h 10 -bgc 0.6 0.6 0.6;
			rowLayout -nc 2 -cw2 148 150;
				columnLayout;
					button -l "Create" -w 148 -h 30 -bgc 1 1 1  -c ( "FaceStudio3GroupCreate;window -e -vis off " + $FaceStudio3GroupCreate);
				setParent ..;
				columnLayout;
					button -l "Cancel" -w 150 -h 30 -bgc 1 1 1 -c ( "window -e -vis off " + $FaceStudio3GroupCreate);
				setParent ..;

	showWindow $FaceStudio3GroupCreate;
}

