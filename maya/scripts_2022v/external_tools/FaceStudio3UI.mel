global proc FaceStudio3GroupRenameUI ()
{
	string $FaceStudio3GroupRename = "FaceStudio3GroupRenameWin";
	if (`window -exists $FaceStudio3GroupRename` )
		deleteUI $FaceStudio3GroupRename;	

	string $groupName[] = `textScrollList -q -si fs3_groupsList`;

	window -tlb off -s off  -width 300 -height 115  -title "FaceStudio v.3.0  -  Rename group" $FaceStudio3GroupRename;
		columnLayout -bgc 0.6 0.6 0.6 -adjustableColumn true;		
			separator -st none -h 20 -bgc 0.6 0.6 0.6;
			textFieldGrp -bgc 0.6 0.6 0.6 -l "Name" -cw2 50 250 -tx $groupName[0] fs3_groupnewname;
			separator -st none -h 10 -bgc 0.6 0.6 0.6;
			rowLayout -nc 2 -cw2 148 150;
				columnLayout;
					button -l "Rename" -w 148 -h 30 -bgc 1 1 1  -c ( "FaceStudio3GroupRename;window -e -vis off " + $FaceStudio3GroupRename);
				setParent ..;
				columnLayout;
					button -l "Cancel" -w 150 -h 30 -bgc 1 1 1 -c ( "window -e -vis off " + $FaceStudio3GroupRename);
				setParent ..;

	showWindow $FaceStudio3GroupRename;
}

