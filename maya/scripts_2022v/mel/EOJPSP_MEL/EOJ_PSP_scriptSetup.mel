/*
EOJ_PSP_scriptSetupUI
坂井元一

EOPPSPで使用するツールPEdit用のアトリビュートをMAYAでセットアップします。

EOJ_PSP_matterSetup_set(string $toroAttr,int $value)
$toroAttrで指定したアトリビュートを$valueの値、任意の型式でshapeノードに追加します。

*/

global proc EOJ_PSP_scriptSetup_addMotionTable(string $mode,int $index){
	
	string $obj[]=`ls -tr -sl`;
	
	if(!size($obj)){
		return;
	}
	
	string $relatedShape[]=`listRelatives -typ shape $obj[0]`;
	
	string $value;
	
	if (`attributeExists "MotionTable" $relatedShape[0]`){
		$value=`getAttr ($relatedShape[0]+".MotionTable")`;
	}
	
	string $separatedCommand[];
	tokenize($value,";",$separatedCommand);
	
	//add
	if($mode=="add"){
		$value=$value+"AddMotionTable(\"New\",0,0,0);";
		if (!`attributeExists "MotionTable" $relatedShape[0]`){
			addAttr -k false -hidden false -ln "MotionTable"  -dt "string" $relatedShape[0];
			setAttr -type "string" ($relatedShape[0]+".MotionTable") $value;
		}else{
			setAttr -type "string" ($relatedShape[0]+".MotionTable") $value;
		}
	}
	
	//modify
	int $index;
	if($mode=="modify"){
		$separatedCommand[$index]="";
		$separatedCommand[$index]=$separatedCommand[$index]+`text -q -l ("addMotionTable"+$index)`;
		$separatedCommand[$index]=$separatedCommand[$index]+"(\"";
		$separatedCommand[$index]=$separatedCommand[$index]+`textField -q -tx ("addMotionTableTag"+$index)`;
		$separatedCommand[$index]=$separatedCommand[$index]+"\",";
		$separatedCommand[$index]=$separatedCommand[$index]+`intField -q -v ("addMotionTableValueA"+$index)`;
		$separatedCommand[$index]=$separatedCommand[$index]+",";
		$separatedCommand[$index]=$separatedCommand[$index]+`intField -q -v ("addMotionTableValueB"+$index)`;
		$separatedCommand[$index]=$separatedCommand[$index]+",";
		$separatedCommand[$index]=$separatedCommand[$index]+`intField -q -v ("addMotionTableValueC"+$index)`;
		$separatedCommand[$index]=$separatedCommand[$index]+")";
		$value=`stringArrayToString $separatedCommand ";"`+";";
		setAttr -type "string" ($relatedShape[0]+".MotionTable") $value;
	}
	
	//delete
	if($mode=="delete"){
		$value="";
		stringArrayRemoveAtIndex($index,$separatedCommand);
		for($each in $separatedCommand){
			$value=$value+$each+";";
		}
		setAttr -type "string" ($relatedShape[0]+".MotionTable") $value;
	}
	
	//show
	EOJ_PSP_scriptSetup_MotionTableWindow $value;
}

global proc EOJ_PSP_scriptSetup_MotionTableWindow(string $MotionTable){
	string $obj[]=`ls -tr -l -sl`;
	string $separatedCommand[];
	tokenize($MotionTable,";",$separatedCommand);
	if (`window -q -ex EOJ_PSP_scriptSetup_MotionTableLayout`){
		deleteUI EOJ_PSP_scriptSetup_MotionTableLayout;
	}
	window EOJ_PSP_scriptSetup_MotionTableLayout;
	columnLayout;
	text -w 80 -l "selected object";
	text -w 320 -h 40 -fn "boldLabelFont" -bgc 0.9 1.0 0.9 -l $obj[0] "EOJ_PSP_scriptSetup_addMotionTable_selected";
	rowLayout -nc 2 -cw2 160 160;
		button -w 160 -bgc 0.9 1.0 1.0 -l "addTable" -c "EOJ_PSP_scriptSetup_addMotionTable add 0";
		button -w 160 -bgc 0.9 0.9 1.0 -l "show Object Table" -c "EOJ_PSP_scriptSetup_addMotionTable show 0";
	setParent..;
	rowLayout -nc 6 -cw6 80 80 40 40 40 50;
		text -w 50 -l "script";
		text -w 50 -l "name";
		text -w 50 -l "start";
		text -w 50 -l "count";
		text -w 50 -l "offset";
	setParent..;
	if($MotionTable!=""){
		int $i;
		for($each in $separatedCommand){
			string $commandA=("EOJ_PSP_scriptSetup_addMotionTable modify "+$i);
			string $commandB=("EOJ_PSP_scriptSetup_addMotionTable delete "+$i);
			string $tmp[];
			tokenize($each,"\"(,)",$tmp);
			rowLayout -nc 6 -cw6 80 80 40 40 40 30 ;
				text -l $tmp[0] ("addMotionTable"+$i);
				textField -w 80 -cc $commandA -tx $tmp[1] ("addMotionTableTag"+$i);
				intField -w 40 -cc $commandA -v (int($tmp[2])) ("addMotionTableValueA"+$i);
				intField -w 40 -cc $commandA -v (int($tmp[3])) ("addMotionTableValueB"+$i);
				intField -w 40 -cc $commandA -v (int($tmp[4])) ("addMotionTableValueC"+$i);
				button -bgc 1.0 0.9 0.8 -w 30 -l "del" -c $commandB;
			setParent..;
			$i++;
		}
	}
	setParent..;
	window -e -w 320 -h (100+((size($separatedCommand)+1)*22)) EOJ_PSP_scriptSetup_MotionTableLayout;
	
	showWindow EOJ_PSP_scriptSetup_MotionTableLayout;
}

global proc EOJ_PSP_scriptSetup_preset(string $userAttr[]){
	
	string $floatFieldList[] = {
	};

	string $intFieldList[] = {
	};

	string $floatSliderGrpList[] = {
	};

	string $intSliderGrpList[] = {
	};

	string $checkBoxList[] = {
	};

	string $radioButtonGrpList[] = {
	};

	string $frameLayoutList[] = {
	};

	string $textFieldList[] = {
		"AddMotionTable"
	};

	string $textFieldList_file[] = {
	};
	string $optionMenu[] = {
	};
	
	
	for($each in $userAttr){
		if(`stringArrayContains $each  $textFieldList`){
			 string $value=`textField -q -tx $each`;
			 EOJ_PSP_scriptSetup_set $each $value "string";
		}
		
		if(`stringArrayContains $each  $intFieldList`){
			 int $value=`intField -q -v $each`;
			 EOJ_PSP_scriptSetup_set $each $value "int";
			 print ($each+":"+$value+"\n");
		}
	}
	
	
}

global proc EOJ_PSP_scriptSetup_set(string $userAttr,string $value,string $style){
	string $obj[]=`ls -tr -sl`;

	if (size($obj)){
		for($each in $obj){
			string $relatedShape[]=`listRelatives -typ shape $each`;
			
			
			if($style=="string"){
				if(!`attributeExists $userAttr  $relatedShape[0]`){
					addAttr -k false -hidden false -ln $userAttr  -dt "string" $relatedShape[0];
				}
				setAttr -type "string" ($relatedShape[0]+"."+$userAttr) $value;
			}
			
			if($style=="int"){
				if(!`attributeExists $userAttr  $relatedShape[0]`){
					addAttr -k false-at short -hidden false -ln  $userAttr $relatedShape[0];
				}
				setAttr -channelBox true ($relatedShape[0]+"."+$userAttr) (int($value));				
			}
			
		}
	}
}

global proc EOJ_PSP_scriptSetupUI_storeRecallUI ( string $mode ){
	string $prefix="MS_EOJ_PSP_scriptSetupUI__";
	
	string $floatFieldList[] = {
		};

	string $intFieldList[] = {
		};

	string $floatSliderGrpList[] = {
		};

	string $intSliderGrpList[] = {
		};

	string $checkBoxList[] = {
		};

	string $radioButtonGrpList[] = {
		};

	string $frameLayoutList[] = {
		};

	string $textFieldList[] = {
		};

	string $textFieldList_file[] = {
		};
		
	string $optionMenu[] = {
		};

	int $cnt;

	if ( $mode == "store" )
	{
		for ( $each in $floatFieldList)
			optionVar -floatValue ($prefix+$each) `floatField -q -value $each`;

		for ( $each in $intFieldList)
			optionVar -intValue ($prefix+$each) `intField -q -value $each`;

		for ( $each in $floatSliderGrpList)
			optionVar -floatValue ($prefix+$each) `floatSliderGrp -q -value $each`;

		for ( $each in $intSliderGrpList)
			optionVar -intValue ($prefix+$each) `intSliderGrp -q -value $each`;

		for ( $each in $checkBoxList)
			optionVar -intValue ($prefix+$each) `checkBox -q -value $each`;

		for ( $each in $radioButtonGrpList)
			optionVar -intValue ($prefix+$each) `radioButtonGrp -q -select $each`;

		for ( $each in $frameLayoutList)
			optionVar -intValue ($prefix+$each) `frameLayout -q -collapse $each`;

		for ( $each in $textFieldList)
			optionVar -stringValue ($prefix+$each) `textField -q -tx $each`;

		for ( $each in $textFieldList_file)
			optionVar -stringValue ($prefix+$each) `textField -q -fileName $each`;

		for ( $each in $optionMenu)
			optionVar -intValue ($prefix+$each) `optionMenu -q -sl $each`;
	}

	if ( $mode == "recall" )
	{
		for ( $each in $floatFieldList)
			if ( `optionVar -exists ($prefix+$each)` )
				floatField -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $intFieldList)
			if ( `optionVar -exists ($prefix+$each)` )
				intField -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $floatSliderGrpList)
			if ( `optionVar -exists ($prefix+$each)` )
				floatSliderGrp -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $intSliderGrpList)
			if ( `optionVar -exists ($prefix+$each)` )
				intSliderGrp -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $checkBoxList)
			if ( `optionVar -exists ($prefix+$each)` )
				checkBox -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $radioButtonGrpList)
			if ( `optionVar -exists ($prefix+$each)` )
				radioButtonGrp -e -select `optionVar -q ($prefix+$each)` $each;

		for ( $each in $frameLayoutList)
			if ( `optionVar -exists ($prefix+$each)` )
				frameLayout -e -collapse `optionVar -q ($prefix+$each)` $each;

		for ( $each in $textFieldList)
			if ( `optionVar -exists ($prefix+$each)` )
				textField -e -tx `optionVar -q ($prefix+$each)` $each;

		for ( $each in $textFieldList_file)
			if ( `optionVar -exists ($prefix+$each)` )
				textField -e -fileName `optionVar -q ($prefix+$each)` $each;
		for ( $each in $optionMenu)
			if ( `optionVar -exists ($prefix+$each)` )
				optionMenu -e -sl `optionVar -q ($prefix+$each)` $each;
	}

	if ( $mode == "reset" )
	{
		for ( $each in $floatFieldList)
			optionVar -remove ($prefix+$each);

		for ( $each in $intFieldList)
			optionVar -remove ($prefix+$each);

		for ( $each in $floatSliderGrpList)
			optionVar -remove ($prefix+$each);

		for ( $each in $intSliderGrpList)
			optionVar -remove ($prefix+$each);

		for ( $each in $checkBoxList)
			optionVar -remove ($prefix+$each);

		for ( $each in $radioButtonGrpList)
			optionVar -remove ($prefix+$each);

		for ( $each in $frameLayoutList)
			optionVar -remove ($prefix+$each);

		for ( $each in $textFieldList)
			optionVar -remove ($prefix+$each);

		for ( $each in $textFieldList_file)
			optionVar -remove ($prefix+$each);

		for ( $each in $optionMenu)
			optionVar -remove ($prefix+$each);
	}
}


global proc EOJ_PSP_scriptSetupUI(){
	if (`window -q -ex EOJ_PSP_scriptSetupUI`){
		deleteUI EOJ_PSP_scriptSetupUI;
	}
	window EOJ_PSP_scriptSetupUI;
	
	columnLayout;
	button -w 300 -l "モーションテーブル" 
		-c "EOJ_PSP_scriptSetup_addMotionTable show 0";
			
			rowLayout -nc 6 -cw6 50 30 50 30 50 50;
			
			textField 
				-w 50
				-cc "EOJ_PSP_scriptSetupUI_storeRecallUI store" 
				"AddMotionTable";
				
			text -l "Start";
			intField
				-v 0 
				-cc "EOJ_PSP_scriptSetupUI_storeRecallUI store" 
				"AddMotionTableStart";
			text -l "Total";
			intField
				-v 0 
				-cc "EOJ_PSP_scriptSetupUI_storeRecallUI store" 
				"AddMotionTableTotal";
			button -w 50 -l "delete" -c "EOJ_PSP_frameSetup_setField";
		setParent..;
		columnLayout "MotionTable";
		string $test[]={"a,100,50,0","b,200,50,0","c,500,30,0","d,40,3,0"};
		for ($each in $test){
			string $new[];
			tokenize($each,",",$new);
			text -w 300 -l ($new[0]+$new[1]+$new[2]);
		}
		setParent..;
		
		
		
	text -w 300 -bgc 0.9 0.9 0.9 -l "PEdit用スクリプト設定";
		separator -w 300;
		textField -w 300 -h 50 "PEScript";
		rowLayout -nc 2 -cw2 150 150;
		button -w 150 -l "PEScriptSetup" -c "EOJ_PSP_extraSetup_preset PEScript";
		button -w 150 -l "PEScriptSetup" -c "EOJ_PSP_extraSetup_preset PEScript";
		setParent..;
		
	text -w 300 -bgc 0.9 0.9 0.9 -l "その他テキスト設定";
		separator -w 300;
		textField -w 300 -h 50 "EXText";
		rowLayout -nc 2 -cw2 150 150;
		button -w 150 -l "PEScriptSetup" -c "EOJ_PSP_extraSetup_preset EXText";
		button -w 150 -l "PEScriptSetup" -c "EOJ_PSP_extraSetup_preset EXText";
		setParent..;
		
		
		
		separator -w 300 -h 100;
		button -w 300 -l "環境変数クリアボタン" -bgc 1.0 0.5 0.5  -c "EOJ_PSP_scriptSetupUI_storeRecallUI reset";
		
		
		
		
		
		
		
	setParent..;
	
	
	
	
	//EOJ_PSP_scriptSetupUI_storeRecallUI recall;
	
	window -e -wh 310 800 EOJ_PSP_scriptSetupUI;
	
	showWindow EOJ_PSP_scriptSetupUI;
}







//EOJ_PSP_scriptSetupUI;


