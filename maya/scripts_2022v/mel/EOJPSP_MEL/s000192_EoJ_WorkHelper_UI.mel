proc string s000192_EoJ_WorkHelper_button(){	string $button_data = "D:/EOJPSP/tools/mel/s000192_EoJ_WorkHelper_button.txt";	string $EOJ_sc_path = "D:/EOJPSP/tools/mel/";	string $source_file[] = {};	string $ret_val = "";	if(`filetest -f $button_data` == 1)	{		$fileId=`fopen $button_data "r"`;		string $set_parts[] = {};		int $index_no = 0;		while ( !`feof $fileId` )		{			string $readLine = `fgetline $fileId`;			$text_count = `tokenize $readLine "\t\n" $set_parts`;			if(`size $set_parts` == 1)			{				$ret_val = $ret_val + ("string $l_" + $index_no + " = `text -l " + "\"" + $set_parts[0] + "\"" + "`;");			}			else			{				$ret_val = $ret_val + ("string $b_" + $index_no + " = `button -l " + "\"" + $set_parts[0] + "\"" + " -al center -c " + "\"" + $set_parts[1] + "\""						 + " -ann " + "\"" + $set_parts[3] + "\"" + " b" + $index_no + "`;");				$source_file[$index_no] = $set_parts[2];				$index_no++;			}		} 		fclose $fileId;	}	else{$err_mess = `confirmDialog -t "Not found" -m "script button list is Not Found" -b "Close" -cb "Close" -ds "Close"`;}	$source_file2 = stringArrayRemoveDuplicates($source_file);	for($i in $source_file2)	{		if(`filetest -f ($EOJ_sc_path + $i)` == 1)		{			string $mel_file = ("\"" + $EOJ_sc_path + $i + "\"");			eval("source " + $mel_file);		}		else		{			$err_mess = `confirmDialog -t "Not found" -m ($i + " Not Found") -b "Close" -cb "Close" -ds "Close"`;		}	}	return $ret_val;}global proc s000192_EoJ_WorkHelper_UI(){	$window = "s000192_EoJ_WorkHelper_UI_window";	if (`window -exists $window`) deleteUI $window;	window $window;	$form = `formLayout`;	string $close_btn = `button -l "Close" -w 100 -c "deleteUI -window s000192_EoJ_WorkHelper_UI_window;"`;	string $sc_lay = `scrollLayout sc_lay`;		columnLayout -adj 1;			string $num_row = `rowColumnLayout -nc 1 -cw 1 200 -ro 1 "top" 5 -co 1 "left" 10 n_r`;			eval(s000192_EoJ_WorkHelper_button());			setParent ..;		columnLayout;	$o = 10;	formLayout -e 		-af $sc_lay "top" $o -af $sc_lay "right" 3 -af $sc_lay "left" 3 -ac $sc_lay "bottom" $o $close_btn		-af $close_btn "right" $o -af $close_btn "bottom" $o		$form;	showWindow ;}