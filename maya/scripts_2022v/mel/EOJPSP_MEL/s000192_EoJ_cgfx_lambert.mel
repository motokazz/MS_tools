/*-----check color texture connection. if connected, connect color texture to lambert shader-----*/proc string s000192_EoJ_cgfx_lambert_reConnectColorTex(string $fxshader, string $lambertshader){	string $connect_chk[] = {};	if(`connectionInfo -id ($fxshader + ".ColorSampler0")` == 1)	{		$connect_chk = `listConnections -d 1 ($fxshader + ".ColorSampler0")`;		connectAttr -f ($connect_chk[0] + ".outColor") ($lambertshader + ".color");	}	return $connect_chk[0];}/*-----check baseColor and baseColorAlpha animation or Value. copy file node Color Gain and Alpha Gain-----*/proc s000192_EoJ_cgfx_lambert_copyGain(string $fxshader, string $file_tex_node){/*copy baseColor value or animation*/	$chk_attr = `listAttr $fxshader`;	if(stringArrayCount("baseColor", $chk_attr) != 0)	{		if(`keyframe -q -kc ($fxshader + ".baseColor")` == 0)		{			$color_val = `getAttr ($fxshader + ".baseColor")`;			setAttr ($file_tex_node + ".colorGain") -type double3 $color_val[0] $color_val[1] $color_val[2];		}	 	else		{			$start_key = `keyframe -in 0 -q ($fxshader + ".baseColor")`;			copyKey -t ":" -f ":" -at "baseColorR" $fxshader;			pasteKey -c 1 -t $start_key[0] -at "cgr" $file_tex_node;			copyKey -t ":" -f ":" -at "baseColorG" $fxshader;			pasteKey -c 1 -t $start_key[0] -at "cgg" $file_tex_node;			copyKey -t ":" -f ":" -at "baseColorB" $fxshader;			pasteKey -c 1 -t $start_key[0] -at "cgb" $file_tex_node;		}	}/*copy baseColorAlpha value or animation*/	if(stringArrayCount("baseColorAlpha", $chk_attr) != 0)	{		if(`keyframe -q -kc ($fxshader + ".baseColorAlpha")` == 0)		{			$alpha_val = `getAttr ($fxshader + ".baseColorAlpha")`;			setAttr ($file_tex_node + ".alphaGain") $alpha_val;		}		else		{			$start_key = `keyframe -in 0 -q ($fxshader + ".baseColorAlpha")`;			copyKey -t ":" -f ":" -at "baseColorAlpha" $fxshader;			pasteKey -c 1 -t $start_key[0] -at "ag" $file_tex_node;		}	}}proc s000192_EoJ_cgfx_set_Attr(string $fxshader, string $lambert_shader){	select -r $lambert_shader;	$list_flag = `getAttr ($fxshader + ".technique")`;/*-----EoJ PSP mel script. made it motokazu sakai-----*/	EOJ_PSP_matterSetup_set("anisoFilter", 0);	EOJ_PSP_matterSetup_set("mipmapFilter", 0);	EOJ_PSP_matterSetup_set("vertexShader", 0);	EOJ_PSP_matterSetup_set("flagmentShader", 0);	if($list_flag == "stexture_add" || $list_flag == "stexture_add_bc" || $list_flag == "stexture_vector_add" || $list_flag == "stexture_vector_add_bc")	{	EOJ_PSP_matterSetup_set("blend", 1);	}	else if($list_flag == "stexture_sub" || $list_flag == "stexture_sub_bc" || $list_flag == "stexture_vector_sub" || $list_flag == "stexture_vector_sub_bc")	{	EOJ_PSP_matterSetup_set("blend", 3);	}	else{EOJ_PSP_matterSetup_set("blend", 0);}	EOJ_PSP_matterSetup_set("fogOff", 0);	if(endString($list_flag, 2) == "bc")	{	EOJ_PSP_matterSetup_set("backfaceCurring", 1);	}	else{	EOJ_PSP_matterSetup_set("backfaceCurring", 0);}	EOJ_PSP_matterSetup_set("zOffset", 0);	EOJ_PSP_matterSetup_set("zFunction", 0);	EOJ_PSP_matterSetup_set("zWrite", 0);	EOJ_PSP_matterSetup_set("aFunction", 0);	EOJ_PSP_matterSetup_set("aReffernce", 0);	EOJ_PSP_matterSetup_set("renderStage", 0);	EOJ_PSP_matterSetup_set("priority", 0);}proc string s000192_EoJ_cgfx_lambert_ret_shader_name(string $shadername){	string $ret_str = "";	string $new_shadername[] = {};	string $div_pathname[] = {};	$path_count = `tokenize $shadername ":" $div_pathname`;	if($path_count != 0){$shadername = $div_pathname[($path_count - 1)];}	$name_count = `tokenize $shadername "_" $new_shadername`;	if($name_count > 1)	{		for($i = 1; $i < `size $new_shadername`; $i++)		{			if($i == 1){$ret_str = $new_shadername[$i];}			else{$ret_str = $ret_str + "_" + $new_shadername[$i];}		}	}	else{$ret_str = "NEW" + $shadername;}	return $ret_str;}global proc s000192_EoJ_cgfx_lambert(){	$mtl_node = `ls -mat`;	for($i in $mtl_node)	{		if(`nodeType $i` == "cgfxShader")		{			string $new_shader = "";			$connect_chk = `listConnections -d 1 ($i + ".outColor")`;			int $chk_bool = 1;			string $cgfx_sg = "";			for($j in $connect_chk)			{				if(`nodeType $j` == "lambert" || `nodeType $j` == "phong"){$chk_bool = 0;}				if(`nodeType $j` == "shadingEngine"){$cgfx_sg = $j;}			}	/*-----create lambert & set connect cgfxSG to lambert hardwareShader-----*/			if($chk_bool == 1)			{				$new_shader_name = s000192_EoJ_cgfx_lambert_ret_shader_name($i);				$new_shader = `shadingNode -as lambert -n $new_shader_name`;				$new_sg = `sets -r true -nss true -em -n ($new_shader + "SG")`;				connectAttr -f ($new_shader + ".outColor") ($new_sg + ".surfaceShader");				connectAttr -f ($i + ".outColor") ($new_shader + ".hardwareShader");		//connect cgfx to lambert hardwareShader				if(`window -ex hyperShadePanel1Window` == 1)				{					window -e -restoreCommand "refreshHyperShadePaneFrontTab firstPaneTabs false;" hyperShadePanel1Window;		//refresh hypershade				}	/*-----re assign cgfx shader to lambert shader-----*/				$assign_node = `listConnections -d 1 ($cgfx_sg + ".dagSetMembers")`;				for($j in $assign_node)				{					sets -e -fe $new_sg $j;					s000192_EoJ_cgfx_set_Attr($i, $new_shader);					select -cl;				}				string $file_tex_node = s000192_EoJ_cgfx_lambert_reConnectColorTex($i, $new_shader);				s000192_EoJ_cgfx_lambert_copyGain($i, $file_tex_node);			}		}	}	$finish_mess = `confirmDialog -t "Finish" -m "Material has been changed" -b "Close" -cb "Close" -ds "Close"`;}source "D:/EOJPSP/tools/mel/EOJ_PSP_matterSetup.mel";