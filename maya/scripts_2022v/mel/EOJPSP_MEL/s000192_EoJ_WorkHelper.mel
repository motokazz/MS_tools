//set camera to ultra rare movieglobal proc s000192_EoJ_set_movie_camera_setting(){	$cam_shape = `ls -ca`;	$chk_cam = 0;	for($i in $cam_shape)	{		$cam_tr = `listRelatives -p $i`;		if($cam_tr[0] == "cam_main"){$chk_cam = 1; break;}	}	if($chk_cam == 0)	{		$new_cam = `camera -coi 5 -fl 35 -lsr 1 -cs 1 -hfa 1.41732 -hfo 0 -vfa 0.94488 -vfo 0 -ff Fill -ovr 1 -mb 0 -sa 144 -ncp 0.01 -fcp 1000 -o 0 -ow 30`;		rename $new_cam[0] "cam_main";		setAttr defaultResolution.width 128;		setAttr defaultResolution.height 256;		setAttr "defaultResolution.deviceAspectRatio" 0.5;		setAttr defaultResolution.pixelAspect 1;		lookThroughModelPanel cam_main modelPanel4;		updateModelPanelBar modelPanel4;		camera -e -dr 1 -ovr 1.3 "cam_main";	}}//change local or world mode when select move or rotate mode only.global proc s000192_EoJ_set_local_world_manip(){	$now_ctx = `currentCtx`;	if($now_ctx == "moveSuperContext")	{		int $chk_move_mode = `manipMoveContext -q -mode Move`;		switch($chk_move_mode)		{			case 0:				manipMoveContext -e -mode 2 Move;				break;			case 2:				manipMoveContext -e -mode 0 Move;				break;			default:				break;		}	}	else if($now_ctx == "RotateSuperContext")	{		int $chk_rot_mode = `manipRotateContext -q -mode Rotate`;		switch($chk_rot_mode)		{			case 0:				manipRotateContext -e -mode 1 Rotate;				break;			case 1:				manipRotateContext -e -mode 0 Rotate;				break;			default:				break;		}	}	else{}}//list up & edit material priority valueglobal proc s000192_EoJ_Priority_check_sel(int $index_no, int $chk_type){	if($chk_type == 0)	{		string $node_name = `button -q -l ("b_" + $index_no)`;		$sg_name = `listConnections -d 1 ($node_name + ".outColor")`;		$geo_name = `listConnections -d 1 ($sg_name[0] + ".dagSetMembers")`;		select -cl;		for($i in $geo_name)		{			select -tgl $i;		}		select -tgl $node_name;	}	else	{		string $node_name = `button -q -l ("b_" + $index_no)`;		select -r $node_name;	}}global proc s000192_EoJ_Priority_check_set_val(int $index_no, int $chk_type){	string $set_attr = "priority";	string $node_name = `button -q -l ("b_" + $index_no)`;	float $node_val = `intField -q -v ("bv_" + $index_no)`;	setAttr ($node_name + "." + $set_attr) $node_val;}proc string s000192_EoJ_Priority_check_attr(){	$mat_name = `ls -mat`;	string $chk_attr = "priority";	string $ret_val = "";	int $index_no = 0;	for($i in $mat_name)	{		$sg_name = `listConnections -d 1 ($i + ".outColor")`;		for($k in $sg_name)		{			$geo_name = `listConnections -d 1 ($k + ".dagSetMembers")`;			if(`attributeQuery -node $i -ex $chk_attr` == 1)			{				int $pri_val = `getAttr ($i + "." + $chk_attr)`;				$ret_val = $ret_val + ("string $bt_" + $index_no + " = `text -w 10 -l  " + "\"   Material" + "\"`;" +					"string $b_" + $index_no + " = `button -l " + $i + " -al left -c " + "\"s000192_EoJ_Priority_check_sel(" + $index_no +", 0) " + "\" b_" + $index_no + "`;" +					"string $bv_" + $index_no + " = `intField -v " + $pri_val + " -cc " + "\"s000192_EoJ_Priority_check_set_val(" + $index_no +", 0) " + "\"bv_" + $index_no + "`;");				$index_no ++;					for($j in $geo_name)				{					$shape_name = `listRelatives -f -s $j`;					if(`attributeQuery -node $shape_name[0] -ex "priority"` == 1)					{						int $pri_val2 = `getAttr ($shape_name[0] + "." + $chk_attr)`;						$ret_val = $ret_val + ("string $bt_" + $index_no + " = `text -l  " + "\"             |_" + "\"` ;" +							"string $b_" + $index_no + " = `button -bgc 0.5 0.7 0.5 -l " + $shape_name[0] + " -al left -c " + "\"s000192_EoJ_Priority_check_sel(" + $index_no +", 1) " + "\" b_" + $index_no + "`;" +							"string $bv_" + $index_no + " = `intField -v " + $pri_val2 + " -cc " + "\"s000192_EoJ_Priority_check_set_val(" + $index_no +", 1) " + "\"bv_" + $index_no + "`;");						$index_no ++;					}				}			}			else			{				for($j in $geo_name)				{					$shape_name = `listRelatives -f -s $j`;					if(`attributeQuery -node $shape_name[0] -ex "priority"` == 1)					{						int $pri_val2 = `getAttr ($shape_name[0] + "." + $chk_attr)`;						$ret_val = $ret_val + ("string $bt_" + $index_no + " = `text -l  " + "\"ShapeOnly" + "\"` ;" +							"string $b_" + $index_no + " = `button -bgc 0.5 0.5 0.7 -l " + $shape_name[0] + " -al left -c " + "\"s000192_EoJ_Priority_check_sel(" + $index_no +", 1) " + "\" b_" + $index_no + "`;" +							"string $bv_" + $index_no + " = `intField -v " + $pri_val2 + " -cc " + "\"s000192_EoJ_Priority_check_set_val(" + $index_no +", 1) " + "\"bv_" + $index_no + "`;");						$index_no ++;					}				}			}		}	}	return $ret_val;}global proc s000192_EoJ_Priority_check(){	$window = "s000192_EoJ_Priority_check";	if (`window -exists $window`) deleteUI $window;	window $window;	scrollLayout sc_lay;		columnLayout -adj 1;			frameLayout -l "Set_Priority" -la "top" -bs "etchedIn" f_l;				string $num_row = `rowColumnLayout -nc 3 -cw 1 55 -cw 2 180 -cw 3 30 n_r`;				eval(s000192_EoJ_Priority_check_attr());				setParent ..;			setParent ..;		columnLayout;	rowColumnLayout -nc 1 -ro 1 "top" 20 -cw 1 80;	string $close_btn = `button -l "Close" -c "deleteUI -window s000192_EoJ_Priority_check;"`;	showWindow ;}//Reload texture'sglobal proc s000192_EoJ_reload_tex(){	$tex_file = `ls -tex`;	for($i in $tex_file)	{		if(`nodeType $i` == "file")		{			AEfileTextureReloadCmd file1.fileTextureName;		}	}}//Freeze transform and Reset Pivotglobal proc s000192_EoJ_reset_piv(){	$node = `ls -sl -l`;	for($i in $node)	{		makeIdentity -a 1 -t 1 -r 1 -s 1 -n 0;		move -a 0 0 0 ($i + ".scalePivot") ($i + ".rotatePivot");	}}//View One Nodeglobal proc s000192_EoJ_View_One_set_val(string $btn_index, int $chk_mode){	int $num_row = `rowColumnLayout -q -nr n_r`;	if($chk_mode == 0)	{		for($i = 0; $i < $num_row; $i++)		{			string $node_s_name = `button -q -l ("bv" + $i)`;			if($i == $btn_index)			{				setAttr ($node_s_name + ".visibility") 1;				button -e -bgc 1 0 0 ("bv" + $i);				button -e -vis 0 ("bv" + $i);				button -e -vis 1 ("bv" + $i);			}			else			{				setAttr ($node_s_name + ".visibility") 0;				button -e -bgc 0.7 0.7 0.7 ("bv" + $i);				button -e -vis 0 ("bv" + $i);				button -e -vis 1 ("bv" + $i);			}		}	}	else	{		for($i = 0; $i < $num_row; $i++)		{			string $node_s_name = `button -q -l ("bv" + $i)`;			setAttr ($node_s_name + ".visibility") 1;		}	}}global proc string s000192_EoJ_View_One_set(){	string $filter_node[] = {};	string $ret_val = "";	$all_shape_node = `ls -s -l`;	int $index_no = 0;	for($i in $all_shape_node)	{		if(`objectType $i` == "mesh")		{			$tr_node = `listRelatives -f -p $i`;			$filter_node[$index_no] = $tr_node[0];			$index_no++;		}	}	$index_no = 0;	for($i in $filter_node)	{		$ret_val = $ret_val + ("string $b_" + $index_no + " = `button -w 150 -l " + $i + " -al left -c " +			 "\"s000192_EoJ_View_One_set_val( " + $index_no + ", 0)" + "\"bv" + $index_no + "`;");		$index_no ++;	}	return $ret_val;}global proc s000192_EoJ_View_One(){	$window = "s000192_EoJ_View_One_window";	if (`window -exists $window`) deleteUI $window;	window $window;	scrollLayout sc_lay;		columnLayout -adj 1;			frameLayout -l "View_Only_Node" -la "top" -bs "etchedIn" f_l;				string $num_row = `rowColumnLayout -nc 1 -cw 1 150 n_r`;				eval(s000192_EoJ_View_One_set());				setParent ..;			setParent ..;		columnLayout;		string $close_btn = `button -l "Close and All View" -c ("s000192_EoJ_View_One_set_val(" + "\"dummy" + "\", 1); deleteUI -window s000192_EoJ_View_One_window;")`;	showWindow ;}//Check Texture UV anim and Color,Alpha Gain animglobal proc s000192_EoJ_Tex_anim_check_sel(){	string $filter_str[] = {};	$info_view = `textScrollList -q -si info_view2`;	string $info_view2 = $info_view[0];	tokenize $info_view2 "----->" $filter_str;	select -r $filter_str[1];}proc s000192_EoJ_Tex_anim_check_UV(){	$tex_node = `ls -tex`;	for($i in $tex_node)	{		$place_name = `listConnections -d 1 ($i + ".offset")`;		if(`keyframe -q -kc ($place_name[0] + ".offset")` != 0)		{			string $info_view = `textScrollList -e -a ("uv_anim----->" + $place_name[0]) info_view2`;		}	}	for($i in $tex_node)	{		if(`keyframe -q -kc ($i + ".colorGain")` != 0)		{			string $info_view = `textScrollList -e -a ("colorGain_anim----->" + $i) info_view2`;		}		if(`keyframe -q -kc ($i + ".alphaGain")` != 0)		{			string $info_view = `textScrollList -e -a ("alphaGain_anim----->" + $i) info_view2`;		}	}}global proc s000192_EoJ_Tex_anim_check(){	$window = "s000192_EoJ_Tex_anim_check";	if (`window -exists $window`) deleteUI $window;	window $window;	$form = `formLayout`;	string $info_view = `textScrollList -nr 10 -dcc "s000192_EoJ_Tex_anim_check_sel" info_view2`;	string $close_btn = `button -l "Close" -c "deleteUI -window s000192_EoJ_Tex_anim_check;"`;	s000192_EoJ_Tex_anim_check_UV;	$o = 5; $o2 = 20; $o3 = 100; $o4 = 10;	formLayout -e		-af $info_view "top" $o -af $info_view "left" $o -af $info_view "right" $o		-ac $close_btn "top" $o $info_view -af $close_btn "right" $o		$form;	showWindow ;}