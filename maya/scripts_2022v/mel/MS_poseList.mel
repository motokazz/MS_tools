	//顔パーツのリスト表示
	global proc MS_poseList_faceList(){
		global string $MS_poseList_faceList[];
		global string $MS_poseList_poseNameList[];//ポーズ名のリスト
		deleteUI "CL_faceList";
		columnLayout -p "SCR_faceList" "CL_faceList";
		int $i;
		for($each in $MS_poseList_faceList){
			rowLayout -nc 4 -cw4 100 30 30 100;
			float $bgc[];
			if (`objExists($each)`){
				$bgc={1.0,1.0,1.0};
			}else{
				$bgc={0.5,0.5,0.5};
			}
				
			button -l $each -w 100 -bgc $bgc[0] $bgc[1] $bgc[2] -c ("select -r "+$each+";MS_poseList_faceList;") ("BUTTON_FL_NAME_"+$each);
			button -l "+" -bgc $bgc[0] $bgc[1] $bgc[2] -c ("select -add "+$each+";MS_poseList_faceList;") ("BUTTON_FL_ADD_"+$each);
			button -l "++" -bgc ($bgc[0]-0.1) ($bgc[1]-0.1) $bgc[2] -c ("MS_poseList_faceList_flexSelector "+$each+";MS_poseList_faceList;") ("BUTTON_FL_FXS_"+$each);
			button -l "rename" -c ("MS_poseList_rename(\""+$each+"\");");
			setParent ..;
		}		
		
		frameLayout -e -h 200 "poseList";
		frameLayout -e -h 200 "faceList";
		
		string $SELOBJ[]=`ls -typ transform -sl`;
		for($eachOBJ in $SELOBJ){
			if(`button -ex ("BUTTON_FL_NAME_"+$eachOBJ)`){
			button -e -bgc 1 0.5 0.5 ("BUTTON_FL_NAME_"+$eachOBJ);
			button -e -bgc 1 0.5 0.5 ("BUTTON_FL_ADD_"+$eachOBJ);
			}
		}
	
		showWindow MS_poseList;
		
	
		setParent ..;
	}
	
	//リネームコマンド
	global proc MS_poseList_rename(string $NEW){
		string $obj[]=`ls -sl`;
		rename $obj $NEW;
	}
	
	global proc float MS_poseList_nearestObjectV3_distance(string $target_a,string $target_b){
		float $a[] = `xform -q -ws -t $target_a`;
		float $b[] = `xform -q -ws -t $target_b`;
		//2点間の移動距離を計算
		float $len = sqrt(($a[0]-$b[0])*($a[0]-$b[0])+($a[1]-$b[1])*($a[1]-$b[1])+($a[2]-$b[2])*($a[2]-$b[2]));
		
		return $len;
		
	}
	
	global proc string[] MS_poseList_nearestObjectV3(string $sourceObj[],string $distObj,string $OPTION){
		//option
		//"sort"=sort list by distance
		//"value"=return sorted value
		//"rate"=return sorted rate(0.0-1.0)
		string $entryObj[]=stringArrayRemove ({$distObj,""},$sourceObj);
		print $entryObj;
		print "---\n";
		string $dists[];
		$i=0;
		for($each in $entryObj){
			float $ftemp=`MS_poseList_nearestObjectV3_distance $distObj $each`;
			$dists[$i]=((1000000+$ftemp)+"<>"+$each);
			$i++;
		}
		string $result[]=`sort $dists`;
		
		string $MAXVAR[];//MAX値保存
		tokenize($result[size($result)-1],"<>",$MAXVAR);
		
		string $sort[];
		string $value[];
		string $rate[];
		$j=0;
		for($each in $result){
			string $stemp[];
			tokenize($each,"<>",$stemp);
			$sort[$j]=$stemp[1];
			
			$value[$j]=(float($stemp[0])-1000000);
			if($value[$j] && float($MAXVAR[0])){
				$rate[$j]=(float($value[$j])/(float($MAXVAR[0])-1000000));
			}else{
				$rate[$j]="0";
			}
			$j++;
		}
		if($OPTION=="sort"){
			return $sort;
		}else if($OPTION=="value"){
			return $value;
		}else if($OPTION=="rate"){
			return $rate;
		}
	}
		
	global proc MS_poseList_faceList_flexSelector(string $HANDLE_OBJ){
		global string $MS_poseList_faceList[];
		int $CNS;
		string $NEAR[];
		//オブジェクト選択時の処理
		string $SELECTED_OBJ[]=`ls -typ transform -sl`;
		if(size($SELECTED_OBJ)>1){
			print "A";
			$NEAR=MS_poseList_nearestObjectV3($SELECTED_OBJ,$HANDLE_OBJ,"sort");//オブジェクト距離ソート
			$CNS=(size($NEAR)-1);
		}else{
			print "G";
			$CNS=`intSliderGrp -q -v "MS_poseList_constQuintity"`;
			$NEAR=MS_poseList_nearestObjectV3($MS_poseList_faceList,$HANDLE_OBJ,"sort");//オブジェクト距離ソート
		}
		string $NEARTMP[];
		int $j;
		for($j=0;$j<=$CNS;$j++){
			$NEARTMP[$j]=$NEAR[$j];
		}
		string $RATE[]=MS_poseList_nearestObjectV3($NEARTMP,$HANDLE_OBJ,"rate");//オブジェクト距離レート
		
		MS_poseList_faceList_flexSelector_delete();
		int $i;
		for($i=0;$i<$CNS;$i++){
			string $tmpcns[]=`parentConstraint -mo -n "MS_poseList_faceList_flexSelector" -w (1-float($RATE[$i])) $NEAR[$CNS] $HANDLE_OBJ $NEAR[$i]`;
			parentConstraint -e -n $tmpcns[0] -w (float($RATE[$i])) $NEAR[$CNS] $NEAR[$i];
		}
		select -r $HANDLE_OBJ;
	}
	
	global proc MS_poseList_faceList_flexSelector_delete(){
		string $CONST[]=`ls -typ parentConstraint "*MS_poseList_faceList_flexSelector*"`;
		if(size($CONST)){
			delete $CONST;
		}
	}
	
	
	
	
	
//■ポーズリストがらみ
	//表示されているポーズからアトリビュートを抜き出し。
	global proc string MS_poseList_getAttr(){
		string $ret;
		global string $MS_poseList_attrList[];
		global string $MS_poseList_faceList[];
		int $i;
		for ($each in $MS_poseList_faceList){
			if(`objExists($each)`){
				$ret+="<";
				for($eachAttr in $MS_poseList_attrList){
					float $var=`getAttr ($each+"."+$eachAttr)`;
					$ret+=(","+$var);
				}
				$ret+=">";
			}
		}
		return $ret;
	}
	
	//ポーズリストに設定してあるポーズを表示
	global proc MS_poseList_POSER(int $ID){
		global string $MS_poseList_poseList[];
		global string $MS_poseList_faceList[];
		global string $MS_poseList_attrList[];
		string $tmp[];//transform_node
		string $tmpB[];//attribute_value
		//modify
		tokenize($MS_poseList_poseList[$ID],"<>",$tmp);
		for($i=0;$i<size($MS_poseList_faceList);$i++){
			tokenize($tmp[$i],",",$tmpB);
			int $j=0;
			for($eachAttr in $MS_poseList_attrList){
				if(`objExists($MS_poseList_faceList[$i])`){
					if(!`getAttr -l ($MS_poseList_faceList[$i]+"."+$eachAttr)`){
						string $com= ("setAttr -clamp "+ $MS_poseList_faceList[$i]+"."+$eachAttr+" ("+$tmpB[$j]+")\n");
						eval $com;
					}
				}
				$j++;
			}
		}
	}
	
