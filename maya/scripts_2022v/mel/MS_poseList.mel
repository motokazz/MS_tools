	clear $MS_poseList_poseList;//ポーズリスト
	clear $MS_poseList_poseNameList;//ポーズ名のリスト
	clear $MS_poseList_faceList;//顔パーツのリスト
	clear $MS_poseList_attrList;//設定アトリビュートのリスト
	
	global string $MS_poseList_poseList[];//ポーズリスト
	global string $MS_poseList_poseNameList[];//ポーズ名のリスト
	global string $MS_poseList_faceList[];//顔パーツのリスト
	global string $MS_poseList_attrList[];//設定アトリビュートのリスト
}

