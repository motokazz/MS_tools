/*
MS_VertexColorMapTool

バーテックスカラーのアトリビュートマップをインポート、エキスポートするmelです。
入出力の設定は、PaintVertexColorToolsOptionsで行ってください。

注意
入出力は、iffファイルフォーマットのみ対応
入出力に使っているフォルダは、カレントプロジェクト下のimagesフォルダで行う。（【カレントプロジェクトフォルダ/images】を作成しておくこと）
*/

global proc MS_VertexColorMapTool_core(string $option){
	
	string $check_a=`checkBox -q -v "deleteProcessUVSet"`;
	
	//ペイントツールに入る、こうしておかないと、アトリビュートマップのコマンドが効かない。
	PaintVertexColorTool;
	
	string $obj_name[]=`ls -sl`;
	
	string $ext=".iff";//今のところiffのみ対応。
	
	for($fname in $obj_name){
		
		$full_path=(`workspace -q -rd`+"images/"+$fname+$ext);
		
		print ("ExportFile:"+$full_path+"\n");
		
		select $fname;
		
		
		
		//UVcheckもし、UVSET「MS_VertexColorMap」が無ければ作る。あれば作らない。
		int $flag=0;
		string $checkname[]=`polyUVSet -q -auv`;
		for ($check in $checkname){
			if ($check=="MS_VertexColorMap"){
				$flag=1;
				print"check!\n";
			}
		}
		
		if ($flag!=1){
			polyAutoProjection -pb 0 -ibd 1 -cm 1 -l 2 -sc 2 -o 1 -p 12 -uvSetName "MS_VertexColorMap";
		}
		
		
		
		polyUVSet -currentUVSet -uvSet "MS_VertexColorMap" $fname;
		
		if ($option=="e"){
			artAttrPaintVertexCtx -e -exportfilesave $full_path "artAttrColorPerVertexContext";
		}
		if ($option=="i"){
			artAttrPaintVertexCtx -e -importfileload $full_path "artAttrColorPerVertexContext";	
		}
		if ($check_a){
			polyUVSet -delete -uvSet "MS_VertexColorMap" $fname;
		}
	}
	
	//後処理
	select $obj_name;
	
	
	//ペイントツールだとウザイからコマンド終了時セレクトツールに戻す
	SelectTool;
	
}

global proc MS_VertexColorMapTool_core2(string $option){
	
	
	
	string $check_a=`checkBox -q -v "deleteProcessUVSet"`;
	
	//ペイントツールに入る、こうしておかないと、アトリビュートマップのコマンドが効かない。
	PaintVertexColorTool;
	
	string $obj_name[]=`ls -sl`;
	
	string $ext=".iff";//今のところiffのみ対応。
	
	for($fname in $obj_name){
		
		$full_path=`textFieldGrp -q -text "filePath"`;
		
		print ("ExportFile:"+$full_path+"\n");
		
		select $fname;
		
		
		
		//UVcheckもし、UVSET「MS_VertexColorMap」が無ければ作る。あれば作らない。
