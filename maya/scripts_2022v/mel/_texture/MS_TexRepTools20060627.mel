global proc MS_TexExtRep()
{
	
	string $ext_name[]={"dummy",".dds",".tga",".tif",".bmp"};

	int $val_radio=`radioButtonGrp -q -sl smp_radio`;

	string $obj_name[]=`ls -sl -typ file`;

	$i=0;
	
	for($i=0;$i<size($obj_name);$i++){
		
		string $name=`getAttr ($obj_name[$i]+".fileTextureName")`;
		
		//ピリオドで分割
		string $buffer[];
		tokenize $name "." $buffer;
		
		setAttr -type "string" ($obj_name[$i]+".fileTextureName") ($buffer[0]+$ext_name[$val_radio]);
		
		
	}
	
	
	print "-------------------------------------------------\n";
	print "        Result - Texture Extension Replace\n";
	print ("texture EXT Replaced to"+$ext_name[$val_radio]+"\n");
	print ("texture EXT Replaced by "+$i+"\n");
	print "-------------------------------------------------\n\n";
	
	
}

global proc MS_TexExtRep_All()
{

	string $ext_name[]={"dummy",".dds",".tga",".tif",".bmp"};
	int $val_radio=`radioButtonGrp -q -sl smp_radio`;

	string $rec_obj[]=`ls -sl`;

	select -all;

	string $obj_name[]=`ls -sl -typ file`;

	$i=0;
	
	for($i=0;$i<size($obj_name);$i++){
	
	string $name=`getAttr ($obj_name[$i]+".fileTextureName")`;


	//ピリオドで分割
	string $buffer[];
	tokenize $name "." $buffer;

	
		setAttr -type "string" ($obj_name[$i]+".fileTextureName") ($buffer[0]+$ext_name[$val_radio]);
	
	}
	
	select -r $rec_obj;
}

global proc MS_ReloadTexAll()
{
	select -all;
	
	string $rec_obj[]=`ls -sl`;

	select -all;
	
	string $obj_name[]=`ls -sl -typ file`;

	$i=0;
	
	for($i=0;$i<size($obj_name);$i++){
	
	string $name=`getAttr ($obj_name[$i]+".fileTextureName")`;
	setAttr ($obj_name[$i]+".fileTextureName") -type "string" $name;
	
	}
	
	select -r $rec_obj;
}

global proc MS_TexRepTools()
{
	
	
	//Window Check
	if(`window -exists MS_TexRepTools`){
		deleteUI MS_TexRepTools;
	}
	
	
	//Create Window
	
	window -wh 600 400 -title "MS_TexRepTools" MS_TexRepTools;
	
	columnLayout ;
	
	//Contents	
	
	
	//text
	text -label "ThisWindowIsWindowFormatSample";
	
	
	separator -w 600 -h 40 -st "single";
	
	//radio
	radioButtonGrp
            		-numberOfRadioButtons 4
            		-label "radio"
            		-labelArray4 ".dds" ".tga" ".tif" ".bmp"
			-sl 1 smp_radio;
	
	
	
	separator -w 600 -h 40 -st "doubleDash"; 
	
	//Execute Buttons
	button -bgc 0.5 0.5 1.0-l "TextureExtReplace" -command "MS_TexExtRep" ;
	
	button -bgc 1.0 0.5 0.5-l "TextureExtReplace_All" -command "MS_TexExtRep_All" ;
	
	separator -w 600 -h 40 -st "single";

	button -l "Reload Texture All" -command "MS_ReloadTexAll" ;
	
	separator -w 600 -h 40 -st "double"; 
	
	
	//Common Buttons
	button -l "undo" -command "Undo" ;
	
	button -l "exit" -command "deleteUI MS_TexRepTools" ;
	
	
	//Footer
	showWindow MS_TexRepTools;
	
}

MS_TexRepTools;

