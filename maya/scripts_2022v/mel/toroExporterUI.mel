/*
toroExpoterUI.mel
坂井元一


・オブジェクト名をファイル名に使用する
exportSelection時に有効
on：
選択しているオブジェクトの名前をファイル名として使用する。
複数のファイルを選んでいる場合、それぞれ別々の名前で出力する。

off：
fileNameダイアログに記入されている名前のファイルに選択しているオブジェクトを出力する

・重複オブジェクトをリネームして出力

チェックon：出力すると出力時に重複オブジェクトをリネームして出力する。
チェックoff：出力するとき重複ファイル警告と重複しているファイルリストを出力する。

・プライオリティー変換（未実装）
オブジェクトをcameraからの距離に応じてソートしプライオリティーに変換して出力する。
もしくは、priorityアトリビュートを参照しそのプライオリティーで出力する。

・エキスポート時にPEdit表示

エキスポート時に出力ファイルと同じ場所にスクリプトファイルを出力しPEditでエキスポートしたものを表示する。

*/
//global string $MP_MATTER_SETUP = "D:/MS_tools/MP_MS_matterSetup.mel";
source "D:/MS_tools/MP_MS_toolpathDefine.mel";
MP_MS_toolpathDefine("MP_MS_matterSetupUI");
MP_MS_toolpathDefine("MP_MS_EoJ_Ret_min_max_anim");

//ロケータ作成
global proc toroExporterUI_transform2locator(){
	string $obj[]=`ls -tr -sl`;
	
	for ($each in $obj){
	
		float $tx=`getAttr($each+".tx")`;
		float $ty=`getAttr($each+".ty")`;
		float $tz=`getAttr($each+".tz")`;
		float $rx=`getAttr($each+".rx")`;
		float $ry=`getAttr($each+".ry")`;
		float $rz=`getAttr($each+".rz")`;
		float $sx=`getAttr($each+".sx")`;
		float $sy=`getAttr($each+".sy")`;
		float $sz=`getAttr($each+".sz")`;
		
		string $loc[]=`spaceLocator`;
		
		setAttr ($loc[0]+".tx") $tx;
		setAttr ($loc[0]+".ty") $ty;
		setAttr ($loc[0]+".tz") $tz;
		setAttr ($loc[0]+".rx") $rx;
		setAttr ($loc[0]+".ry") $ry;
		setAttr ($loc[0]+".rz") $rz;
		setAttr ($loc[0]+".sx") $sx;
		setAttr ($loc[0]+".sy") $sy;
		setAttr ($loc[0]+".sz") $sz;
		
		rename $loc[0] ("loc_"+$each);
		
	}


}

//重複オブジェクト名処理
global proc string[] toroExporterUI_uniqueRename(string $mode){
	//シーン内のオブジェクトを、重複チェックや被らない名前にリネームする
	//オプション
	//check 重複チェックモード
	//rename リネームモード
	
	string $longName[]=`ls -l `;
	string $shortName[];
	
	int $i=0,$j=0;
	string $tmp[];
	string $renamed[];//リネーム前後の名前をセットにした配列<MS_NO_DABURI>という記号で区切られてる。
	string $kaburi[];//被り名前リスト
	int $found;//被りチェック
	
	//ショートネームのリスト作成
	for($each in $longName){
		tokenize($each,"|",$tmp);
		$shortName[$i]=$tmp[size($tmp)-1];
		
		$found =stringArrayCount($shortName[$i],$shortName);
		if($found>1){
			//チェック処理
			if($mode=="check"){
				string $kabutteru[]=`ls -l $shortName[$i]`;
				stringArrayToString($kabutteru,"&\n");
				$kaburi[$j]=("==================================================\n"+stringArrayToString($kabutteru,"\n")+"\n以上"+size($kabutteru)+"オブジェクトが重複\n==================================================\n");
				$j++;
				
			}
			//リネーム処理
			if($mode=="rename"){
				$renamed[$j]=`rename $each ($shortName[$i]+"_#")`+"<MS_NO_DABURI>"+$shortName[$i];
				$j++;
				print $each;
			}
		}
		$found=0;
		$i++;
		
	}
	
	print ("rename "+size($renamed));
	
	//リネーム後に元に戻す処理
	/*
	for($each in $renamed){
		tokenize($each,"<MS_NO_DABURI>",$tmp);
		rename $tmp[0] $tmp[1];
	}
	*/
	return $kaburi;
}

//マテリアルリスト作成
global proc string[] toroExporterUI_createMaterialList(string $OBJ){
	//選んだオブジェクトにくっついてるマテリアルを根こそぎリストアップ
	//レイヤードシェーダー対応
	string $lambertShapeFrom[];
	string $shape[]=`listRelatives -ad -typ shape $OBJ`;
	int $i=0;
	string $shadingEngine[];
	for($eachShape in $shape){
		$shadingEngine=`listConnections -t shadingEngine $eachShape`;
		if(size($shadingEngine)){
			string $lambertTmp[]=`listConnections -t lambert $shadingEngine[0]`;
			string $layeredShader[]=`listConnections -t layeredShader $shadingEngine[0]`;
			if(size($layeredShader)){
				for($eachLayeredShader in $layeredShader){
				string $layeredConnected[]=`listConnections ($eachLayeredShader+".inputs")`;
				$lambertShapeFrom=stringArrayCatenate($lambertShapeFrom,$layeredConnected);
				}
			}
			$lambertShapeFrom=stringArrayCatenate($lambertShapeFrom,$lambertTmp);
		}
		$i++;
	}
	string $MATERIAL_LIST[]=`stringArrayRemoveDuplicates $lambertShapeFrom`;
	return $MATERIAL_LIST;
}



//マテリアルスクリプト処理
global proc int MS_toroExporterUI_lambertAttrChecker(string $lambert){
	//マテリアルに設定してあるエクストラアトリビュートを調べます
	if(
	`attributeExists "anisoFilter" $lambert`||
	`attributeExists "mipmapFilter" $lambert`||
	`attributeExists "vertexShader" $lambert`||
	`attributeExists "flagmentShader" $lambert`||
	`attributeExists "blend" $lambert`||
	`attributeExists "fogOff" $lambert`||
	`attributeExists "backfaceCurring" $lambert`||
	`attributeExists "zOffset" $lambert`||
	`attributeExists "zFunction" $lambert`||
	`attributeExists "zWrite" $lambert`||
	`attributeExists "aFunction" $lambert`||
	`attributeExists "aReffernce" $lambert`||
	`attributeExists "renderStage" $lambert`||
	`attributeExists "priority" $lambert`)
	{
		return 1;
	}else{
		return 0;
	}
	
}

global proc string MS_toroExporterUI_lambertScript(string $objects){
	string $finalCommand;
	string $lambert[];
	int $i;
	//モードによるオブジェクト名選別
	//all：シーンの中にあるすべてのランバートシェーダー選択
	if ($objects=="all"){
		$lambert=`ls -typ lambert -typ phong`;
	}
	//allで無い場合：出力対象のオブジェクトに関連するマテリアルのみを選択
	else{
		string $lambertShapeFrom[];
		string $preobj[]=`ls -tr $objects`;
		for ($each in $preobj){
			$tmp=`toroExporterUI_createMaterialList($each)`;
			$lambertShapeFrom=stringArrayCatenate($lambertShapeFrom,$tmp);
		}
		$lambert=`stringArrayRemoveDuplicates $lambertShapeFrom`;
	}
	
	//マテリアルノードのスクリプト作成
	for($eachLambert in $lambert){
		if(`MS_toroExporterUI_lambertAttrChecker $eachLambert`){
			$finalCommand=$finalCommand+"\/\/---"+$eachLambert+"---\n";
			$finalCommand=$finalCommand+"SelectMaterial(\""+$eachLambert+"\");\n";
		}
		
		//SetTextureFillter設定
		int $anisoFilter,$mipmapFilter;
		if(`attributeExists "anisoFilter" $eachLambert`){
			$anisoFilter=`getAttr ($eachLambert+".anisoFilter")`;
		}
		if(`attributeExists "mipmapFilter" $eachLambert`){
			$mipmapFilter= `getAttr ($eachLambert+".mipmapFilter")`;
		}
		if(`attributeExists "anisoFilter" $eachLambert`||`attributeExists "mipmapFilter" $eachLambert`){
			$finalCommand=$finalCommand+"SetTextureFillter("+$anisoFilter+","+$mipmapFilter+");\n";
		}
		
		//SetShaderFromName　設定
		string $shaderFromName;
		if(`attributeExists "shaderFromName" $eachLambert`){
			$shaderFromName=`getAttr -as ($eachLambert+".shaderFromName")`;
		}
		if(`attributeExists "shaderFromName" $eachLambert`){
			$finalCommand=$finalCommand+"SetShaderFromName(\""+$shaderFromName+"\");\n";
		}
		
		//SetBlend　設定
		if(`attributeExists "blend" $eachLambert`){
			$finalCommand=$finalCommand+"SetBlend("+`getAttr ($eachLambert+".blend")`+");\n";
		}
		
		//SetFogOff　設定
		if(`attributeExists "fogOff" $eachLambert`){
			$finalCommand=$finalCommand+"SetFogOff("+`getAttr ($eachLambert+".fogOff")`+");\n";
		}
		
		//SetBackFaceCulling　設定
		if(`attributeExists "backfaceCurring" $eachLambert`){
			$finalCommand=$finalCommand+"SetBackFaceCulling("+`getAttr ($eachLambert+".backfaceCurring")`+");\n";
		}
		
		//SetZOffset　設定
		if(`attributeExists "zOffset" $eachLambert`){
			$finalCommand=$finalCommand+"SetZOffset("+`getAttr ($eachLambert+".zOffset")`+".0);\n";
		}
		//SetZFunc　設定
		if(`attributeExists "zFunction" $eachLambert`){
			$finalCommand=$finalCommand+"SetZFunc("+`getAttr ($eachLambert+".zFunction")`+");\n";
		}
		
		//SetZWrite　設定
		if(`attributeExists "zWrite" $eachLambert`){
			$finalCommand=$finalCommand+"SetZWrite("+`getAttr ($eachLambert+".zWrite")`+");\n";
		}
		
		//SetAFunc　設定
		if(`attributeExists "aFunction" $eachLambert`){
			$finalCommand=$finalCommand+"SetAFunc("+`getAttr ($eachLambert+".aFunction")`+");\n";
		}
		
		//SetARef　設定
		if(`attributeExists "aReffernce" $eachLambert`){
			$finalCommand=$finalCommand+"SetARef("+`getAttr ($eachLambert+".aReffernce")`+");\n";
		}
		
		//SetStage　設定
		if(`attributeExists "renderStage" $eachLambert`){
			$finalCommand=$finalCommand+"SetStage("+`getAttr ($eachLambert+".renderStage")`+");\n";
		}
		//SetPrio　設定
		if(`attributeExists "priority" $eachLambert`){
			$finalCommand=$finalCommand+"SetPrio("+`getAttr ($eachLambert+".priority")`+");\n";
		}
	}
	return $finalCommand;
}

//ノードスクリプト処理
global proc int MS_toroExporterUI_nodeAttrChecker(string $shape){
	//shapeに設定してあるエクストラアトリビュートを調べます
	if(
	`attributeExists "skin" $shape`||
	`attributeExists "collision" $shape`||
	`attributeExists "osage" $shape`||
	`attributeExists "hide" $shape`||
	`attributeExists "billbord" $shape`||
	`attributeExists "camera" $shape`||
	`attributeExists "renderStage" $shape`||
	`attributeExists "priority" $shape`||
	`attributeExists "nodeSort" $shape`||
	`attributeExists "MotionTable" $shape`
	)
	{
		return 1;
	}else{
		return 0;
	}
	
}

global proc string MS_toroExporterUI_nodeScript(string $objects){
	string $finalCommand;
	string $shape[]=`listRelatives -ad -typ shape -typ camera $objects`;
	int $intValue;
	float $floatValue;
	
	//シェイプノードのアトリビュート出力
	for($eachShape in $shape){
		if(`MS_toroExporterUI_nodeAttrChecker $eachShape`){
			$finalCommand=$finalCommand+"\/\/---"+$eachShape+"---\n";
			$finalCommand=$finalCommand+"SelectNode(\""+$eachShape+"\");\n";
			if(`attributeExists "osage" $eachShape`){
				$intValue=`getAttr ($eachShape+".osage")`;
				$finalCommand=$finalCommand+"SetNodeOsage("+$intValue+");\n";
			}
			if(`attributeExists "skin" $eachShape`){
				$intValue=`getAttr ($eachShape+".skin")`;
				$finalCommand=$finalCommand+"SetNodeSkin("+$intValue+");\n";
			}
			if(`attributeExists "collision" $eachShape`){
				$intValue=`getAttr ($eachShape+".collision")`;
				$finalCommand=$finalCommand+"SetNodeCollision("+$intValue+");\n";
			}
			
			if(`attributeExists "osage" $eachShape`){
				$intValue=`getAttr ($eachShape+".osage")`;
				$finalCommand=$finalCommand+"SetNodeOsage("+$intValue+");\n";
			}

			if(`attributeExists "hide" $eachShape`){
				$intValue=`getAttr ($eachShape+".hide")`;
				$finalCommand=$finalCommand+"SetNodeHide("+$intValue+");\n";
			}
			if(`attributeExists "billbord" $eachShape`){
				$intValue=`getAttr ($eachShape+".billbord")`;
				$finalCommand=$finalCommand+"SetNodeBillbord("+$intValue+");\n";
			}
			if(`attributeExists "camera" $eachShape`){
				$intValue=`getAttr ($eachShape+".camera")`;
				$finalCommand=$finalCommand+"SetNodeCamera("+$intValue+");\n";
			}
			if(`attributeExists "renderStage" $eachShape`){
				$intValue=`getAttr ($eachShape+".renderStage")`;
				$finalCommand=$finalCommand+"SetNodeStage("+($intValue-1)+");\n";
			}
			if(`attributeExists "priority" $eachShape`){
				$floatValue=`getAttr ($eachShape+".priority")`;
				$finalCommand=$finalCommand+"SetNodePrio("+$floatValue+".0);\n";
			}
			if(`attributeExists "nodeSort" $eachShape`){
				$intValue=`getAttr ($eachShape+".nodeSort")`;
				$finalCommand=$finalCommand+"SetNodeSort("+$intValue+");\n";
			}
		}
	}
	return $finalCommand;
}

//スクリプト出力コア
global proc MS_toroExporterUI_exportScript(string $filePath,string $fileName,string $obj_name[],int $mode){
	//PEdit用スクリプト出力
	int $priorityOffset=`intField -q -v "priorityOffset"`;
	int $useObjectNameCheck=`checkBox -q -v useObjectNameCheck`;//オブジェクト名を利用してExportSelection
	int $optimize=`checkBox -q -v "optimize"`;
	int $save=`checkBox -q -v "save"`;
	int $exit=`checkBox -q -v "exit"`;
	
	//★★★ヘッダー★★★
	string $finalCommand;
	//$finalCommand="int main()\n{\n";
	
	//ExportSelection、オブジェ名個別出力時のコマンド：マテリアル設定出力用
	if ($useObjectNameCheck && $mode ){
		for($eachObj in $obj_name){
			
			//対象オブジェクト指定処理
			$finalCommand=$finalCommand+"\/\/---"+$eachObj+"---\n";
			$finalCommand=$finalCommand+"AddScene (\""+$filePath+$eachObj+".toro\");\n";
			
			//Script出力
			string $stringValue;
			string $shape[]=`listRelatives -ad -typ shape -typ camera $eachObj`;
			for($eachShape in $shape){
				if(`attributeExists "MotionTable" $eachShape`){
					$stringValue=`getAttr ($eachShape+".MotionTable")`;
					$finalCommand=$finalCommand+$stringValue;
				}
				if(`attributeExists "EventTable" $eachShape`){
					$stringValue=`getAttr ($eachShape+".EventTable")`;
					$finalCommand=$finalCommand+$stringValue;
				}
				if(`attributeExists "ExtraScript" $eachShape`){
					$stringValue=`getAttr ($eachShape+".ExtraScript")`;
					$finalCommand=$finalCommand+$stringValue;
				}
			}
			
			//マテリアルとノード、それぞれのアトリビュートをスクリプトに変換
			$finalCommand=$finalCommand+`MS_toroExporterUI_lambertScript $eachObj`;
			$finalCommand=$finalCommand+`MS_toroExporterUI_nodeScript $eachObj`;
			
			//出力オプション
			if($optimize){
				$finalCommand=$finalCommand+"Optimize();\n";
			}
			if($save){
				$finalCommand=$finalCommand+"SaveScene(\""+$filePath+$eachObj+".toro\");\n";
			}
			if($exit){
				$finalCommand=$finalCommand+"Exit();\n";
			}
		}
	}
	//ExportSelection、オブジェ名個別出力で無い時のコマンド：マテリアル設定出力用
	if (!$useObjectNameCheck && $mode){
		//ファイル名指定
		$finalCommand=$finalCommand+"AddScene (\""+$filePath+$fileName+".toro\");\n";
		
		//マテリアルとノード、それぞれのアトリビュートをスクリプトに変換
		for($eachObj in $obj_name){
			$finalCommand=$finalCommand+"\/\/---"+$eachObj+"---\n";
			$finalCommand=$finalCommand+`MS_toroExporterUI_lambertScript $eachObj`;
			$finalCommand=$finalCommand+`MS_toroExporterUI_nodeScript $eachObj`;
		}
		
		//出力オプション
		if($optimize){
			$finalCommand=$finalCommand+"Optimize();\n";
		}
		if($save){
			$finalCommand=$finalCommand+"SaveScene(\""+$filePath+$fileName+".toro\");\n";
		}
		if($exit){
			$finalCommand=$finalCommand+"Exit();\n";
		}
	}
	//ExportAll時のコマンド：マテリアル設定出力用
	if(!$mode){
		//ファイル名指定
		$finalCommand=$finalCommand+"AddScene (\""+$filePath+$fileName+".toro\");\n";
		
		//すべてのマテリアルのアトリビュートをスクリプトに変換
		$finalCommand=$finalCommand+`MS_toroExporterUI_lambertScript "all"`;
		
		//ノードのアトリビュートをスクリプトに変換
		$obj_name=`ls -as -tr`;
		for($eachObj in $obj_name){
			$finalCommand=$finalCommand+`MS_toroExporterUI_nodeScript $eachObj`;
		}
		//出力オプション
		if($optimize){
			//$finalCommand=$finalCommand+"Optimize();\n";
			$finalCommand=$finalCommand+"//Optimize();\n";
		}
		if($save){
			$finalCommand=$finalCommand+"SaveScene(\""+$filePath+$fileName+".toro\");\n";
		}
		if($exit){
			$finalCommand=$finalCommand+"Exit();\n";
		}
	}
	
	//★★★フッター★★★
	//$finalCommand=$finalCommand+"return 0;}\n";
	
	
	//スクリプトファイル出力処理
	int $fileId;
	if(`filetest -f ($filePath+$fileName+".tscr")`){
		$fileId=`fopen ($filePath+$fileName+".tscr") "w"`;
	}else{
		$fileId=`fopen ($filePath+$fileName+".tscr")`;
	}
	print $fileId;
 	fprint $fileId $finalCommand;
 	fclose $fileId;
	
}

//エキスポーターコア
global proc toroExporterUI_core(int $mode){
	
	string $ToroTool="D:/MProject/ToroTool.exe";//ToroToolのパス
	string $command;//エキスポートコマンド生成用ストリング
	string $obj_name[]=`ls -as -sl`;//トップオブジェクト選択
	string $defaultCommand="file -op \"\" -typ \"ToroExporter\" -pr ";//エキスポートコマンド
	string $tmp[];//テンポラリー配列
	string $pri_list_path="/EOJPSP/refference_design/pri_list/";//プライオリティーリストのパス
	
	
	//ダイアログから出力オプションの取得
	string $filePath=`textField -q -fileName "filePath"`;
	string $fileName=`textField -q -tx fileName`;
	int $useObjectNameCheck=`checkBox -q -v useObjectNameCheck`;//オブジェクト名を利用してExportSelection
	int $nameCheckRename=`checkBox -q -v "nameCheckRename"`;
	int $showViewer=`checkBox -q -v "showViewer"`;
	int $exportPEditScript=`checkBox -q -v "exportPEditScript"`;
	int $exportFrameSet=`checkBox -q -v "exportFrameSet"`;
	
	//シーン名取得
	string $arrey[];
	string $sn=`file -sn -q`;
	tokenize $sn "/." $arrey ;
	string $sceneName;
	if($sn!=""){
		$sceneName=$arrey[size($arrey)-2];
	}else{
		$sceneName="NewScene";
	}
	
	//現在のフレーム情報取得
	float $minTime=`playbackOptions -q -minTime`;
	float $maxTime=`playbackOptions -q -maxTime`;
	float $animationStartTime=`playbackOptions -q -animationStartTime`;
	float $animationEndTime=`playbackOptions -q -animationEndTime`;	
	float $currentTime=`currentTime -q`;

	//重複オブジェクトチェック＆リネーム
	$tmp=`toroExporterUI_uniqueRename check`;
	if(size($tmp)){
		if($nameCheckRename){
			toroExporterUI_uniqueRename rename;
		}else{
			confirmDialog -bgc 1.0 0.8 0.6 -t "error" -m ("重複オブジェクトがあります\n\n"+stringArrayToString($tmp,"\n"));
			return;
		}
	}
	
	//森田アニメフレーム取得MEL発動
	//global $MP_FRAMESET;
	//source ("D:/MS_tools/EOJPSP_MEL/s000192_EoJ_Ret_min_max_anim.mel";
	//森田プライオリティーリスト発動
	//source "D:/MS_tools/EOJPSP_MEL/s000192_EoJ_exp_pri_list.mel";
	
	//エキスポートコマンド作成
	if ($useObjectNameCheck && $mode ){
		//オブジェクト名を利用してExportSelection
		if(size ($obj_name)){
			for($each in $obj_name){
				//森田MEL or フレームセット
				string $relatedShape[]=`listRelatives -typ shape $each`;
				if($exportFrameSet && `attributeExists "startFrame" $relatedShape[0]`){
					int $startFrame=`getAttr ($each+".startFrame")`;
					int $endFrame=`getAttr ($each+".endFrame")`;
					playbackOptions -animationStartTime $startFrame;
					playbackOptions -animationEndTime $endFrame;
					playbackOptions -minTime $startFrame;
					playbackOptions -maxTime $endFrame;
					print "frameSet\n";
					print ($endFrame+"\n");
				}else if($exportFrameSet){
				int $obj_frame[]=`s000192_EoJ_Ret_min_max_anim $each`;
					if($obj_frame[0]==$obj_frame[1]){
						playbackOptions -animationStartTime $obj_frame[0];
						playbackOptions -animationEndTime $obj_frame[1];
						playbackOptions -minTime $obj_frame[0];
						playbackOptions -maxTime $obj_frame[1];
						print"morita";
					}
				}else{
					playbackOptions -animationStartTime $currentTime;
					playbackOptions -animationEndTime ($currentTime+1);
					playbackOptions -minTime $currentTime;
					playbackOptions -maxTime ($currentTime+1);
					print "noAnim\n";
				}
				
				//パス表記
				int $headcheck=startsWith($each,"|");
				if ($headcheck){$each=endString($each, (size($each)-1));}
				select -r $each;
				$command=$defaultCommand+"-es \""+($filePath+$each)+"\"";
				eval $command;
				
				//森田プライオリティーリスト
				//s000192_EoJ_exp_pri_list($pri_list_path,$each,1,"cx");
				
				print ($command+"\n");
			}
		}else{
			confirmDialog -bgc 1.0 0.8 0.6 -t "error" -m "オブジェクトを選んでね\n";
			return;
		}
	}
	if (!$useObjectNameCheck && $mode){
		//ExportSelection
		$command=$defaultCommand+"-es \""+($filePath+$fileName)+"\"";
		eval $command;
		print ($command+"\n");
		
	}
	
	if($useObjectNameCheck && !$mode){
		//ExportAll &objname
		$command=$defaultCommand+"-ea \""+$filePath+$sceneName+"\"";
		eval $command;
		print ($command+"\n");
	}
	
	if(!$useObjectNameCheck && !$mode){
		//ExportAll
		$command=$defaultCommand+"-ea \""+($filePath+$fileName)+"\"";
		eval $command;
		print ($command+"\n");
	}
	
	//出力時にいろいろいじったシーン情報を元に戻す
	playbackOptions -minTime $minTime;
	playbackOptions -maxTime $maxTime;
	playbackOptions -animationStartTime $animationStartTime;
	playbackOptions -animationEndTime $animationEndTime;
	currentTime $currentTime;
	select -r $obj_name;
	
	
	
	
	//スクリプト出力用
	if($exportPEditScript){
		if ($useObjectNameCheck && $mode ){
			MS_toroExporterUI_exportScript($filePath,$sceneName,$obj_name,$mode);
		}
		if (!$useObjectNameCheck && $mode ){
			MS_toroExporterUI_exportScript($filePath,$fileName,$obj_name,$mode);
		}
		if($useObjectNameCheck && !$mode ){
			string $all_shape[]=`ls -as -tr`;
			MS_toroExporterUI_exportScript($filePath,$sceneName,$all_shape,$mode);
		}
		if(!$useObjectNameCheck && !$mode ){
			string $all_shape[]=`ls -as -tr`;
			MS_toroExporterUI_exportScript($filePath,$fileName,$all_shape,$mode);
		}
	}
	//出力時にビューワーを開く
	if ($showViewer && $useObjectNameCheck){
		system("start "+$ToroTool+" "+$filePath+$sceneName+".tscr");
	}else if($showViewer){
		system("start "+$ToroTool+" "+$filePath+$fileName+".tscr");
	}
	
}

//UI
global proc MS_toroExporterUI_get_dir(string $exp_dir,string $dummy){
	textField -e -fileName ($exp_dir+"/") "filePath";
}

global proc MS_toroExporterUI_fileBrowser(){
	global string $gDefaultFileBrowserDir;
	string $orgpath=$gDefaultFileBrowserDir;
	string $filePath=`textField -q -fileName "filePath"`;
	eval("global string $gDefaultFileBrowserDir=\""+$filePath+"\"");
	fileBrowser "MS_toroExporterUI_get_dir" "Select Directory" "" 4 ;
	MS_toroExporterUI_storeRecallUI store;
	eval("global string $gDefaultFileBrowserDir=\""+$orgpath+"\"");
}

global proc MS_toroExporterUI_storeRecallUI( string $mode ){
	string $prefix="MS_toroExporterUI__";
	
	string $floatFieldList[] = {
		};

	string $intFieldList[] = {
		"priorityOffset"
		};

	string $floatSliderGrpList[] = {
		};

	string $intSliderGrpList[] = {
		};

	string $checkBoxList[] = {
		"useObjectNameCheck",
		"nameCheckRename",
		"showViewer",
		"exportFrameSet",
		"optimize",
		"save",
		"getPriority",
		"exportPEditScript",
		"exit"
		};

	string $radioButtonGrpList[] = {
		};

	string $frameLayoutList[] = {
		};

	string $textFieldList[] = {
		"fileName"
		};

	string $textFieldList_file[] = {
		"filePath"
		};

	int $cnt;

	if ( $mode == "store" )
	{
		for ( $each in $floatFieldList)
			optionVar -floatValue ($prefix+$each) `floatField -q -value $each`;

		for ( $each in $intFieldList)
			optionVar -intValue ($prefix+$each) `intField -q -value $each`;

		for ( $each in $floatSliderGrpList)
			optionVar -floatValue ($prefix+$each) `floatSliderGrp -q -value $each`;

		for ( $each in $intSliderGrpList)
			optionVar -intValue ($prefix+$each) `intSliderGrp -q -value $each`;

		for ( $each in $checkBoxList)
			optionVar -intValue ($prefix+$each) `checkBox -q -value $each`;

		for ( $each in $radioButtonGrpList)
			optionVar -intValue ($prefix+$each) `radioButtonGrp -q -select $each`;

		for ( $each in $frameLayoutList)
			optionVar -intValue ($prefix+$each) `frameLayout -q -collapse $each`;

		for ( $each in $textFieldList)
			optionVar -stringValue ($prefix+$each) `textField -q -tx $each`;

		for ( $each in $textFieldList_file)
			optionVar -stringValue ($prefix+$each) `textField -q -fileName $each`;
	}

	if ( $mode == "recall" )
	{
		for ( $each in $floatFieldList)
			if ( `optionVar -exists ($prefix+$each)` )
				floatField -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $intFieldList)
			if ( `optionVar -exists ($prefix+$each)` )
				intField -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $floatSliderGrpList)
			if ( `optionVar -exists ($prefix+$each)` )
				floatSliderGrp -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $intSliderGrpList)
			if ( `optionVar -exists ($prefix+$each)` )
				intSliderGrp -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $checkBoxList)
			if ( `optionVar -exists ($prefix+$each)` )
				checkBox -e -value `optionVar -q ($prefix+$each)` $each;

		for ( $each in $radioButtonGrpList)
			if ( `optionVar -exists ($prefix+$each)` )
				radioButtonGrp -e -select `optionVar -q ($prefix+$each)` $each;

		for ( $each in $frameLayoutList)
			if ( `optionVar -exists ($prefix+$each)` )
				frameLayout -e -collapse `optionVar -q ($prefix+$each)` $each;

		for ( $each in $textFieldList)
			if ( `optionVar -exists ($prefix+$each)` )
				textField -e -tx `optionVar -q ($prefix+$each)` $each;

		for ( $each in $textFieldList_file)
			if ( `optionVar -exists ($prefix+$each)` )
				textField -e -fileName `optionVar -q ($prefix+$each)` $each;

	}

	if ( $mode == "reset" )
	{
		for ( $each in $floatFieldList)
			optionVar -remove ($prefix+$each);

		for ( $each in $intFieldList)
			optionVar -remove ($prefix+$each);

		for ( $each in $floatSliderGrpList)
			optionVar -remove ($prefix+$each);

		for ( $each in $intSliderGrpList)
			optionVar -remove ($prefix+$each);

		for ( $each in $checkBoxList)
			optionVar -remove ($prefix+$each);

		for ( $each in $radioButtonGrpList)
			optionVar -remove ($prefix+$each);

		for ( $each in $frameLayoutList)
			optionVar -remove ($prefix+$each);

		for ( $each in $textFieldList)
			optionVar -remove ($prefix+$each);

		for ( $each in $textFieldList_file)
			optionVar -remove ($prefix+$each);
	}
}

global proc toroExporterUI(){
	
	global string $MP_MATTER_SETUP;
	
	
	if (`window -q -ex toroExporterUI`){
		deleteUI toroExporterUI;
	}
	window toroExporterUI;
	
	columnLayout;
	text -w 217 -bgc 0.9 0.9 0.9 -l "ファイルオプション";
		rowLayout -nc 3 -cw3 50 110 50;
			text -label "filePath";
			textField -w 110 -fileName "D:/export/" "filePath" ;
			button -w 50 -label "Brouse" -c "MS_toroExporterUI_fileBrowser" "Brouse";
		setParent..;
		
		rowLayout -nc 2 -cw2 50 160;
			text -label "fileName";
			textField -w 160 -tx "default" -cc "MS_toroExporterUI_storeRecallUI store" "fileName";
		setParent..;
		checkBox 
			-l "オブジェクト名をファイル名に使用する" 
			-v 0 
			-onc "textField -e -en 0 \"fileName\";MS_toroExporterUI_storeRecallUI store;" 
			-ofc "textField -e -en 1 \"fileName\";MS_toroExporterUI_storeRecallUI store;" 
			"useObjectNameCheck";
		text -l "※expoerAllするとシーン名が出力されます。";
		text -l "※複数のオブジェクト選択時、それぞれ出力されます";
		separator -w 217;
	text -w 217 -bgc 0.9 0.9 0.9 -l "名前重複に関するオプション";
		checkBox 
			-l "重複オブジェクトをリネームして出力" 
			-v 0
			-onc "MS_toroExporterUI_storeRecallUI store;" 
			-ofc "MS_toroExporterUI_storeRecallUI store;" 	
			"nameCheckRename";
			
		separator -w 217;
	text -w 217 -bgc 0.9 0.9 0.9 -l "tscrスクリプト出力用";
		checkBox
			-l "PEdit用スクリプト（tscr）出力"
			-v 1
			-onc "checkBox -e -en 1 showViewer;MS_toroExporterUI_storeRecallUI store;" 
			-ofc "checkBox -e -en 0 -v 0 showViewer;MS_toroExporterUI_storeRecallUI store;" 	
			"exportPEditScript";
		checkBox
			-l "最適化コマンド出力"
			-v 1
			-onc "MS_toroExporterUI_storeRecallUI store;" 
			-ofc "MS_toroExporterUI_storeRecallUI store;" 	
			"optimize";		
		checkBox
			-l "スクリプトにセーブコマンド出力"
			-v 0
			-onc "MS_toroExporterUI_storeRecallUI store;" 
			-ofc "MS_toroExporterUI_storeRecallUI store;" 	
			"save";		
		checkBox
			-l "ビューワーを起動（tscrを実行）"
			-v 0
			-onc "MS_toroExporterUI_storeRecallUI store;" 
			-ofc "MS_toroExporterUI_storeRecallUI store;" 
			"showViewer";
		checkBox
			-l "セーブしたらPEditを終了"
			-v 0
			-onc "MS_toroExporterUI_storeRecallUI store;" 
			-ofc "MS_toroExporterUI_storeRecallUI store;" 
			"exit";
			
		separator -w 217;
		rowLayout -nc 2 -cw2 150 67;
		button -w 150 -l "exprot selection" -bgc 0.8 1.0 0.8  -c "toroExporterUI_core 1";
		button -w 60 -l "exprot All" -bgc 0.8 0.8 1.0  -c "toroExporterUI_core 0";
		setParent..;
	text -w 217 -bgc 0.9 0.9 0.9 -l "その他の出力用";
		checkBox
			-l "アニメーション出力"
			-v 1
			-onc "MS_toroExporterUI_storeRecallUI store;" 
			-ofc "MS_toroExporterUI_storeRecallUI store;" 	
			"exportFrameSet";
			
		separator -w 217;
		checkBox
			-l "プライオリティー変換（未実装）"
			-v 0
			-onc "MS_toroExporterUI_storeRecallUI store;" 
			-ofc "MS_toroExporterUI_storeRecallUI store;" 	
			"getPriority";
		separator -w 217;
		rowLayout -nc 2 -cw2 160 50;
		text -l "プライオリティー開始値";
		intField -min -255 -max 255 "priorityOffset";
		setParent..;
		
		button -w 210 -l "toroExporterUI_transform2locator" -bgc 0.8 0.8 1.0  -c "toroExporterUI_transform2locator";
		button -w 210 -l "MP_MS_matterSetup" -bgc 1.0 0.8 1.0  -c ("MP_MS_matterSetupUI;");

		setParent..;
	
		columnLayout;
		separator -w 217 -h 100;
		button -w 210 -l "環境変数クリアボタン" -bgc 1.0 0.5 0.5  -c "MS_toroExporterUI_storeRecallUI reset";

	MS_toroExporterUI_storeRecallUI recall;
	
	if(`checkBox -q -v "useObjectNameCheck"`){
		textField -e -en 0 "fileName";
	}else{
		textField -e -en 1 "fileName";
	}
	
	
	if(!`checkBox -q -v "exportPEditScript"`){
		checkBox -e -en 0 "showViewer";
	}
	
	window -e -wh 217 440 toroExporterUI;
	
	showWindow toroExporterUI;
}

//toroExporterUI;

