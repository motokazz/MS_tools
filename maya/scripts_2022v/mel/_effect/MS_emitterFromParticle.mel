global proc int[] MS_selectTime(){
	/*
	タイムスライダーから時間を取得
	
	スライダーで範囲選択がある場合はその範囲内を
	そうでない場合は現在のタイムスライダーの範囲を返す
	
	*/
	//グローバル宣言しないとプロシージャ内でタイムスライダーを特定できない。
	global string $gPlayBackSlider;
	
	string $buf[];
	
	string $tc=`timeControl -q -rng -gt $gPlayBackSlider`;
	
	tokenize $tc ":\"" $buf;
	
	int $st=$buf[0];
	int $ed=$buf[1];
	if(($ed-$st)<=1){
		$st=`playbackOptions -q -min`;
		$ed=`playbackOptions -q -max`;
	}
	return {$st,$ed};
}




global proc MS_setEmitterV2(string $EmitterName,int $strtm,int $endtm,int $BeforeFlame0,int $AfterFlame0,int $rnd1,int $noKey){
	//オリジナルからの改良点、フレーム指定を（スタート時間、継続時間）と言う指定から（スタート時間、終了時間）と言う指定に。

	string $obj[]=`ls -sl`;
	for($name in $obj){
		
		select -r $name;
		setEmitterInfo;
		
		setAttr -type "string" ($name+".EmitterName") $EmitterName;
		
		if(!$noKey){
		
		
		
		$strtm=$strtm+rand ($rnd1);
		
		
//スタートフレーム設定
		if($BeforeFlame0){
			
			currentTime ($strtm-1);
			setKeyframe -v 0 ($name+".EmitterVolume");
		
		}
		currentTime $strtm ;
		setKeyframe -v 1 ($name+".EmitterVolume");
		
		currentTime ($endtm-1);
		setKeyframe -v 1 ($name+".EmitterVolume");
		
//エンドフレーム設定
		if($AfterFlame0){
			
			currentTime ($endtm);
			setKeyframe -v 0 ($name+".EmitterVolume");
		
		}

		
		keyTangent -ott step ($name+".EmitterVolume");
		
		currentTime ($endtm-1);
		
		}
	}
}



global proc MS_Particle2Curve(){

	$sel = `ls -sl -sn -o`;
	$part = $sel[0];
	int $count = `getAttr ($sel[0]+".count")`;
	int $i = 0;
	
	$pos_v0 = `particle -at position -id 0 -q $part`;
	$pos_v1 = `particle -at position -id 1 -q $part`;
	curve -d 1 -p $pos_v0[0] $pos_v0[1] $pos_v0[2] -p $pos_v1[0] $pos_v1[1] $pos_v1[2] -k 0 -k 1 -n curvez;
	
	for($i=2;$i<$count;$i++){
	$pos = `particle -at position -id $i -q $part`;
	extendCurve -cos 0 -ch 0 -em 2 -px $pos[0] -py $pos[1] -pz $pos[2] -s 0 -jn true -rmk true -rpo on "curvez" ;
	}
	
	rename curvez particle2curve;
	
}

global proc MS_emitterFromParticle(){
	float $tm[]=`MS_selectTime`;
	
	float $PPos[]=`xform -q -ws -t $particle+".pt["+$i+"]"`;
	
	
}

global proc MS_emitterFromParticleUI()
{
	
	//Window Check
	if(`window -exists MS_emitterFromParticleUI`){
		deleteUI MS_emitterFromParticleUI;
	}
	
	//Create Window
	
	window -title "MS_emitterFromParticleUI" MS_emitterFromParticleUI;
	
	
	button -l "MS_emitterFromParticle" -c "MS_emitterFromParticle";
	
	
	//Footer
	showWindow MS_emitterFromParticleUI;
	
}

MS_emitterFromParticleUI;




