/*
20060908
EOJ専用
フォグの設定が存在すれば表示。

使用法：
フォグ設定のあるシーンを読み込んで、コマンド実行。
*/
global proc MS_fogchecker(){
	if(`window -q -ex MS_fogchecker_core`)deleteUI MS_fogchecker_core;
	window MS_fogchecker_core;
	columnLayout;
	string $obj[]=`ls -typ "cgfxShader" -sl`;
	//if((size($obj))==0){string $obj[]=`ls -typ "cgfxShader"`;}
	
	for($each in $obj){
		
		text -l $each;
		separator -w 100;
		
		text -l "Near    : ";
		textField -w 100 -tx `getAttr ($each+".fogNear")`;
		text -l "Far     : ";
		textField -w 100 -tx `getAttr ($each+".fogFar")`;
		text -l "ColorR  : ";
		textField -w 100 -tx `getAttr ($each+".fogColorX")`;
		text -l "ColorG  : ";
		textField -w 100 -tx `getAttr ($each+".fogColorY")`;
		text -l "ColorB  : ";
		textField -w 100 -tx `getAttr ($each+".fogColorZ")`;
		
		text -l "Density : ";
		textField -tx `getAttr ($each+".fogDensity")`;
		
		print `getAttr ($each+".fogColor")`;
	}
	showWindow MS_fogchecker_core;
}
