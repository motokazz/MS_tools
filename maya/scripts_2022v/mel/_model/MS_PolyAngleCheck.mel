/*
-------------------
MS_PolyAngleCheck.mel
-------------------

◆概要
ある一定の方向を向いているポリゴンを選択する。

◆使用方法
スクリプトを事項するとダイアログが開く。
オブジェクトを選んで設定して実行ボタンを押す。


◆詳細
やってみればわかる

※注意
SelectionConstrainのほうが1000万倍くらい優れている。




*/




global proc float[] getNormal( string $face ){

	string $info[] = ` polyInfo -fn $face `;

	string $elm[];
	tokenize $info[0] " " $elm ;

	float $Result[] = { (float)$elm[2] , $elm[3] , $elm[4] };
	normalize $Result;
	return $Result ;
}


global proc MS_PolyAngleCheck_A(){

	PolySelectConvert 1;

	string $name_poly[]=`filterExpand -ex true -sm 34`;
	string $res_poly[];
	
	float $val_throushould=`floatSliderGrp -q -v throushould`;

	float $val_angle_x=`floatSliderGrp -q -v angle_x`;
	float $val_angle_y=`floatSliderGrp -q -v angle_y`;
	float $val_angle_z=`floatSliderGrp -q -v angle_z`;

	$val_radios=`radioButtonGrp -q -sl radioflag`;
	
	$i=0;
	$j=0;
	
	
	for($i=0;$i<size($name_poly);$i++){
	
		vector $val_poly=`getNormal $name_poly[$i]`;
		
		
		$test=$name_poly[$i]+"   "+$val_poly+"\n"+$val_radios+"\n\n";
		
		
		if(
			(abs($val_angle_x-$val_poly.x))<$val_throushould && 
			(abs($val_angle_y-$val_poly.y))<$val_throushould && 
			(abs($val_angle_z-$val_poly.z))<$val_throushould 
		){
			$res_poly[$j]=$name_poly[$i];
			$j++;
		}
		
		
	}

select $res_poly;

clear $res_poly;
clear $name_poly;


}



global proc Ms_PolyAngleCheck(){
	if(`window -exists Ms_AngleCheck`){
		deleteUI Ms_AngleCheck;
	}
	
	window -title "Ms_AngleCheck" Ms_AngleCheck;	
	
	$form = `formLayout`;

	setParent $form;
	$sep=`separator`;


	$com_angle_x=`floatSliderGrp -l "Xrad" -field true -min -1 -max 1 -v 0 angle_x`;
	$com_angle_y=`floatSliderGrp -l "Yrad" -field true -min -1 -max 1 -v 1 angle_y`;
	$com_angle_z=`floatSliderGrp -l "Zrad" -field true -min -1 -max 1 -v 0 angle_z`;

	$com_throushould=`floatSliderGrp -l "throushould" -field true -min -1 -max 1 -v 0.5 throushould`;

	$com_radios_a=`radioButtonGrp
            		-numberOfRadioButtons 3
            		-label "Rock Resolution"
            		-labelArray3 "X" "Y" "Z"
			-sl 1 radioflag`;

	$com_anglecheck=`button -l "AngleCheck" -command "MS_PolyAngleCheck_A" `;
	$com_und=`button -l "undo" -command "Undo" `;
	$com_ext=`button -l "exit" -command "deleteUI Ms_AngleCheck" `;

	formLayout -e
//----------------------------------
	-af $com_angle_x "top" 10
        -af $com_angle_x "left" 5
        -an $com_angle_x "right"
        -an $com_angle_x "bottom"

	-af $sep "top" 40
	-af $sep "left" 5
	-af $sep "right" 5
	-an $sep "bottom"
//----------------------------------
	-af $com_angle_y "top" 50
        -af $com_angle_y "left" 5
        -an $com_angle_y "right"
        -an $com_angle_y "bottom"

	-af $sep "top" 90
	-af $sep "left" 5
	-af $sep "right" 5
	-an $sep "bottom"
//----------------------------------
	-af $com_angle_z "top" 100
        -af $com_angle_z "left" 5
        -an $com_angle_z "right"
        -an $com_angle_z "bottom"

	-af $sep "top" 140
	-af $sep "left" 5
	-af $sep "right" 5
	-an $sep "bottom"
//----------------------------------
	-af $com_throushould "top" 150
        -af $com_throushould "left" 5
        -an $com_throushould "right"
        -an $com_throushould "bottom"

	-af $sep "top" 190
	-af $sep "left" 5
	-af $sep "right" 5
	-an $sep "bottom"
//------------------------------------

	-af $com_radios_a "top" 200
	-af $com_radios_a "left" 5
	-an $com_radios_a "right"
	-an $com_radios_a "bottom"

//------------------------------------

	-af $com_anglecheck "top" 250
        -af $com_anglecheck "left" 5
        -ap $com_anglecheck "right" 0 20
        -an $com_anglecheck "bottom"

        -af $com_und "top" 250
        -ap $com_und "left" 0 60
        -ap $com_und "right" 0 80
        -an $com_und "bottom"

        -af $com_ext "top" 250
        -ap $com_ext "left" 0 80
        -af $com_ext "right" 5
        -an $com_ext "bottom"
	$form;
	
	showWindow Ms_AngleCheck;
	

}


Ms_PolyAngleCheck;

