
/*
-------------------
mel_name.mel
-------------------

◆概要
なんだかよくわからない

◆使用方法



◆詳細
多分、法線の角度をチェックして？度以内のフェースを選択するようなものだと思う。
SelectionConstrainを発見して開発中止したような気がする。


※注意
使っても何も得しない。



*/
global proc MS_AngleCheck_CV(){
	float $val_org=`floatSliderGrp -q -v throushold`;
	string $obj[]=`ls -typ transform -sl`;
	for($each in $obj){
		select -add ($each+".cv[0:*]");
	}
	string $name_temp[]=`filterExpand -ex true -sm 28`;
	
	string $res_array[];
	int $i=0;
	int $j=0;
	for($i=0;$i<(size($name_temp)-2);$i++){
		vector $vec_a=`pointPosition -w $name_temp[$i]`;
		vector $vec_b=`pointPosition -w $name_temp[$i+1]`;
		vector $vec_c=`pointPosition -w $name_temp[$i+2]`;
		
		vector $vec_ab=$vec_a-$vec_b;
		vector $vec_bc=$vec_b-$vec_c;
		float $res_a=`angle $vec_ab $vec_bc`;
		print ($res_a+"\n");
		
		if($res_a<$val_org){
			$res_array[$j]=$name_temp[$i+1];
			$j++;
		}
		
		select -r $res_array;
	}
	
}




global proc MS_AngleCheck_A(){
	string $name_vtx[]=`filterExpand -ex true -sm 31 -sm 28`;
	string $res_vtx[];
	
	float $val_org=`floatSliderGrp -q -v throushold`;
	float $pai=(3.141592654);
	
	$i=0;
	$j=0;
	
	for($i=0;$i<size($name_vtx);$i++){
	
		select $name_vtx[$i];
	
		PolySelectConvert 2;
		PolySelectConvert 3;
	
		string $name_temp[]=`filterExpand -ex true -sm 31 -sm 28`;
	
		vector $vec_a=`pointPosition -w $name_temp[0]`;
		vector $vec_b=`pointPosition -w $name_temp[1]`;
		vector $vec_c=`pointPosition -w $name_temp[2]`;
	
	
	
		vector $vec_ab=$vec_a-$vec_b;
		vector $vec_bc=$vec_b-$vec_c;
		$res_a=`angle $vec_ab $vec_bc`;
		print $res_a;
	/*
	
		print "----------------------------------------------\n";
		print ($i+"\n"+$name_temp[0]+"\n"+$name_temp[1]+"\n"+$name_temp[2]+"\nangle:"+`angle $vec_ab $vec_bc`+"\n"+`cross $vec_ab $vec_bc`+"\n"+`dot $vec_ab $vec_bc`+"\nmag:"+`mag $vec_ab`+"\n\n");
		print ($res_a+"\n");
		print "----------------------------------------------\n";
	*/
	
		float $val_big=`fmod $res_a $pai`;
	
	
		if($val_big<$val_org || ($pai-$val_org)<$val_big && $val_big<($pai+$val_org)){
			$res_vtx[$j]=$name_vtx[$i];
			$j++;
		}
	
	clear $name_temp;
	}

select $res_vtx;

clear $res_vtx;
clear $name_vtx;


}



global proc Ms_AngleCheck_V2(){
	if(`window -exists Ms_AngleCheck_V2`){
		deleteUI Ms_AngleCheck_V2;
	}
	
	window -title "Ms_AngleCheck" Ms_AngleCheck_V2;	
	
	columnLayout;
	
	floatSliderGrp -l "throushold" -field true -min 0 -max 3.14 -v 0.1 throushold;
	
	separator -w 400;
	
	button -l "AngleCheck_Poly" -command "MS_AngleCheck_A" ;
	button -l "AngleCheck_CV" -command "MS_AngleCheck_CV" ;
	
	showWindow Ms_AngleCheck_V2;
	

}


Ms_AngleCheck_V2;

