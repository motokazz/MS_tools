global proc int[] MS_selectTime(){
	/*
	タイムスライダーから時間を取得
	
	スライダーで範囲選択がある場合はその範囲内を
	そうでない場合は現在のタイムスライダーの範囲を返す
	
	*/
	//グローバル宣言しないとプロシージャ内でタイムスライダーを特定できない。
	global string $gPlayBackSlider;
	
	string $buf[];
	
	string $tc=`timeControl -q -rng -gt $gPlayBackSlider`;
	
	tokenize $tc ":\"" $buf;
	
	int $st=$buf[0];
	int $ed=$buf[1];
	if(($ed-$st)<=1){
		$st=`playbackOptions -q -min`;
		$ed=`playbackOptions -q -max`;
	}
	return {$st,$ed};
}



global proc MS_constraint(
	int $point,
	string $point_option,
	int $aim,
	int $orient,
	int $scale,
	int $parent,
	int $geometry,
	int $normal,
	int $tangent,
	int $poleVector,
	string $target[],
	string $obj[])
{
	
	for($each in $obj){
		
		if($point){
		string $option=stringArrayToString($target," ");
		eval("pointConstraint -w 1.0 -o 0 0 0 "+$point_option+" "+$option+" "+$each+";");
		}
		
		if($aim)
		aimConstraint -offset 0 0 0 -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "vector" $target $each;
		
		if($orient)
		orientConstraint -offset 0 0 0 -weight 1 $target $each;
		
		if($scale)
		scaleConstraint -offset 1 1 1 -weight 1 $target $each;
		
		if($parent)
		parentConstraint -mo -weight 1 $target $each;
		
		
		if($geometry)
		geometryConstraint -weight 1 $target $each;
		
		if($normal)
		normalConstraint -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "vector" -worldUpVector 0 1 0 $target $each;
		
		if($tangent)
		tangentConstraint -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "vector" -worldUpVector 0 1 0 $target $each;
		
		if($poleVector)
		poleVectorConstraint -weight 1 $target $each;
		
	}
	
}


global proc string createCurve(float $strtm,float $endtm,int $cdg,float $step,string $obj,int $bspline,int $revCurve){
	
	//モーションからカーブを作成する
	
	float $range=($endtm-$strtm);
	
	currentTime -e $strtm;
	
	float $dtf[]=`xform -q -a -t -ws $obj`;
	
	string $newCurve=`curve -ws -d $cdg -p $dtf[0] $dtf[1] $dtf[2]`;
	
	float $ct=0;
	int $i=0;
	for($i=0;$i<($range/$step);$i++){
		$ct=$ct+$step;
		currentTime -e ($strtm+$ct);
		float $dtf[]=`xform -q -a -t -ws $obj`;
		curve -ws -a -p $dtf[0] $dtf[1] $dtf[2] $newCurve;
	}
	
	//カーブを反転する
	if($revCurve){
		reverseCurve -ch 0 -rpo 1 $newCurve;
	}
	
	//fitBsplineを使う
	if($bspline){
		
		string $bs[]=`fitBspline -ch 1 -tol 0.01 $newCurve`;
		$newCurve=$bs[0];
		
	}

	
	return $newCurve;
	
}
global proc string createJoint(int $step,float $length){


	string $jname=`joint -a -p 0 0 0 -sc 0 `;
	float $span=($length/$step);
	float $val=0;
	while($val<$length){
		$val=$val+$span;
		joint -a -p 0 0 (-$val) -sc 0 ;
	}
	
	return $jname;
}

global proc string createPathAnimetedLocator(string $cname,int $sframe,int $eflame){
	
	string $obj[]=`spaceLocator -p 0 0 0`;
	
	pathAnimation -fractionMode true -follow false -startTimeU $sframe -endTimeU $eflame -c $cname $obj[0];
	
	return $obj[0];
}
global proc string[] IKspline(string $jparent,string $ikcurve){
	
	string $child[]=`listRelatives -ad $jparent`;
	
	string $ikn[0]=`ikHandle -sol ikSplineSolver -ccv false -roc false -cra true -pcv false -sj $jparent -ee $child[0] -c $ikcurve`;
	string $ret[];
	$ret[0]=$ikn[0];
	string $prt[]=`listRelatives -p $jparent`;
	$ret[1]=$prt[0];
	return $ret;
	
	
}
global proc jointscaleFromAnimation(int $strtm,int $endtm,string $obj){
	/*
	親アニメーションの前後のフレーム差でスケルトンをスケーリングする
	*/
	
	float $all[];
	
	currentTime ($strtm-1);
	float $ff[]=`xform -q -ws -t $obj`;
	
	
	//すべてのフレーム間で動き距離を検査
	for($i=$strtm;$i<$endtm;$i++){
		
		currentTime $i;
		
		float $cf[] = `xform -q -ws -t $obj`;
		
		float $len = sqrt(($ff[0]-$cf[0])*($ff[0]-$cf[0])+($ff[1]-$cf[1])*($ff[1]-$cf[1])+($ff[2]-$cf[2])*($ff[2]-$cf[2]));
		
		$all[$i-$strtm]=$len;
		
		$ff= $cf;
		
	}
	
	
	//一番大きい動きを検査
	float $hikaku[]=`sort $all`;
	float $maxrange=$hikaku[(size($hikaku)-1)];
	
	//キーフレーム作成
	for($i=$strtm;$i<$endtm;$i++){
		
		float $rate=($all[$i-$strtm]/$maxrange);
		
		setKeyframe -at "scaleX" -t $i -v $rate $obj;
		setKeyframe -at "scaleY" -t $i -v $rate $obj;
		setKeyframe -at "scaleZ" -t $i -v $rate $obj;
		
	}
	
}global proc string[] MS_arrayAdd(string $arr[],string $add){
	$arr[size($arr)]=$add;
	return $arr;
}
global proc string[] MS_arrayInvert(string $arr[]){
	string $newArray[];
	
	for ($i=0;$i<size($arr);$i++){
		string $temp=$arr[size($arr)-$i-1];
		$newArray[$i]=$temp;
	}
	
	return $newArray;
}

global proc MS_jointLoft(){
	string $new[];
	$obj=`ls -l -sl`;
	for ($i=0;$i<(size($obj)-1);$i++){
		
		string $jntA[]=`listRelatives -ad -f -typ joint $obj[$i]`;
		
		string $jntB[]=`listRelatives -ad -f -typ joint $obj[($i+1)]`;
		
		if(`nodeType $obj[$i]`=="joint"){
			$jntA[size($jntA)]=$obj[$i];
		}
		if(`nodeType $obj[$i+1]`=="joint"){
			$jntB[size($jntB)]=$obj[$i+1];
		}

		
		string $com="polyCreateFacet -ch on -tx 1 -s 1 ";
		
		string $newj[]=`MS_arrayInvert $jntB`;
		
		string $allJoints[]=`stringArrayCatenate $jntA $newj`;
		
		for ($each in $allJoints){
			float $loc[]=`xform -q -ws -t $each`;
			$com=($com+"-p "+$loc[0]+" "+$loc[1]+" "+$loc[2]+" ");
		}
		
		//トレイルのポリゴン作成
		$new=`eval $com`;
		
		//スキニング
		select -r $new[0] $jntA $jntB;
		SmoothBindSkin;
		
		//頂点カラー
		
		float $step=(2.0/(size($allJoints)));
		print $step;
		print "\n";
		for($j=0;$j<size($jntA);$j++){
			string $vtxname=($new[0]+".vtx["+$j+"]");
			float $colval=($step*$j);
			print $colval;
			print "\n";
			polyColorPerVertex -r $colval -g $colval -b $colval -a $colval $vtxname ;
		}
		
		for($j=0;$j<size($jntB);$j++){
			int $k=size($jntA)+$j;
			string $vtxname=($new[0]+".vtx["+$k+"]");
			float $colval=($step*(size($jntA)+size($jntB)-$k));
			print $colval;
			print "\n";
			polyColorPerVertex -r $colval -g $colval -b $colval -a $colval $vtxname ;
		}
		
	}
	
	//シェーダー作成＆割付
	createEF_1;
	
	string $shad[]=`ls -sl`;
	string $sg[]=`listConnections -t shadingEngine`;
	string $cgfx[]=`listConnections -t cgfxShader`;
	
	select -r $new;
	sets -e -forceElement $sg[0];
	
	
	//MS_VFA

	MS_VFA_Float(
	`playbackOptions -q -min`,
	`playbackOptions -q -max`,
	0,
	1,
	$obj[0],
	$cgfx,
	{"baseColorAlpha"}
	
);

	
	
	
	
}


global proc string[] MS_selectFilter(){

	/*
	より分け選択
	*/
	
	string $objz[]=`ls -typ transform -sl`;
	if(!size($objz)){
		$objz=`filterExpand -sm 12 -sm 22 -sm 31 -sm 32 -sm 34 -sm 46 `;
	}
	return $objz;
	
}
global proc MS_trailEmitter(
	int $strtm,
	int $endtm,
	int $curvedegree,
	int $curveStep,
	int $bspline,
	int $revCurve,
	int $jointPartsQuantity,
	float $jointLength
){
	/*
//MS_trail====================================================================
	
	//---param---
	//createCurve
	int $curvedegree=1;//curvedegree
	int $curveStep=1;//curveStep
	int $bspline=1;
	int $revCurve =1;
	
	//createJoint
	int $jointPartsQuantity=10;//jointPartsQuantity
	float $jointLength=100;//jointLength

	//---paramend---	
	
	*/
	
	
	string $obj[]=`ls -sl`;
	
	
	string $cname=`createCurve $strtm $endtm $curvedegree $curveStep $obj[0] $bspline $revCurve`;
	
	string $jname=`createJoint $jointPartsQuantity $jointLength`;

	string $iknul[]=`IKspline $jname $cname`;
	
	//カーブを反転しないとikSplineが逆にくっついちゃう
	string $check[]=`ls -typ transform -sl `;
	
	if(size($check)){
		MS_constraint (1,"",0,0,0,0,0,0,0,0,$obj,{$iknul[1]});
	}else{
		MS_vertexpointConstraint $obj $iknul[1];
	}
	
	//MS_vertexpointConstraint $obj $iknul[1];
	
	jointscaleFromAnimation $strtm $endtm $jname;
	
	
	
	
//==========================================================================
	
	string $target[];
	
	$target=`listRelatives -ad -f -typ joint $jname`;
	
	float $threshold=0.5;
	
	
	string $newLocz[];
	int $i=0;
	for($each in $target){
		string $newLoc[]=`spaceLocator`;
		MS_setEmitter("sak_traildef",0,0,0,0,0,1);
		MS_constraint (1,"",0,1,0,0,0,0,0,0,{$each},$newLoc);
		$newLocz[$i]=$newLoc[0];
		$i++;
	}
	
	int $atime[]=`MS_selectTime`;
	
	MS_VFA_Switch $atime[0] $atime[1] $threshold $target[0] $newLocz {"EmitterVolume"};
	
	
	
	

}global proc int[] MS_selectTime(){
	/*
	タイムスライダーから時間を取得
	
	スライダーで範囲選択がある場合はその範囲内を
	そうでない場合は現在のタイムスライダーの範囲を返す
	
	*/
	//グローバル宣言しないとプロシージャ内でタイムスライダーを特定できない。
	global string $gPlayBackSlider;
	
	string $buf[];
	
	string $tc=`timeControl -q -rng -gt $gPlayBackSlider`;
	
	tokenize $tc ":\"" $buf;
	
	int $st=$buf[0];
	int $ed=$buf[1];
	if(($ed-$st)<=1){
		$st=`playbackOptions -q -min`;
		$ed=`playbackOptions -q -max`;
	}
	return {$st,$ed};
}



global proc MS_constraint(
	int $point,
	string $point_option,
	int $aim,
	int $orient,
	int $scale,
	int $parent,
	int $geometry,
	int $normal,
	int $tangent,
	int $poleVector,
	string $target[],
	string $obj[])
{
	
	for($each in $obj){
		
		if($point){
		string $option=stringArrayToString($target," ");
		eval("pointConstraint -w 1.0 -o 0 0 0 "+$point_option+" "+$option+" "+$each+";");
		}
		
		if($aim)
		aimConstraint -offset 0 0 0 -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "vector" $target $each;
		
		if($orient)
		orientConstraint -offset 0 0 0 -weight 1 $target $each;
		
		if($scale)
		scaleConstraint -offset 1 1 1 -weight 1 $target $each;
		
		if($parent)
		parentConstraint -mo -weight 1 $target $each;
		
		
		if($geometry)
		geometryConstraint -weight 1 $target $each;
		
		if($normal)
		normalConstraint -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "vector" -worldUpVector 0 1 0 $target $each;
		
		if($tangent)
		tangentConstraint -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "vector" -worldUpVector 0 1 0 $target $each;
		
		if($poleVector)
		poleVectorConstraint -weight 1 $target $each;
		
	}
	
}


global proc string createJoint(int $step,float $length){


	string $jname=`joint -a -p 0 0 0 -sc 0 `;
	float $span=($length/$step);
	float $val=0;
	while($val<$length){
		$val=$val+$span;
		joint -a -p 0 0 (-$val) -sc 0 ;
	}
	
	return $jname;
}

global proc string[] MS_arrayInvert(string $arr[]){
	string $newArray[];
	
	for ($i=0;$i<size($arr);$i++){
		string $temp=$arr[size($arr)-$i-1];
		$newArray[$i]=$temp;
	}
	
	return $newArray;
}
global proc MS_VFA_Float(
	int $strtm,
	int $endtm,
	float $minvalue,
	float $maxvalue,
	string $target,
	string $obj[],
	string $attr[])
{
	/*
	親アニメーションの前後のフレーム差でスケルトンをスケーリングする
	*/
	
	float $all[];
	
	currentTime ($strtm-1);
	float $ff[]=`xform -q -ws -t $target`;
	
	
	//すべてのフレーム間で動き距離を検査
	for($i=$strtm;$i<$endtm;$i++){
		
		currentTime $i;
		
		float $cf[] = `xform -q -ws -t $target`;
		//2点間の移動距離を計算
		float $len = sqrt(($ff[0]-$cf[0])*($ff[0]-$cf[0])+($ff[1]-$cf[1])*($ff[1]-$cf[1])+($ff[2]-$cf[2])*($ff[2]-$cf[2]));
		
		$all[$i-$strtm]=$len;
		
		$ff= $cf;
		
	}
	
	
	//一番大きい動きを検査
	float $hikaku[]=`sort $all`;
	float $maxrange=$hikaku[(size($hikaku)-1)];
	
	//キーフレーム作成
	for($each in $obj){
		for($i=$strtm;$i<$endtm;$i++){
			
			float $rate=($all[$i-$strtm]/$maxrange)*$maxvalue;
			if($rate<$minvalue){$rate=$minvalue;}
				for($eachAttr in $attr)
				setKeyframe -at $eachAttr -t $i -v $rate $each;
				
		}
	}
}global proc string createCurve(float $strtm,float $endtm,int $cdg,float $step,string $obj,int $bspline,int $revCurve){
	
	//モーションからカーブを作成する
	
	float $range=($endtm-$strtm);
	
	currentTime -e $strtm;
	
	float $dtf[]=`xform -q -a -t -ws $obj`;
	
	string $newCurve=`curve -ws -d $cdg -p $dtf[0] $dtf[1] $dtf[2]`;
	
	float $ct=0;
	int $i=0;
	for($i=0;$i<($range/$step);$i++){
		$ct=$ct+$step;
		currentTime -e ($strtm+$ct);
		float $dtf[]=`xform -q -a -t -ws $obj`;
		curve -ws -a -p $dtf[0] $dtf[1] $dtf[2] $newCurve;
	}
	
	//カーブを反転する
	if($revCurve){
		reverseCurve -ch 0 -rpo 1 $newCurve;
	}
	
	//fitBsplineを使う
	if($bspline){
		
		string $bs[]=`fitBspline -ch 1 -tol 0.01 $newCurve`;
		$newCurve=$bs[0];
		
	}

	
	return $newCurve;
	
}
global proc string createPathAnimetedLocator(string $cname,int $sframe,int $eflame){
	
	string $obj[]=`spaceLocator -p 0 0 0`;
	
	pathAnimation -fractionMode true -follow false -startTimeU $sframe -endTimeU $eflame -c $cname $obj[0];
	
	return $obj[0];
}
global proc string[] IKspline(string $jparent,string $ikcurve){
	
	string $child[]=`listRelatives -ad $jparent`;
	
	string $ikn[0]=`ikHandle -sol ikSplineSolver -ccv false -roc false -cra true -pcv false -sj $jparent -ee $child[0] -c $ikcurve`;
	string $ret[];
	$ret[0]=$ikn[0];
	string $prt[]=`listRelatives -p $jparent`;
	$ret[1]=$prt[0];
	return $ret;
	
	
}

