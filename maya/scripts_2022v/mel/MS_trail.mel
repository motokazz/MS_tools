		for ($each in $allJoints){
			float $loc[]=`xform -q -ws -t $each`;
			$com=($com+"-p "+$loc[0]+" "+$loc[1]+" "+$loc[2]+" ");
		}
		
		//トレイルのポリゴン作成
		$new=`eval $com`;
		
		//スキニング
		select -r $new[0] $jntA $jntB;
		SmoothBindSkin;
		
		//頂点カラー
		
		float $step=(2.0/(size($allJoints)));
		print $step;
		print "\n";
		for($j=0;$j<size($jntA);$j++){
			string $vtxname=($new[0]+".vtx["+$j+"]");
			float $colval=($step*$j);
			print $colval;
			print "\n";
			polyColorPerVertex -r $colval -g $colval -b $colval -a $colval $vtxname ;
		}
		
		for($j=0;$j<size($jntB);$j++){
			int $k=size($jntA)+$j;
			string $vtxname=($new[0]+".vtx["+$k+"]");
			float $colval=($step*(size($jntA)+size($jntB)-$k));
			print $colval;
			print "\n";
			polyColorPerVertex -r $colval -g $colval -b $colval -a $colval $vtxname ;
		}
		
	}
	
	//シェーダー作成＆割付
	createEF_1;
	
	string $shad[]=`ls -sl`;
	string $sg[]=`listConnections -t shadingEngine`;
	string $cgfx[]=`listConnections -t cgfxShader`;
	
	select -r $new;
	sets -e -forceElement $sg[0];
	
	
	//MS_VFA

	MS_VFA_Float(
	`playbackOptions -q -min`,
	`playbackOptions -q -max`,
	0,
	1,
	$obj[0],
	$cgfx,
	{"baseColorAlpha"}
	
);

	
	
	
	
}


global proc jointscaleFromAnimation(int $strtm,int $endtm,string $obj){
	/*
	親アニメーションの前後のフレーム差でスケルトンをスケーリングする
	*/
	
	float $all[];
	
	currentTime ($strtm-1);
	float $ff[]=`xform -q -ws -t $obj`;
	
	
	//すべてのフレーム間で動き距離を検査
	for($i=$strtm;$i<$endtm;$i++){
		
		currentTime $i;
		
		float $cf[] = `xform -q -ws -t $obj`;
		
		float $len = sqrt(($ff[0]-$cf[0])*($ff[0]-$cf[0])+($ff[1]-$cf[1])*($ff[1]-$cf[1])+($ff[2]-$cf[2])*($ff[2]-$cf[2]));
		
		$all[$i-$strtm]=$len;
		
		$ff= $cf;
		
	}
	
	
	//一番大きい動きを検査
	float $hikaku[]=`sort $all`;
	float $maxrange=$hikaku[(size($hikaku)-1)];
	
	//キーフレーム作成
	for($i=$strtm;$i<$endtm;$i++){
		
		float $rate=($all[$i-$strtm]/$maxrange);
		
		setKeyframe -at "scaleX" -t $i -v $rate $obj;
		setKeyframe -at "scaleY" -t $i -v $rate $obj;
		setKeyframe -at "scaleZ" -t $i -v $rate $obj;
		
	}
	
}global proc string[] MS_selectFilter(){

	/*
	より分け選択
	*/
	
	string $objz[]=`ls -typ transform -sl`;
	if(!size($objz)){
		$objz=`filterExpand -sm 12 -sm 22 -sm 31 -sm 32 -sm 34 -sm 46 `;
	}
	return $objz;
	
}
global proc MS_trail(
	int $curvedegree,
	int $curveStep,
	int $bspline,
	int $revCurve,
	int $jointPartsQuantity,
	float $jointLength
){


//---param---
	//createCurve
	//int $curvedegree=1;//curvedegree
	//int $curveStep=1;//curveStep
	//int $bspline=1;
	//int $revCurve =1;
	
	//createJoint
	//int $jointPartsQuantity=10;//jointPartsQuantity
	//float $jointLength=100;//jointLength

//---paramend---

	int $tm[]=`MS_selectTime`;
	
	string $obj[]=`MS_selectFilter`;
	
	
	string $cname=`createCurve $tm[0] $tm[1] $curvedegree $curveStep $obj[0] $bspline $revCurve`;
	
	string $jname=`createJoint $jointPartsQuantity $jointLength`;
	
	
	string $iknul[]=`IKspline $jname $cname`;
	
	//カーブを反転しないとikSplineが逆にくっついちゃう

	
	MS_vertexpointConstraint $obj $iknul[1];
	
	jointscaleFromAnimation $tm[0] $tm[1] $jname;
}


global proc MS_vertexpointConstraint(string $src[],string $dist){
	
	string $a;
	$a=($a+"{\n");
	
	string $obj=stringArrayToString($src,"\",\"");
	
	$a=($a+"string $objz[]={\""+$obj+"\"};\n");
	$a=($a+"float $totalX=0;\n");
	$a=($a+"float $totalY=0;\n");
	$a=($a+"float $totalZ=0;\n");
	
	//ボリューム中心検出
	$a=($a+"for ($each in $objz){\n");
			
	$a=($a+"vector $location=`xform -q -ws -t $each`;\n");

	$a=($a+"$totalX=$totalX+($location.x);\n");
	$a=($a+"$totalY=$totalY+($location.y);\n");
	$a=($a+"$totalZ=$totalZ+($location.z);\n");
			
	$a=($a+"}\n");

	$a=($a+"xform -ws -t ($totalX/size($objz)) ($totalY/size($objz)) ($totalZ/size($objz)) "+$dist+";\n");
	$a=($a+"}\n");
	
	print $a;
	expression -n "MS_vertexpointConstraint_Expression"-o $dist -s $a;
}
global proc MS_trailEmitter(
	int $strtm,
	int $endtm,
	int $curvedegree,
	int $curveStep,
	int $bspline,
	int $revCurve,
	int $jointPartsQuantity,
	float $jointLength
){
	/*
//MS_trail====================================================================
	
	//---param---
	//createCurve
	int $curvedegree=1;//curvedegree
	int $curveStep=1;//curveStep
	int $bspline=1;
	int $revCurve =1;
	
	//createJoint
	int $jointPartsQuantity=10;//jointPartsQuantity
	float $jointLength=100;//jointLength

	//---paramend---	
	
	*/
	
	
	string $obj[]=`ls -sl`;
	
	
	string $cname=`createCurve $strtm $endtm $curvedegree $curveStep $obj[0] $bspline $revCurve`;
	
	string $jname=`createJoint $jointPartsQuantity $jointLength`;

	string $iknul[]=`IKspline $jname $cname`;
	
	//カーブを反転しないとikSplineが逆にくっついちゃう
	string $check[]=`ls -typ transform -sl `;
	
	if(size($check)){
		MS_constraint (1,"",0,0,0,0,0,0,0,0,$obj,{$iknul[1]});
	}else{
		MS_vertexpointConstraint $obj $iknul[1];
	}
	
	//MS_vertexpointConstraint $obj $iknul[1];
	
	jointscaleFromAnimation $strtm $endtm $jname;
	
	
	
	
//==========================================================================
	
	string $target[];
	
	$target=`listRelatives -ad -f -typ joint $jname`;
	
	float $threshold=0.5;
	
	
	string $newLocz[];
	int $i=0;
	for($each in $target){
		string $newLoc[]=`spaceLocator`;
		MS_setEmitter("sak_traildef",0,0,0,0,0,1);
		MS_constraint (1,"",0,1,0,0,0,0,0,0,{$each},$newLoc);
		$newLocz[$i]=$newLoc[0];
		$i++;
	}
	
	int $atime[]=`MS_selectTime`;
	
	MS_VFA_Switch $atime[0] $atime[1] $threshold $target[0] $newLocz {"EmitterVolume"};
	
	
	
	

}global proc MS_VFA_Switch(
	int $strtm,
	int $endtm,
	float $threshold,
	string $target,
	string $obj[],
	string $attr[])
{
	/*
	親アニメーションの前後のフレーム差でスケルトンをスケーリングする
	*/
	
	
	float $all[];
	
	currentTime ($strtm-1);
	float $ff[]=`xform -q -ws -t $target`;
	
	
	//すべてのフレーム間で動き距離を検査
	for($i=$strtm;$i<$endtm;$i++){
		
		currentTime $i;
		
		float $cf[] = `xform -q -ws -t $target`;
		//2点間の移動距離を計算
		float $len = sqrt(($ff[0]-$cf[0])*($ff[0]-$cf[0])+($ff[1]-$cf[1])*($ff[1]-$cf[1])+($ff[2]-$cf[2])*($ff[2]-$cf[2]));
		
		$all[$i-$strtm]=$len;
		
		$ff= $cf;
		
	}
	
	int $val;
	//一番大きい動きを検査
	float $hikaku[]=`sort $all`;
	float $maxrange=$hikaku[(size($hikaku)-1)];
	
	//キーフレーム作成
	for($each in $obj){
		for($i=$strtm;$i<$endtm;$i++){
			
			float $rate=($all[$i-$strtm]/$maxrange);
			if($rate<$threshold){$val=0;}else{$val=1;}
			
			for($eachAttr in $attr){
				setKeyframe -at $eachAttr -t $i -v $val $each;
			}
			
			
		}
	}
	
}global proc MS_trailEmitter_pipe(){
	int $curvedegree=`intSliderGrp -q -v curvedegree`;
	
	int $curveStep=`intSliderGrp -q -v curveStep`;
	
	int $bspline=`checkBox -q -v bspline`;
	
	int $revCurve=`checkBox -q -v revCurve`;
	
	int $jointPartsQuantity=`intSliderGrp -q -v jointPartsQuantity`;
	
	float $jointLength=`floatSliderGrp -q -v jointLength`;
	
	int $tm[]=`MS_selectTime`;
	//string $obj[]=`MS_selectFilter`;
	string $cname=`MS_trailEmitter $tm[0] $tm[1] $curvedegree $curveStep $bspline $revCurve $jointPartsQuantity $jointLength`;
	
}

global proc MS_motionSpline_pipe(){
	int $curvedegree=`intSliderGrp -q -v curvedegree`;
	
	int $curveStep=`intSliderGrp -q -v curveStep`;
	
	int $bspline=`checkBox -q -v bspline`;
	
	int $revCurve=`checkBox -q -v revCurve`;
	
	int $jointPartsQuantity=`intSliderGrp -q -v jointPartsQuantity`;
	
	
	float $jointLength=`floatSliderGrp -q -v jointLength`;
	int $tm[]=`MS_selectTime`;
	string $obj[]=`MS_selectFilter`;
	string $cname=`createCurve $tm[0] $tm[1] $curvedegree $curveStep $obj[0] $bspline $revCurve`;
	
}

