proc string pad(string $a, int $b) {
   int $nsize = `size $a`;
   string $pad = "";

   if($nsize < $b) {
      for($i = 0; $i < ($b-$nsize); $i++) {
         $pad = $pad+"0";
      }
      return $pad+$a;
   }
   else {
      return $a;
   }

}

proc string MS_fullpathSplit(string $str){
	string $splitted[];
	tokenize($str,"|",$splitted);
	if(size($splitted)>1){
	string $ret=$splitted[(size($splitted)-2)];
	return $ret;
	}else{
	return $str;
	}
}

