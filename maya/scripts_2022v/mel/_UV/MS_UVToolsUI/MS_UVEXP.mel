global proc MS_UVEXP()
{

	PolySelectConvert 4;
	string $uvsuvs[]=`filterExpand -ex true -sm 35`;
	
	
	float $uvvalA[] =`polyEditUV -q -u $uvsuvs[0]`;
	float $uvvalB[] =`polyEditUV -q -u $uvsuvs[1]`;
	float $uvvalC[] =`polyEditUV -q -u $uvsuvs[2]`;
	float $uvvalD[] =`polyEditUV -q -u $uvsuvs[3]`;
	float $uvvalU = ($uvvalA[0]+$uvvalB[0]+$uvvalC[0]+$uvvalD[0])/4;
	float $uvvalV = ($uvvalA[1]+$uvvalB[1]+$uvvalC[1]+$uvvalD[1])/4;
	
	$i=0;
	for ($i=0;$i<4;$i++){
	
		float $UVval[]=`polyEditUV -q -u $uvsuvs[$i]`;
		
		if( $UVval[0]<$uvvalU &&  $UVval[1]<$uvvalV){
			polyEditUV -r 0 -u 0 -v 0 $uvsuvs[$i];
		}else if( $UVval[0]>$uvvalU && $UVval[1]>$uvvalV ){
			polyEditUV -r 0 -u 1 -v 1 $uvsuvs[$i];
		}else if( $UVval[0]<$uvvalU && $UVval[1]>$uvvalV ){
			polyEditUV -r 0 -u 0 -v 1 $uvsuvs[$i];
//		}else if( $UVval[0]>$uvvalU && $UVval[1]<$uvvalV ){
		}else{
			polyEditUV -r 0 -u 1 -v 0 $uvsuvs[$i];
		}
	}
	
	
	//‚±‚±‚©‚çStrainUVBorder
	
	string $num[];
	int $luv[];
	string $bname[];
	string $SUVName;
	string $SUVNend;
	
	string $obj[]=`ls -o -sl`;
	int $aaa[]=`polyEvaluate -uv $obj[0]`;
	
	
	tokenize ($uvsuvs[0],"[]",$bname);
	
	for ($i=0;$i<4;$i++){
		tokenize ($uvsuvs[$i],"[]",$num);
		$luv[$i]=int($num[size($num)-1]);
	}
	
	int $nuv[]=`sort $luv`;
	
	for ($i=0;$i<3;$i++){
		$SUVName=($bname[0]+"["+$nuv[$i]+":"+$nuv[$i+1]+"]");
		polyStraightenUVBorder -bo 0 -pl 0 -c 0 -gt 0 -ch 0 $SUVName;
		
	}
	
	
	
	
	$SUVName=($bname[0]+"["+"0"+":"+$nuv[0]+"]");
	$SUVNend=($bname[0]+"["+$nuv[3]+":"+($aaa[0]-1)+"]");
	polyStraightenUVBorder -bo 0 -pl 0 -c 0 -gt 0 -ch 0 $SUVName $SUVNend;

}

