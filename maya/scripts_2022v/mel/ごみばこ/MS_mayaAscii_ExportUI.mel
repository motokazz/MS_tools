global proc MS_mayaAscii_ExportUI()
{
if(`window -q -ex MyTools_mayaAscii_Export`)deleteUI MyTools_mayaAscii_Export;
window MyTools_mayaAscii_Export;
formLayout myUIFormLayout;
//--DataPart--//
text -label "filePath" "tex10" ;//Data//
textField -fileName `workspace -q -rd` -width 200 "filePath" ;//Data//
button -label "Brouse" -c "fileBrowser \"mayaAscii_Export_get_dir\" \"Select Directory\" \"\" 4" "Brouse";
text -label "additional ModelName" "text7" ;//Data//
text -label "additional AnimationName" "text6" ;//Data//
separator -width 300 "separator9" ;//Data//
button -backgroundColor 0.9411966801 1 0.7639999986 -label "exit" -width 48 -recomputeSize 0 -command "deleteUI MyTools_mayaAscii_Export" "exit" ;//Data//
button -width 80 -backgroundColor 0.8368660212 1 0.7720000148 -label "Export" -recomputeSize 0 -command "MS_mayaAscii_Export" "Export" ;//Data//
button -width 48 -backgroundColor 0.7720000148 0.8368660212 1 -label "Camera" -recomputeSize 0 -command "mayaAscii_Camera_Export" "CameraExport" ;//Data//
separator -width 300 -height 2 "separator8" ;//Data//
textField -width 100 "AnimationName" ;//Data//
textField -width 100 "ModelName";//Data//
checkBox -recomputeSize 0 -v 1 -label "History" -width 128 "History" ;//Data//
checkBox -recomputeSize 0 -v 1 -label "Channels" -width 128 "Channels" ;//Data//
checkBox -recomputeSize 0 -v 1 -label "Expressions" -width 128 "Expressions" ;//Data//
checkBox -recomputeSize 0 -v 1 -label "Constraints" -width 128 "Constraints" ;//Data//
checkBox -recomputeSize 0 -v 1 -label "TextureInfo" -width 128 "TextureInfo" ;//Data//

formLayout -e
	-af "History" "left" 16//Data//
	-af "History" "top" 16//Data//
	-af "Channels" "left" 16//Data//
	-af "Channels" "top" 32//Data//
	-af "Expressions" "left" 16//Data//
	-af "Expressions" "top" 48//Data//
	-af "Constraints" "left" 16//Data//
	-af "Constraints" "top" 64//Data//
	-af "TextureInfo" "left" 16//Data//
	-af "TextureInfo" "top" 80//Data//
	-af "text7" "left" 176//Data//
	-af "text7" "top" 16//Data//
	-af "ModelName" "left" 176//Data//
	-af "ModelName" "top" 32//Data//
	-af "text6" "left" 176//Data//
	-af "text6" "top" 64//Data//
	-af "AnimationName" "left" 176//Data//
	-af "AnimationName" "top" 80//Data//
	-af "separator9" "left" 0//Data//
	-af "separator9" "top" 136//Data//
	-af "tex10" "left" 0//Data//
	-af "tex10" "top" 144//Data//
	-af "filePath" "left" 0//Data//
	-af "filePath" "top" 160//Data//
	-af "Brouse" "left" 224//Data//
	-af "Brouse" "top" 160//Data//
	-af "separator8" "left" 0//Data//
	-af "separator8" "top" 184//Data//
	-af "CameraExport" "left" 16//Data//
	-af "CameraExport" "top" 192//Data//
	-af "Export" "left" 160//Data//
	-af "Export" "top" 192//Data//
	-af "exit" "left" 256//Data//
	-af "exit" "top" 192//Data//
	
//--DataPart--//
myUIFormLayout;
showWindow MyTools_mayaAscii_Export;
}
