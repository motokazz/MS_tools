global proc HRC_XFF_Export()
{
if(`window -q -ex MyTools_HRC_XFF_Export`)deleteUI MyTools_HRC_XFF_Export;
window MyTools_HRC_XFF_Export;
formLayout myUIFormLayout;
//--DataPart--//
text -label "filePath" "tex10" ;//Data//
textField -fileName "D:/DATA/xff/" -width 200 "filePath" ;//Data//
button -label "Brouse" "Brouse" ;//Data//
text -label "ModelName" "text7" ;//Data//
text -label "AnimationName" "text6" ;//Data//
separator -width 300 "separator9" ;//Data//
button -backgroundColor 0.9411966801 1 0.7639999986 -label "exit" -width 48 -recomputeSize 0 -command "deleteUI MyTools_HRC_XFF_Export" "exit" ;//Data//
button -width 48 -backgroundColor 1 0.8368660212 0.7720000148 -label "Export" -recomputeSize 0 -command "MS_HRC_XFF_Export_core" "Export" ;//Data//
separator -width 300 -height 2 "separator8" ;//Data//
textField -width 100 "AnimationName" ;//Data//
textField -width 100 -fileName "" -text "ModelName" -insertText "" -annotation "ModelName" -preventOverride 0 "ModelName" ;//Data//
checkBox -recomputeSize 0 -v 0 -label "IgnoreReferencenode" -width 128 "IgnoreReferencenode" ;//Data//
checkBox -recomputeSize 0 -v 0 -label "IgnoreBindpose" -width 128 "IgnoreBindpose" ;//Data//
checkBox -recomputeSize 0 -v 1 -label "ExportMatAnim" -width 128 "ExportMatAnim" ;//Data//
checkBox -recomputeSize 0 -v 1 -label "ExportAnim" -width 128 "ExportAnim" ;//Data//
checkBox -recomputeSize 0 -v 1 -label "ExportModel" -width 128 "ExportModel" ;//Data//
formLayout -e
	-af "tex10" "left" 0//Data//
	-af "tex10" "top" 128//Data//
	-af "filePath" "left" 0//Data//
	-af "filePath" "top" 144//Data//
	-af "Brouse" "left" 224//Data//
	-af "Brouse" "top" 144//Data//
	-af "text7" "left" 176//Data//
	-af "text7" "top" 32//Data//
	-af "text6" "left" 176//Data//
	-af "text6" "top" 64//Data//
	-af "separator9" "left" 0//Data//
	-af "separator9" "top" 176//Data//
	-af "exit" "left" 256//Data//
	-af "exit" "top" 192//Data//
	-af "Export" "left" 192//Data//
	-af "Export" "top" 192//Data//
	-af "separator8" "left" 0//Data//
	-af "separator8" "top" 112//Data//
	-af "AnimationName" "left" 176//Data//
	-af "AnimationName" "top" 80//Data//
	-af "ModelName" "left" 176//Data//
	-af "ModelName" "top" 48//Data//
	-af "IgnoreReferencenode" "left" 16//Data//
	-af "IgnoreReferencenode" "top" 80//Data//
	-af "IgnoreBindpose" "left" 16//Data//
	-af "IgnoreBindpose" "top" 64//Data//
	-af "ExportMatAnim" "left" 16//Data//
	-af "ExportMatAnim" "top" 48//Data//
	-af "ExportAnim" "left" 16//Data//
	-af "ExportAnim" "top" 32//Data//
	-af "ExportModel" "left" 16//Data//
	-af "ExportModel" "top" 16//Data//
//--DataPart--//
myUIFormLayout;
showWindow MyTools_HRC_XFF_Export;
}
HRC_XFF_Export;
