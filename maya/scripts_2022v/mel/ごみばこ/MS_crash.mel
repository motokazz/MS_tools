
global proc copyTransform(string $source,string $dist){

	float $tx,$ty,$tz,$rx,$ry,$rz,$sx,$sy,$sz;

	$tx =	getAttr ($dist + ".tx");
		setAttr ($source+ ".tx") $tx;
	$ty =	getAttr ($dist + ".ty");
		setAttr ($source+ ".ty") $ty;
	$tz =	getAttr ($dist + ".tz");
		setAttr ($source+ ".tz") $tz;

	$rx =	getAttr ($dist + ".rx");
		setAttr ($source+ ".rx") $rx ;
	$ry =	getAttr ($dist + ".ry");
		setAttr ($source+ ".ry") $ry;
	$rz =	getAttr ($dist + ".rz");
		setAttr ($source+ ".rz") $rz;

	$sx =	getAttr ($dist + ".sx");
		setAttr ($source+ ".sx") $sx;
	$sy =	getAttr ($dist + ".sy");
		setAttr ($source+ ".sy") $sy;
	$sz =	getAttr ($dist + ".sz");
		setAttr ($source+ ".sz") $sz ;
}



global proc MS_rndvtxsel(string $obj_b){
	
	int $rndvtx=`rand 57`;
		string $newname=$obj_b+".vtx["+$rndvtx+"]";
		select -r  $newname;
}

global proc MS_vtxcenter(string $obj_b){

	vector $numberPoint = `pointPosition -w`; 
	
	string $spv=$obj_b+".scalePivot";
	string $rpv=$obj_b+".rotatePivot";
	
	move -ws ($numberPoint.x)($numberPoint.y)($numberPoint.z) $spv $rpv ;

}

global proc MS_randomrotate(string $obj_b){
	
	$rndx=`rand 360`;
	$rndy=`rand 360`;
	$rndz=`rand 360`;
	
	rotate $rndx $rndy $rndz $obj_b;
	
	
}




global proc MS_CenterResetter(string $obj_a){


string $obj_a_tx=$obj_a+".tx";
string $obj_a_ty=$obj_a+".ty";
string $obj_a_tz=$obj_a+".tz";

string $obj_a_rpx=$obj_a+".rotatePivotX";
string $obj_a_rpy=$obj_a+".rotatePivotY";
string $obj_a_rpz=$obj_a+".rotatePivotZ";

float $orgx=`getAttr $obj_a_tx`;
float $orgy=`getAttr $obj_a_ty`;
float $orgz=`getAttr $obj_a_tz`;
float $flpx=`getAttr $obj_a_rpx`;
float $flpy=`getAttr $obj_a_rpy`;
float $flpz=`getAttr $obj_a_rpz`;

setAttr $obj_a_tx (-$flpx);
setAttr $obj_a_ty (-$flpy);
setAttr $obj_a_tz (-$flpz);

makeIdentity -apply true -t 1 -r 1 -s 0 -n 0 $obj_a;

setAttr $obj_a_tx ($orgx+$flpx);
setAttr $obj_a_ty ($orgy+$flpy);
setAttr $obj_a_tz ($orgz+$flpz);

}



global proc MS_ctrfit(string $dist,string $source){
	
	xform -cp $dist;
	
	$tx=getAttr ($dist + ".tx");
	$tx=$tx+getAttr ($dist + ".rpx");
	$ty=getAttr ($dist + ".ty");
	$ty=$ty+getAttr ($dist + ".rpy");
	$tz=getAttr ($dist + ".tz");
	$tz=$tz+getAttr ($dist + ".rpz");

	move -ws $tx $ty $tz $source;

}


global proc MS_bools(string $obj_a,string $obj_b){
	
	duplicate -n "bla" $obj_a;
	duplicate -n "blb" $obj_b;
	polyBoolOp -n "pc_a" -op 2 -ch 0 bla blb;
	
	duplicate -n "bla" $obj_a;
	duplicate -n "blb" $obj_b;
	polyBoolOp -n "pc_b" -op 3 -ch 0 bla blb;

	delete $obj_a;
	
}





global proc MS_crash(){
		
	//checker
	string $nameOfObjs[] = `ls -sl`;
	
	if ( size($nameOfObjs[0]) == 0 )
	{
		confirmDialog -t "Nothing Selected" -m "Please select an object." -b Continue;
		return;
	}
	
	MS_rndvtxsel $nameOfObjs[1];
	MS_vtxcenter $nameOfObjs[1];
	MS_randomrotate $nameOfObjs[1];
	MS_CenterResetter $nameOfObjs[1];
	
	MS_ctrfit $nameOfObjs[0] $nameOfObjs[1];
	
	MS_bools $nameOfObjs[0] $nameOfObjs[1];
	confirmDialog -t "Nothing Selected" -m $nameOfObjs[0]  -b Continue;
	
}

MS_crash;
