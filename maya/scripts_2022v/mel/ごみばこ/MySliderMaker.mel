// Creation Date: <Date>// Author: <Your Name Here>//// Description: This script creates a custom slider that // controls the Translate Y attribute of an object named // pSphere1.// -----------------global proc MySliderMaker(){	if(`window -exists mySliderTest`){		deleteUI mySliderTest;	}	window -title "Slider for testobj" mySliderTest;	columnLayout ;	attrFieldSliderGrp		-min -10		-max 10		-at .tx;	attrFieldSliderGrp		-min -10		-max 10		-at .ty;	attrFieldSliderGrp		-min -10		-max 10		-at .tz;	attrFieldSliderGrp		-min -10		-max 10		-at .rx;	attrFieldSliderGrp		-min -10		-max 10		-at .ry;	attrFieldSliderGrp		-min -10		-max 10		-at .rz;	attrFieldSliderGrp		-min -10		-max 10		-at .sx;	attrFieldSliderGrp		-min -10		-max 10		-at .sy;	attrFieldSliderGrp		-min -10		-max 10		-at .sz;	showWindow mySliderTest;}