/*
-------------------
MS_locater.mel
-------------------

◆概要
数値入力による絶対・相対・ランダムな移動・回転・スケーリングツール。


◆使用方法
実行するとダイアログが出るので適当にいじるといろいろなことがおきる。


◆詳細
とりあえずRandomとExpandは使えると思う。


※注意


改良課題：
・オブジェクト形状の中心にセンターを強制移動してしまうのを直す。
・元スケールからリニアに減算するデュプリケーターをつくる。
・親子関係を考慮したセンター操作が出来るようにする。

*/




global proc vector MS_ditectCenter(int $mode){
	/*
	0　バウンディングボックス中心検出
	1　ボリューム中心検出
	
	戻り値：vector
	*/
	
	//より分け選択
	string $objz[];
	
	if(`selectMode -q -co`){
		$objz=`filterExpand -sm 31 -sm 32 -sm 34 -sm 46`;
	}else{
		$objz=`ls -tr -sl`;
	}	
	
	
	vector $loc;
	string $locatorList[];
	string $temp[];
	
	float $totalX;
	float $totalY;
	float $totalZ;
	
	if ($mode==0){
		
		//バウンディングボックス中心検出
		
		float $bbox[6] = `exactWorldBoundingBox $objz`;
		$loc=<<(($bbox[3]+$bbox[0])/2),(($bbox[4]+$bbox[1])/2),(($bbox[5]+$bbox[2])/2)>>;
		
		
	}else if ($mode==1){
		
		//ボリューム中心検出
		for ($each in $objz){
			
			vector $location=`xform -q -ws -t $each`;

			$totalX=$totalX+($location.x);
			$totalY=$totalY+($location.y);
			$totalZ=$totalZ+($location.z);
			
		}
		
		$loc=<<($totalX/size($objz)),($totalY/size($objz)),($totalZ/size($objz))>>;
	}
	
	return $loc;

}



global proc MS_expand(int $random,int $objCenter){
/*
$random 
0 ランダムOFF
1 ランダムON

$objCenter
0 ローテーション時にオブジェクトのローテーションの位置をそれぞれのオブジェクトの中心にしない。
1 ローテーション時にオブジェクトのローテーションの位置をそれぞれのオブジェクトの中心にする。

*/

	string $objz[];
	
	if(`selectMode -q -co`){
		$objz=`filterExpand -sm 31 -sm 32 -sm 34 -sm 46`;
	}else{
		$objz=`ls -tr -sl`;
	}
	
	float $expx=`floatSliderGrp -q -v expx`;
	float $expy=`floatSliderGrp -q -v expy`;
	float $expz=`floatSliderGrp -q -v expz`;
	
	float $trnx=`floatSliderGrp -q -v trnx`;
	float $trny=`floatSliderGrp -q -v trny`;
	float $trnz=`floatSliderGrp -q -v trnz`;
	
	float $rotx=`floatSliderGrp -q -v rotx`;
	float $roty=`floatSliderGrp -q -v roty`;
	float $rotz=`floatSliderGrp -q -v rotz`;
	
	float $sclx=`floatSliderGrp -q -v sclx`;
	float $scly=`floatSliderGrp -q -v scly`;
	float $sclz=`floatSliderGrp -q -v sclz`;
	
	$rndtx=$trnx;
	$rndty=$trny;
	$rndtz=$trnz;
	
	$rnd_rotx=$rotx;
	$rnd_roty=$roty;
	$rnd_rotz=$rotz;
	
	$rnd_sclx=$sclx;
	$rnd_scly=$scly;
	$rnd_sclz=$sclz;
	
	//----center check---
	select -r $objz;
	vector $center=`MS_ditectCenter 1`;
	print ($center+"\n");
	
	for($name in $objz){
		
		if(!`selectMode -q -co`||$objCenter==1){
			xform -cp $name;
		}

		//----center check---
		
		select -r $name;
		vector $nameCenter=`MS_ditectCenter 1 `;
		
		//---Create Randomseed---
		
		if($random==1){
			
			$rndtx=rand($trnx,(-$trnx));
			$rndty=rand($trny,(-$trny));
			$rndtz=rand($trnz,(-$trnz));
			
			$rnd_rotx=rand($rotx,-$rotx);
			$rnd_roty=rand($roty,-$roty);
			$rnd_rotz=rand($rotz,-$rotz);
			
			$rnd_sclx=rand(1,$sclx);
			$rnd_scly=rand(1,$scly);
			$rnd_sclz=rand(1,$sclz);
			
		}
		
		//---Expand&Translarte---
		$valx=(((($nameCenter.x)-($center.x))*($expx-1))+$rndtx);
		$valy=(((($nameCenter.y)-($center.y))*($expy-1))+$rndty);
		$valz=(((($nameCenter.z)-($center.z))*($expz-1))+$rndtz);
		
		move -ws -r $valx $valy $valz $name;
		
		rotate -p ($nameCenter.x) ($nameCenter.y) ($nameCenter.z) -r $rnd_rotx $rnd_roty $rnd_rotz $name;
		
		scale -r $rnd_sclx $rnd_scly $rnd_sclz $name;
	}
	
	select $objz;
	
}



global proc MS_expandV2(int $random,int $objCenter){
/*
$random 
0 ランダムOFF
1 ランダムON

$objCenter
0 ローテーション時にオブジェクトのローテーションの位置をそれぞれのオブジェクトの中心にしない。
1 ローテーション時にオブジェクトのローテーションの位置をそれぞれのオブジェクトの中心にする。

*/

	string $objz[];
	
	if(`selectMode -q -co`){
		$objz=`filterExpand -sm 31 -sm 32 -sm 34 -sm 46`;
	}else{
		$objz=`ls -tr -sl`;
	}
	
	float $expx=`floatSliderGrp -q -v expx`;
	float $expy=`floatSliderGrp -q -v expy`;
	float $expz=`floatSliderGrp -q -v expz`;
	
	float $trnx=`floatSliderGrp -q -v trnx`;
	float $trny=`floatSliderGrp -q -v trny`;
	float $trnz=`floatSliderGrp -q -v trnz`;
	
	float $rotx=`floatSliderGrp -q -v rotx`;
	float $roty=`floatSliderGrp -q -v roty`;
	float $rotz=`floatSliderGrp -q -v rotz`;
	
	float $sclx=`floatSliderGrp -q -v sclx`;
	float $scly=`floatSliderGrp -q -v scly`;
	float $sclz=`floatSliderGrp -q -v sclz`;
	
	$rndtx=$trnx;
	$rndty=$trny;
	$rndtz=$trnz;
	
	$rnd_rotx=$rotx;
	$rnd_roty=$roty;
	$rnd_rotz=$rotz;
	
	$rnd_sclx=$sclx;
	$rnd_scly=$scly;
	$rnd_sclz=$sclz;
	
	//----center check---
	select -r $objz;
	vector $center=`xform -q -t $objz[0]`;
	print ($center+"\n");
	
	for($name in $objz){
		
		if(!`selectMode -q -co`||$objCenter==1){
			xform -cp $name;
		}

		//----center check---
		
		select -r $name;
		vector $nameCenter=`MS_ditectCenter 1 `;
		
		//---Create Randomseed---
		
		if($random==1){
			
			$rndtx=rand($trnx,(-$trnx));
			$rndty=rand($trny,(-$trny));
			$rndtz=rand($trnz,(-$trnz));
			
			$rnd_rotx=rand($rotx,-$rotx);
			$rnd_roty=rand($roty,-$roty);
			$rnd_rotz=rand($rotz,-$rotz);
			
			$rnd_sclx=rand(1,$sclx);
			$rnd_scly=rand(1,$scly);
			$rnd_sclz=rand(1,$sclz);
			
		}
		
		//---Expand&Translarte---
		$valx=(((($nameCenter.x)-($center.x))*($expx-1))+$rndtx);
		$valy=(((($nameCenter.y)-($center.y))*($expy-1))+$rndty);
		$valz=(((($nameCenter.z)-($center.z))*($expz-1))+$rndtz);
		
		move -ws -r $valx $valy $valz $name;
		
		rotate -p ($nameCenter.x) ($nameCenter.y) ($nameCenter.z) -r $rnd_rotx $rnd_roty $rnd_rotz $name;
		
		scale -r $rnd_sclx $rnd_scly $rnd_sclz $name;
	}
	
	select $objz;
	
}



global proc MS_loc_CenterResetter_core(int $mode,int $flz_trn,int $flz_rot,int $flz_scl){
	
/*
オブジェクトの中心をピボットの位置に。



*/
	if($mode){
		print"this mode is Test!!!\n";
	}
	
	
	
	string $objz[]=`ls -sl`;
	
	for($each in $objz){
		
		$tx=($each+".tx");
		$ty=($each+".ty");
		$tz=($each+".tz");
		
		$rx=($each+".rx");
		$ry=($each+".ry");
		$rz=($each+".rz");
		
		$sx=($each+".sx");
		$sy=($each+".sy");
		$sz=($each+".sz");
		
		float $orgtx=`getAttr $tx`;
		float $orgty=`getAttr $ty`;
		float $orgtz=`getAttr $tz`;
		
		float $orgrx=`getAttr $rx`;
		float $orgry=`getAttr $ry`;
		float $orgrz=`getAttr $rz`;
		
		float $orgsx=`getAttr $sx`;
		float $orgsy=`getAttr $sy`;
		float $orgsz=`getAttr $sz`;
		
		float $pivlx=`getAttr ($each+".rotatePivotX")`;
		float $pivly=`getAttr ($each+".rotatePivotY")`;
		float $pivlz=`getAttr ($each+".rotatePivotZ")`;
		
		//.rotatePivotTranslate：なにやら隠しアトリビュート。これを使わないと、pivotの正確な移動値が割り出せない。
		float $pivtx=`getAttr ($each+".rotatePivotTranslateX")`;
		float $pivty=`getAttr ($each+".rotatePivotTranslateY")`;
		float $pivtz=`getAttr ($each+".rotatePivotTranslateZ")`;
		
		setAttr $tx (-($pivtx+$pivlx));
		setAttr $ty (-($pivty+$pivly));
		setAttr $tz (-($pivtz+$pivlz));
		
		setAttr $sx 1;
		setAttr $sy 1;
		setAttr $sz 1;
		
		makeIdentity -a 1 -t $flz_trn -r $flz_rot -s $flz_scl -n 0 $each;
		
		
		setAttr $tx ($orgtx+$pivlx+$pivtx);
		setAttr $ty ($orgty+$pivly+$pivty);
		setAttr $tz ($orgtz+$pivlz+$pivtz);
		
	}
}




global proc MS_loc_CenterResetter_pipe(){
	int $mode;
	string $cp=`radioCollection -q -sl "cp"`;
	int $flz_scl =`checkBox -q -v "flz_scl"` ;//Data//
	int $flz_rot =`checkBox -q -v "flz_rot" `;//Data//
	int $flz_trn =`checkBox -q -v "flz_trn"` ;//Data//
	print $cp;
	if($cp=="BBC"){$mode=0;}
	else if($cp=="VLC"){$mode=1;}
	
	MS_loc_CenterResetter_core $mode $flz_trn $flz_rot $flz_scl;
	
	
	
}


global proc MS_locater_valReset(){
	/*
	UIの値をすべてリセット。
	*/
	
	floatSliderGrp -e -v 1 expx;
	floatSliderGrp -e -v 1 expy;
	floatSliderGrp -e -v 1 expz;
	
	floatSliderGrp -e -v 0 trnx;
	floatSliderGrp -e -v 0 trny;
	floatSliderGrp -e -v 0 trnz;
	
	floatSliderGrp -e -v 0 rotx;
	floatSliderGrp -e -v 0 roty;
	floatSliderGrp -e -v 0 rotz;
	
	floatSliderGrp -e -v 1 sclx;
	floatSliderGrp -e -v 1 scly;
	floatSliderGrp -e -v 1 sclz;
}


global proc MS_locaterUI()
