//createcurve

curve -d 3 -p 0 0 0 -p 10 0 0 -p 20 0 0 -p 30 0 0 -p 40 0 0 -p 50 0 0 -k 0 -k 0 -k 0 -k 1 -k 2 -k 3 -k 3 -k 3 ;


//createclusuter

select -cl  ;
select -r curve1.cv[0] ;
newCluster " -envelope 1 -exclusive \"deformPartition#\"";
// Result: cluster1 cluster1Handle //
hilite -r curve1 ;
select -cl  ;
select -r curve1.cv[1] ;
newCluster " -envelope 1 -exclusive \"deformPartition#\"";
// Result: cluster2 cluster2Handle //
hilite -r curve1 ;
select -r curve1.cv[2] ;
newCluster " -envelope 1 -exclusive \"deformPartition#\"";
// Result: cluster3 cluster3Handle //
hilite -r curve1 ;
select -r curve1.cv[3] ;
newCluster " -envelope 1 -exclusive \"deformPartition#\"";
// Result: cluster4 cluster4Handle //
hilite -r curve1 ;
select -r curve1.cv[4] ;
newCluster " -envelope 1 -exclusive \"deformPartition#\"";
// Result: cluster5 cluster5Handle //
hilite -r curve1 ;
select -r curve1.cv[5] ;
newCluster " -envelope 1 -exclusive \"deformPartition#\"";
// Result: cluster6 cluster6Handle //




//CreatePolygonCube;

polyCube -w 1 -h 1 -d 1 -sx 1 -sy 1 -sz 1 -ax 0 1 0 -cuv 1 -ch 1 -n "MS_cable1";
move -rpr 10 0 0 ;

duplicate -renameChildren -smartTransform;
move -rpr 20 0 0 ;

duplicate -renameChildren -smartTransform;
move -rpr 30 0 0 ;
duplicate -renameChildren -smartTransform;
move -rpr 40 0 0 ;


//loactor

spaceLocator -p 0 0 0;

spaceLocator -p 0 0 0;
// Result: locator2 //
move -rpr 50 0 0 ;



//constraint

select -r MS_cable1 ;
select -add cluster2Handle ;
pointConstraint -offset 0 0 0 -weight 1;
// Result: cluster2Handle_pointConstraint1 //

select -r MS_cable3 ;
select -add cluster4Handle ;
pointConstraint -offset 0 0 0 -weight 1;

select -r MS_cable2 ;
select -add cluster3Handle ;
pointConstraint -offset 0 0 0 -weight 1;
// Result: cluster3Handle_pointConstraint1 //
select -r cluster5Handle ;
select -r MS_cable4 ;
select -add cluster5Handle ;
pointConstraint -offset 0 0 0 -weight 1;

select -r locator1 ;
select -add cluster2Handle ;
pointConstraint -offset 0 0 0 -weight 1;
// Result: cluster2Handle_pointConstraint1 //

select -r locator2 ;
select -add cluster6Handle ;
pointConstraint -offset 0 0 0 -weight 1;
// Result: cluster6Handle_pointConstraint1 //



//add rigidbody

// Result: cluster5Handle_pointConstraint1 //
select -r MS_cable1 ;
select -r MS_cable1 MS_cable2 MS_cable3 MS_cable4 ;
rigidBody -active -m 0.1 -dp 0 -sf 0.2 -df 0 -b 0 -l 0 -tf 200 -iv 0 0 0 -iav 0 0 0 -c 0 -pc 0 -i 0 0 0 -imp 0 0 0 -si 0 0 0 -sio none ;
// Result: rigidSolver //
// Result: rigidBody1 rigidBody2 rigidBody3 rigidBody4 //
gravity -pos 0 0 0 -m 9.8 -att 0 -dx 0 -dy -1 -dz 0  -mxd -1  -vsh none -vex 0 -vof 0 0 0 -vsw 360 -tsr 0.5 ;
// Result: gravityField1 //
connectDynamic -f gravityField1  MS_cable1 MS_cable2 MS_cable3 MS_cable4;
// Result: rigidBody1 rigidBody2 rigidBody3 rigidBody4 //





//hinge
select -r MS_cable1 ;
constrain -nail  -name "asi_hinge#" ;
// Result: asi_hinge1 //
move -rpr 0 0 0 ;
hilite -r MS_cable4 ;
select -d  ;
hilite -u MS_cable4 ;
select -r MS_cable4 ;
constrain -nail  -name "asi_hinge#" ;
// Result: asi_hinge2 //
move -rpr 50 0 0 ;
select -r MS_cable1 ;
select -tgl MS_cable2 ;




//spring
constrain -spring  -name "asi_hinge#" -st 5 -d 0.1 -i 0 ;
// Result: asi_hinge3 //
select -r MS_cable2 ;
select -tgl MS_cable3 ;
constrain -spring  -name "asi_hinge#" -st 5 -d 0.1 -i 0 ;
// Result: asi_hinge4 //
select -r MS_cable3 ;
select -tgl MS_cable4 ;
constrain -spring  -name "asi_hinge#" -st 5 -d 0.1 -i 0 ;
// Result: asi_hinge5 //


select -r MS_cable1 ;
select -tgl MS_cable2 ;
select -tgl MS_cable3 ;
select -tgl MS_cable4 ;
setAttr "rigidBody4.damping" 2;
setAttr "rigidBody1.damping" 2;
setAttr "rigidBody2.damping" 2;
setAttr "rigidBody3.damping" 2;
select -cl  ;
select -r asi_hinge3 ;
select -r asi_hinge3 asi_hinge4 ;
select -r asi_hinge3 asi_hinge4 asi_hinge5 ;
setAttr "asi_hinge5.springStiffness" 70;
setAttr "asi_hinge3.springStiffness" 70;
setAttr "asi_hinge4.springStiffness" 70;
select -addFirst rigidSolver ;
select -d rigidSolver ;
select -addFirst time1 ;
select -d time1 ;
select -addFirst rigidSolver ;
select -cl  ;





expression -s "tx = locator1.tx;"  -o asi_hinge1 -ae 1 -uc all ;
// Result: expression1 //


select -cl  ;



//create tube


circle -c 0 0 0 -nr 0 1 0 -sw 360 -r 0.2 -d 3 -ut 0 -tol 0.01 -s 8 -ch 1; objectMoveCommand;


select -r nurbsCircle1 ;
select -tgl curve1 ;
extrude -ch true -rn true -po 0 -et 2 -ucp 1 -fpt 1 -upn 0 -rotation 0 -scale 1 -rsp 1 "nurbsCircle1" "curve1" ;
// Result: extrudedSurface1 extrude1 //

setAttr "nurbsCircle1.rotateZ" 90;

wire -gw false -en 1.000000 -ce 0.000000 -li 0.000000 -w curve1 extrudedSurface1;
// Result: wire1 curve1 //

