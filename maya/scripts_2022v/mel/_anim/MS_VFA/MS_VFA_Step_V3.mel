global proc MS_VFA_Step_V3(
	int $strtm,
	int $endtm,	
	float $threshold,
	float $ground,
	string $target,
	string $obj[],
	string $tgtAttr[]
	)
{
	
	float $all[];
	//‚·‚×‚Ä‚ÌƒtƒŒ[ƒ€ŠÔ‚Å“®‚«‹——£‚ğŒŸ¸
	for($i=$strtm;$i<$endtm;$i++){
		
		currentTime $i;
		
		float $checkPos[] = `xform -q -ws -t $target`;
		$all[$i-$strtm]=$checkPos[1];
		
	}
	
	
	//ˆê”Ô‘å‚«‚¢“®‚«‚ğŒŸ¸
	float $hikaku[]=`sort $all`;
	float $bottomValue=$hikaku[0];
	
		
	currentTime -u 1 ($strtm-1);
	float $ff[]=`xform -q -ws -t $target`;
	int $val,$fval;
	for($i=$strtm;$i<$endtm;$i++){
		currentTime -u 1 $i;

		float $cf[] = `xform -q -ws -t $target`;
		
		for($each in $obj){
			for($eachAttr in $tgtAttr){
				
				float $len = sqrt(($ff[0]-$cf[0])*($ff[0]-$cf[0])+($ff[1]-$cf[1])*($ff[1]-$cf[1])+($ff[2]-$cf[2])*($ff[2]-$cf[2]));
				
				if($len>$threshold && $cf[1]<=($ground+$bottomValue)){
					$val=1;
				}
				if($len<$threshold || $cf[1]>($ground+$bottomValue)){
					$val=0;
				}
				
				if ($val!=$fval){
					setKeyframe -at $eachAttr -t ($i-1) -v $fval $each;
					setKeyframe -at $eachAttr -t $i -v $val $each;
				}
				print ($val+"||"+$len+":"+$threshold+"||"+$cf[1]+":"+($ground+$bottomValue)+"\n");
			}
		}

		$fval=$val;
		$ff= $cf;
	}
	
	//•âŠ®•ÏX
	for($each in $obj){
		selectKey -add -k ($each+"_EmitterVolume") ;
		keyTangent -ott step;
	}

	
	
	
}




