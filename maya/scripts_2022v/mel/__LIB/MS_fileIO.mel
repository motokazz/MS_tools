global proc MS_save(string $fileName,string $DATA){
	//ファイル出力処理
	int $fileId;
	if(`filetest -f $fileName`){
		$fileId=`fopen $fileName "w"`;
	}else{
		$fileId=`fopen $fileName`;
	}
 	fprint $fileId $DATA;
 	fclose $fileId;
}

global proc MS_arraySave(string $fileName,string $DATA[]){
	//配列ファイル出力処理
	int $fileId;
	if(`filetest -f $fileName`){
		$fileId=`fopen $fileName "w"`;
	}else{
		$fileId=`fopen $fileName`;
	}
	for ($each in $DATA){
		fprint $fileId $each;
	}
 	fclose $fileId;
	
}

global proc string MS_load(string $fileName){
	//ファイル入力処理
	int $fileId;
	string $DATA;
	if(`filetest -f $fileName`){
		$fileId=`fopen $fileName "r"`;
	}
 	$DATA=`fread $fileId $DATA`;
 	fclose $fileId;
	return $DATA;
}

global proc string[] MS_arrayLoad(string $fileName){
	//配列ファイル入力処理
	int $fileId;
	int $i;
	string $nextLine;
	string $DATA[];
	if(`filetest -f $fileName`){
		$fileId=`fopen $fileName "r"`;
		
		$i=0;
		do{
			$nextLine = `fgetline $fileId`;
			$DATA[$i]=$nextLine;
			$i++;
		}
		while ( size( $nextLine ) > 0 ) ;
		fclose $fileId;
	}
	return $DATA;
}

